DEFINE VARIABLE ver_por AS INTEGER LABEL "Ordenado Por" VIEW-AS RADIO-SET 
                HORIZONTAL RADIO-BUTTONS "Codigo",  1 , "Nombre", 0 INITIAL 0.

DEFINE VARIABLE des_destino LIKE Destino.cdg_destino LABEL "Desde Destino".
DEFINE VARIABLE has_destino LIKE Destino.cdg_destino LABEL "Hasta Destino".
DEFINE VARIABLE des_nombre  LIKE Destino.nombre.
DEFINE VARIABLE has_nombre  LIKE Destino.nombre.