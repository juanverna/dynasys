          v-nomrubro  = "{1}" .   
          DO j = 1 TO 12:
             v-importe  [ j ] = {2} [ j ].
          END.   
          DISPLAY v-nomrubro 
                  v-importe  [  1 ] 
                  v-importe  [  2 ] 
                  v-importe  [  3 ] 
                  v-importe  [  4 ] 
                  v-importe  [  5 ] 
                  v-importe  [  6 ] 
                  v-importe  [  7 ] 
                  v-importe  [  8 ] 
                  v-importe  [  9 ] 
                  v-importe  [ 10 ] 
                  v-importe  [ 11 ] 
                  v-importe  [ 12 ] 
                  WITH FRAME frm-listado.
          DOWN WITH FRAME frm-listado.

