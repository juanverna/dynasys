&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-assign-statement V-table-Win 
PROCEDURE local-assign-statement :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

   IF Vigencia_precios.fch_desde:INPUT-VALUE IN FRAME {&FRAME-NAME} > Lista_Precios.rige_hasta OR
      Vigencia_precios.fch_desde:INPUT-VALUE IN FRAME {&FRAME-NAME} < Lista_Precios.rige_desde
   THEN DO:
       RUN ponmensj.p ( "LPRE010" ).
   END.
  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'assign-statement':U ) .

  /* Code placed here will execute AFTER standard behavior.    */

  {findempresa.i}
  Vigencia_precios.cdg_empresa = Empresa.cdg_empresa.
  Vigencia_precios.cdg_lista   = Lista_precios.cdg_lista.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-delete-record V-table-Win 
PROCEDURE local-delete-record :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */
  
  DEFINE VARIABLE sino AS LOGICAL.

  sino = NO.

   MESSAGE "La eliminacion de la vigencia de precios producirá"
            "tambien la eliminación de todos los cambios de precio con esa fecha. Desea Proceder"
       VIEW-AS ALERT-BOX QUESTION  BUTTONS YES-NO TITLE "Confirmación" UPDATE sino.

   IF sino
   THEN DO:
       FOR EACH Articulo_precio OF Vigencia_precios:
           DELETE Articulo_precio.
       END.
   END.

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'delete-record':U ) .

  /* Code placed here will execute AFTER standard behavior.    */

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

