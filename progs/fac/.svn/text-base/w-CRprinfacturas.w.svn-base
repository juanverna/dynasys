&ANALYZE-RESUME


/* **********************  Internal Procedures  *********************** */

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE adm-create-objects W-Win  _ADM-CREATE-OBJECTS
PROCEDURE adm-create-objects :
/*------------------------------------------------------------------------------
  Purpose:     Create handles for all SmartObjects used in this procedure.
               After SmartObjects are initialized, then SmartLinks are added.
  Parameters:  <none>
------------------------------------------------------------------------------*/
  DEFINE VARIABLE adm-current-page  AS INTEGER NO-UNDO.

  RUN get-attribute IN THIS-PROCEDURE ('Current-Page':U).
  ASSIGN adm-current-page = INTEGER(RETURN-VALUE).

  CASE adm-current-page: 

    WHEN 0 THEN DO:
       RUN init-object IN THIS-PROCEDURE (
             INPUT  'v-rng-facturas.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Layout = ':U ,
             OUTPUT h_v-rng-facturas ).
       RUN set-position IN h_v-rng-facturas ( 9.10 , 11.00 ) NO-ERROR.
       /* Size in UIB:  ( 5.71 , 103.00 ) */

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'p-CRejecutarSPPAU.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Layout = ':U ,
             OUTPUT h_p-ejecutar ).
       RUN set-position IN h_p-ejecutar ( 16.71 , 11.00 ) NO-ERROR.
       /* Size in UIB:  ( 2.14 , 103.00 ) */

       /* Adjust the tab order of the smart objects. */
       RUN adjust-tab-order IN adm-broker-hdl ( h_v-rng-facturas ,
             btn-buscar:HANDLE IN FRAME F-Main , 'AFTER':U ).
       RUN adjust-tab-order IN adm-broker-hdl ( h_p-ejecutar ,
             v-estado:HANDLE IN FRAME F-Main , 'AFTER':U ).
    END. /* Page 0 */

  END CASE.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE adm-row-available W-Win  _ADM-ROW-AVAILABLE
PROCEDURE adm-row-available :
/*------------------------------------------------------------------------------
  Purpose:     Dispatched to this procedure when the Record-
               Source has a new row available.  This procedure
               tries to get the new row (or foriegn keys) from
               the Record-Source and process it.
  Parameters:  <none>
------------------------------------------------------------------------------*/

  /* Define variables needed by this internal procedure.             */
  {src/adm/template/row-head.i}

  /* Process the newly available records (i.e. display fields,
     open queries, and/or pass records on to any RECORD-TARGETS).    */
  {src/adm/template/row-end.i}

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE buscar W-Win 
PROCEDURE buscar :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
  DEFINE VAR cant AS INT NO-UNDO.
  DEFINE BUFFER bPunto-venta FOR Punto-venta.
  v-estado:SCREEN-VALUE IN FRAME {&FRAME-NAME} = "Espere mientras se busca los pendientes de impresion".
  chProgressBar:ProgressBar:MIN = 0.    
  cant = 0.
  FOR EACH bPunto-venta WHERE bPunto-venta.Habilitado:
      cant = cant + ( IF  bPunto-venta.TP = "E" THEN 2 ELSE 1 ).
  END.
  chProgressBar:ProgressBar:MAX = cant. 
  chProgressBar:ProgressBar:value = 0. 
  EMPTY TEMP-TABLE t-pendiente.

  FOR EACH bPunto-venta WHERE bPunto-venta.Habilitado AND bPunto-venta.TP = "E"
      BY bPunto-venta.cdg_puntovta:
      RUN rango ( bPunto-venta.cdg_puntovta, "FA" ). 
      chProgressBar:ProgressBar:value = chProgressBar:ProgressBar:VALUE + 1.    
      RUN rango ( bPunto-venta.cdg_puntovta, "FB" ). 
      chProgressBar:ProgressBar:value = chProgressBar:ProgressBar:VALUE + 1.    
  END.
  FOR EACH bPunto-venta WHERE bPunto-venta.Habilitado AND bPunto-venta.TP = "M" 
      BY bPunto-venta.cdg_puntovta:
      RUN rango ( bPunto-venta.cdg_puntovta, "FC" ). 
      chProgressBar:ProgressBar:value = chProgressBar:ProgressBar:VALUE + 1.    
  END.
  {&OPEN-QUERY-{&BROWSE-NAME}}
  v-estado:SCREEN-VALUE in FRAME {&FRAME-NAME} = "Proceso Terminado. Ingresando Parametros ...".
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE control_load W-Win  _CONTROL-LOAD
PROCEDURE control_load :
/*------------------------------------------------------------------------------
  Purpose:     Load the OCXs    
  Parameters:  <none>
  Notes:       Here we load, initialize and make visible the 
               OCXs in the interface.                        
------------------------------------------------------------------------------*/

&IF "{&OPSYS}" = "WIN32":U AND "{&WINDOW-SYSTEM}" NE "TTY":U &THEN
DEFINE VARIABLE UIB_S    AS LOGICAL    NO-UNDO.
DEFINE VARIABLE OCXFile  AS CHARACTER  NO-UNDO.

OCXFile = SEARCH( "w-CRprinfacturas.wrx":U ).
IF OCXFile = ? THEN
  OCXFile = SEARCH(SUBSTRING(THIS-PROCEDURE:FILE-NAME, 1,
                     R-INDEX(THIS-PROCEDURE:FILE-NAME, ".":U), "CHARACTER":U) + "wrx":U).

IF OCXFile <> ? THEN
DO:
  ASSIGN
    chProgressBar = ProgressBar:COM-HANDLE
    UIB_S = chProgressBar:LoadControls( OCXFile, "ProgressBar":U)
  .
  RUN DISPATCH IN THIS-PROCEDURE("initialize-controls":U) NO-ERROR.
END.
ELSE MESSAGE "w-CRprinfacturas.wrx":U SKIP(1)
             "The binary control file could not be found. The controls cannot be loaded."
             VIEW-AS ALERT-BOX TITLE "Controls Not Loaded".

&ENDIF

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE disable_UI W-Win  _DEFAULT-DISABLE
PROCEDURE disable_UI :
/*------------------------------------------------------------------------------
  Purpose:     DISABLE the User Interface
  Parameters:  <none>
  Notes:       Here we clean-up the user-interface by deleting
               dynamic widgets we have created and/or hide 
               frames.  This procedure is usually called when
               we are ready to "clean-up" after running.
------------------------------------------------------------------------------*/
  /* Delete the WINDOW we created */
  IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(W-Win)
  THEN DELETE WIDGET W-Win.
  IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE enable_UI W-Win  _DEFAULT-ENABLE
PROCEDURE enable_UI :
/*------------------------------------------------------------------------------
  Purpose:     ENABLE the User Interface
  Parameters:  <none>
  Notes:       Here we display/view/enable the widgets in the
               user-interface.  In addition, OPEN all queries
               associated with each FRAME and BROWSE.
               These statements here are based on the "Other 
               Settings" section of the widget Property Sheets.
------------------------------------------------------------------------------*/
  DISPLAY v-estado 
      WITH FRAME F-Main IN WINDOW W-Win.
  ENABLE BROWSE-2 btn-buscar 
      WITH FRAME F-Main IN WINDOW W-Win.
  {&OPEN-BROWSERS-IN-QUERY-F-Main}
  VIEW W-Win.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-exit W-Win 
PROCEDURE local-exit :
/* -----------------------------------------------------------
  Purpose:  Starts an "exit" by APPLYing CLOSE event, which starts "destroy".
  Parameters:  <none>
  Notes:    If activated, should APPLY CLOSE, *not* dispatch adm-exit.   
-------------------------------------------------------------*/
   APPLY "CLOSE":U TO THIS-PROCEDURE.
   
   RETURN.
       
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-initialize W-Win 
PROCEDURE local-initialize :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'initialize':U ) .

  /* Code placed here will execute AFTER standard behavior.    */
RUN buscar.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-view W-Win 
PROCEDURE local-view :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'view':U ) .

  /* Code placed here will execute AFTER standard behavior.    */

  {setwintit.i "SIC/FAC" "Impresión de Facturas"}

  v-estado:SCREEN-VALUE IN FRAME {&FRAME-NAME} = "Ingresando Parametros ...".

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE lst-ejecutar W-Win 
PROCEDURE lst-ejecutar :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
  DEFINE VARIABLE v-tip_comprob      LIKE Fac_header.tip_comprob.
  DEFINE VARIABLE v-prf_comprob      LIKE Fac_header.prf_comprob.
  DEFINE VARIABLE v-des_nrocomprob   LIKE Fac_header.nro_comprob.
  DEFINE VARIABLE v-has_nrocomprob   LIKE Fac_header.nro_comprob.


  DEFINE VARIABLE error_rango      AS LOGICAL NO-UNDO.
  DEFINE VARIABLE hay_error        AS LOGICAL NO-UNDO.
  DEFINE VARIABLE ERROR_nro        AS INT NO-UNDO.
  DEFINE VAR juntas AS LOGICAL NO-UNDO.
  DEFINE VAR listaposible AS CHAR NO-UNDO.
  DEFINE VAR cFullPath AS CHAR NO-UNDO.
  DEFINE VAR xFullPath AS CHAR NO-UNDO.
  DEFINE VAR ReportePath AS CHAR NO-UNDO.
  DEFINE VAR exportFileName AS CHAR NO-UNDO.
  DEF VAR xfile AS CHAR NO-UNDO.
  {findempresa.i}

   RUN dar_rango IN h_v-rng-facturas  ( OUTPUT v-tip_comprob,
                                       OUTPUT v-prf_comprob,
                                       OUTPUT v-des_nrocomprob,
                                       OUTPUT v-has_nrocomprob,
                                       OUTPUT error_rango ).

  IF error_rango 
  THEN DO:
       RUN ver-error-rango ( "Datos de rango" ).
       hay_error = error_rango.
  END.    
  IF NOT hay_error  THEN DO:
         RUN getparametro_l.p( INPUT "CREDEBFC" , OUTPUT juntas ).
         IF juntas THEN
           listaposible = "F" + SUBSTR(v-tip_comprob,2) + ",C" + SUBSTR(v-tip_comprob,2) + ",D" + SUBSTR(v-tip_comprob,2).
        ELSE
           listaposible = v-tip_comprob.
      
      FIND FIRST fac_header 
              WHERE Fac_header.cdg_empresa  = empresa.cdg_empresa
              AND CAN-DO(listaposible, Fac_header.tip_comprob)
              AND Fac_header.prf_comprob  = v-prf_comprob
              AND Fac_header.nro_comprob  <= v-has_nrocomprob
              AND Fac_header.nro_comprob  >= v-des_nrocomprob NO-LOCK NO-ERROR.
    
      IF NOT AVAILABLE fac_header THEN DO:
           RUN ver-error-rango ( "Ninguna factura en ese rango" ).
           hay_error = error_rango.
      END.
  END.
  IF NOT hay_error
  THEN DO:
       
       v-estado:SCREEN-VALUE IN FRAME {&FRAME-NAME} = "Ejecutando Proceso ...".
       ReportePath = "FAC/" + formularioFAC( ROWID(fac_header) ).
/*       MESSAGE v-des_nrocomprob v-has_nrocomprob SKIP 
           reportePath + "MR.p"
           VIEW-AS ALERT-BOX INFO BUTTONS OK.*/

       RUN VALUE( reportePath + "MR.p")  ( 
                            INPUT v-tip_comprob,
                            INPUT v-prf_comprob,
                            INPUT v-des_nrocomprob,
                            INPUT v-has_nrocomprob,
                            INPUT empresa.cdg_empresa,
                            OUTPUT xfile
                           ).
     
       /*a Imprimir*/
    
        RUN fullPath (ReportePath, '.rpt':U, OUTPUT cFullPath).
        IF cFullPath = ? 
        THEN DO:
            RUN mensajepar.p (INPUT cfullPath, INPUT "CREP000").
            RETURN ERROR.
        END.
        CREATE "CrystalRuntime.Application" chApplication.
        chReport = chApplication:OpenReport(cFullPath, {&crOpenReportByTempCopy}).
        chReport:DiscardSavedData(). /*eliminando lo previamente grabado*/
        RUN fullpath ( INPUT xfile, INPUT "", OUTPUT xFullPath ).
        chReport:Database:Tables:item(1):setTableLocation(xFullPath, '', '').
        RUN crearReporte(chReport,"rpt",/*ViewReport*/ FALSE, /*impresora*/ "?" , 
            /*exportToDisk*/ FALSE, INPUT-OUTPUT exportFileName ).        
            RELEASE OBJECT chReport. 
            chReport = ?.
            RELEASE OBJECT chApplication.
            chApplication = ?.

  /*         RUN borra_temp ( INPUT xfile, OUTPUT ERROR_nro ).*/
           RUN buscar.
           v-estado:SCREEN-VALUE in FRAME {&FRAME-NAME} = "Proceso Terminado. Ingresando Parametros ...".
      END.
    
    
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE rango W-Win 
PROCEDURE rango :
/*------------------------------------------------------------------------------
  Purpose:     crea en la temporal t-
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
DEF VAR listaposible AS CHAR NO-UNDO.
DEF VAR juntas AS LOGICAL NO-UNDO.
DEFINE INPUT PARAMETER v-prf_comprob LIKE fac_header.prf_comprob.
DEFINE INPUT PARAMETER v-tip_comprob LIKE fac_header.tip_comprob.

DEFINE VAR ii LIKE fac_header.nro_comprob NO-UNDO.
{findempresa.i}
RUN getparametro_l.p( INPUT "CREDEBFC" , OUTPUT juntas ).
IF juntas THEN
 listaposible = "F" + SUBSTR(v-tip_comprob,2) + ",C" + SUBSTR(v-tip_comprob,2) + ",D" + SUBSTR(v-tip_comprob,2).
ELSE
 listaposible = v-tip_comprob.

FOR EACH Fac_header NO-LOCK
       WHERE Fac_header.cdg_empresa = empresa.cdg_empresa 
         AND CAN-DO(listaposible, Fac_header.tip_comprob)
         AND Fac_header.prf_comprob = v-prf_comprob 
         AND fac_header.impreso = ""
         BREAK BY Fac_header.prf_comprob BY Fac_header.nro_comprob :

  IF FIRST-OF( Fac_header.prf_comprob ) THEN DO:
      CREATE t-pendiente.
      ASSIGN 
          t-pendiente.cdg_puntovta      = Fac_header.prf_comprob
          t-pendiente.tip_comprob       = Fac_header.tip_comprob
          t-pendiente.primer_comprob    = fac_header.nro_comprob
          t-pendiente.ultimo_comprob    = fac_header.nro_comprob
          ii = t-pendiente.primer_comprob.
     
  END.
  IF LAST-OF( Fac_header.prf_comprob ) THEN DO:
      ASSIGN 
          t-pendiente.ultimo_comprob    = fac_header.nro_comprob.
          ii = t-pendiente.primer_comprob.
      NEXT.
  END.

  IF ii <> fac_header.nro_comprob THEN DO:
      ASSIGN 
          t-pendiente.ultimo_comprob    = ii - 1.
      CREATE t-pendiente.
      ASSIGN 
          t-pendiente.cdg_puntovta      = Fac_header.prf_comprob
          t-pendiente.tip_comprob       = Fac_header.tip_comprob
          t-pendiente.primer_comprob    = fac_header.nro_comprob
          t-pendiente.ultimo_comprob    = fac_header.nro_comprob
          ii = t-pendiente.primer_comprob.
  END.
  ii = ii + 1.
END.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

