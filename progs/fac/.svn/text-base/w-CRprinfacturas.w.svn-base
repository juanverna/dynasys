     _START_FREEFORM
OPEN QUERY {&SELF-NAME}
    FOR EACH T-Pendiente ,
        FIRST punto-venta WHERE punto-venta.cdg_puntovta = T-Pendiente.cdg_puntovta
         NO-LOCK BY T-Pendiente.cdg_puntovta .
     _END_FREEFORM
     _Query            is OPENED
*/  /* BROWSE BROWSE-2 */
