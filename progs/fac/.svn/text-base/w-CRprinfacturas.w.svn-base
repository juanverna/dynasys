/* Definitions for BROWSE BROWSE-2                                      */
&Scoped-define FIELDS-IN-QUERY-BROWSE-2 T-Pendiente.cdg_puntovta Punto-venta.dsc_puntovta T-Pendiente.tip_comprob T-Pendiente.primer_comprob T-Pendiente.ultimo_comprob   
&Scoped-define ENABLED-FIELDS-IN-QUERY-BROWSE-2   
&Scoped-define SELF-NAME BROWSE-2
&Scoped-define QUERY-STRING-BROWSE-2 FOR EACH T-Pendiente , ~
               FIRST punto-venta WHERE punto-venta.cdg_puntovta = T-Pendiente.cdg_puntovta          NO-LOCK BY T-Pendiente.cdg_puntovta
&Scoped-define OPEN-QUERY-BROWSE-2 OPEN QUERY {&SELF-NAME}     FOR EACH T-Pendiente , ~
               FIRST punto-venta WHERE punto-venta.cdg_puntovta = T-Pendiente.cdg_puntovta          NO-LOCK BY T-Pendiente.cdg_puntovta .
&Scoped-define TABLES-IN-QUERY-BROWSE-2 T-Pendiente punto-venta
&Scoped-define FIRST-TABLE-IN-QUERY-BROWSE-2 T-Pendiente
&Scoped-define SECOND-TABLE-IN-QUERY-BROWSE-2 punto-venta


/* Definitions for FRAME F-Main                                         */
