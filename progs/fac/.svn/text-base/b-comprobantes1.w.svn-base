/* ***********************  Control Definitions  ********************** */


/* Definitions of the field level widgets                               */
/* Query definitions                                                    */
&ANALYZE-SUSPEND
DEFINE QUERY br_table FOR 
      Fac_header SCROLLING.
&ANALYZE-RESUME

/* Browse definitions                                                   */
DEFINE BROWSE br_table
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _DISPLAY-FIELDS br_table B-table-Win _STRUCTURED
  QUERY br_table NO-LOCK DISPLAY
      Fac_header.anulado FORMAT "Si/No":U
      Fac_header.impreso COLUMN-LABEL "I" FORMAT "X":U WIDTH 1.4
      Fac_header.estado_2_impresion COLUMN-LABEL "Rec!Imp." FORMAT "X(2)":U
      aplicado() @ aplicado COLUMN-LABEL "AP" FORMAT "X":U
      pagado() @ paga COLUMN-LABEL "P" FORMAT "X":U
      Fac_header.fecha FORMAT "99/99/9999":U
      Fac_header.tip_comprob COLUMN-LABEL "Ti!po" FORMAT "X(3)":U
      Fac_header.prf_comprob COLUMN-LABEL "Pre!fijo" FORMAT "9999":U
      Fac_header.nro_comprob COLUMN-LABEL "Número!Comprob" FORMAT "ZZZZZZZ9":U
      Fac_header.imp_total FORMAT "->,>>>,>>>,>>9.99":U
      listaP() @ listaP COLUMN-LABEL "Lista" FORMAT "X(8)":U WIDTH 8.6
      Fac_header.nro_contrato FORMAT "ZZZZZ9":U WIDTH 14.4
      Fac_header.nro_evento_correo COLUMN-LABEL "Evento!EV" FORMAT "->>>>>>9":U
            WIDTH 16.6
/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME
    WITH NO-ASSIGN NO-ROW-MARKERS NO-COLUMN-SCROLLING SEPARATORS SIZE 114 BY 6.43 ROW-HEIGHT-CHARS .67 FIT-LAST-COLUMN.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME F-Main
     br_table AT ROW 1 COL 1
    WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY 
         SIDE-LABELS NO-UNDERLINE THREE-D 
         AT COL 1 ROW 1
         SIZE 137.8 BY 6.43 WIDGET-ID 100.


