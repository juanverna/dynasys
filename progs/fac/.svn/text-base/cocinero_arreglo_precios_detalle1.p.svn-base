DEFINE VAR vv AS DECIMAL NO-UNDO.
DEFINE VAR vvc AS INT NO-UNDO.
FIND articulo WHERE articulo.cdg_articulo = "23F".
FOR EACH fac_header WHERE fecha > 01/01/2011 AND prf_comprob > 1:
    vv = 0.
    vvc = 0.
FOR EACH fac_detalle OF fac_header:
vv = vv + fac_detalle.subtotal_gral.
vvc = vvc + 1.
END.
IF vvc > 1 THEN DISPLAY nro_comprob prf_comprob.
