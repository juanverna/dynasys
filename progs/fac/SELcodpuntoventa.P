/*========================================================================================*/
/*                    SELECCIONA UNA SERIE DE CODIGOS DE Puntos de Venta                       */
/*========================================================================================*/

DEFINE INPUT-OUTPUT PARAMETER seleccion AS CHARACTER.

DEFINE VARIABLE disponibles     AS CHARACTER.
DEFINE VARIABLE elegidos        AS CHARACTER.

DEFINE VARIABLE j               AS INTEGER.

/*========================================================================================*/
/*                                     PROCESO                                            */
/*========================================================================================*/
{findempresa.i}
disponibles = "".
elegidos = "".
FOR EACH punto-venta WHERE Punto-venta.cdg_empresa = empresa.cdg_empresa BY Punto-venta.cdg_puntovta:
    IF LOOKUP(string(Punto-venta.cdg_puntovta,"9999"),seleccion,",") = 0
         THEN disponibles = disponibles + "," + Punto-venta.dsc_puntovta.
         ELSE elegidos = elegidos + "," + Punto-venta.dsc_puntovta.
END.
disponibles = SUBSTRING(disponibles,2).
elegidos    = SUBSTRING(elegidos,2).

RUN d-selectar.w ( INPUT-OUTPUT elegidos, INPUT-OUTPUT disponibles, INPUT "Selección de Puntos de Venta" ).

seleccion = "".
DO j = 1 TO NUM-ENTRIES(elegidos,","):
    FIND Punto-venta WHERE Punto-venta.dsc_puntovta = ENTRY(j,elegidos,",") NO-LOCK.
    seleccion = seleccion + "," + string(Punto-venta.cdg_puntovta,"9999") .
END.
seleccion = SUBSTRING(seleccion,2).
  
