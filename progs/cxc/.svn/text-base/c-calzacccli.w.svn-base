/* ***********************  Control Definitions  ********************** */

/* Define the widget handle for the window                              */
DEFINE VAR C-Win AS WIDGET-HANDLE NO-UNDO.

/* Definitions of the field level widgets                               */
DEFINE BUTTON btn_compensar 
     LABEL "C&ompensar" 
     SIZE 23 BY 1.19.

DEFINE BUTTON btn_credito 
     LABEL "&Créditos" 
     SIZE 23 BY 1.24.

DEFINE BUTTON btn_credito-in 
     LABEL "&Créditos" 
     SIZE 23 BY 1.24.

DEFINE BUTTON btn_debito 
     LABEL "&Débitos" 
     SIZE 23 BY 1.24.

DEFINE BUTTON btn_debito-in 
     LABEL "&Débitos" 
     SIZE 23 BY 1.19.

DEFINE BUTTON Btn_Done DEFAULT 
     LABEL "&Salir" 
     SIZE 23 BY 1.24
     BGCOLOR 8 .

DEFINE VARIABLE id_moneda AS CHARACTER FORMAT "X(256)":U INITIAL "0" 
     VIEW-AS COMBO-BOX INNER-LINES 5
     LIST-ITEM-PAIRS "Item 1","0"
     DROP-DOWN-LIST
     SIZE 27 BY 1
     BGCOLOR 15 FGCOLOR 9 FONT 4 NO-UNDO.

DEFINE VARIABLE des_fecha-cre AS DATE FORMAT "99/99/99":U 
     LABEL "Del" 
     VIEW-AS FILL-IN 
     SIZE 15 BY 1
     BGCOLOR 15 FGCOLOR 9 FONT 4 NO-UNDO.

DEFINE VARIABLE des_fecha-deb AS DATE FORMAT "99/99/99":U 
     LABEL "Del" 
     VIEW-AS FILL-IN 
     SIZE 15 BY 1
     BGCOLOR 15 FGCOLOR 9 FONT 4 NO-UNDO.

DEFINE VARIABLE has_fecha-cre AS DATE FORMAT "99/99/99":U 
     LABEL "Al" 
     VIEW-AS FILL-IN 
     SIZE 15 BY 1
     BGCOLOR 15 FGCOLOR 9 FONT 4 NO-UNDO.

DEFINE VARIABLE has_fecha-deb AS DATE FORMAT "99/99/99":U 
     LABEL "Al" 
     VIEW-AS FILL-IN 
     SIZE 15 BY 1
     BGCOLOR 15 FGCOLOR 9 FONT 4 NO-UNDO.

DEFINE VARIABLE saldo AS DECIMAL FORMAT "->>,>>>,>>9.99":U INITIAL 0 
     LABEL "Diferencia" 
     VIEW-AS FILL-IN 
     SIZE 15 BY 1
     BGCOLOR 15 FGCOLOR 13 FONT 4 NO-UNDO.

DEFINE VARIABLE t_movcre AS DECIMAL FORMAT "->>,>>>,>>9.99":U INITIAL 0 
     LABEL "$" 
     VIEW-AS FILL-IN 
     SIZE 16.8 BY 1
     BGCOLOR 15 FGCOLOR 12 FONT 4 NO-UNDO.

DEFINE VARIABLE t_movdeb AS DECIMAL FORMAT "->>,>>>,>>9.99":U INITIAL 0 
     LABEL "$" 
     VIEW-AS FILL-IN 
     SIZE 18.6 BY 1
     BGCOLOR 15 FGCOLOR 12 FONT 4 NO-UNDO.

DEFINE VARIABLE t_regcre AS INTEGER FORMAT ">>9":U INITIAL 0 
     VIEW-AS FILL-IN 
     SIZE 7 BY 1
     BGCOLOR 15 FGCOLOR 2  NO-UNDO.

DEFINE VARIABLE t_regdeb AS INTEGER FORMAT ">>9":U INITIAL 0 
     VIEW-AS FILL-IN 
     SIZE 5.6 BY 1
     BGCOLOR 15 FGCOLOR 2  NO-UNDO.

DEFINE VARIABLE v-cdg_cliente AS CHARACTER FORMAT "X(8)" 
     LABEL "Cliente" 
     VIEW-AS FILL-IN 
     SIZE 13 BY 1
     BGCOLOR 15 FGCOLOR 9 .

DEFINE VARIABLE v-dsc_cliente AS CHARACTER FORMAT "X(50)" 
     VIEW-AS FILL-IN 
     SIZE 43 BY 1
     BGCOLOR 7 FGCOLOR 15 .

DEFINE VARIABLE v-saldo-a-imputar AS DECIMAL FORMAT "->>,>>>,>>9.99":U INITIAL 0 
     LABEL "Imputar" 
     VIEW-AS FILL-IN 
     SIZE 15 BY 1
     BGCOLOR 15 FGCOLOR 9 FONT 4 NO-UNDO.

DEFINE RECTANGLE RECT-1
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 74.2 BY 1.67.

DEFINE RECTANGLE RECT-2
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 73.8 BY 1.67.

DEFINE RECTANGLE RECT-3
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
