&ANALYZE-RESUME

/* Browse definitions                                                   */
DEFINE BROWSE BROWSE-CRE
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _DISPLAY-FIELDS BROWSE-CRE C-Win _STRUCTURED
  QUERY BROWSE-CRE NO-LOCK DISPLAY
      CC_acreditan.selectado COLUMN-LABEL "Se-!lec" FORMAT "*/":U
            WIDTH 4.2
      CC_acreditan.tip_comprob FORMAT "X(3)":U WIDTH 6.2
      CC_acreditan.prf_comprob FORMAT "9999":U WIDTH 6.4
      CC_acreditan.nro_comprob FORMAT "ZZZZZZZ9":U WIDTH 10.8
      CC_acreditan.nro_vencimiento COLUMN-LABEL "Nro.!Ven." FORMAT ">>9":U
            WIDTH 5.4
      CC_acreditan.fecha_emision FORMAT "99/99/9999":U WIDTH 14.4
      CC_acreditan.credito - CC_acreditan.debito COLUMN-LABEL "Saldo del!Comprobante" FORMAT "->>>,>>>,>>9.99":U
            WIDTH 16.2
/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME
    WITH NO-ROW-MARKERS SIZE 74 BY 17.62
         BGCOLOR 15 FONT 4
         TITLE BGCOLOR 15 "Movimientos que acreditan en la cuenta".

DEFINE BROWSE BROWSE-DEB
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _DISPLAY-FIELDS BROWSE-DEB C-Win _STRUCTURED
  QUERY BROWSE-DEB NO-LOCK DISPLAY
      CC_debitan.selectado COLUMN-LABEL "Se-!lec" FORMAT "*/":U
            WIDTH 5.2
      CC_debitan.tip_comprob FORMAT "X(3)":U WIDTH 6.2
      CC_debitan.prf_comprob FORMAT "9999":U WIDTH 6.2
      CC_debitan.nro_comprob FORMAT "ZZZZZZZ9":U WIDTH 11.2
      CC_debitan.nro_vencimiento COLUMN-LABEL "Nro.!Ven." FORMAT ">>9":U
            WIDTH 6.2
      CC_debitan.fecha_emision FORMAT "99/99/9999":U WIDTH 13.2
      CC_debitan.debito - CC_debitan.credito COLUMN-LABEL "Saldo del!Comprobante" FORMAT "->>>,>>>,>>9.99":U
            WIDTH 16.2
/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME
    WITH NO-ROW-MARKERS SIZE 74 BY 17.62
         BGCOLOR 15 FONT 4
         TITLE BGCOLOR 15 "Movimientos que debitan en la cuenta".


