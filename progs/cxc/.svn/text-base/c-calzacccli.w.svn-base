&Scoped-define TABLES-IN-QUERY-BROWSE-DEB CC_debitan
&Scoped-define FIRST-TABLE-IN-QUERY-BROWSE-DEB CC_debitan


/* Definitions for FRAME DEFAULT-FRAME                                  */

/* Standard List Definitions                                            */
