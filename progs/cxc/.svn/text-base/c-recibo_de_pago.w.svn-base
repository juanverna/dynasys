/* Query definitions                                                    */
&ANALYZE-SUSPEND
DEFINE QUERY BROWSE-6 FOR 
      T-Rec_detalle, 
      Moneda_detalle SCROLLING.

DEFINE QUERY BRW-TOTALES FOR 
      T-Totales_recibo, 
      Moneda_totales SCROLLING.

DEFINE QUERY DEFAULT-FRAME FOR 
      T-Rec_header SCROLLING.
&ANALYZE-RESUME

/* Browse definitions                                                   */
DEFINE BROWSE BROWSE-6
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _DISPLAY-FIELDS BROWSE-6 C-Win _STRUCTURED
  QUERY BROWSE-6 NO-LOCK DISPLAY
      T-Rec_detalle.tip_cancela FORMAT "X(3)":U
      T-Rec_detalle.prf_cancela FORMAT "ZZZ9":U
      T-Rec_detalle.nro_cancela FORMAT "ZZZZZZZZ9":U
      T-Rec_detalle.nro_vencimiento FORMAT ">>9":U
      Moneda_detalle.abrevia FORMAT "X(5)":U
      T-Rec_detalle.importe FORMAT "->,>>>,>>>,>>9.99":U
      T-Rec_detalle.imp_pesos FORMAT "->,>>>,>>>,>>9.99":U
      T-Rec_detalle.cambio FORMAT "->>,>>9.9999":U
      T-Rec_detalle.new_cambio FORMAT "->>,>>9.9999":U
      T-Rec_detalle.difcambio FORMAT "->,>>>,>>>,>>9.99":U
      T-Rec_detalle.clausula_dolar FORMAT "yes/no":U
      T-Rec_detalle.prc_difcambio FORMAT ">>9.99":U
      T-Rec_detalle.prc_mincambio FORMAT ">>9.99":U
      T-Rec_detalle.leyenda FORMAT "X(15)":U
/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME
    WITH NO-ROW-MARKERS SIZE 153 BY 8.1
         TITLE "Comprobantes cancelados con el presente Recibo" FIT-LAST-COLUMN.

DEFINE BROWSE BRW-TOTALES
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _DISPLAY-FIELDS BRW-TOTALES C-Win _STRUCTURED
  QUERY BRW-TOTALES NO-LOCK DISPLAY
      Moneda_totales.descripcion FORMAT "X(20)":U
      T-Totales_recibo.imp_total FORMAT "->,>>>,>>>,>>9.99":U
      T-Totales_recibo.imp_difcambio FORMAT "->,>>>,>>>,>>9.99":U
      T-Totales_recibo.imp_pesos FORMAT "->,>>>,>>>,>>9.99":U
/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME
    WITH NO-ROW-MARKERS SEPARATORS SIZE 80 BY 5.71.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME DEFAULT-FRAME
     btn_cancel AT ROW 1.48 COL 27
     btn_anular AT ROW 1.48 COL 49
     btn_leyenda AT ROW 1.48 COL 71
     btn_observ AT ROW 1.48 COL 93
     btn_imprim AT ROW 1.48 COL 115
     Btn_salir AT ROW 1.48 COL 138
     btn_grabar AT ROW 1.52 COL 5
     v-anulado AT ROW 3.57 COL 137 COLON-ALIGNED NO-LABEL
     T-Rec_header.tip_comprob AT ROW 3.62 COL 15 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 6 BY 1
          BGCOLOR 15 FGCOLOR 9 
     T-Rec_header.prf_comprob AT ROW 3.62 COL 22 COLON-ALIGNED NO-LABEL
          VIEW-AS FILL-IN NATIVE 
          SIZE 8 BY 1
          BGCOLOR 15 FGCOLOR 9 
     T-Rec_header.nro_comprob AT ROW 3.62 COL 31 COLON-ALIGNED NO-LABEL
          VIEW-AS FILL-IN NATIVE 
          SIZE 16 BY 1
          BGCOLOR 15 FGCOLOR 9 
     T-Rec_header.fecha AT ROW 3.62 COL 56 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 17 BY 1
          BGCOLOR 15 FGCOLOR 9 
     v-importe AT ROW 3.62 COL 86 COLON-ALIGNED
     T-Rec_header.fch_cambio AT ROW 3.62 COL 118 COLON-ALIGNED
          LABEL "Cambio Al" FORMAT "99/99/99"
          VIEW-AS FILL-IN NATIVE 
          SIZE 16 BY 1
          BGCOLOR 15 FGCOLOR 9 
     v-cdg_cliente AT ROW 4.81 COL 15 COLON-ALIGNED
     v-dsc_cliente AT ROW 4.81 COL 31 COLON-ALIGNED NO-LABEL
     T-Rec_header.mes AT ROW 4.81 COL 118 COLON-ALIGNED
          LABEL "Per"
          VIEW-AS FILL-IN NATIVE 
          SIZE 7 BY 1
          BGCOLOR 15 FGCOLOR 9 
     T-Rec_header.ano AT ROW 4.81 COL 126 COLON-ALIGNED NO-LABEL
          VIEW-AS FILL-IN NATIVE 
          SIZE 8 BY 1
          BGCOLOR 15 FGCOLOR 9 
     T-Rec_header.tipo_pago AT ROW 5 COL 140 NO-LABEL
          VIEW-AS RADIO-SET VERTICAL
          RADIO-BUTTONS 
                    "Cancelación", 1,
"A Imputar", 2
          SIZE 17 BY 1.33
     v-cdg_domicilio AT ROW 6 COL 15 COLON-ALIGNED
     v-dsc_domicilio AT ROW 6 COL 31 COLON-ALIGNED NO-LABEL
     v-abv_provincia AT ROW 6 COL 114 COLON-ALIGNED NO-LABEL
     v-cdg_moneda AT ROW 7.67 COL 15 COLON-ALIGNED
     v-dsc_moneda AT ROW 7.67 COL 31 COLON-ALIGNED NO-LABEL
     T-Rec_header.cambio AT ROW 7.67 COL 66 COLON-ALIGNED NO-LABEL
          VIEW-AS FILL-IN NATIVE 
          SIZE 14 BY 1
          BGCOLOR 15 FGCOLOR 9 
     v-cdg_condicion_impos AT ROW 7.67 COL 91 COLON-ALIGNED
     v-dsc_condicion_impos AT ROW 7.67 COL 105 COLON-ALIGNED NO-LABEL
     v-cdg_imputacion AT ROW 8.86 COL 15 COLON-ALIGNED
     v-dsc_imputacion AT ROW 8.86 COL 31 COLON-ALIGNED NO-LABEL
     v-cdg_cobrador AT ROW 8.86 COL 91 COLON-ALIGNED
     v-dsc_cobrador AT ROW 8.86 COL 105 COLON-ALIGNED NO-LABEL
     T-Rec_header.calcular_cambio AT ROW 10.05 COL 47 NO-LABEL
          VIEW-AS RADIO-SET HORIZONTAL
          RADIO-BUTTONS 
                    "Si", yes,
"No", no
          SIZE 15 BY 1.1
     T-Rec_header.cambio_dolar AT ROW 10.05 COL 66 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 14 BY 1
          BGCOLOR 15 FGCOLOR 9 
     btn_valores AT ROW 10.05 COL 93
     T-Rec_header.nro_rendicion AT ROW 10.05 COL 138 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 17 BY 1
          BGCOLOR 15 FGCOLOR 9 
     BRW-TOTALES AT ROW 11.95 COL 5
     T-Rec_header.imp_pesos AT ROW 13.38 COL 102 COLON-ALIGNED
          LABEL "Eq.Cobrado"
          VIEW-AS FILL-IN 
          SIZE 17 BY 1
          BGCOLOR 7 FGCOLOR 15 
    WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY 
         SIDE-LABELS NO-UNDERLINE THREE-D 
         AT COL 1 ROW 1
         SIZE 160 BY 27.67.

/* DEFINE FRAME statement is approaching 4K Bytes.  Breaking it up   */
DEFINE FRAME DEFAULT-FRAME
     T-Rec_header.imp_bruto AT ROW 13.38 COL 138 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 17 BY 1
          BGCOLOR 7 FGCOLOR 14 
     T-Rec_header.imp_difcambio AT ROW 14.57 COL 102 COLON-ALIGNED
          LABEL "Dif.Cambio"
          VIEW-AS FILL-IN 
          SIZE 17 BY 1
          BGCOLOR 7 FGCOLOR 15 
     T-Rec_header.imp_total AT ROW 14.57 COL 138 COLON-ALIGNED
          LABEL "Total Neto"
          VIEW-AS FILL-IN NATIVE 
          SIZE 17 BY 1
          BGCOLOR 7 FGCOLOR 14 
     a-tip_comprob AT ROW 16.71 COL 118 COLON-ALIGNED HELP
          "Tipo de comprobante"
     a-prf_comprob AT ROW 16.71 COL 127 COLON-ALIGNED HELP
          "Prefijo de 4 digitos del comprobante" NO-LABEL
     a-nro_comprob AT ROW 16.71 COL 136 COLON-ALIGNED HELP
          "Nro. de comprobante" NO-LABEL
     a-nro_vencimiento AT ROW 16.71 COL 150 COLON-ALIGNED HELP
          "Numero de vencimiento del documento" NO-LABEL
     BROWSE-6 AT ROW 18.38 COL 5
     "Calcular diferencia de cambio:" VIEW-AS TEXT
          SIZE 29 BY .95 AT ROW 10.05 COL 18
     "   Total Cobrado Equivalente" VIEW-AS TEXT
          SIZE 31 BY .86 AT ROW 12.19 COL 90
          BGCOLOR 5 FGCOLOR 15 FONT 4
     "    Importes de este Recibo" VIEW-AS TEXT
          SIZE 33 BY .86 AT ROW 12.19 COL 124
          BGCOLOR 5 FGCOLOR 15 FONT 4
     RECT-10 AT ROW 11.95 COL 123
     RECT-11 AT ROW 18.14 COL 3
     RECT-12 AT ROW 11.71 COL 3
     RECT-13 AT ROW 16.48 COL 87
     RECT-2 AT ROW 1.24 COL 3
     RECT-3 AT ROW 1.24 COL 137
     RECT-4 AT ROW 3.38 COL 3
     RECT-5 AT ROW 4.71 COL 139
     RECT-6 AT ROW 3.38 COL 138
     RECT-7 AT ROW 7.43 COL 3
     RECT-8 AT ROW 11.71 COL 87
     RECT-9 AT ROW 11.95 COL 88
    WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY 
         SIDE-LABELS NO-UNDERLINE THREE-D 
         AT COL 1 ROW 1
         SIZE 160 BY 27.67.


