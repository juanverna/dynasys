/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME T-Rec_header.nro_comprob
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL T-Rec_header.nro_comprob C-Win
ON MOUSE-SELECT-DBLCLICK OF T-Rec_header.nro_comprob IN FRAME DEFAULT-FRAME /* nro_comprob */
OR MOUSE-MENU-DOWN,"." OF T-Rec_header.nro_comprob IN FRAME {&FRAME-NAME}
DO:
  IF modo <> MD_ALTA
  THEN DO:
    DEFINE VARIABLE lista_estados AS CHARACTER.
    DEFINE VARIABLE titulo_window AS CHARACTER.
  
    CASE modo:
       WHEN MD_ALTA          
       THEN DO:
            titulo_window = "".     /* Esta opcion la contemplamos por unicidad pero no debería producirse nunca */
            lista_estados = "".
       END.
       WHEN MD_MULTIPLE      
       THEN DO:
            titulo_window = "Selección de Recibos de Pago".
            lista_estados = " ,E".
       END.
       WHEN MD_DEFINIDA             /* Esta opcion la contemplamos por unicidad pero no debería producirse nunca */
       THEN DO:
            titulo_window = "".
            lista_estados = "".
       END.
       WHEN MD_RELACION             /* Esta opcion la contemplamos por unicidad pero no debería producirse nunca */
       THEN DO:
            titulo_window = "".
            lista_estados = "".
       END.
       WHEN MD_READONLY      
       THEN DO:
            titulo_window = "Selección Recibos de Pago".
            lista_estados = " ,E".
       END.
       WHEN MD_CAMBIO        
       THEN DO:
            titulo_window = "".
            lista_estados = "".
       END.
       WHEN MD_ANULACION        
       THEN DO:
            titulo_window = "Selección de Recibos de Pago".
            lista_estados = "E".
       END.
       WHEN MD_EMISION        
       THEN DO:
            titulo_window = "Selección de Recibos de Pago".
            lista_estados = "".
       END.
    END CASE.     
  
    RUN d-seleccionar_recibo.w (INPUT titulo_window, INPUT lista_estados, INPUT "R*", OUTPUT rid_recibo).
    IF rid_recibo <> ?
    THEN DO:
       FIND Rec_header WHERE ROWID(Rec_header) = rid_recibo NO-LOCK.
       DISPLAY Rec_header.tip_comprob @ T-Rec_header.tip_comprob 
               Rec_header.prf_comprob @ T-Rec_header.prf_comprob
               Rec_header.nro_comprob @ T-Rec_header.nro_comprob
               WITH FRAME {&FRAME-NAME}.
       IF modo = MD_ANULACION AND Rec_header.anulado
       THEN DO:
            RUN PONMENSJ.P (INPUT "DOCS002").
            RETURN NO-APPLY.
       END.
       ELSE DO:
            RUN traer_documento.
       END.
    END.  
    RETURN NO-APPLY.  
  END.
  ELSE DO:
    BELL.
    RETURN NO-APPLY.
  END.

END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL T-Rec_header.nro_comprob C-Win
ON RETURN OF T-Rec_header.nro_comprob IN FRAME DEFAULT-FRAME /* nro_comprob */
DO:

  IF modo <> MD_ALTA
  THEN DO:
    IF LOOKUP(INPUT FRAME {&FRAME-NAME} T-Rec_header.tip_comprob,"DA,DB,DC,DE") <> 0 
    THEN DO:
       RUN PONMENSJ.P (INPUT "DOCS010").
       RETURN NO-APPLY.
    END.
 
    FIND Rec_header 
         WHERE Rec_header.cdg_empresa = Empresa.cdg_empresa
           AND Rec_header.tip_comprob = INPUT T-Rec_header.tip_comprob 
           AND Rec_header.prf_comprob = INPUT T-Rec_header.prf_comprob
           AND Rec_header.nro_comprob = INPUT T-Rec_header.nro_comprob
               NO-ERROR.
 
    IF NOT AVAILABLE Rec_header 
    THEN DO:
         IF LOCKED Rec_header
            THEN RUN PONMENSJ.P (INPUT "DOCS000").
            ELSE RUN PONMENSJ.P (INPUT "DOCS001").
         RETURN NO-APPLY.
    END.
    ELSE DO:
         IF modo = MD_ANULACION AND Rec_header.anulado
         THEN DO:
              RUN PONMENSJ.P (INPUT "DOCS002").
              RETURN NO-APPLY.
         END.
         ELSE DO:
             rid_recibo = ROWID(Rec_header).
             RUN traer_documento.
         END.
    END.
  END.
  ELSE DO:
    BELL.
    RETURN NO-APPLY.
  END.

END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


