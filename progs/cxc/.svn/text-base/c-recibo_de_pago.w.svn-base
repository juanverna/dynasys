     VIEW-AS FILL-IN NATIVE 
     SIZE 15 BY 1
     BGCOLOR 15 FGCOLOR 9 .

DEFINE VARIABLE v-dsc_cliente AS CHARACTER FORMAT "X(40)" 
     VIEW-AS FILL-IN 
     SIZE 82 BY 1
     BGCOLOR 7 FGCOLOR 15 .

DEFINE VARIABLE v-dsc_cobrador AS CHARACTER FORMAT "X(20)" 
     VIEW-AS FILL-IN 
     SIZE 50 BY 1
     BGCOLOR 7 FGCOLOR 15 .

DEFINE VARIABLE v-dsc_condicion_impos AS CHARACTER FORMAT "X(25)" 
