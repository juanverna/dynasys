     _FldNameList[5]   = Temp-Tables.Moneda_detalle.abrevia
     _FldNameList[6]   = Temp-Tables.T-Rec_detalle.importe
     _FldNameList[7]   = Temp-Tables.T-Rec_detalle.imp_pesos
     _FldNameList[8]   = Temp-Tables.T-Rec_detalle.cambio
     _FldNameList[9]   = Temp-Tables.T-Rec_detalle.new_cambio
     _FldNameList[10]   = Temp-Tables.T-Rec_detalle.difcambio
     _FldNameList[11]   = Temp-Tables.T-Rec_detalle.clausula_dolar
     _FldNameList[12]   = Temp-Tables.T-Rec_detalle.prc_difcambio
     _FldNameList[13]   = Temp-Tables.T-Rec_detalle.prc_mincambio
     _FldNameList[14]   = Temp-Tables.T-Rec_detalle.leyenda
     _Query            is OPENED
*/  /* BROWSE BROWSE-6 */
