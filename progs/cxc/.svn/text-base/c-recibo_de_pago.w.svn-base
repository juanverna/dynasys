/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&UNDEFINE SELF-NAME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CUSTOM _MAIN-BLOCK C-Win 


/* ***************************  Main Block  *************************** */

/* Set CURRENT-WINDOW: this will parent dialog-boxes and frames.        */
ASSIGN CURRENT-WINDOW                = {&WINDOW-NAME} 
       THIS-PROCEDURE:CURRENT-WINDOW = {&WINDOW-NAME}.

/* The CLOSE event can be used from inside or outside the procedure to  */
/* terminate it.                                                        */
ON CLOSE OF THIS-PROCEDURE 
   RUN disable_UI.

{findempresa.i}
{findsector.i}
que_sector = Area.cdg_area.
/* Best default for GUI applications is...                              */
PAUSE 0 BEFORE-HIDE.

/* Now enable the interface and wait for the exit condition.            */
/* (NOTE: handle ERROR and END-KEY so cleanup code will always fire.    */
MAIN-BLOCK:
REPEAT TRANSACTION
       ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:

  RUN enable_UI.
  RUN iniciar_documento.
  RUN frame_sensitiva ( INPUT NO ).  
  CLEAR FRAME {&FRAME-NAME} ALL.
  RUN crear_registro.
  IF modo = MD_DEFINIDA
     THEN RUN traer_documento.
     ELSE RUN frame_sensitiva ( INPUT YES ).
  IF modo = MD_ALTA THEN APPLY "ENTRY" TO v-cdg_cliente.
  WAIT-FOR U1 OF THIS-PROCEDURE.
  CASE codigo_salir:
       WHEN CD_SALIR THEN UNDO,LEAVE.
       WHEN CD_CANCELAR THEN UNDO,RETRY.
       WHEN CD_GRABAR THEN NEXT.
  END CASE.
   
END.
APPLY "CLOSE" TO THIS-PROCEDURE. /* hay que ver si realmente hace falta */

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


/* **********************  Internal Procedures  *********************** */

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE abre_query_totales C-Win 
PROCEDURE abre_query_totales :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  OPEN QUERY BRW-TOTALES
      FOR EACH T-Totales_recibo OF T-Rec_header, FIRST Moneda_totales OF T-Totales_recibo NO-LOCK.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE asignar_caja C-Win 
PROCEDURE asignar_caja :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    ASSIGN T-Caj_header.nro_cuenta      = Familia_cliente.nro_cuenta
           T-Caj_header.nro_cliente     = T-Rec_header.nro_cliente
           T-Caj_header.cdg_empresa     = T-Rec_header.cdg_empresa
           T-Caj_header.prf_comprob     = T-Rec_header.prf_comprob
           T-Caj_header.tip_comprob     = T-Rec_header.tip_comprob
           T-Caj_header.importe         = T-Rec_header.imp_pesos + 
                                          T-Rec_header.imp_difcambio
           T-Caj_header.fecha           = T-Rec_header.fecha.

    EMPTY TEMP-TABLE T-Caja-imputacion.
    RUN crear_caja_imputacion.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE asignar_cambio C-Win 
PROCEDURE asignar_cambio :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  DEFINE VARIABLE p-xx AS DATE . /* Por Compatibilidad */

  RUN cotizar_moneda.p ( INPUT  Moneda.cdg_moneda,
                         INPUT  T-Rec_header.cdg_empresa, 
                         INPUT  T-Rec_header.fch_cambio,       
                         OUTPUT T-Rec_header.cambio,  
                         OUTPUT T-Rec_header.fch_cambio ).

  RUN cotizar_moneda.p ( INPUT  codigo_dolar,
                         INPUT  T-Rec_header.cdg_empresa, 
                         INPUT  T-Rec_header.fecha,       
                         OUTPUT T-Rec_header.cambio_dolar,  
                         OUTPUT p-xx ).


  DISPLAY T-Rec_header.cambio 
          T-Rec_header.cambio_dolar
          T-Rec_header.fch_cambio 
          WITH FRAME {&FRAME-NAME}.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE asignar_condicion C-Win 
PROCEDURE asignar_condicion :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  v-tip_comprob = "R" + Condicion_impos.tipo_factura.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE asignar_imputacion C-Win 
PROCEDURE asignar_imputacion :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  T-Rec_header.cdg_imputacion = Imputacion.cdg_imputacion.
  /*
  T-Rec_header.T-Cta_cte        = Imputacion.T-Cta_cte.
  */
  
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE asignar_moneda C-Win 
PROCEDURE asignar_moneda :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
  
  T-Rec_header.nro_moneda = Moneda.nro_moneda.
  T-Rec_header.fch_cambio = T-Rec_header.fecha - 1.
  RUN levantar_cuenta_corriente.
  RUN asignar_cambio.
  RUN calculos.
  
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE borrar_diferencia_cambio C-Win 
PROCEDURE borrar_diferencia_cambio :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
   
   DEFINE VARIABLE p-punto_venta  AS INTEGER.
   DEFINE VARIABLE p-cdg_concepto AS INTEGER.
   DEFINE VARIABLE x-proporcion   AS DECIMAL DECIMALS 6.
   DEFINE VARIABLE x-delta_cambio LIKE Rec_header.cambio.

   EMPTY TEMP-TABLE T-Fac_header.               
   EMPTY TEMP-TABLE T-Fac_detalle.              
   EMPTY TEMP-TABLE T-Sub_header_vta.           
   EMPTY TEMP-TABLE T-Sub_detalle_vta.          
   EMPTY TEMP-TABLE T-Fac_header_impuesto.      
   EMPTY TEMP-TABLE T-Fac_detalle_impuesto.     

   /* Borramos diferencias de cambio que se hubieran generado con cambios anteriores */

   FOR EACH T-Rec_detalle OF T-Rec_header:
       T-Rec_detalle.difcambio = 0.
   END.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE borrar_tablas_temporales C-Win 
PROCEDURE borrar_tablas_temporales :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

 EMPTY TEMP-TABLE T-Rec_header            NO-ERROR.
 EMPTY TEMP-TABLE T-Rec_detalle           NO-ERROR.
 EMPTY TEMP-TABLE T-Totales_recibo        NO-ERROR.

 EMPTY TEMP-TABLE T-Fac_header            NO-ERROR.
 EMPTY TEMP-TABLE T-Fac_detalle           NO-ERROR.
 EMPTY TEMP-TABLE T-Sub_header_vta        NO-ERROR. 
 EMPTY TEMP-TABLE T-Sub_detalle_vta       NO-ERROR.
 EMPTY TEMP-TABLE T-Fac_header_impuesto   NO-ERROR.
 EMPTY TEMP-TABLE T-Fac_detalle_impuesto  NO-ERROR.

 EMPTY TEMP-TABLE T-Caja-imputacion       NO-ERROR.
 EMPTY TEMP-TABLE T-Caj_header            NO-ERROR.
 EMPTY TEMP-TABLE T-Caj_detalle           NO-ERROR.
 EMPTY TEMP-TABLE T-Valor                 NO-ERROR. 
 EMPTY TEMP-TABLE T-Cheque                NO-ERROR.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE calcular_cambio C-Win 
PROCEDURE calcular_cambio :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
   
   DEFINE VARIABLE p-punto_venta  AS INTEGER.
   DEFINE VARIABLE p-cdg_concepto AS INTEGER.
   DEFINE VARIABLE x-proporcion   AS DECIMAL DECIMALS 6.
   DEFINE VARIABLE x-delta_cambio LIKE Rec_header.cambio.

   EMPTY TEMP-TABLE T-Fac_header.               
   EMPTY TEMP-TABLE T-Fac_detalle.              
   EMPTY TEMP-TABLE T-Sub_header_vta.           
   EMPTY TEMP-TABLE T-Sub_detalle_vta.          
   EMPTY TEMP-TABLE T-Fac_header_impuesto.      
   EMPTY TEMP-TABLE T-Fac_detalle_impuesto.     

   RUN getparametro_n.p (  INPUT  "DFCAMPVT", OUTPUT p-punto_venta ).
   RUN getparametro_n.p (  INPUT  "DFCAMCON", OUTPUT p-cdg_concepto ).

   RUN getparametro.p (  INPUT  "DFCAMCNV",
                         OUTPUT v-valor_c,
                         OUTPUT v-valor_d,
                         OUTPUT v-valor_l,
                         OUTPUT v-valor_n,
                         OUTPUT v-observacion ).

   FIND Condicion_venta WHERE Condicion_venta.cdg_cndventa = v-valor_c NO-LOCK.
   
   RUN getparametro.p (  INPUT  "DFCAMART",
                         OUTPUT v-valor_c,
                         OUTPUT v-valor_d,
                         OUTPUT v-valor_l,
                         OUTPUT v-valor_n,
                         OUTPUT v-observacion ).

   FIND Articulo WHERE Articulo.cdg_articulo = v-valor_c NO-LOCK.

   FIND Domicilio OF T-Rec_header NO-LOCK.
   FIND FIRST Moneda_local WHERE Moneda_local.es_local NO-LOCK.

   RUN getparametro.p (  INPUT  "DFDEPOSI",
                         OUTPUT v-valor_c,
                         OUTPUT v-valor_d,
                         OUTPUT v-valor_l,
                         OUTPUT v-valor_n,
                         OUTPUT v-observacion ).
   FIND Deposito WHERE Deposito.cdg_deposito = v-valor_c NO-LOCK.

   CREATE T-Fac_header.
   BUFFER-COPY T-Rec_header TO T-Fac_header 
        ASSIGN T-Fac_header.origen            = "R"
               T-Fac_header.cdg_comprobante   = v-debito_cambio
               T-Fac_header.estado            = "P"
               T-Fac_header.cta_cte           = YES 
               T-Fac_header.nro_factura       = 1
               T-Fac_header.fecha             = T-Rec_header.fecha
               T-Fac_header.fecha_iva         = T-Fac_header.fecha
               T-Fac_header.fecha_precios     = T-Fac_header.fecha
               T-Fac_header.cdg_imputacion    = p-cdg_concepto
               T-Fac_header.impreso           = ""
               T-Fac_header.cambio            = 1
               T-Fac_header.nro_cndventa      = Condicion_venta.nro_cndventa
               T-Fac_header.nro_moneda        = Moneda_local.nro_moneda
               T-Fac_header.nombre            = Cliente.nom_cliente
               T-Fac_header.direccion_leg     = Cliente.direccion
               T-Fac_header.localidad_leg     = Cliente.localidad
               T-Fac_header.cdg_postal_leg    = Cliente.cdg_postal
               T-Fac_header.cdg_provincia_leg = Cliente.cdg_provincia
               T-Fac_header.cdg_condiva       = Cliente.cdg_condiva
               T-Fac_header.nro_vendedor      = Cliente.nro_vendedor
               T-Fac_header.nombre_domicilio  = Domicilio.nombre
               T-Fac_header.nro_domicilio     = Domicilio.nro_domicilio
               T-Fac_header.direccion         = Domicilio.direccion
               T-Fac_header.cdg_provincia     = Domicilio.cdg_provincia
               T-Fac_header.localidad         = Domicilio.localidad
               T-Fac_header.cdg_postal        = Domicilio.cdg_postal
               T-Fac_header.cdg_zonag         = Domicilio.cdg_zonag
               T-Fac_header.imp_total         = 0
               T-Fac_header.mes               = MONTH(T-Fac_header.fecha) 
               T-Fac_header.ano               = YEAR(T-Fac_header.fecha)
               T-Fac_header.nro_deposito      = Deposito.nro_deposito 
               T-Fac_header.prf_comprob       = p-punto_venta
               T-Fac_header.nro_comprob       = T-Fac_header.nro_factura.

   FIND Comprobante_cambio OF T-Fac_header NO-LOCK.

   /* Borramos diferencias de cambio que se hubieran generado con cambios anteriores */

   FOR EACH T-Rec_detalle OF T-Rec_header, FIRST Moneda_detalle OF T-Rec_detalle NO-LOCK:

       IF Moneda_detalle.es_local
       THEN DO:
           T-Rec_detalle.imp_pesos = T-Rec_detalle.importe.
           IF T-Rec_detalle.clausula_dolar
           THEN DO:     
               ASSIGN T-Rec_detalle.difcambio = ( T-Rec_detalle.new_cambio_dolar - T-Rec_detalle.cambio_dolar ) * 
                                                  T-Rec_detalle.importe / T-Rec_detalle.cambio_dolar * 
                                                  T-Rec_detalle.prc_difcambio / 100.
           END.
           ELSE DO:
               ASSIGN T-Rec_detalle.difcambio = 0.
           END.

       END.
       ELSE DO:

           ASSIGN T-Rec_detalle.imp_pesos = T-Rec_detalle.importe * T-Rec_detalle.cambio
                  T-Rec_detalle.difcambio = ( T-Rec_detalle.new_cambio - T-Rec_detalle.cambio ) * 
                                              T-Rec_detalle.importe * T-Rec_detalle.prc_difcambio / 100.
       END.

       IF ABS(T-Rec_detalle.difcambio / T-Rec_detalle.imp_pesos) >= T-Rec_detalle.prc_mincambio / 100
       THEN DO:
         /*T-Fac_header.imp_total = T-Fac_header.imp_total + T-Rec_detalle.difcambio.    */
           CREATE T-Fac_detalle.
           ASSIGN T-Fac_header.ultima_linea  = T-Fac_header.ultima_linea + 1
                  T-Fac_detalle.nro_factura  = T-Fac_header.nro_factura
                  T-Fac_detalle.nro_linea    = T-Fac_header.ultima_linea
                  T-Fac_detalle.cantidad     = IF T-Rec_detalle.difcambio > 0 THEN 1 ELSE -1
                  T-Fac_detalle.granel       = 1
                  T-Fac_detalle.nro_articulo = Articulo.nro_articulo
                  T-Fac_detalle.detallada    = T-Rec_detalle.tip_cancela + "-" + STRING(T-Rec_detalle.prf_cancela,"9999") + "-" + STRING(T-Rec_detalle.nro_cancela,"99999999") 
                                               + " " + STRING(T-Rec_detalle.importe,">>>>>9.99-") 
                                               + " " + STRING(T-Rec_detalle.prc_difcambio,">>9.99")
                                               + " " + STRING(T-Rec_detalle.new_cambio,">>>>9.9999")
                                               + " " + STRING(T-Rec_detalle.cambio,">>>>9.9999").
           IF Comprobante_cambio.aplica_impuestos
           THEN DO:
               FIND Condicion_impos OF T-Fac_header NO-LOCK.
               OPEN QUERY q-iva
                   FOR EACH Impuesto_condicion OF Condicion_impos NO-LOCK, 
                       FIRST Impuesto OF Impuesto_condicion
                             WHERE Impuesto.es_iva NO-LOCK.
               GET FIRST q-iva.
               ASSIGN T-Fac_detalle.precio = ABS(T-Rec_detalle.difcambio) / ( 1 + Impuesto_condicion.tasa / 100.0 ).
           END.
           ELSE DO:
               ASSIGN T-Fac_detalle.precio = ABS(T-Rec_detalle.difcambio).
           END.

       END.
       ELSE DO:
           T-Rec_detalle.difcambio = 0.
       END.

       T-Fac_header.imp_total = T-Fac_header.imp_total + T-Rec_detalle.difcambio.
           
   END.

   FIND FIRST T-Fac_header NO-ERROR. /* No esta disponible cuando sale del lazo */
   IF AVAILABLE T-Fac_header
   THEN DO:
       IF T-Fac_header.imp_total < 0
       THEN DO:
           ASSIGN
               T-Fac_header.cdg_comprobante = v-credito_cambio.
       END.

       RUN calcular_comprobante_cliente.p ( 
                                INPUT-OUTPUT TABLE T-Fac_header,
                                INPUT-OUTPUT TABLE T-Fac_detalle,
                                INPUT-OUTPUT TABLE T-Sub_header_vta,
                                INPUT-OUTPUT TABLE T-Sub_detalle_vta,
                                INPUT-OUTPUT TABLE T-Fac_header-bon,
                                INPUT-OUTPUT TABLE T-Fac_detalle-bon,
                                INPUT-OUTPUT TABLE T-Fac_header_impuesto,
                                INPUT-OUTPUT TABLE T-Fac_detalle_impuesto,
                                INPUT-OUTPUT TABLE T-Asn_header,
                                INPUT-OUTPUT TABLE T-Asn_detalle,
                                INPUT-OUTPUT TABLE T-Asn_totales
                                ).

       FIND FIRST T-Fac_header.

   END.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE calculos C-Win 
PROCEDURE calculos :
/*------------------------------------------------------------------------------
  Purpose: Realiza el calculo del importe final de una factura     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
  DEFINE VARIABLE o-importe AS DECIMAL    NO-UNDO.
  
  EMPTY TEMP-TABLE T-Sub_header_vta NO-ERROR.
  EMPTY TEMP-TABLE T-Sub_detalle_vta NO-ERROR.
  
  IF T-Rec_header.calcular_cambio
  THEN DO:
 
      IF T-Rec_header.tipo_pago = 1 
          THEN RUN calcular_cambio.
      

      RUN calcular_recibo.p ( INPUT-OUTPUT TABLE T-Rec_header,
                              INPUT-OUTPUT TABLE T-Rec_detalle,
                              INPUT-OUTPUT TABLE T-Totales_recibo).

      FIND FIRST T-Rec_header.

  END.
  ELSE DO:
      RUN calcular_recibo.p ( INPUT-OUTPUT TABLE T-Rec_header,
                              INPUT-OUTPUT TABLE T-Rec_detalle,
                              INPUT-OUTPUT TABLE T-Totales_recibo).
      FIND FIRST T-Rec_header.

      ASSIGN T-Rec_header.imp_difcambio = 0.
      RUN borrar_diferencia_cambio.
  END.

  RUN abre_query_totales.

  DISPLAY T-Rec_header.imp_difcambio 
          T-Rec_header.imp_pesos 
          WITH FRAME {&FRAME-NAME}.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE color_ctacte C-Win 
PROCEDURE color_ctacte :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  DO WITH FRAME {&FRAME-NAME}:
        ASSIGN
           T-Rec_header.imp_total:BGCOLOR   = 7
           T-Rec_header.imp_total:FGCOLOR   = 15

           a-tip_comprob:BGCOLOR            = 15
           a-prf_comprob:BGCOLOR            = 15
           a-nro_comprob:BGCOLOR            = 15
           a-nro_vencimiento:BGCOLOR        = 15

           a-tip_comprob:FGCOLOR            = 9
           a-prf_comprob:FGCOLOR            = 9
           a-nro_comprob:FGCOLOR            = 9
           a-nro_vencimiento:FGCOLOR        = 9.

  END.
  
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE color_total C-Win 
PROCEDURE color_total :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  DO WITH FRAME {&FRAME-NAME}:
        ASSIGN
           T-Rec_header.imp_total:BGCOLOR   = 15
           T-Rec_header.imp_total:FGCOLOR   = 9

           a-tip_comprob:BGCOLOR            = 7
           a-prf_comprob:BGCOLOR            = 7
           a-nro_comprob:BGCOLOR            = 7
           a-nro_vencimiento:BGCOLOR        = 7 

           a-tip_comprob:FGCOLOR            = 15
           a-prf_comprob:FGCOLOR            = 15
           a-nro_comprob:FGCOLOR            = 15
           a-nro_vencimiento:FGCOLOR        = 15.
           
  END.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE corregir_detalle C-Win 
PROCEDURE corregir_detalle :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
  
     IF modo = MD_ALTA
     THEN DO:

         RUN d-detalle_recibo.w ( INPUT  T-Rec_detalle.tip_cancela,
                                  INPUT  T-Rec_detalle.prf_cancela,
                                  INPUT  T-Rec_detalle.nro_cancela,
                                  INPUT  T-Rec_detalle.nro_vencimiento,
                                  INPUT  0, 
                                  INPUT  T-Rec_detalle.nro_linea,
                                  INPUT  modo,
                                  INPUT  MD_CAMBIO,
                                  OUTPUT v-nro_linea,
                                  INPUT-OUTPUT TABLE T-Rec_header,
                                  INPUT-OUTPUT TABLE T-Rec_detalle).

         FIND FIRST T-Rec_header.
         IF v-nro_linea <> 0
         THEN DO:
             RUN calculos.
             {&OPEN-QUERY-{&BROWSE-NAME}}
         END.

     END.
     ELSE DO:

         RUN d-detalle_recibo.w ( INPUT  T-Rec_detalle.tip_cancela,
                                  INPUT  T-Rec_detalle.prf_cancela,
                                  INPUT  T-Rec_detalle.nro_cancela,
                                  INPUT  T-Rec_detalle.nro_vencimiento,
                                  INPUT  0, 
                                  INPUT  T-Rec_detalle.nro_linea,
                                  INPUT  modo,
                                  INPUT  MD_READONLY,
                                  OUTPUT v-nro_linea,
                                  INPUT-OUTPUT TABLE T-Rec_header,
                                  INPUT-OUTPUT TABLE T-Rec_detalle).

         FIND FIRST T-Rec_header.

     END.                              

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE crear_caja C-Win 
PROCEDURE crear_caja :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    CREATE T-Caj_header.
    BUFFER-COPY T-Rec_header TO T-Caj_header
        ASSIGN T-Caj_header.fecha             = T-Rec_header.fecha
               T-Caj_header.hora              = TIME
               T-Caj_header.ultima_linea      = 0
               T-Caj_header.nro_transaccion   = NEXT-VALUE(proxima_txncaja)
               T-Caj_header.importe           = T-Rec_header.imp_pesos + 
                                                T-Rec_header.imp_difcambio
               T-Caj_header.emitir            = NO
               T-Caj_header.cdg_caja          = Caja.cdg_caja
               T-Caj_header.nro_cuenta        = Familia_cliente.nro_cuenta
               T-Caj_header.observacion       = Cliente.cdg_cliente + 
                                                "-" + Cliente.nom_cliente
               T-Caj_header.tipo_mov          = "I"
               T-Rec_header.nro_transaccion   = T-Caj_header.nro_transaccion.

    EMPTY TEMP-TABLE T-Caja-imputacion.
    RUN crear_caja_imputacion.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE crear_caja_imputacion C-Win 
PROCEDURE crear_caja_imputacion :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    CREATE T-Caja-imputacion.
    ASSIGN T-Caja-imputacion.nro_cuenta       = Familia_cliente.nro_cuenta
           T-Caja-imputacion.nro_entidad      = Caja.nro_entidad
           T-Caja-imputacion.nro_obra         = 0
           T-Caja-imputacion.nro_transaccion  = T-Caj_header.nro_transaccion
           T-Caja-imputacion.observacion      = ""
           T-Caja-imputacion.valor            = T-Caj_header.importe.


END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE crear_detalle C-Win 
PROCEDURE crear_detalle :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    DEFINE VARIABLE x-importe LIKE Rec_detalle.importe.

    x-importe  = IF v-importe <> 0 
                    THEN MINIMUM(T-Cta_cte.debito - T-Cta_cte.credito,v-importe)
                    ELSE T-Cta_cte.debito - T-Cta_cte.credito.

    RUN d-detalle_recibo.w ( INPUT  a-tip_comprob,
                             INPUT  a-prf_comprob,
                             INPUT  a-nro_comprob,
                             INPUT  a-nro_vencimiento,
                             INPUT  x-importe, 
                             INPUT  0,
                             INPUT  modo,
                             INPUT  MD_ALTA,
                             OUTPUT v-nro_linea,
                             INPUT-OUTPUT TABLE T-Rec_header,
                             INPUT-OUTPUT TABLE T-Rec_detalle).

     FIND FIRST T-Rec_header.

     IF v-nro_linea <> 0
     THEN DO:
         RUN calculos.
         {&OPEN-QUERY-{&BROWSE-NAME}}
         v-importe = v-importe - T-Rec_detalle.importe.
         IF v-importe < 0 THEN v-importe = 0.
         DISPLAY v-importe WITH FRAME {&FRAME-NAME}.
         RUN calculos.                                           
         T-Rec_header.tipo_pago:SENSITIVE IN FRAME {&FRAME-NAME} = NO.
         v-cdg_moneda:SENSITIVE IN FRAME {&FRAME-NAME} = NO.
     END.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE crear_registro C-Win 
PROCEDURE crear_registro :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  DO TRANSACTION:
    
      CREATE T-Rec_header.
      ASSIGN T-Rec_header.cdg_comprobante   = "RECIBCLI"
             T-Rec_header.nro_usuario       = Usuario.nro_usuario 
             T-Rec_header.cdg_empresa       = Empresa.cdg_empresa
             T-Rec_header.fecha             = TODAY 
             T-Rec_header.fch_cambio        = TODAY - 1
             T-Rec_header.mes               = MONTH(T-Rec_header.fecha) 
             T-Rec_header.ano               = YEAR(T-Rec_header.fecha)
             T-Rec_header.cdg_empresa       = Empresa.cdg_empresa 
             T-Rec_header.tip_comprob       = "" 
             T-Rec_header.nro_recibo        = 0  
             T-Rec_header.estado            = "E"  
             T-Rec_header.nro_comprob       = T-Rec_header.nro_recibo
             T-Rec_header.prf_comprob       = 0
             T-Rec_header.nro_moneda        = Moneda.nro_moneda 
             T-Rec_header.cambio            = Moneda.cambio  
             T-Rec_header.cdg_imputacion    = Imputacion.cdg_imputacion
             T-Rec_header.num_sucursal      = sucursal-id    
             T-Rec_header.origen            = "M"
             T-Rec_header.tipo_pago         = 1
             T-Rec_header.calcular_cambio   = YES
             v-cdg_moneda                   = Moneda.cdg_moneda
             v-dsc_moneda                   = Moneda.abrevia
             v-cdg_imputacion               = Imputacion.cdg_imputacion
             v-dsc_imputacion               = Imputacion.dsc_imputacion. 
      
      RUN asignar_cambio.

  END.

  DISPLAY
         T-Rec_header.fecha   
         T-Rec_header.fch_cambio   
         T-Rec_header.mes      
         T-Rec_header.ano
         T-Rec_header.cambio  
         T-Rec_header.tipo_pago
         v-cdg_imputacion
         v-dsc_imputacion
         v-cdg_moneda
         v-dsc_moneda 
         WITH FRAME {&FRAME-NAME}.

  codigo_salir = ?.

  IF    modo = MD_MULTIPLE
     OR modo = MD_ANULACION
     OR modo = MD_EMISION
  THEN DO:
       DO WITH FRAME {&FRAME-NAME}:
          T-Rec_header.tip_comprob:FGCOLOR = 9.
          T-Rec_header.tip_comprob:BGCOLOR = 15.

          T-Rec_header.prf_comprob:FGCOLOR = 9.
          T-Rec_header.prf_comprob:BGCOLOR = 15.

          T-Rec_header.nro_comprob:FGCOLOR = 9.
          T-Rec_header.nro_comprob:BGCOLOR = 15.
       END.
  END.


END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE desmarcar_todos C-Win 
PROCEDURE desmarcar_todos :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  FOR EACH T-Cta_cte OF Cliente WHERE T-Cta_cte.user-id-sel = st_seleccionado:

      T-Cta_cte.user-id-sel = "".
      T-Cta_cte.selectado   = NO.
      T-Cta_cte.imputado    = NO.
      
  END.


END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE disable_UI C-Win  _DEFAULT-DISABLE
PROCEDURE disable_UI :
/*------------------------------------------------------------------------------
  Purpose:     DISABLE the User Interface
  Parameters:  <none>
  Notes:       Here we clean-up the user-interface by deleting
               dynamic widgets we have created and/or hide 
               frames.  This procedure is usually called when
               we are ready to "clean-up" after running.
------------------------------------------------------------------------------*/
  /* Delete the WINDOW we created */
  IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(C-Win)
  THEN DELETE WIDGET C-Win.
  IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE enable_UI C-Win  _DEFAULT-ENABLE
PROCEDURE enable_UI :
/*------------------------------------------------------------------------------
  Purpose:     ENABLE the User Interface
  Parameters:  <none>
  Notes:       Here we display/view/enable the widgets in the
               user-interface.  In addition, OPEN all queries
               associated with each FRAME and BROWSE.
               These statements here are based on the "Other 
               Settings" section of the widget Property Sheets.
------------------------------------------------------------------------------*/

  {&OPEN-QUERY-DEFAULT-FRAME}
  GET FIRST DEFAULT-FRAME.
  DISPLAY v-anulado v-importe v-cdg_cliente v-dsc_cliente v-cdg_domicilio 
          v-dsc_domicilio v-abv_provincia v-cdg_moneda v-dsc_moneda 
          v-cdg_condicion_impos v-dsc_condicion_impos v-cdg_imputacion 
          v-dsc_imputacion v-cdg_cobrador v-dsc_cobrador a-tip_comprob 
          a-prf_comprob a-nro_comprob a-nro_vencimiento 
      WITH FRAME DEFAULT-FRAME IN WINDOW C-Win.
  IF AVAILABLE T-Rec_header THEN 
    DISPLAY T-Rec_header.tip_comprob T-Rec_header.prf_comprob 
          T-Rec_header.nro_comprob T-Rec_header.fecha T-Rec_header.fch_cambio 
          T-Rec_header.mes T-Rec_header.ano T-Rec_header.tipo_pago 
          T-Rec_header.cambio T-Rec_header.calcular_cambio 
          T-Rec_header.cambio_dolar T-Rec_header.nro_rendicion 
          T-Rec_header.imp_pesos T-Rec_header.imp_bruto 
          T-Rec_header.imp_difcambio T-Rec_header.imp_total 
      WITH FRAME DEFAULT-FRAME IN WINDOW C-Win.
  ENABLE RECT-10 RECT-11 RECT-12 RECT-13 RECT-2 RECT-3 RECT-4 RECT-5 RECT-6 
         RECT-7 RECT-8 RECT-9 Btn_salir v-importe BRW-TOTALES BROWSE-6 
      WITH FRAME DEFAULT-FRAME IN WINDOW C-Win.
  {&OPEN-BROWSERS-IN-QUERY-DEFAULT-FRAME}
  VIEW C-Win.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE frame_sensitiva C-Win 
PROCEDURE frame_sensitiva :
/*------------------------------------------------------------------------------
  Purpose: habilita o deshabilita los campos de la frame para el estado inicial
           de la misma que se da cuando comienza el ciclo de transaccion. El es-
           tado definitivo de los campos lo ajusta la rutina habilitar_campos ( INPUT YES ).   
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  DEFINE INPUT PARAMETER habilitado AS LOGICAL.

  DO WITH FRAME {&FRAME-NAME}:

     IF NOT habilitado
     THEN DO:
          ASSIGN
                btn_grabar:SENSITIVE                      = NO
                btn_leyenda:SENSITIVE                     = NO
                btn_cancel:SENSITIVE                      = NO
                btn_anular:SENSITIVE                      = NO
                btn_observ:SENSITIVE                      = NO
                btn_imprim:SENSITIVE                      = NO
                T-Rec_header.tip_comprob:SENSITIVE        = NO
                T-Rec_header.prf_comprob:SENSITIVE        = NO
                T-Rec_header.nro_comprob:SENSITIVE        = NO
                T-Rec_header.fecha:SENSITIVE              = NO
                T-Rec_header.fch_cambio:SENSITIVE         = NO
                T-Rec_header.ano:SENSITIVE                = NO
                T-Rec_header.cambio:SENSITIVE             = NO
                T-Rec_header.cambio_dolar:SENSITIVE       = NO
                T-Rec_header.mes:SENSITIVE                = NO
                v-cdg_condicion_impos:SENSITIVE           = NO
                v-cdg_domicilio:SENSITIVE                 = NO
                v-cdg_imputacion:SENSITIVE                = NO
                v-cdg_moneda:SENSITIVE                    = NO
                v-cdg_cliente:SENSITIVE                   = NO
              /*btn_verimputacion:SENSITIVE               = NO*/
                a-tip_comprob:SENSITIVE                   = NO
                a-prf_comprob:SENSITIVE                   = NO
                a-nro_comprob:SENSITIVE                   = NO
                a-nro_vencimiento:SENSITIVE               = NO.
                
     END.
     ELSE DO:

                    /* Deshabilitamos todo y después habilitamos según cada caso */


            RUN frame_sensitiva ( NO ).


            CASE modo:
       
                WHEN MD_ALTA          
                THEN DO:
                     ASSIGN
                        v-cdg_cliente:SENSITIVE                 = YES
                        T-Rec_header.tipo_pago:SENSITIVE        = YES.

         
                END.
                WHEN MD_MULTIPLE      
                THEN DO:
                     ASSIGN
                        T-Rec_header.tip_comprob:SENSITIVE        = YES
                        T-Rec_header.prf_comprob:SENSITIVE        = YES
                        T-Rec_header.nro_comprob:SENSITIVE        = YES.
                END.
                WHEN MD_DEFINIDA      
                THEN DO:
                     /* Nada habilitado */         
                END.
                WHEN MD_RELACION      
                THEN DO:
                     /* Nada habilitado */         
         
                END.
                WHEN MD_READONLY      
                THEN DO:
                     /* Nada habilitado */         
         
                END.
                WHEN MD_CAMBIO        
                THEN DO:
                     /* Nada habilitado */         
                END.
                WHEN MD_ANULACION        
                THEN DO:
                     ASSIGN
                        T-Rec_header.tip_comprob:SENSITIVE        = YES
                        T-Rec_header.prf_comprob:SENSITIVE        = YES
                        T-Rec_header.nro_comprob:SENSITIVE        = YES.
         
                END.
                WHEN MD_EMISION        
                THEN DO:
                     ASSIGN
                        T-Rec_header.tip_comprob:SENSITIVE        = YES
                        T-Rec_header.prf_comprob:SENSITIVE        = YES
                        T-Rec_header.nro_comprob:SENSITIVE        = YES.         
                END.
       
           END CASE.     
     END.
  END.
  
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE grabar_datos C-Win 
PROCEDURE grabar_datos :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    DO TRANSACTION:
        
        IF T-Rec_header.tipo_pago = 1
        THEN DO:
            IF T-Rec_header.calcular_cambio
            THEN DO:

                FIND FIRST T-Fac_header NO-ERROR.
                IF AVAILABLE T-Fac_header AND T-Fac_header.imp_total <> 0
                THEN DO:
                    FIND Tipocomprobante OF T-Fac_header NO-LOCK.
                    /*
                    FIND FIRST Tipo_puntovta OF Tipocomprobante
                        WHERE Tipo_puntovta.preferido 
                          AND Tipo_puntovta.cdg_empresa = T-Fac_header.cdg_empresa NO-LOCK.
                    T-Fac_header.prf_comprob = Tipo_puntovta.cdg_puntovta.
                    */
    
                    RUN emitir_diferencia_cambio.p ( INPUT-OUTPUT TABLE T-Fac_header,
                                                     INPUT TABLE T-Fac_detalle,
                                                     INPUT TABLE T-Sub_header_vta, 
                                                     INPUT TABLE T-Sub_detalle_vta,
                                                     INPUT TABLE T-Fac_header_impuesto,
                                                     INPUT TABLE T-Fac_detalle_impuesto).

                    FIND Moneda WHERE Moneda.es_local NO-LOCK.
    
                    FOR EACH T-Fac_header, Tipocomprobante OF T-Fac_header:
    
                        T-Rec_header.ultima_linea = T-Rec_header.ultima_linea + 1.
                        CREATE T-Rec_detalle.
                        ASSIGN T-Rec_detalle.nro_recibo       = T-Rec_header.nro_recibo
                               T-Rec_detalle.nro_linea        = T-Rec_header.ultima_linea
                               T-Rec_detalle.cdg_emprecancela = T-Rec_header.cdg_empresa
                               T-Rec_detalle.tip_cancela      = T-Fac_header.tip_comprob
                               T-Rec_detalle.prf_cancela      = T-Fac_header.prf_comprob
                               T-Rec_detalle.nro_cancela      = T-Fac_header.nro_comprob
                               T-Rec_detalle.nro_vencimiento  = 1
                               T-Rec_detalle.nro_moneda       = Moneda.nro_moneda
                               T-Rec_detalle.cambio           = 1
                               T-Rec_detalle.importe          = 0
                               T-Rec_detalle.imp_pesos        = 0
                               T-Rec_detalle.difcambio        = 
                                    IF Tipocomprobante.debita 
                                       THEN T-Fac_header.imp_total
                                       ELSE T-Fac_header.imp_total * ( - 1 ) 
                               T-Rec_detalle.es_difcambio     = YES.
    
                    END.
                END.
            END.
        END.

        RUN completar_auditoria.p ( OUTPUT T-Rec_header.nro_usuario,
                                    OUTPUT T-Rec_header.fecha_grab,
                                    OUTPUT T-Rec_header.hora_grab,
                                    OUTPUT T-Rec_header.pc_name).

        CREATE Rec_header.
        BUFFER-COPY T-Rec_header TO Rec_header
            ASSIGN  Rec_header.nro_recibo = NEXT-VALUE(proxima_transaccion).

        FOR EACH T-Rec_detalle:
            CREATE Rec_detalle.
            BUFFER-COPY T-Rec_detalle TO Rec_detalle
                ASSIGN  Rec_detalle.nro_recibo = Rec_header.nro_recibo.
        END.

        FOR EACH T-Totales_recibo:
            CREATE Totales_recibo.
            BUFFER-COPY T-Totales_recibo TO Totales_recibo
                ASSIGN  Totales_recibo.nro_recibo = Rec_header.nro_recibo.
        END.

        IF TRUE /* Rec_header.nro_transaccion <> 0 */ /* tiene tx caja asociada */
        THEN DO:

            CREATE Caj_header.
            BUFFER-COPY T-Caj_header TO Caj_header
                ASSIGN Caj_header.nro_transaccion = NEXT-VALUE(proxima_transaccion)
                       Caj_header.cdg_empresa = Rec_header.cdg_empresa
                       Caj_header.tip_comprob = Rec_header.tip_comprob
                       Caj_header.prf_comprob = Rec_header.prf_comprob
                       Caj_header.nro_comprob = Rec_header.nro_comprob
                       Rec_header.nro_transaccion = Caj_header.nro_transaccion.

            FOR EACH T-Caja-imputacion:
                CREATE Caja-imputacion.
                BUFFER-COPY T-Caja-imputacion TO Caja-imputacion
                    ASSIGN Caja-imputacion.nro_transaccion = Caj_header.nro_transaccion.
            END.

            FOR EACH T-Caj_detalle OF T-Caj_header, Rubro OF T-Caj_detalle:

                CREATE Caj_detalle.
                BUFFER-COPY T-Caj_detalle TO Caj_detalle
                    ASSIGN Caj_detalle.nro_transaccion = Caj_header.nro_transaccion.

                CASE Rubro.tipo:
                    WHEN "P" 
                    THEN DO:
                        FIND T-Cheque OF T-Caj_detalle NO-LOCK.
                        CREATE Cheque.
                        BUFFER-COPY T-Cheque TO Cheque
                            ASSIGN Cheque.nro_transaccion = Caj_header.nro_transaccion
                                   Cheque.nro_cheque = NEXT-VALUE(proximo_cheque)
                                   Caj_detalle.nro_cheque = Cheque.nro_cheque.
                        RELEASE Cheque.
                    END.
                    WHEN "V" 
                    THEN DO:
                        FIND T-Valor OF T-Caj_detalle NO-LOCK.
                        CREATE Valor.
                        BUFFER-COPY T-Valor TO Valor
                            ASSIGN Valor.nro_transaccion = Caj_header.nro_transaccion
                                   Valor.nro_valor = NEXT-VALUE(proximo_valor)
                                   Valor.fecha_recepcion = Caj_header.fecha
                                   Valor.nro_cliente = Cliente.nro_cliente
                                   Valor.cdg_caja = Caj_header.cdg_caja
                                   Valor.estado = "00"
                                   Caj_detalle.nro_valor = Valor.nro_valor.
                        RELEASE Valor.
                    END.

                END CASE.
                RELEASE Caj_detalle.

            END.

            RUN emitir_movcaja.p ( INPUT ROWID(Caj_header)).
            RELEASE Caj_header.    

        END.

        RUN emitir_recibo.p ( ROWID(Rec_header)).

        RUN borrar_tablas_temporales.    

   END.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE habilitar_campos C-Win 
PROCEDURE habilitar_campos :
/*------------------------------------------------------------------------------
  Purpose: habilita o deshabilita los campos de la frame para el estado final
           de la misma que se da cuando se ejecuta el ciclo de transaccion. El es-
           tado inicial de los campos lo ajusta la rutina frame_sensitiva.   
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  DEFINE INPUT PARAMETER habilitado AS LOGICAL.

  DO WITH FRAME {&FRAME-NAME}:

                  /* Deshabilitamos todo y después habilitamos según cada caso */

     ASSIGN
          btn_grabar:SENSITIVE                      = NO
          btn_leyenda:SENSITIVE                     = NO
          btn_cancel:SENSITIVE                      = NO
          btn_anular:SENSITIVE                      = NO
          btn_observ:SENSITIVE                      = NO
          btn_imprim:SENSITIVE                      = NO
          T-Rec_header.tip_comprob:SENSITIVE        = NO
          T-Rec_header.prf_comprob:SENSITIVE        = NO
          T-Rec_header.nro_comprob:SENSITIVE        = NO
          T-Rec_header.fecha:SENSITIVE              = NO
          T-Rec_header.fch_cambio:SENSITIVE         = NO
          T-Rec_header.ano:SENSITIVE                = NO
          T-Rec_header.cambio:SENSITIVE             = NO
          T-Rec_header.cambio_dolar:SENSITIVE       = NO
          T-Rec_header.calcular_cambio:SENSITIVE    = NO
          T-Rec_header.mes:SENSITIVE                = NO
          v-cdg_condicion_impos:SENSITIVE           = NO
          v-cdg_domicilio:SENSITIVE                 = NO
          v-cdg_imputacion:SENSITIVE                = NO
          v-cdg_moneda:SENSITIVE                    = NO
          v-cdg_cliente:SENSITIVE                   = NO
          /*btn_verimputacion:SENSITIVE               = NO*/.

     CASE modo:

       WHEN MD_ALTA          
       THEN DO:
            ASSIGN
                  btn_grabar:SENSITIVE                      = YES
                  btn_leyenda:SENSITIVE                     = YES
                  btn_cancel:SENSITIVE                      = YES
                  btn_anular:SENSITIVE                      = NO
                  btn_observ:SENSITIVE                      = YES
                  btn_imprim:SENSITIVE                      = NO
                  T-Rec_header.tip_comprob:SENSITIVE        = YES
                  T-Rec_header.prf_comprob:SENSITIVE        = YES
                  T-Rec_header.nro_comprob:SENSITIVE        = YES
                  T-Rec_header.fecha:SENSITIVE              = YES
                  T-Rec_header.fch_cambio:SENSITIVE         = YES
                  T-Rec_header.ano:SENSITIVE                = YES
                  T-Rec_header.cambio:SENSITIVE             = mod_cambio
                  T-Rec_header.cambio_dolar:SENSITIVE       = YES
                  T-Rec_header.calcular_cambio:SENSITIVE    = YES
                  T-Rec_header.mes:SENSITIVE                = YES
                  T-Rec_header.tipo_pago:SENSITIVE          = NO
                  v-cdg_condicion_impos:SENSITIVE           = YES
                  v-cdg_domicilio:SENSITIVE                 = YES
                  v-cdg_imputacion:SENSITIVE                = YES
                  v-cdg_moneda:SENSITIVE                    = YES
                  v-cdg_cliente:SENSITIVE                   = NO
                  v-cdg_cobrador:SENSITIVE                  = YES
                  /*btn_verimputacion:SENSITIVE               = NO*/.

       END.
       WHEN MD_MULTIPLE      
       THEN DO:
            ASSIGN
                btn_cancel:SENSITIVE                      = YES
                btn_observ:SENSITIVE                      = YES
                btn_leyenda:SENSITIVE                     = YES
                btn_imprim:SENSITIVE                      = YES
              /*btn_verimputacion:SENSITIVE               = YES*/
                btn_valores:SENSITIVE                     = T-Rec_header.nro_transaccion <> 0.

       END.
       WHEN MD_DEFINIDA      
       THEN DO:
            ASSIGN
                btn_observ:SENSITIVE                      = YES
                btn_imprim:SENSITIVE                      = YES
                btn_leyenda:SENSITIVE                     = YES
                /*btn_verimputacion:SENSITIVE               = YES*/
                btn_valores:SENSITIVE                     = T-Rec_header.nro_transaccion <> 0.
       END.
       WHEN MD_RELACION      
       THEN DO:
            ASSIGN
                btn_observ:SENSITIVE                      = YES
                btn_imprim:SENSITIVE                      = YES
                btn_leyenda:SENSITIVE                     = YES
                /*btn_verimputacion:SENSITIVE               = YES*/
                btn_valores:SENSITIVE                     = T-Rec_header.nro_transaccion <> 0.
       END.
       WHEN MD_READONLY      
       THEN DO:
            ASSIGN
                btn_observ:SENSITIVE                      = YES
                btn_imprim:SENSITIVE                      = YES
                btn_leyenda:SENSITIVE                     = YES
                /*btn_verimputacion:SENSITIVE               = YES*/
                btn_valores:SENSITIVE                     = T-Rec_header.nro_transaccion <> 0.
       END.
       WHEN MD_CAMBIO        
       THEN DO:
            ASSIGN
                btn_observ:SENSITIVE                      = YES
                btn_imprim:SENSITIVE                      = YES
                btn_leyenda:SENSITIVE                     = YES
                /*btn_verimputacion:SENSITIVE               = YES*/
                btn_valores:SENSITIVE                     = T-Rec_header.nro_transaccion <> 0.
       END.
       WHEN MD_ANULACION        
       THEN DO:
            ASSIGN
                btn_cancel:SENSITIVE                      = YES
                btn_anular:SENSITIVE                      = YES
                btn_observ:SENSITIVE                      = YES
                btn_imprim:SENSITIVE                      = YES
                btn_leyenda:SENSITIVE                     = YES
                /*btn_verimputacion:SENSITIVE               = YES*/
                btn_valores:SENSITIVE                     = T-Rec_header.nro_transaccion <> 0.
       END.
       WHEN MD_EMISION        
       THEN DO:
            ASSIGN
                btn_grabar:SENSITIVE                      = YES
                btn_observ:SENSITIVE                      = YES
                btn_imprim:SENSITIVE                      = YES
                btn_leyenda:SENSITIVE                     = YES
                /*btn_verimputacion:SENSITIVE               = YES*/
                btn_valores:SENSITIVE                     = T-Rec_header.nro_transaccion <> 0.
       END.

    END CASE.     

  END.
  
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

