DEFINE VARIABLE ver_por AS INTEGER LABEL "Ordenado Por" VIEW-AS RADIO-SET 
                HORIZONTAL RADIO-BUTTONS "Codigo",  1 , "Nombre", 0 INITIAL 1.
DEFINE VARIABLE por_cod AS INTEGER INITIAL 1.
DEFINE VARIABLE por_nom AS INTEGER INITIAL 0.
DEFINE VARIABLE des_codigo LIKE Cobrador.cdg_cobrador  LABEL "Desde Cobrador".
DEFINE VARIABLE has_codigo LIKE Cobrador.cdg_cobrador  LABEL "Hasta Cobrador".
DEFINE VARIABLE des_nombre LIKE Cobrador.nom_cobrador.
DEFINE VARIABLE has_nombre LIKE Cobrador.nom_cobrador.
DEFINE QUERY qry_cobrador FOR Cobrador.
