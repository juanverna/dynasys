&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE upd-ejecutar W-Win 
PROCEDURE upd-ejecutar :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
DEFINE INPUT PARAMETER v-add_del AS CHARACTER FORMAT "X(3)".

DEFINE VARIABLE des_articulo   AS CHARACTER.
DEFINE VARIABLE has_articulo   AS CHARACTER.
DEFINE VARIABLE des_nombre     AS CHARACTER.
DEFINE VARIABLE has_nombre     AS CHARACTER.
DEFINE VARIABLE ver_por        AS INTEGER.
DEFINE VARIABLE lista_sectores AS CHARACTER.
DEFINE VARIABLE error_rango    AS LOGICAL.
DEFINE VARIABLE hay_error      AS LOGICAL.

RUN dar_rango IN h_v-rng-articulo ( OUTPUT des_articulo, 
                                    OUTPUT has_articulo, 
                                    OUTPUT des_nombre, 
                                    OUTPUT has_nombre, 
                                    OUTPUT ver_por,
                                    OUTPUT error_rango ).
IF error_rango 
THEN DO:
     RUN ver-error-rango ( "Artículos" ).
     hay_error = error_rango.
END.     

RUN validar-sectores IN h_v-lista_sectores ( INPUT  hay_error,
                                             OUTPUT lista_sectores,
                                             OUTPUT hay_error ).

IF lista_sectores = "" AND hay_error = NO
THEN DO:
    RUN PONMENSJ.P ("AREA010").
    hay_error = YES.
END.

IF NOT hay_error
THEN DO:

     RUN setear-botones ( NO ).        
     v-estado:SCREEN-VALUE IN FRAME {&FRAME-NAME} = "Ejecutando Proceso ...".

     RUN mod_del_sector.p ( INPUT v-add_del,
                            INPUT des_articulo,
                            INPUT has_articulo,
                            INPUT lista_sectores
                           ).

     v-estado:SCREEN-VALUE in FRAME {&FRAME-NAME} = "Proceso Terminado. Ingresando Parametros ...".
     RUN setear-botones ( YES ).        

END.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

