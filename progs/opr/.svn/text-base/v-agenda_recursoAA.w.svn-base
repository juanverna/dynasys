     LIST-ITEM-PAIRS "0",1
     DROP-DOWN-LIST
     SIZE 16 BY 1 TOOLTIP "Tipo de Restriccion o Tipo de Evento ( PARAM DFLTIPEV )".

DEFINE VARIABLE min_dia AS INTEGER FORMAT "->,>>>,>>9":U INITIAL 240 
