DEFINE BUFFER bant FOR evento.
DEFINE BUFFER aviso FOR evento.
FIND restriccion NO-LOCK WHERE restriccion.cdg_restriccion = "AVISOF".
FOR EACH evento NO-LOCK WHERE evento.nro_tipo_evento = 1 AND NOT evento.anulado AND evento.sub_evento = 1 AND evento.fasignado >= 12/14/2011  AND evento.fasignado <= 01/01/2012:
FIND contrato_restriccion NO-LOCK WHERE contrato_restriccion.nro_contrato = evento.nro_identificacion AND contrato_restriccion.sub_evento = 
evento.sub_evento AND contrato_restriccion.nro_restriccion = restriccion.nro_restriccion NO-ERROR.
IF NOT AVAILABLE contrato_restriccion THEN NEXT.
FIND FIRST aviso NO-LOCK WHERE aviso.refevento = evento.nro_evento AND NOT aviso.anulado NO-ERROR.
RELEASE bant.
FOR EACH bant NO-LOCK WHERE bant.nro_cliente = evento.nro_cliente and NOT bant.anulado AND
     bant.nro_identificacion = evento.nro_identificacion AND 
     bant.nro_tipo_evento = evento.nro_tipo_evento AND
     bant.sub_evento = evento.sub_evento AND bant.fasignado < evento.fasignado BY bant.fasignado DESC :
    LEAVE.
END.
IF bant.fasignado <= 11/14/2011 THEN NEXT.
IF NOT AVAILABLE aviso THEN DISPLAY evento.nro_evento evento.fasignado
"NO EXISTE" @ aviso.fasignado.
ELSE DO:
    IF aviso.fasignado <> bant.fasignado OR entry(1, aviso.recurso) <> entry(1,bant.recursos) THEN DO:
    /*IF AVAILABLE aviso AND aviso.fasignado = bant.fasignado THEN DO:*/
    IF 1=1 THEN DO:        
            display evento.nro_evento evento.fasignado
            bant.fasignado LABEL "ACTUAL" WHEN AVAILABLE bant
            bant.recursos
            aviso.fasignado LABEL "AVISO" WHEN AVAILABLE aviso
            aviso.recursos.
        END.
    ELSE DO:
            FIND CURRENT aviso EXCLUSIVE-LOCK.
            FOR EACH recurso_agenda OF aviso :
                     DELETE recurso_agenda.
            END.
            aviso.fasignado = ?.
            aviso.recursos = "".
        END.
    END.
END.
END.
