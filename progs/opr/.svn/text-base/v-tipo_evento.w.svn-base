/* ***********************  Control Definitions  ********************** */


/* Definitions of the field level widgets                               */
DEFINE BUTTON btn_nextcolorfondo 
     IMAGE-UP FILE "adeicon\next-au":U
     LABEL "btn_nextmes" 
     SIZE 4 BY 1.

DEFINE BUTTON btn_nextcolorletra 
     IMAGE-UP FILE "adeicon\next-au":U
     LABEL "btn_nextmes" 
     SIZE 4 BY 1.

DEFINE BUTTON btn_prevcolorfondo 
     IMAGE-UP FILE "adeicon\prev-au":U
     LABEL "btn_prevcolorletra 2" 
     SIZE 4 BY 1.

DEFINE BUTTON btn_prevcolorletra 
     IMAGE-UP FILE "adeicon\prev-au":U
     LABEL "Button 44" 
     SIZE 4 BY 1.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME F-Main
     Tipo_evento.cdg_tipo_evento AT ROW 1 COL 14 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 9.6 BY 1
     Tipo_evento.nro_tipo_evento AT ROW 1 COL 45.2 COLON-ALIGNED WIDGET-ID 20
          LABEL "Nro"
          VIEW-AS FILL-IN 
          SIZE 6 BY 1
     Tipo_evento.color_letra AT ROW 1 COL 64 COLON-ALIGNED WIDGET-ID 16
          VIEW-AS FILL-IN 
          SIZE 6 BY 1
          BGCOLOR 15 FGCOLOR 9 
     btn_prevcolorletra AT ROW 1 COL 73 WIDGET-ID 12
     btn_nextcolorletra AT ROW 1 COL 77 WIDGET-ID 8
     Tipo_evento.Origen AT ROW 2.19 COL 14 COLON-ALIGNED WIDGET-ID 4
          VIEW-AS FILL-IN 
          SIZE 32 BY 1
     Tipo_evento.color_fondo AT ROW 2.19 COL 64 COLON-ALIGNED WIDGET-ID 14
          VIEW-AS FILL-IN 
          SIZE 6 BY 1
          BGCOLOR 15 FGCOLOR 9 
     btn_prevcolorfondo AT ROW 2.19 COL 73 WIDGET-ID 10
     btn_nextcolorfondo AT ROW 2.19 COL 77 WIDGET-ID 6
     Tipo_evento.Habilidades AT ROW 3.38 COL 14 COLON-ALIGNED WIDGET-ID 2
          VIEW-AS FILL-IN 
          SIZE 65 BY 1
     Tipo_evento.Descripcion AT ROW 5.05 COL 3 NO-LABEL
          VIEW-AS EDITOR
          SIZE 78 BY 4.29
     Tipo_evento.Certificado AT ROW 9.57 COL 12 WIDGET-ID 28
          VIEW-AS TOGGLE-BOX
          SIZE 14 BY .81
     Tipo_evento.factura AT ROW 9.57 COL 32 WIDGET-ID 24
          LABEL "Factura"
          VIEW-AS TOGGLE-BOX
          SIZE 11.6 BY .81
     Tipo_evento.OT AT ROW 9.57 COL 46 WIDGET-ID 32
          VIEW-AS TOGGLE-BOX
          SIZE 8 BY .81
     Tipo_evento.informa AT ROW 9.57 COL 55 WIDGET-ID 18
          VIEW-AS TOGGLE-BOX
          SIZE 13.4 BY .81
    WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY 
         SIDE-LABELS NO-UNDERLINE THREE-D 
         AT COL 1 ROW 1 SCROLLABLE .


