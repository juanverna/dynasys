OUTPUT TO c:\ccc1.txt.
DEFINE VAR imp_firma AS DECIMAL INITIAL 170.0.
DEFINE VAR impp AS DECIMAL NO-UNDO.
FOR EACH contrato_hd WHERE contrato_hd.rige_desde >= 11/01/2011 AND contrato_hd.estado = "A" AND NOT contrato_hd.anulado AND contrato_hd.fecha_baja = ?:
DISPLAY nro_contrato.
FIND Punto-venta WHERE punto-venta.cdg_punto = contrato_hd.prf NO-LOCK NO-ERROR.
  find cliente OF contrato_hd NO-ERROR.
IF NOT AVAILABLE cliente THEN do:
    DISPLAY "NO ESTA".
    NEXT.
END.

  FIND contrato_dt OF contrato_hd WHERE contrato_dt.solocuota1 NO-ERROR.
  FIND articulo OF contrato_dt.
  IF AVAILABLE contrato_dt THEN DO:
              ASSIGN contrato_dt.precio = IF punto-venta.TP = "E" THEN imp_firma / 1.21 ELSE imp_firma
                     contrato_dt.precio_cf = imp_firma
                     contrato_dt.subtotal_bruto = IF punto-venta.TP = "E" THEN imp_firma / 1.21 ELSE imp_firma
                     contrato_dt.subtotal_bruto_cf = imp_firma
                     contrato_dt.subtotal_gral = imp_firma
                     contrato_dt.subtotal_neto = IF punto-venta.TP = "E" THEN imp_firma / 1.21 ELSE imp_firma
                     contrato_dt.subtotal_neto_cf = imp_firma
                     contrato_dt.detallada = articulo.detallada
                     contrato_dt.nro_factura_anticipo = 0.
  END.
 impp = 0.
FOR EACH contrato_dt OF contrato_hd:
  impp = impp + contrato_dt.precio_cf.
END.
Contrato_hd.imp_iva = IF punto-venta.TP = "E" THEN impp * 0.21 / 1.21 ELSE impp. 
Contrato_hd.imp_neto = IF punto-venta.TP = "E" THEN impp / 1.21 ELSE impp       .
Contrato_hd.imp_bruto = Contrato_hd.imp_neto .
Contrato_hd.imp_total = impp.
END.

  
  
