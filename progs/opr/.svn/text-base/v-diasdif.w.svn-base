&ANALYZE-RESUME

 


/* **********************  Create OCX Containers  ********************** */

&ANALYZE-SUSPEND _CREATE-DYNAMIC

&IF "{&OPSYS}" = "WIN32":U AND "{&WINDOW-SYSTEM}" NE "TTY":U &THEN

CREATE CONTROL-FRAME Cs ASSIGN
       FRAME           = FRAME F-Main:HANDLE
       ROW             = 3.62
       COLUMN          = 23
       HEIGHT          = 1.57
       WIDTH           = 20
       HIDDEN          = no
       SENSITIVE       = yes.

PROCEDURE adm-create-controls:
      Cs:NAME = "Cs":U .
/* Cs OCXINFO:CREATE-CONTROL from: {EAF26C8F-9586-101B-9306-0020AF234C9D} type: CSSpin */
      Cs:MOVE-AFTER(Contrato_Restriccion.Valor:HANDLE IN FRAME F-Main).

END PROCEDURE.

&ENDIF

&ANALYZE-RESUME /* End of _CREATE-DYNAMIC */


