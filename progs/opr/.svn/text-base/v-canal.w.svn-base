/* External Tables                                                      */
&Scoped-define EXTERNAL-TABLES canal Cliente
&Scoped-define FIRST-EXTERNAL-TABLE canal


/* Need to scope the external tables to this procedure                  */
DEFINE QUERY external_tables FOR canal, Cliente.
/* Standard List Definitions                                            */
&Scoped-Define ENABLED-FIELDS canal.nro_tipo_evento 
&Scoped-define ENABLED-TABLES canal
&Scoped-define FIRST-ENABLED-TABLE canal
