{stavisado.i}
DEFINE BUFFER bevento FOR evento.
    DEFINE BUFFER bcontrato_hd FOR contrato_hd.
DEFINE VAR sigue AS LOGICAL NO-UNDO.
DEFINE VAR pperiodo AS INT.
DEFINE VAR ddd AS DATE.
DEFINE VAR hhh AS DATE.
DEFINE VAR v-mes AS INT.
DEFINE VAR v-ano AS INT.
DEFINE VAR i AS INT.

message "La generacion gaba los errores en el clipboard" VIEW-AS ALERT-BOX INFORMATION.
UPDATE v-mes v-ano  WITH FRAME pperiodo.
 pperiodo = v-ano * 100 + v-mes.
 ddd = DATE(v-mes,1,v-ano).
hhh = DATE( MONTH(ddd + 32 ), 1 , YEAR( ddd + 32 ) ) - 1 .
sigue = TRUE.
OUTPUT TO "CLIPBOARD".

/*ver hijos muertos*/
FOR EACH restriccion WHERE restriccion.cdg_restriccion BEGINS "BLOQ":
    FOR EACH contrato_hd WHERE contrato_hd.rige_hasta >= ddd AND
          contrato_hd.estado = "A" AND
          contrato_hd.rige_desde <= hhh AND
          ( contrato_hd.cant_periodos = 0 OR contrato_hd.resto_periodos > 0 )
          AND contrato_hd.primer_ano * 100 + contrato_hd.primer_mes  <= pperiodo and 
          not Contrato_hd.anulado and ( contrato_hd.fecha_baja = ? OR year(contrato_hd.fecha_baja) * 100 + MONTH(contrato_hd.fecha_baja) > pperiodo )
          ,FIRST cliente OF contrato_hd :
        FIND contrato_restriccion OF contrato_hd WHERE contrato_restriccion.nro_restriccion = restriccion.nro_restriccion NO-ERROR.
        IF AVAILABLE contrato_restriccion THEN DO:
            IF NOT CAN-FIND( bcontrato_hd WHERE bcontrato_hd.nro_contrato = int(entry( 1 , contrato_restriccion.valor,"|")) and
                             ROWID(bcontrato_hd) <> ROWID(contrato_hd) AND
                             bcontrato_hd.rige_hasta >= ddd AND
                             bcontrato_hd.rige_desde <= hhh AND
                            ( bcontrato_hd.cant_periodos = 0 OR bcontrato_hd.resto_periodos > 0 )
                            AND bcontrato_hd.primer_ano * 100 + bcontrato_hd.primer_mes  <= pperiodo and 
                            not bContrato_hd.anulado and  ( bcontrato_hd.fecha_baja = ? OR year( bcontrato_hd.fecha_baja ) * 100 + MONTH( bcontrato_hd.fecha_baja ) > pperiodo )) THEN DO:
            DISPLAY "CONTRATO:" contrato_hd.nro_contrato " TIENE PADRE INVALIDO:" entry( 1 , contrato_restriccion.valor, "|" ).
            sigue = FALSE.
            END.

                END.
    END.
END.
MESSAGE "HIJOS MUERTOS".
IF NOT sigue THEN RETURN.

/*ver evsigue a un muerto*/
FOR EACH restriccion WHERE restriccion.cdg_restriccion BEGINS "dfEV":
    FOR EACH contrato_hd WHERE contrato_hd.rige_hasta >= ddd AND
          contrato_hd.rige_desde <= hhh AND
          ( contrato_hd.cant_periodos = 0 OR contrato_hd.resto_periodos > 0 )
          AND contrato_hd.primer_ano * 100 + contrato_hd.primer_mes  <= pperiodo and 
          not Contrato_hd.anulado and  ( contrato_hd.fecha_baja = ? OR year(contrato_hd.fecha_baja) * 100 + MONTH(contrato_hd.fecha_baja) > pperiodo )
          ,FIRST cliente OF contrato_hd :
        FIND contrato_restriccion OF contrato_hd WHERE contrato_restriccion.nro_restriccion = restriccion.nro_restriccion NO-ERROR.
        IF AVAILABLE contrato_restriccion THEN DO:
            
                IF NOT CAN-FIND( bcontrato_hd WHERE bcontrato_hd.nro_contrato = int(entry( 1 , contrato_restriccion.valor , "|" )) and
                                 ROWID(bcontrato_hd) <> ROWID(contrato_hd) AND
                                 bcontrato_hd.rige_hasta >= ddd AND
                                 bcontrato_hd.rige_desde <= hhh AND
                                ( bcontrato_hd.cant_periodos = 0 OR bcontrato_hd.resto_periodos > 0 )
                                AND bcontrato_hd.primer_ano * 100 + bcontrato_hd.primer_mes  <= pperiodo and 
                                not bContrato_hd.anulado and  ( bcontrato_hd.fecha_baja = ? OR year( bcontrato_hd.fecha_baja ) * 100 + MONTH( bcontrato_hd.fecha_baja ) > pperiodo )) THEN DO:
                DISPLAY "EL CONTRATO:" contrato_hd.nro_contrato " SIGUE A UN CTO. INVALIDO:" entry( 1 , contrato_restriccion.valor , "|").
                sigue = FALSE.
                END.
            
        END.
    END.
END.
MESSAGE "HIJOS MUERTOS EVSIGUE".
IF NOT sigue THEN RETURN.

/*LLEVA y NO AVISADO*/
FOR EACH restriccion WHERE restriccion.cdg_restriccion = "AVISOF":
    FOR EACH evento WHERE periodo = pperiodo AND evento.origen = "CONTRATO" AND NOT evento.anulado, FIRST cliente OF evento:
        FIND contrato_restriccion WHERE contrato_restriccion.nro_contrato = evento.nro_identificacion AND
            contrato_restriccion.sub_evento = evento.sub_evento AND 
            contrato_restriccion.nro_restriccion = restriccion.nro_restriccion NO-ERROR.
        IF AVAILABLE contrato_restriccion THEN
            IF entry(3 , contrato_restriccion.valor , "|") = "L" AND not avisoentregado(evento.nro_evento) THEN DO:
                DISPLAY "LLEVA y NO AVISADO" evento.nro_evento cliente.cdg_cliente.
                sigue = FALSE.
            END.
    END.
END.
MESSAGE "LLEVA y NO AVISADO".
IF NOT sigue AND  FALSE THEN RETURN.

FOR EACH restriccion WHERE restriccion.cdg_restriccion = "AVISOF":
    FOR EACH evento WHERE periodo = pperiodo AND evento.origen = "CONTRATO" AND NOT evento.anulado, FIRST cliente OF evento:
        FIND contrato_restriccion WHERE contrato_restriccion.nro_contrato = evento.nro_identificacion AND
            contrato_restriccion.sub_evento = evento.sub_evento AND 
            contrato_restriccion.nro_restriccion = restriccion.nro_restriccion NO-ERROR.
        IF AVAILABLE contrato_restriccion THEN
            IF entry(3 , contrato_restriccion.valor , "|") = "E" AND avisoentregado(evento.nro_evento) THEN DO:
                DISPLAY "AVISADOS EN EL FUTURO" evento.nro_evento cliente.cdg_cliente.
                sigue = FALSE.
            END.
    END.
END.
MESSAGE "AVISADOS EN EL FUTURO ".
IF NOT sigue AND  FALSE THEN RETURN.

FOR EACH restriccion WHERE restriccion.cdg_restriccion = "AVISOF":
    FOR EACH evento WHERE periodo = pperiodo AND evento.origen = "CONTRATO" AND NOT evento.anulado, FIRST cliente OF evento:
        IF evento.sub_evento > 1  THEN NEXT.
        FIND contrato_restriccion WHERE contrato_restriccion.nro_contrato = evento.nro_identificacion AND
            contrato_restriccion.sub_evento = evento.sub_evento AND 
            contrato_restriccion.nro_restriccion = restriccion.nro_restriccion NO-ERROR.
        IF NOT AVAILABLE contrato_restriccion AND avisoentregado(evento.nro_evento) THEN DO:
            DISPLAY "ESTA AVISADO y NO TIENE RESTRICCION AVISO" evento.nro_evento cliente.cdg_cliente.
                sigue = FALSE.
            END.
    END.
END.
MESSAGE "ESTA AVISADO y NO TIENE RESTRICCION AVISO".
IF NOT sigue AND  FALSE THEN RETURN.

/*Bloque partido*/
FOR EACH evento WHERE periodo = pperiodo AND evento.origen = "CONTRATO" AND 
       NOT evento.anulado AND
       evento.nro_evento_padre = 0 AND
       ( evento.fasignado<>? OR evento.bloqueado ):
    FIND cliente OF evento.
    FOR each bevento WHERE bevento.nro_evento_padre = evento.nro_evento AND NOT BEVENTO.ANULADO:
        IF (bevento.fasignado<>?) <> (evento.fasignado<>?) or
        bevento.bloqueado <> evento.bloqueado
        THEN
            DISPLAY "PADRE ASIGNADO SIN HIJO ASIGNADO" evento.nro_evento cliente.cdg_cliente BEVENTO.NRO_EVENTO.     END.
END.
MESSAGE "PADRE ASIGNADO SIN HIJO ASIGNADO".

/*Bloque partido hijo bloqueado o asignado sin el padre*/
FOR EACH evento WHERE periodo = pperiodo AND evento.origen = "CONTRATO" AND 
       NOT evento.anulado AND
       evento.nro_evento_padre <> 0 AND
       ( evento.fasignado<>? OR evento.bloqueado ):
    FIND cliente OF evento.
    FIND bevento WHERE bevento.nro_evento = evento.nro_evento_padre AND NOT BEVENTO.ANULADO NO-ERROR.
    IF AVAILABLE bevento THEN DO:
        IF (bevento.fasignado<>?) <> (evento.fasignado<>?) or
        bevento.bloqueado <> evento.bloqueado
        THEN
            DISPLAY "HIJO ASIGNADO SIN PADRE" evento.nro_evento cliente.cdg_cliente.
    END.
    ELSE
        DISPLAY "HIJO ASIGNADO NO EXISTE PADRE" evento.nro_evento cliente.cdg_cliente.



END.
MESSAGE "HIJO ASIGNADO SIN PADRE".


/*a resolver*/
/*bloquear todos contratos dentro del mismo bloque de un avisado y bloquea los eventos con lleva*/
FOR EACH restriccion WHERE restriccion.cdg_restriccion = "AVISOF":
    FOR EACH evento WHERE periodo = pperiodo AND evento.origen = "CONTRATO" AND NOT evento.anulado AND evento.fasignado<>?:
        FIND contrato_restriccion WHERE contrato_restriccion.nro_contrato = evento.nro_identificacion AND
            contrato_restriccion.sub_evento = evento.sub_evento AND 
            contrato_restriccion.nro_restriccion = restriccion.nro_restriccion NO-ERROR.
        IF AVAILABLE contrato_restriccion THEN
            IF entry(3,contrato_restriccion.valor,"|") = "L" THEN DO:
                evento.bloqueado = TRUE.
                FOR EACH bevento WHERE bevento.nro_evento_padre = evento.nro_evento AND
                            ROWID(bevento) <> ROWID(evento):
                    IF CAN-find( contrato_hd WHERE contrato_hd.nro_contrato = bevento.nro_identificacion AND
                        contrato_hd.fecha_baja = ? OR YEAR( contrato_hd.fecha_baja ) * 100 + MONTH( contrato_hd.fecha_baja ) >= evento.periodo AND
                        contrato_hd.anulado = FALSE ) THEN
                        bevento.bloqueado = TRUE.
                END.
                FOR EACH bevento WHERE bevento.nro_evento = evento.nro_evento_padre AND
                    ROWID(bevento) <> ROWID(evento):
                        IF CAN-find( contrato_hd WHERE contrato_hd.nro_contrato = bevento.nro_identificacion AND
                        contrato_hd.fecha_baja = ? OR YEAR( contrato_hd.fecha_baja ) * 100 + MONTH( contrato_hd.fecha_baja ) >= evento.periodo AND
                        contrato_hd.anulado = FALSE ) THEN
                        bevento.bloqueado = TRUE.
                END.
            END.
    END.
end.
MESSAGE "BLOQUEAR AVISOS EN EL BLOQUE".

/*matar los contratos caidos*/
FOR EACH evento WHERE periodo = pperiodo AND evento.origen = "CONTRATO" AND NOT evento.anulado:
    IF NOT CAN-find( contrato_hd WHERE contrato_hd.nro_contrato = evento.nro_identificacion AND
    contrato_hd.fecha_baja = ? OR YEAR( contrato_hd.fecha_baja ) * 100 + MONTH( contrato_hd.fecha_baja ) >= evento.periodo AND
    contrato_hd.anulado = FALSE ) THEN DO:
        evento.anulado = TRUE.
        evento.mobs = ( IF evento.mobs <> "" THEN evento.mobs + " " ELSE "" ) + "ANULADO EN CONSISTENCIA " + STRING(NOW) + " por: " + USERID("SIC").
    END.
END.
MESSAGE "ANULAR LOS CONTRATOS CAIDOS".
/*el resto eliminarlos para volver a generarlos*/
FOR EACH evento WHERE periodo = pperiodo AND not avisoentregado(evento.nro_evento) AND NOT frealizado<>? AND NOT bloqueado AND origen = "CONTRATO":             
    DELETE evento.
END.
MESSAGE "BORRAR EVENTOS".
OUTPUT CLOSE.
MESSAGE "FIN CORRIDA" VIEW-AS ALERT-BOX INFORMATION.


