    FOR EACH evento:
    
    IF evento.origen = "CONTRATO" THEN DO:
    FIND restriccion WHERE restriccion.nro_tipo_evento = evento.nro_tipo_evento AND restriccion.cdg_restriccion BEGINS "AVISO" NO-LOCK NO-ERROR.
    IF NOT AVAILABLE restriccion THEN NEXT.
    FIND contrato_restriccion WHERE contrato_restriccion.nro_contrato = INT(evento.nro_identificacion) AND
        contrato_restriccion.sub_evento = evento.sub_evento AND
        contrato_restriccion.nro_restriccion = restriccion.nro_restriccion NO-LOCK NO-ERROR.
    IF AVAILABLE contrato_restriccion THEN DO:
        IF entry(3,contrato_restriccion.valor,"|") = "L" THEN evento.entrega = 1.
    END.
END.
    END.
