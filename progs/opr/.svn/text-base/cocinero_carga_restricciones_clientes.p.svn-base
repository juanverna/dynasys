IMPORT STREAM inn UNFORMATTED registro.        
a1 = entry(1,registro,chr( 9 )).

FIND cliente WHERE cliente.cdg_cliente = a1 NO-LOCK NO-ERROR.
IF NOT AVAILABLE cliente THEN DO:
DISPLAY a1.
UNDO,NEXT.
END.
    /*diasem*/
    FIND restriccion no-lock WHERE restriccion.cdg_restriccion BEGINS "DIASsEM" AND restriccion.nro_tipo_evento = 13.
    a2 = entry(3,registro,chr( 9 )).
    IF a2 <> "" THEN DO:
        FIND cliente_restriccion OF cliente WHERE cliente_restriccion.nro_restriccion = restriccion.nro_restriccion NO-ERROR.
        IF NOT AVAILABLE cliente_restriccion THEN DO:
            CREATE cliente_restriccion.
            ASSIGN cliente_restriccion.nro_cliente = cliente.nro_cliente
                   cliente_restriccion.nro_restriccion = restriccion.nro_restriccion.
        END.
            cliente_restriccion.valor = entry(1,ENTRY(2,a2,"["),"]").
    END.
