DEFINE buffer bevento FOR evento.
DEFINE buffer baevento FOR evento.
find restriccion no-lock WHERE restriccion.cdg_restriccion BEGINS "AVISOF" AND
                  restriccion.nro_tipo_evento = 1.
FOR EACH evento WHERE evento.refevento <> 0 AND evento.periodo >= 201111 AND NOT anulado:
FIND bevento WHERE bevento.nro_evento = evento.refevento.
FIND FIRST contrato_restriccion WHERE contrato_restriccion.nro_contrato = bevento.nro_identificacion AND
                       contrato_restriccion.sub_evento = bevento.sub_evento AND 
                       contrato_restriccion.nro_restriccion = restriccion.nro_restriccion NO-LOCK NO-ERROR.
IF NOT AVAILABLE contrato_restriccion OR ENTRY(3 , contrato_restriccion.valor ,"|" ) <> "L" THEN NEXT.
/*evento aviso
 bevento evento*/
FOR EACH baevento where
         baevento.nro_tipo_evento = bevento.nro_tipo_evento AND
         baevento.nro_identificacion = bevento.nro_identificacion and
         baevento.sub_evento = 1 and
         NOT baevento.anulado AND
         baevento.frealizado = ? AND
         baevento.origen = bevento.origen AND
         baevento.fasignado > TODAY AND
         baevento.periodo < bevento.periodo AND
         ROWID(baevento) <> ROWID(bevento) BY baevento.fasignado DESC:
         LEAVE.
END.
IF NOT AVAILABLE baevento THEN NEXT.
    IF evento.fasignado = baevento.fasignado THEN
        evento.evsigue = baevento.nro_evento.
END.
