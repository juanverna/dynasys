DEFINE BUFFER orevento FOR evento.
FIND tipo_evento WHERE tipo_evento.cdg_tipo_evento = "AV".

find restriccion WHERE restriccion.cdg_restriccion BEGINS tipo_evento.origen AND
               restriccion.nro_tipo_evento = 1 .
FOR EACH evento WHERE evento.nro_tipo_evento = tipo_evento.nro_tipo_evento AND evento.frealizado = ? AND NOT evento.anulado AND evento.origen = "AVISO":
FIND FIRST contrato_restriccion WHERE contrato_restriccion.nro_contrato = evento.nro_identificacion AND
                   contrato_restriccion.sub_evento = evento.sub_evento AND 
                   contrato_restriccion.nro_restriccion = restriccion.nro_restriccion NO-LOCK NO-ERROR.
IF NOT AVAILABLE contrato_restriccion THEN NEXT.
IF ENTRY(3 , contrato_restriccion.valor ,"|" ) = "L" THEN DO:
FIND orevento WHERE orevento.nro_evento = evento.refevento.
DISPLAY evento.nro_evento orevento.nro_evento. 
DELETE evento.
RUN crea_aviso_evento.p ( ROWID(orevento) ).
