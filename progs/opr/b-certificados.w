&ANALYZE-SUSPEND _UIB-CODE-BLOCK _FUNCTION soloactivos B-table-Win 
FUNCTION soloactivos RETURNS LOGICAL
  ( valor AS logical ) :
/*------------------------------------------------------------------------------
  Purpose:  
    Notes:  
------------------------------------------------------------------------------*/
  soloactivos = valor.
  RUN adm-open-query.
  RETURN TRUE.   /* Function return value. */

END FUNCTION.

