/* ************************  Function Implementations ***************** */

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _FUNCTION restan B-table-Win 
FUNCTION restan RETURNS INTEGER
  ( /* parameter-definitions */ ) :
/*------------------------------------------------------------------------------
  Purpose:  
    Notes:  
------------------------------------------------------------------------------*/

  RETURN if certificados.nro_certificado <> 0 then 
       certificados.nro_Hasta - certificados.nro_certificado else certificados.nro_Hasta - certificados.nro_desde  + 1.   /* Function return value. */

END FUNCTION.

