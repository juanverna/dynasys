&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-open-query B-table-Win 
PROCEDURE local-open-query :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/
DEF VAR hp AS HANDLE NO-UNDO.
DEF VAR hcp AS CHAR NO-UNDO.

  /* Code placed here will execute PRIOR to standard behavior. */

RUN get-link-handle IN adm-broker-hdl
      ( INPUT THIS-PROCEDURE,
        INPUT "container-source",
        OUTPUT hcp ).
    hp = WIDGET-HANDLE(hcp).
    IF VALID-HANDLE(hp) THEN 
        nrotipo = dynamic-function("nrotipo" IN hp).
  /* Code placed here will execute PRIOR to standard behavior. */

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'open-query':U ) .

  /* Code placed here will execute AFTER standard behavior.    */

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE seleccionados B-table-Win 
PROCEDURE seleccionados :
/*------------------------------------------------------------------------------
  Purpose: Entrega la lista de todos los seleccionados    
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
DEFINE OUTPUT PARAMETER lista AS CHAR NO-UNDO.
DEF VAR i AS INT NO-UNDO.
lista = "".

DO i = 1 TO br_table:NUM-SELECTED-ROWS IN FRAME {&FRAME-NAME}:
    br_table:FETCH-SELECTED-ROW ( i ).
    lista = lista + "," + Recurso.cdg_recurso.
END.
lista = SUBSTR(lista,2).
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE seleccionar B-table-Win 
PROCEDURE seleccionar :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
DEFINE input PARAMETER lista AS CHAR NO-UNDO.
DEF VAR i AS INT NO-UNDO.

DO i = 1 TO NUM-ENTRIES(lista):
FIND recurso WHERE recurso.cdg_recurso = ENTRY(i,lista) NO-LOCK NO-ERROR.
    IF AVAILABLE recurso THEN DO:
      REPOSITION  br_table TO ROWID ROWID(recurso) .
      br_table:SELECT-FOCUSED-ROW() IN FRAME {&frame-NAME}.
    END.
END.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

