&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE adm-create-objects W-Win _ADM-CREATE-OBJECTS
PROCEDURE adm-create-objects :
/*------------------------------------------------------------------------------
  Purpose:     Create handles for all SmartObjects used in this procedure.
               After SmartObjects are initialized, then SmartLinks are added.
  Parameters:  <none>
------------------------------------------------------------------------------*/
  DEFINE VARIABLE adm-current-page  AS INTEGER NO-UNDO.

  RUN get-attribute IN THIS-PROCEDURE ('Current-Page':U).
  ASSIGN adm-current-page = INTEGER(RETURN-VALUE).

  CASE adm-current-page: 

    WHEN 0 THEN DO:
       RUN init-object IN THIS-PROCEDURE (
             INPUT  'b-reqpenap.r':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Layout = ':U ,
             OUTPUT h_b-reqpenap ).
       RUN set-position IN h_b-reqpenap ( 2.00 , 3.00 ) NO-ERROR.
       /* Size in UIB:  ( 7.50 , 84.00 ) */

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'v-reqpenap.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Layout = ':U ,
             OUTPUT h_v-reqpenap ).
       RUN set-position IN h_v-reqpenap ( 9.75 , 3.00 ) NO-ERROR.
       /* Size in UIB:  ( 5.50 , 84.00 ) */

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'p-editar.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Edge-Pixels = 2,
                     SmartPanelType = Update-Trans,
                     AddFunction = One-Record':U ,
             OUTPUT h_p-editar ).
       RUN set-position IN h_p-editar ( 15.50 , 3.00 ) NO-ERROR.
       RUN set-size IN h_p-editar ( 1.78 , 69.00 ) NO-ERROR.

       /* Links to SmartViewer h_v-reqpenap. */
       RUN add-link IN adm-broker-hdl ( h_b-reqpenap , 'Record':U , h_v-reqpenap ).
       RUN add-link IN adm-broker-hdl ( h_p-editar , 'TableIO':U , h_v-reqpenap ).

       /* Adjust the tab order of the smart objects. */
       RUN adjust-tab-order IN adm-broker-hdl ( h_b-reqpenap ,
             Btn_Done-2:HANDLE IN FRAME F-Main , 'BEFORE':U ).
       RUN adjust-tab-order IN adm-broker-hdl ( h_v-reqpenap ,
             h_b-reqpenap , 'AFTER':U ).
       RUN adjust-tab-order IN adm-broker-hdl ( h_p-editar ,
             h_v-reqpenap , 'AFTER':U ).
    END. /* Page 0 */

  END CASE.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


