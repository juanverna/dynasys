DEFINE VARIABLE ver_por AS INTEGER LABEL "Ordenado Por" VIEW-AS RADIO-SET 
                HORIZONTAL RADIO-BUTTONS "Codigo",  1 , "Nombre", 0 INITIAL 0.

DEFINE VARIABLE des_novedad LIKE Novedad.cdg_novedad LABEL "Desde Novedad".
DEFINE VARIABLE has_novedad LIKE Novedad.cdg_novedad LABEL "Hasta Novedad".
DEFINE VARIABLE des_nombre  LIKE Novedad.descripcion.
DEFINE VARIABLE has_nombre  LIKE Novedad.descripcion.