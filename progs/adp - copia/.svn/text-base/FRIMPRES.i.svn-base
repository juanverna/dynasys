FORM 
    SPACE(3)
    Impresora.cdg_impresora FGCOLOR fe_c BGCOLOR be_c
    Impresora.nombre        FGCOLOR fe_c BGCOLOR be_c
    Impresora.puerto        FGCOLOR fe_c BGCOLOR be_c
    brw_impresora AT ROW 2 COL 1     
    SPACE(3) ver
    brw_list      AT ROW 2 COL 1 
    SKIP(0.5)
    SPACE(5) BTN_GRABAR SPACE(2) BTN_CANCEL SPACE(2)
             BTN_BAJA   SPACE(2) BTN_OBSERV SPACE(2) 
             BTN_IMPRIM SPACE(2) BTN_SALIR
    SKIP(0.1) 
    rtn_botones AT ROW 1.0 COL 1.1
    WITH CENTERED AT ROW 1 COL 1 1 DOWN 
         TITLE FONT 9 "Datos de la Impresora" THREE-D
         SIDE-LABELS  FGCOLOR f-fg_c BGCOLOR f-bg_c FONT 9
         FRAME frm-impresora OVERLAY.
