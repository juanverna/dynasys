       RUN set-position IN h_p-updspa-7 ( 23.38 , 29.00 ) NO-ERROR.
       RUN set-size IN h_p-updspa-7 ( 2.38 , 126.00 ) NO-ERROR.

       /* Links to SmartViewer h_v-que_articulo-6. */
       RUN add-link IN adm-broker-hdl ( h_b-articulo , 'Record':U , h_v-que_articulo-6 ).

       /* Links to SmartBrowser h_b-articulo_atributo. */
