       RUN adjust-tab-order IN adm-broker-hdl ( h_p-updspa-6 ,
             h_v-alias_cliente , 'AFTER':U ).
    END. /* Page 8 */
    WHEN 9 THEN DO:
       RUN init-object IN THIS-PROCEDURE (
             INPUT  'v-que_articulo.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Layout = ':U ,
             OUTPUT h_v-que_articulo-7 ).
       RUN set-position IN h_v-que_articulo-7 ( 2.67 , 45.00 ) NO-ERROR.
       /* Size in UIB:  ( 1.67 , 94.00 ) */

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'v-articulo_documental.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Layout = ':U ,
             OUTPUT h_v-articulo_documental ).
       RUN set-position IN h_v-articulo_documental ( 4.57 , 29.00 ) NO-ERROR.
       /* Size in UIB:  ( 18.81 , 125.00 ) */

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'p-soloedita.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Edge-Pixels = 2,
                     SmartPanelType = Update-Trans,
                     AddFunction = One-Record':U ,
             OUTPUT h_p-soloedita-2 ).
       RUN set-position IN h_p-soloedita-2 ( 23.86 , 30.00 ) NO-ERROR.
       RUN set-size IN h_p-soloedita-2 ( 1.76 , 125.00 ) NO-ERROR.

       /* Links to SmartViewer h_v-que_articulo-7. */
