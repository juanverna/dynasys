       /* Links to SmartViewer h_v-articulo_documental. */
       RUN add-link IN adm-broker-hdl ( h_b-articulo , 'Record':U , h_v-articulo_documental ).
       RUN add-link IN adm-broker-hdl ( h_p-soloedita-2 , 'TableIO':U , h_v-articulo_documental ).

       /* Adjust the tab order of the smart objects. */
       RUN adjust-tab-order IN adm-broker-hdl ( h_v-que_articulo-7 ,
             h_folder , 'AFTER':U ).
       RUN adjust-tab-order IN adm-broker-hdl ( h_v-articulo_documental ,
