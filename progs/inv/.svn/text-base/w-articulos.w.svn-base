       RUN add-link IN adm-broker-hdl ( h_p-updspa-6 , 'TableIO':U , h_v-alias_cliente ).

       /* Adjust the tab order of the smart objects. */
       RUN adjust-tab-order IN adm-broker-hdl ( h_v-que_articulo-5 ,
             h_folder , 'AFTER':U ).
       RUN adjust-tab-order IN adm-broker-hdl ( h_b-alias_cliente ,
