FIND Usuario WHERE cdg_usuario = "carlos".
CREATE autoriza_transaccion.
ASSIGN Autoriza_transaccion.nro_usuario = Usuario.nro_usuario
       Autoriza_transaccion.cdg_comprobante = ""
       Autoriza_transaccion.cdg_empresa = "M"
       Autoriza_transaccion.cdg_estado_final = "IR"
       Autoriza_transaccion.cdg_estado_inicial = "AA"
       Autoriza_transaccion.importe_limite = 0 
       Autoriza_transaccion.rige_desde = 01/01/2005
       Autoriza_transaccion.rige_hasta = 12/31/2199
       Autoriza_transaccion.tabla_comprobante = "Ped_header".
