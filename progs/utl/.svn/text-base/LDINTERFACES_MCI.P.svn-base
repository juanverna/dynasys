              + STRING(DCC_TRA.INT-DCC-NROREM, "9999999999999999")
              + STRING(DCC_TRA.INT-DCC-CONPGO, "99999999").
        PUT lineadcct
            SKIP.
  END.
OUTPUT CLOSE.

que_archivo = dire_tmp + "xcc." + archivo.
OUTPUT TO VALUE(que_archivo).

FOR EACH XCC_TRA:
 lineaxcct = STRING(XCC_TRA.INT-XCC-CENFAC, "9999999999")
           + STRING(XCC_TRA.INT-XCC-CODDOC, "999999999")
           + STRING(XCC_TRA.INT-XCC-NUMDOC, "99999999999999")
           + STRING(XCC_TRA.INT-XCC-CODEMP, "99999999")
           + CONVIERTE(XCC_TRA.INT-XCC-IMPGRAS, "-9999999999999999.99")
           + CONVIERTE(XCC_TRA.INT-XCC-IMPNGRS, "-9999999999999999.99")
           + CONVIERTE(XCC_TRA.INT-XCC-IMPPRO,  "-9999999999999999.99")
           + CONVIERTE(XCC_TRA.INT-XCC-IMPBON,  "-9999999999999999.99")
           + CONVIERTE(XCC_TRA.INT-XCC-IMPBOI,  "-9999999999999999.99")
           + CONVIERTE(XCC_TRA.INT-XCC-IMPPIN,  "-9999999999999999.99")
           + CONVIERTE(XCC_TRA.INT-XCC-IMPBOP,  "-9999999999999999.99")
           + CONVIERTE(XCC_TRA.INT-XCC-IMPPRP,  "-9999999999999999.99")
           + CONVIERTE(XCC_TRA.INT-XCC-GRABON,  "-9999999999999999.99")
           + CONVIERTE(XCC_TRA.INT-XCC-NGRBON,  "-9999999999999999.99").
        PUT
            lineaxcct
            SKIP.
END.
OUTPUT CLOSE.

que_archivo = dire_tmp + "zcc." + archivo.
OUTPUT TO VALUE(que_archivo).
FOR EACH ZCC_TRA:
  lineazcct = STRING(ZCC_TRA.INT-ZCC-CODDOC, "999999999")
            + STRING(ZCC_TRA.INT-ZCC-CENFAC, "9999999999")
            + STRING(ZCC_TRA.INT-ZCC-NUMDOC, "99999999999999")
            + STRING(ZCC_TRA.INT-ZCC-NROPRO, "9999999999")
            + STRING(ZCC_TRA.INT-ZCC-CODSAB, "99999999")            
            + REPLACE(STRING(ZCC_TRA.INT-ZCC-CANFAC, "9999999999999.999"), "." , ",")
            + REPLACE(STRING(ZCC_TRA.INT-ZCC-CANCGA, "9999999999999.999"), "." , ",")
            + REPLACE(STRING(ZCC_TRA.INT-ZCC-PREUNI, "9999999999999.999"), "." , ",")            
            + CONVIERTE(ZCC_TRA.INT-ZCC-IMBOIN, "-9999999999999.999")
            + CONVIERTE(ZCC_TRA.INT-ZCC-IMBODE, "-9999999999999.999")
            + CONVIERTE(ZCC_TRA.INT-ZCC-IMBOTO, "-9999999999999.999")
            + CONVIERTE(ZCC_TRA.INT-ZCC-IMPRIN, "-9999999999999.999")
            + CONVIERTE(ZCC_TRA.INT-ZCC-IMPRDE, "-9999999999999.999")
            + CONVIERTE(ZCC_TRA.INT-ZCC-IMPRTO, "-9999999999999.999")
            + STRING(ZCC_TRA.INT-ZCC-CODEMP, "99999999")
            + STRING(ZCC_TRA.INT-ZCC-ORDVL1, "9999999999")
            + STRING(ZCC_TRA.INT-ZCC-ORDVL3, "9999999999")
            + REPLACE(STRING(ZCC_TRA.INT-ZCC-PORIVA, "999999999.999"), "." , ",")
            + STRING(ZCC_TRA.INT-ZCC-CODCTO, "9999999999")
            + CONVIERTE(ZCC_TRA.INT-ZCC-TOGRAV, "-9999999999999999.99")
            + CONVIERTE(ZCC_TRA.INT-ZCC-TONEFA, "-9999999999999999.99")
            + CONVIERTE(ZCC_TRA.INT-ZCC-TOTIVA, "-9999999999999999.99").
        PUT
            lineazcct
            SKIP.
END.
OUTPUT CLOSE.

que_archivo = dire_tmp + "scm." + archivo.
OUTPUT TO VALUE(que_archivo).

FOR EACH SCM_TRA:
 lineascmt = STRING(SCM_TRA.INT-SCM-CODGEN, "9999999")
           + STRING(SCM_TRA.INT-SCM-AMNDOP, "999999999999")
           + STRING(SCM_TRA.INT-SCM-PLADEP, "9999999999")
           + STRING(SCM_TRA.INT-SCM-CODDOC, "999999999")
           + STRING(SCM_TRA.INT-SCM-FECDOC, "99999999999999")
           + REPLACE(STRING(SCM_TRA.INT-SCM-IMPNGR, "9999999999999999.99"), "." , ",")
           + REPLACE(STRING(SCM_TRA.INT-SCM-IMPGRA, "9999999999999999.99"), "." , ",")
           + REPLACE(STRING(SCM_TRA.INT-SCM-IMPIVI, "9999999999999999.99"), "." , ",")
           + REPLACE(STRING(SCM_TRA.INT-SCM-IMPIVN, "9999999999999999.99"), "." , ",")
           + REPLACE(STRING(SCM_TRA.INT-SCM-IMPEIV, "9999999999999999.99"), "." , ",")
           + REPLACE(STRING(SCM_TRA.INT-SCM-IMPEIB, "9999999999999999.99"), "." , ",")
           + STRING(SCM_TRA.INT-SCM-TIPCLI, "99999999")
           + CONVIERTE(SCM_TRA.INT-SCM-IMPBON, "-9999999999999999.99")
           + CONVIERTE(SCM_TRA.INT-SCM-GRAILC, "-9999999999999999.99")
           + CONVIERTE(SCM_TRA.INT-SCM-GRAMAS, "-9999999999999999.99")
           + CONVIERTE(SCM_TRA.INT-SCM-NGRILC, "-9999999999999999.99")
           + CONVIERTE(SCM_TRA.INT-SCM-NGRMAS, "-9999999999999999.99")
           + CONVIERTE(SCM_TRA.INT-SCM-PROILC, "-9999999999999999.99")
           + CONVIERTE(SCM_TRA.INT-SCM-PROMAS, "-9999999999999999.99")
           + CONVIERTE(SCM_TRA.INT-SCM-BONILC, "-9999999999999999.99")
           + CONVIERTE(SCM_TRA.INT-SCM-BONMAS, "-9999999999999999.99")
           + CONVIERTE(SCM_TRA.INT-SCM-IMPBOI, "-9999999999999999.99")
           + CONVIERTE(SCM_TRA.INT-SCM-IMPBOM, "-9999999999999999.99")
           + CONVIERTE(SCM_TRA.INT-SCM-IMPPRI, "-9999999999999999.99")
           + CONVIERTE(SCM_TRA.INT-SCM-IMPPRM, "-9999999999999999.99")
           + REPLACE(STRING(SCM_TRA.INT-SCM-IMPEIVX, "9999999999999999.99"), "." , ",").
                      
        PUT
            lineascmt
            SKIP.
END.
OUTPUT CLOSE.

que_archivo = dire_tmp + "asc." + archivo.
OUTPUT TO VALUE(que_archivo).
FOR EACH ASCC_TRA:
  lineaasct = STRING(ASCC_TRA.INT-ASCC-CODGEN, "9999999")
            + STRING(ASCC_TRA.INT-ASCC-AMNDOP, "999999999999")
            + STRING(ASCC_TRA.INT-ASCC-PLADEP, "9999999999")
            + STRING(ASCC_TRA.INT-ASCC-CODDOC, "999999999")
            + STRING(ASCC_TRA.INT-ASCC-FECDOC, "99999999999999")
            + STRING(ASCC_TRA.INT-ASCC-CODPRO, "99999999")
            + REPLACE(STRING(ASCC_TRA.INT-ASCC-IMPEIB, "9999999999999999.99"), "." , ",").
        PUT
            lineaasct
            SKIP.
END.
OUTPUT CLOSE.

END PROCEDURE.


/* __________________________________________________________________________________________________________*/
/*                                                                                                           */
/*                                           funciones                                                       */
/* __________________________________________________________________________________________________________*/

FUNCTION CONVIERTE RETURNS CHARACTER. 
DEFINE VARIABLE Dato AS CHARACTER.

    IF parm1 < 0 then Dato = REPLACE(STRING(parm1, parm2), "." , ",").
    ELSE Dato = REPLACE(REPLACE(STRING(parm1, parm2), "." , ","), " ", "+").

    RETURN (Dato). 
    
END FUNCTION.    



