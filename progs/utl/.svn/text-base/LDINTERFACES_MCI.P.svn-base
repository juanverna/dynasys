DO TRANSACTION:
    RUN GENERA.
    RUN BAJA.
END.


/* __________________________________________________________________________________________________________*/
/*                                                                                                           */
/*                                           procedimientos                                                  */
/* __________________________________________________________________________________________________________*/

PROCEDURE GENERA:

    FOR EACH Fac_header EXCLUSIVE-LOCK
        WHERE NOT Fac_header.proc_estad
          AND Fac_header.fecha >= des_fecha
          AND Fac_header.fecha <= has_fecha
          AND Fac_header.cdg_empresa = cempresa,
                        FIRST Tipocomprobante OF Fac_header WHERE Tipocomprobante.afecta_stock,
        FIRST Cliente OF Fac_header, FIRST Grupo-empresario OF CLiente WHERE Grupo-empresario.viaja_estadisticas,
        FIRST Comprobante_concepto WHERE Comprobante_concepto.cdg_imputacion = Fac_header.cdg_imputacion
                                    AND Comprobante_concepto.cdg_comprobante = Tipocomprobante.cdg_comprobante
                                    AND Comprobante_concepto.codigo_mci <> 0:

      FIND Cta_cte OF Cliente WHERE Fac_header.tip_comprob = Cta_cte.tip_comprob
                                AND Fac_header.prf_comprob = Cta_cte.prf_comprob
                                AND Fac_header.nro_comprob = Cta_cte.nro_comprob
                                AND Fac_header.cdg_empresa = Cta_cte.cdg_empresa NO-LOCK NO-ERROR.
      FIND Domicilio OF cliente WHERE Domicilio.nro_domicilio = Fac_header.nro_domicilio NO-ERROR.
      FIND Provincia OF Domicilio NO-ERROR.
      FIND Rem_header WHERE Rem_header.nro_remito =  Fac_header.nro_remito NO-ERROR.
      IF AVAILABLE Rem_header THEN FIND Ped_header WHERE Ped_header.nro_pedido =  Rem_header.nro_pedido NO-ERROR.

      IMPIVI = 0. /* recorro la tabla de impuestos del comprobante y verifico si el mismo es_IVA*/
      IMPIVN = 0. /* considero que no existen NO INSCRIPTO*/
      IMPEIV = 0. /* recorro la tabla de impuestos del comprobante y verifico si NO es_IVA y es un impuesto nacional   => Perc. Iva */
      IMPEIB = 0. /* recorro la tabla de impuestos del comprobante y verifico si NO es_IVA y es un impuesto provincial => Perc. IBrutos */
      IMPGRA = 0.
      GRAPIV = 0.
      IMPNGR = 0.
      xx = 0.

      FOR EACH Fac_header_impuesto OF Fac_header:
          FIND Impuesto OF Fac_header_impuesto NO-ERROR.
          IF Impuesto.es_iva
          THEN DO:
               IMPIVI = IMPIVI + Fac_header_impuesto.importe.
               IMPGRA = IMPGRA + Fac_header_impuesto.monto_imponible.
          END.
          ELSE DO:
              IF Impuesto.nivel = 0
              THEN DO:
                   IMPEIV = IMPEIV +  Fac_header_impuesto.importe.
                   /*GRAPIV = GRAPIV +  Fac_header_impuesto.monto_imponible.*/
              END.
              ELSE IMPEIB = IMPEIB +  Fac_header_impuesto.importe.
          END.
          xx = xx + Fac_header_impuesto.importe.
      END.
      GRAPIV = IMPGRA. /* POR ORDEN DE SANDRA */

      codgen = IF SUBSTRING(Fac_header.tip_comprob,2,1) = "I" THEN 3 ELSE 5.
      FIND ASCC WHERE ASCC.INT-ASCC-CODGEN = codgen
                  AND ASCC.INT-ASCC-CODDOC = Comprobante_concepto.codigo_mci
                  AND ASCC.INT-ASCC-FECDOC = YEAR(Fac_header.fecha) * 10000 + MONTH(Fac_header.fecha) * 100 + DAY(Fac_header.fecha)
                  AND ASCC.INT-ASCC-CODPRO = INT(Provincia.cdg_provincia) NO-ERROR.
      IF NOT AVAILABLE ASCC
      THEN DO:
          CREATE ASCC.
          ASSIGN ASCC.INT-ASCC-CODGEN = codgen
                 ASCC.INT-ASCC-CODDOC = Comprobante_concepto.codigo_mci
                 ASCC.INT-ASCC-FECDOC = YEAR(Fac_header.fecha) * 10000 + MONTH(Fac_header.fecha) * 100 + DAY(Fac_header.fecha)
                 ASCC.INT-ASCC-CODPRO = INT(Provincia.cdg_provincia)
                 ASCC.INT-ASCC-AMNDOP = YEAR(Fac_header.fecha) * 100 + MONTH(Fac_header.fecha)
                 ASCC.INT-ASCC-PLADEP = 37.
      END.
      ASSIGN ASCC.INT-ASCC-IMPEIB = ASCC.INT-ASCC-IMPEIB + IMPEIB.
      IF xx = 0 THEN IMPNGR  = Fac_header.imp_neto.
      ELSE DO:
          IF Fac_header.imp_neto > IMPGRA
              THEN IMPNGR  =  Fac_header.imp_neto - IMPGRA.
      END.

      CREATE DCC.
      ASSIGN DCC.INT-DCC-CENFAC     = Fac_header.prf_comprob
             DCC.INT-DCC-CODDOC     = Comprobante_concepto.codigo_mci
             DCC.INT-DCC-LETIVA     = SUBSTRING(Fac_header.tip_comprob,2,1)
             DCC.INT-DCC-NUMDOC     = Fac_header.nro_comprob
             DCC.INT-DCC-FECING     = YEAR(Fac_header.fecha) * 10000 + MONTH(Fac_header.fecha) * 100 + DAY(Fac_header.fecha)
             DCC.INT-DCC-NRGUIA     = 0
             DCC.INT-DCC-CODGEN     = IF SUBSTRING(Fac_header.tip_comprob,2,1) = "I" THEN 3 ELSE 5
             DCC.INT-DCC-PLADEP     = 37
             DCC.INT-DCC-FECDOC     = YEAR(Fac_header.fecha) * 10000 + MONTH(Fac_header.fecha) * 100 + DAY(Fac_header.fecha)
             DCC.INT-DCC-NROCLI     = INTEGER(Cliente.cdg_cliente)
             DCC.INT-DCC-NROSUC     = Domicilio.nro_domicilio WHEN AVAILABLE Domicilio
             DCC.INT-DCC-CFDORI     = 0
             DCC.INT-DCC-CODDOR     = 0
             DCC.INT-DCC-LETIVO     = SUBSTRING(Fac_header.tip_comprob,2,1)
             DCC.INT-DCC-NUMDOR     = 0
             DCC.INT-DCC-FEVEFA     = IF AVAILABLE Cta_cte THEN YEAR(Cta_cte.fecha_vencimiento) * 10000 + MONTH(Cta_cte.fecha_vencimiento) * 100 + DAY(Cta_cte.fecha_vencimiento)
                                                           ELSE YEAR(Fac_header.fecha) * 10000 + MONTH(Fac_header.fecha) * 100 + DAY(Fac_header.fecha)
             DCC.INT-DCC-FEVERE     = IF AVAILABLE Cta_cte THEN YEAR(Cta_cte.fecha_vencimiento) * 10000 + MONTH(Cta_cte.fecha_vencimiento) * 100 + DAY(Cta_cte.fecha_vencimiento)
                                                           ELSE YEAR(Fac_header.fecha) * 10000 + MONTH(Fac_header.fecha) * 100 + DAY(Fac_header.fecha)
             DCC.INT-DCC-NROFLE     = 9999
             DCC.INT-DCC-NROREP     = 37
             DCC.INT-DCC-HORING     = 0
             DCC.INT-DCC-FEVILP     = 0
             DCC.INT-DCC-IMPIVI     = IMPIVI
             DCC.INT-DCC-IMPIVN     = IMPIVN
             DCC.INT-DCC-IMPGRA     = IMPGRA
             DCC.INT-DCC-IMPNGR     = IMPNGR
             DCC.INT-DCC-IMPEIV     = IMPEIV
             DCC.INT-DCC-IMPEIB     = IMPEIB
             DCC.INT-DCC-IMPBON     = IMPBON
             DCC.INT-DCC-NROPED     = Ped_header.nro_comprob WHEN AVAILABLE Ped_header
             DCC.INT-DCC-FEINCO     = 0
             DCC.INT-DCC-CODZVT     = IF NUM-ENTRIES(Domicilio.cdg_subclasezng,".") >= 4 THEN INT(ENTRY(4,Domicilio.cdg_subclasezng,".")) ELSE 0
             DCC.INT-DCC-TIPCLI     = INT(Cliente.cdg_famclie)
             DCC.INT-DCC-FECCON     = 0
             DCC.INT-DCC-HORCON     = 0
             DCC.INT-DCC-CODACT     = INT(Cliente.cdg_tipoclie)
             DCC.INT-DCC-FECPCL     = YEAR(Ped_header.fecha) * 10000 + MONTH(Ped_header.fecha) * 100 + DAY(Ped_header.fecha) WHEN AVAILABLE Ped_header
             DCC.INT-DCC-MARLIQ     = ""
             DCC.INT-DCC-CODPRO     = INT(Provincia.cdg_provincia)
             DCC.INT-DCC-NROLEG     = 0
             DCC.INT-DCC-LEGAJO-MOD = 0
             DCC.INT-DCC-LETEXT     = ""
             DCC.INT-DCC-SUCEXT     = 0
             DCC.INT-DCC-NUMEXT     = 0
             DCC.INT-DCC-PERREF     = 0
             DCC.INT-DCC-MARDEP     = ""
             DCC.INT-DCC-GRAILC     = 0
             DCC.INT-DCC-GRAMAS     = 0
             DCC.INT-DCC-NGRILC     = 0
             DCC.INT-DCC-NGRMAS     = 0
             DCC.INT-DCC-BONILC     = 0
             DCC.INT-DCC-BONMAS     = 0
             DCC.INT-DCC-PROILC     = 0
             DCC.INT-DCC-PROMAS     = 0
             DCC.INT-DCC-IMPBOI     = 0
             DCC.INT-DCC-IMPBOM     = 0
             DCC.INT-DCC-IMPPRI     = 0
             DCC.INT-DCC-IMPPRM     = 0
             DCC.INT-DCC-IMPMUL     = 0
             DCC.INT-DCC-GRAPIV     = GRAPIV
             DCC.INT-DCC-TERRIT     = IF NUM-ENTRIES(Domicilio.cdg_subclasezng,".") >= 4 THEN INT(ENTRY(4,Domicilio.cdg_subclasezng,".")) ELSE 0
             DCC.INT-DCC-NROREM     = Rem_header.nro_comprob WHEN AVAILABLE Rem_header
             DCC.INT-DCC-CONPGO     = Fac_header.nro_cndventa.


/*       IF Tipocomprobante.debita THEN sig =  1. */
/*                                 ELSE sig = -1. */

      FIND SCM WHERE SCM.INT-SCM-CODGEN = DCC.INT-DCC-CODGEN
                 AND SCM.INT-SCM-CODDOC = DCC.INT-DCC-CODDOC
                 AND SCM.INT-SCM-FECDOC = DCC.INT-DCC-FECDOC
                 AND SCM.INT-SCM-LETIVA = DCC.INT-DCC-LETIVA
                 AND SCM.INT-SCM-TIPCLI = DCC.INT-DCC-TIPCLI NO-ERROR.
      IF NOT AVAILABLE SCM
      THEN DO:
            CREATE SCM.
            ASSIGN SCM.INT-SCM-CODGEN = DCC.INT-DCC-CODGEN
                   SCM.INT-SCM-AMNDOP = YEAR(Fac_header.fecha) * 100 + MONTH(Fac_header.fecha)
                   SCM.INT-SCM-CODDOC = DCC.INT-DCC-CODDOC
                   SCM.INT-SCM-FECDOC = DCC.INT-DCC-FECDOC
                   SCM.INT-SCM-LETIVA = DCC.INT-DCC-LETIVA
                   SCM.INT-SCM-TIPCLI = DCC.INT-DCC-TIPCLI.

      END.
      ASSIGN SCM.INT-SCM-IMPIVI   = SCM.INT-SCM-IMPIVI + sig * IMPIVI
             SCM.INT-SCM-IMPIVN   = SCM.INT-SCM-IMPIVN + sig * IMPIVN
             SCM.INT-SCM-IMPEIV   = SCM.INT-SCM-IMPEIV + sig * IMPEIV
             SCM.INT-SCM-IMPEIB   = SCM.INT-SCM-IMPEIB + sig * IMPEIB
             SCM.INT-SCM-IMPEIVX  = 0. /* TODAVÍA NO LO TENGO DEFINIDO*/

      FIND Imputacion OF Fac_header.
      FOR EACH Fac_detalle OF Fac_header:
            FIND Articulo OF Fac_detalle.
            FIND Familia_impositiva OF Articulo.
            FIND Articulo_Propiedad OF Articulo NO-ERROR.

            CREATE ZCC.
            ASSIGN ZCC.INT-ZCC-CODDOC = Comprobante_concepto.codigo_mci
                   ZCC.INT-ZCC-CENFAC = Fac_header.prf_comprob
                   ZCC.INT-ZCC-LETIVA = SUBSTRING(Fac_header.tip_comprob,2,1)
                   ZCC.INT-ZCC-NUMDOC = Fac_header.nro_comprob
                   ZCC.INT-ZCC-NROPRO = INTEGER(SUBSTRING(Articulo.cdg_articulo,4,6))
                   ZCC.INT-ZCC-CODSAB = INT(Articulo_Propiedad.cdg_propiedad) WHEN AVAILABLE Articulo_Propiedad
                   ZCC.INT-ZCC-CANFAC = Fac_detalle.cantidad
                   ZCC.INT-ZCC-PREUNI = Fac_detalle.precio.


            FIND Articulo-Proveedor WHERE Articulo-Proveedor.nro_articulo = Fac_detalle.nro_articulo
                                      AND Fac_header.fecha <= Articulo-Proveedor.a_fecha NO-ERROR.
            IF AVAILABLE Articulo-Proveedor
            THEN FIND Proveedor WHERE Proveedor.nro_proveedor = Articulo-Proveedor.nro_proveedor.
            ELSE FIND Proveedor WHERE Proveedor.nro_proveedor = 1.
            
            ZCC.INT-ZCC-CODEMP = INT(Proveedor.cdg_proveedor).
            FIND XCC WHERE XCC.INT-XCC-CENFAC = Fac_header.prf_comprob
                       AND XCC.INT-XCC-LETIVA = SUBSTRING(Fac_header.tip_comprob,2,1)
                       AND XCC.INT-XCC-NUMDOC = Fac_header.nro_comprob
                       AND XCC.INT-XCC-CODEMP = INT(Proveedor.cdg_proveedor) NO-ERROR.
            IF NOT AVAILABLE XCC
            THEN DO:
                CREATE XCC.
                ASSIGN XCC.INT-XCC-CENFAC = Fac_header.prf_comprob
                       XCC.INT-XCC-CODDOC = Comprobante_concepto.codigo_mci
                       XCC.INT-XCC-LETIVA = SUBSTRING(Fac_header.tip_comprob,2,1)
                       XCC.INT-XCC-NUMDOC = Fac_header.nro_comprob
                       XCC.INT-XCC-CODEMP = int(Proveedor.cdg_proveedor).
            END.
            FIND FIRST Fac_detalle_impuesto OF Fac_detalle NO-ERROR.
            IF AVAILABLE Fac_detalle_impuesto
            THEN DO:
                IF INT(Proveedor.cdg_proveedor) = 1
                THEN SCM.INT-SCM-GRAMAS = SCM.INT-SCM-GRAMAS + sig * Fac_detalle.subtotal_neto.
                ELSE SCM.INT-SCM-GRAILC = SCM.INT-SCM-GRAILC + sig * Fac_detalle.subtotal_neto.
                SCM.INT-SCM-IMPGRA  = SCM.INT-SCM-IMPGRA + sig * Fac_detalle.subtotal_neto.
                XCC.INT-XCC-IMPGRAS = XCC.INT-XCC-IMPGRAS + sig * Fac_detalle.subtotal_neto.
            END.
            ELSE DO:
                IF AVAILABLE Proveedor AND INT(Proveedor.cdg_proveedor) = 1
                THEN SCM.INT-SCM-NGRMAS = SCM.INT-SCM-NGRMAS + sig * Fac_detalle.subtotal_neto.
                ELSE SCM.INT-SCM-NGRILC = SCM.INT-SCM-NGRILC + sig * Fac_detalle.subtotal_neto.
                SCM.INT-SCM-IMPNGR  = SCM.INT-SCM-IMPNGR + sig * Fac_detalle.subtotal_neto.
                XCC.INT-XCC-IMPNGRS = XCC.INT-XCC-IMPNGRS + sig * Fac_detalle.subtotal_neto.
            END.

            FOR EACH Fac_detalle_impuesto OF Fac_detalle:
               FIND Impuesto WHERE Impuesto.cdg_impuesto = Fac_detalle_impuesto.cdg_impuesto.
               IF Impuesto.es_iva
               THEN DO:
                    ZCC.INT-ZCC-INDIVA = "S".
                    ZCC.INT-ZCC-PORIVA = Fac_detalle_impuesto.tasa.
                    xx = Fac_detalle_impuesto.importe.
                    IF Imputacion.afecta_stock 
                    THEN ZCC.INT-ZCC-TOTIVA = ZCC.INT-ZCC-TOTIVA + sig * xx.                    
               END.
            END.
            IF Comprobante_concepto.codigo_mci = 614
            THEN DO:
                ZCC.INT-ZCC-TOGRAV = ZCC.INT-ZCC-TOGRAV + Fac_detalle.precio.
                ZCC.INT-ZCC-TONEFA = ZCC.INT-ZCC-TONEFA + Fac_detalle.precio + xx.
            END.
            ELSE DO:
                IF Imputacion.afecta_stock 
                THEN DO:
                    IF Fac_header.tip_comprob MATCHES "*A*" 
                    THEN DO:
                        ZCC.INT-ZCC-TONEFA = ZCC.INT-ZCC-TONEFA + sig * Fac_detalle.subtotal_neto.
                        ZCC.INT-ZCC-TOGRAV = ZCC.INT-ZCC-TOGRAV + (Fac_detalle.precio *  10).
                    END.
                    ELSE DO:
                        IF Fac_header.tip_comprob MATCHES "*B*" 
                        THEN DO:
                            IF  Familia_impositiva.cdg_familimpos = "2" 
                            THEN DO:
                                ZCC.INT-ZCC-TONEFA = ZCC.INT-ZCC-TONEFA + sig * Fac_detalle.subtotal_neto.
                                ZCC.INT-ZCC-TOGRAV = ZCC.INT-ZCC-TOGRAV + (Fac_detalle.precio *  10).
                            END.
                            ELSE DO:
                                ZCC.INT-ZCC-TONEFA = ZCC.INT-ZCC-TONEFA + sig * Fac_detalle.subtotal_neto_cf.
                                ZCC.INT-ZCC-TOGRAV = ZCC.INT-ZCC-TOGRAV + (Fac_detalle.precio_cf *  10).
                            END.
                        END.
                    END.
                END.
                ELSE ZCC.INT-ZCC-TOGRAV = ZCC.INT-ZCC-TOGRAV + Fac_detalle.precio.            
            END.
            FOR EACH Fac_detalle-bon OF Fac_detalle:
               XCC.INT-XCC-IMPBON  =  XCC.INT-XCC-IMPBON  + sig * Fac_detalle-bon.importe.
               ZCC.INT-ZCC-IMBODE  =  ZCC.INT-ZCC-IMBODE  + sig * Fac_detalle-bon.importe.
               SCM.INT-SCM-IMPBON  =  SCM.INT-SCM-IMPBON  + sig * Fac_detalle-bon.importe.
               IF AVAILABLE Proveedor AND INT(Proveedor.cdg_proveedor) = 1
               THEN SCM.INT-SCM-BONMAS = SCM.INT-SCM-BONMAS + sig * Fac_detalle.subtotal_neto.
               ELSE SCM.INT-SCM-BONILC = SCM.INT-SCM-BONILC + sig * Fac_detalle.subtotal_neto.
            END.

            FOR EACH Fac_detalle-bon OF Fac_detalle:
                DCC.INT-DCC-IMPBON  =  DCC.INT-DCC-IMPBON  + ( Fac_detalle-bon.importe).
            END.

      END.

      Fac_header.proc_estad = YES.

    END.

END PROCEDURE.

PROCEDURE BAJA:

archivo = STRING(YEAR(has_fecha),"9999") + STRING(MONTH(has_fecha),"99") + STRING(DAY(has_fecha),"99") + "." + REPLACE(STRING(TIME, "HH:mm:SS"), ":", "") + ".0042.p.mci".
que_archivo = dire_tmp + "dcc." + archivo.

OUTPUT TO VALUE(que_archivo).
CREATE DCC_TRA.
FOR EACH DCC:
   lineadcc = STRING(DCC.INT-DCC-CENFAC, "9999")
            + STRING(DCC.INT-DCC-CODDOC, "999")
            + STRING(DCC.INT-DCC-LETIVA, "X(1)")
            + STRING(DCC.INT-DCC-NUMDOC, "99999999")
            + STRING(DCC.INT-DCC-FECING, "99999999")
            + STRING(DCC.INT-DCC-NRGUIA, "99999999")
            + STRING(DCC.INT-DCC-ORDGRA, "9999")
            + STRING(DCC.INT-DCC-CODGEN, "9")
            + STRING(DCC.INT-DCC-PLADEP, "9999")
            + STRING(DCC.INT-DCC-FECDOC, "99999999")
            + STRING(DCC.INT-DCC-NROCLI, "999999")
            + STRING(DCC.INT-DCC-NROSUC, "9999")
            + STRING(DCC.INT-DCC-CFDORI, "9999")
            + STRING(DCC.INT-DCC-CODDOR, "999")
            + STRING(DCC.INT-DCC-LETIVO, "X(1)")
            + STRING(DCC.INT-DCC-NUMDOR, "99999999")
            + STRING(DCC.INT-DCC-FEVEFA, "99999999")
            + STRING(DCC.INT-DCC-FEVERE, "99999999")
            + STRING(DCC.INT-DCC-NROFLE, "9999")
            + STRING(DCC.INT-DCC-NROREP, "9999")
            + STRING(DCC.INT-DCC-HORING, "999999")
            + STRING(DCC.INT-DCC-FEVILP, "99999999")
            + REPLACE(STRING(DCC.INT-DCC-IMPIVI, "9999999999999999.99"), "." , ",")
            + REPLACE(STRING(DCC.INT-DCC-IMPIVN, "9999999999999999.99"), "." , ",")
            + REPLACE(STRING(DCC.INT-DCC-IMPGRA, "9999999999999999.99"), "." , ",")
            + REPLACE(STRING(DCC.INT-DCC-IMPNGR, "9999999999999999.99"), "." , ",")
            + REPLACE(STRING(DCC.INT-DCC-IMPEIV, "9999999999999999.99"), "." , ",")
            + REPLACE(STRING(DCC.INT-DCC-IMPEIB, "9999999999999999.99"), "." , ",")
            + CONVIERTE(DCC.INT-DCC-IMPBON, "-999999999999999.99")
            + STRING(DCC.INT-DCC-NROPED, "9999999999")
            + STRING(DCC.INT-DCC-FEINCO, "99999999")
            + STRING(DCC.INT-DCC-CODZVT, "9999")
            + STRING(DCC.INT-DCC-TIPCLI, "99")
            + STRING(DCC.INT-DCC-FECCON, "99999999")
            + STRING(DCC.INT-DCC-HORCON, "999999")
            + STRING(DCC.INT-DCC-CODACT, "99")
            + STRING(DCC.INT-DCC-FECPCL, "99999999")
            + STRING(DCC.INT-DCC-MARLIQ, "X(1)")
            + STRING(DCC.INT-DCC-CODPRO, "99")
            + STRING(DCC.INT-DCC-NROLEG, "999999")
            + STRING(DCC.INT-DCC-LEGAJO-MOD, "999999")
            + STRING(DCC.INT-DCC-LETEXT, "X(1)")
            + STRING(DCC.INT-DCC-SUCEXT, "9999")
            + STRING(DCC.INT-DCC-NUMEXT, "99999999")
            + STRING(DCC.INT-DCC-PERREF, "999999")
            + STRING(DCC.INT-DCC-MARDEP, "X(1)")
            + CONVIERTE(DCC.INT-DCC-GRAILC, "-99999999999.99")
            + CONVIERTE(DCC.INT-DCC-GRAMAS, "-99999999999.99")
            + CONVIERTE(DCC.INT-DCC-NGRILC, "-99999999999.99")
            + CONVIERTE(DCC.INT-DCC-NGRMAS, "-99999999999.99")
            + CONVIERTE(DCC.INT-DCC-BONILC, "-99999999999.99")
            + CONVIERTE(DCC.INT-DCC-BONMAS,  "-99999999999.99")
            + CONVIERTE(DCC.INT-DCC-PROILC, "-99999999999.99")
            + CONVIERTE(DCC.INT-DCC-PROMAS, "-99999999999.99")
            + CONVIERTE(DCC.INT-DCC-IMPBOI, "-999999999999999.99")
            + CONVIERTE(DCC.INT-DCC-IMPBOM,  "-999999999999999.99")
            + CONVIERTE(DCC.INT-DCC-IMPPRI,  "-999999999999999.99")
            + CONVIERTE(DCC.INT-DCC-IMPPRM, "-999999999999999.99")
            + CONVIERTE(DCC.INT-DCC-IMPMUL, "-9999999999999999.99")
            + REPLACE(STRING(DCC.INT-DCC-GRAPIV, "99999999999.99"), "." , ",")
            + STRING(DCC.INT-DCC-TERRIT, "9999")
            + STRING(DCC.INT-DCC-NROREM, "9999999999")
            + STRING(DCC.INT-DCC-CONPGO, "99").
      PUT lineadcc
          SKIP.

       ASSIGN DCC_TRA.INT-DCC-CENFAC  = DCC_TRA.INT-DCC-CENFAC + DCC.INT-DCC-CENFAC
              DCC_TRA.INT-DCC-CODDOC  = DCC_TRA.INT-DCC-CODDOC + DCC.INT-DCC-CODDOC 
              DCC_TRA.INT-DCC-NUMDOC  = DCC_TRA.INT-DCC-NUMDOC + DCC.INT-DCC-NUMDOC
              DCC_TRA.INT-DCC-FECING  = DCC_TRA.INT-DCC-FECING + DCC.INT-DCC-FECING
              DCC_TRA.INT-DCC-NRGUIA  = DCC_TRA.INT-DCC-NRGUIA + DCC.INT-DCC-NRGUIA
              DCC_TRA.INT-DCC-ORDGRA  = DCC_TRA.INT-DCC-ORDGRA + DCC.INT-DCC-ORDGRA
              DCC_TRA.INT-DCC-CODGEN  = DCC_TRA.INT-DCC-CODGEN + DCC.INT-DCC-CODGEN        
              DCC_TRA.INT-DCC-PLADEP  = DCC_TRA.INT-DCC-PLADEP + DCC.INT-DCC-PLADEP
              DCC_TRA.INT-DCC-FECDOC  = DCC_TRA.INT-DCC-FECDOC + DCC.INT-DCC-FECDOC         
              DCC_TRA.INT-DCC-NROCLI  = DCC_TRA.INT-DCC-NROCLI + DCC.INT-DCC-NROCLI           
              DCC_TRA.INT-DCC-NROSUC  = DCC_TRA.INT-DCC-NROSUC + DCC.INT-DCC-NROSUC           
              DCC_TRA.INT-DCC-CFDORI  = DCC_TRA.INT-DCC-CFDORI + DCC.INT-DCC-CFDORI          
              DCC_TRA.INT-DCC-CODDOR  = DCC_TRA.INT-DCC-CODDOR + DCC.INT-DCC-CODDOR        
              DCC_TRA.INT-DCC-NUMDOR  = DCC_TRA.INT-DCC-NUMDOR + DCC.INT-DCC-NUMDOR          
              DCC_TRA.INT-DCC-FEVEFA  = DCC_TRA.INT-DCC-FEVEFA + DCC.INT-DCC-FEVEFA          
              DCC_TRA.INT-DCC-FEVERE  = DCC_TRA.INT-DCC-FEVERE + DCC.INT-DCC-FEVERE          
              DCC_TRA.INT-DCC-NROFLE  = DCC_TRA.INT-DCC-NROFLE + DCC.INT-DCC-NROFLE          
              DCC_TRA.INT-DCC-NROREP  = DCC_TRA.INT-DCC-NROREP + DCC.INT-DCC-NROREP          
              DCC_TRA.INT-DCC-HORING  = DCC_TRA.INT-DCC-HORING + DCC.INT-DCC-HORING          
              DCC_TRA.INT-DCC-FEVILP  = DCC_TRA.INT-DCC-FEVILP + DCC.INT-DCC-FEVILP          
              DCC_TRA.INT-DCC-IMPIVI  = DCC_TRA.INT-DCC-IMPIVI + DCC.INT-DCC-IMPIVI        
              DCC_TRA.INT-DCC-IMPIVN  = DCC_TRA.INT-DCC-IMPIVN + DCC.INT-DCC-IMPIVN        
              DCC_TRA.INT-DCC-IMPGRA  = DCC_TRA.INT-DCC-IMPGRA + DCC.INT-DCC-IMPGRA        
              DCC_TRA.INT-DCC-IMPNGR  = DCC_TRA.INT-DCC-IMPNGR + DCC.INT-DCC-IMPNGR        
              DCC_TRA.INT-DCC-IMPEIV  = DCC_TRA.INT-DCC-IMPEIV + DCC.INT-DCC-IMPEIV         
              DCC_TRA.INT-DCC-IMPEIB  = DCC_TRA.INT-DCC-IMPEIB + DCC.INT-DCC-IMPEIB        
              DCC_TRA.INT-DCC-IMPBON  = DCC_TRA.INT-DCC-IMPBON + DCC.INT-DCC-IMPBON        
              DCC_TRA.INT-DCC-NROPED  = DCC_TRA.INT-DCC-NROPED + DCC.INT-DCC-NROPED          
              DCC_TRA.INT-DCC-FEINCO  = DCC_TRA.INT-DCC-FEINCO + DCC.INT-DCC-FEINCO          
              DCC_TRA.INT-DCC-CODZVT  = DCC_TRA.INT-DCC-CODZVT + DCC.INT-DCC-CODZVT          
              DCC_TRA.INT-DCC-TIPCLI  = DCC_TRA.INT-DCC-TIPCLI + DCC.INT-DCC-TIPCLI          
              DCC_TRA.INT-DCC-FECCON  = DCC_TRA.INT-DCC-FECCON + DCC.INT-DCC-FECCON          
              DCC_TRA.INT-DCC-HORCON  = DCC_TRA.INT-DCC-HORCON + DCC.INT-DCC-HORCON          
              DCC_TRA.INT-DCC-CODACT  = DCC_TRA.INT-DCC-CODACT + DCC.INT-DCC-CODACT           
              DCC_TRA.INT-DCC-FECPCL  = DCC_TRA.INT-DCC-FECPCL + DCC.INT-DCC-FECPCL            
