DEFINE VAR des_fecha AS DATE INIT 07/02/03.                  
DEFINE VAR has_fecha AS DATE INIT 07/02/03.                
DEFINE VAR cempresa  LIKE Empresa.cdg_empresa INIT "M". 




/* DEFINE INPUT PARAMETER des_fecha AS DATE.                  */
/* DEFINE INPUT PARAMETER has_fecha AS DATE.                  */
/* DEFINE INPUT PARAMETER cempresa  LIKE Empresa.cdg_empresa. */

FUNCTION convierte RETURNS CHARACTER (INPUT parm1 AS DECIMAL,
                                      INPUT parm2 AS CHARACTER) FORWARD.    

{VRSHARED.I "NEW"}

DEFINE VARIABLE IMPIVI       AS DECIMAL.
