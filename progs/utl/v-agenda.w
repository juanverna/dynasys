&Scoped-define SELF-NAME btn_clave
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL btn_clave V-table-Win
ON CHOOSE OF btn_clave IN FRAME F-Main /* Asignar Clave */
DO:
  RUN cambia_pw-agenda.p ( INPUT ROWID(Agenda)).
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME btn_imprimir
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL btn_imprimir V-table-Win
ON CHOOSE OF btn_imprimir IN FRAME F-Main /* Imprimir Agenda */
DO:
  FIND Parametro WHERE cdg_parametro = "IMPAGTEL" NO-LOCK NO-ERROR.
  
  IF AVAILABLE Parametro  
  THEN DO:
        IF CAN-DO(observacion,USERID("despacho")) 
        THEN DO:
              RUN imprimir_agenda.p (INPUT ROWID(Agenda)).
        END.
        ELSE DO:
              MESSAGE "Se intenta ejecutar una función no autorizada"
                      VIEW-AS ALERT-BOX ERROR TITLE "Error de seguridad".
        END.
  END.
  ELSE DO:
        MESSAGE "Se intenta ejecutar una función no autorizada"
                VIEW-AS ALERT-BOX ERROR TITLE "Error de seguridad".
  END.
END.

