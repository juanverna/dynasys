          BGCOLOR 7 FGCOLOR 15 
     T-Planprod_hd.prf_comprob AT ROW 3.62 COL 20 COLON-ALIGNED NO-LABEL
          VIEW-AS FILL-IN NATIVE 
          SIZE 8 BY 1
          BGCOLOR 7 FGCOLOR 15 
     T-Planprod_hd.nro_comprob AT ROW 3.62 COL 29 COLON-ALIGNED NO-LABEL
          VIEW-AS FILL-IN NATIVE 
          SIZE 13.2 BY 1
          BGCOLOR 7 FGCOLOR 15 
     v-anulado AT ROW 3.62 COL 43 COLON-ALIGNED NO-LABEL
     v-pto_venta AT ROW 3.62 COL 74 COLON-ALIGNED NO-LABEL
     v-comprobante AT ROW 3.62 COL 125 COLON-ALIGNED NO-LABEL
     v-cdg_cliente AT ROW 4.81 COL 11 COLON-ALIGNED
     v-dsc_cliente AT ROW 4.81 COL 29 COLON-ALIGNED NO-LABEL
     T-Planprod_hd.fecha_inicio AT ROW 4.81 COL 98 COLON-ALIGNED
          LABEL "Inicio"
          VIEW-AS FILL-IN NATIVE 
          SIZE 15 BY 1
          BGCOLOR 15 FGCOLOR 9 
     T-Planprod_hd.fecha_final AT ROW 4.81 COL 141 COLON-ALIGNED
          LABEL "Final"
          VIEW-AS FILL-IN NATIVE 
          SIZE 15 BY 1
          BGCOLOR 15 FGCOLOR 9 
     v-cdg_area AT ROW 6 COL 11 COLON-ALIGNED
     v-dsc_area AT ROW 6 COL 29 COLON-ALIGNED NO-LABEL
     v-cdg_empleado AT ROW 6 COL 98 COLON-ALIGNED
     v-dsc_empleado AT ROW 6 COL 115 COLON-ALIGNED NO-LABEL
     v-cdg_articulo AT ROW 8.38 COL 2 NO-LABEL
     T-Planprod_hd.leyenda AT ROW 8.38 COL 25 NO-LABEL
          VIEW-AS EDITOR SCROLLBAR-VERTICAL
          SIZE 133 BY 2.81
          BGCOLOR 15 FGCOLOR 9 
     BRW-DETALLE AT ROW 11.48 COL 1
     RECT-2 AT ROW 1.24 COL 3
     RECT-3 AT ROW 1.24 COL 132
     "         Observaciones pertinentes al presente plan de produccion" VIEW-AS TEXT
          SIZE 133 BY 1 AT ROW 7.19 COL 25
          BGCOLOR 5 FGCOLOR 15 
     "  Articulos Producidos" VIEW-AS TEXT
          SIZE 22 BY 1 AT ROW 7.19 COL 2
          BGCOLOR 5 FGCOLOR 15 
    WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY 
         SIDE-LABELS NO-UNDERLINE THREE-D 
         AT COL 1 ROW 1
         SIZE 157.4 BY 27.67.


