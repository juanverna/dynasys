/* Define the widget handle for the window                              */
DEFINE VAR C-Win AS WIDGET-HANDLE NO-UNDO.

/* Definitions of the field level widgets                               */
DEFINE BUTTON btn_anular 
     LABEL "&Anular" 
     SIZE 24 BY 1.33.

DEFINE BUTTON btn_cancel 
     LABEL "&Cancelar" 
     SIZE 24 BY 1.33.

DEFINE BUTTON btn_copiar 
     LABEL "&Copiar" 
     SIZE 24 BY 1.33.

DEFINE BUTTON btn_grabar 
     LABEL "&Grabar" 
     SIZE 24 BY 1.33.

DEFINE BUTTON btn_imprim 
     LABEL "&Reimprimir" 
     SIZE 24 BY 1.33.

DEFINE BUTTON Btn_salir DEFAULT 
     LABEL "&Salir" 
     SIZE 24 BY 1.33
     BGCOLOR 8 .

DEFINE VARIABLE v-anulado AS CHARACTER FORMAT "X(256)":U 
     VIEW-AS FILL-IN 
     SIZE 30 BY 1
     FGCOLOR 12 FONT 6 NO-UNDO.

DEFINE VARIABLE v-cdg_area AS CHARACTER FORMAT "X(256)":U 
     LABEL "Area" 
     VIEW-AS FILL-IN NATIVE 
     SIZE 17 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-cdg_articulo AS CHARACTER FORMAT "X(14)" 
     VIEW-AS FILL-IN NATIVE 
     SIZE 22 BY 1
     BGCOLOR 14 FGCOLOR 12 FONT 6.

DEFINE VARIABLE v-cdg_cliente AS CHARACTER FORMAT "X(8)" 
     LABEL "Cliente" 
     VIEW-AS FILL-IN NATIVE 
     SIZE 17 BY 1
     BGCOLOR 15 FGCOLOR 9 .

DEFINE VARIABLE v-cdg_empleado AS CHARACTER FORMAT "X(8)":U 
     LABEL "Responsable" 
     VIEW-AS FILL-IN NATIVE 
     SIZE 15 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-comprobante AS CHARACTER FORMAT "X(256)":U 
     VIEW-AS FILL-IN 
     SIZE 31 BY 1
     FONT 6 NO-UNDO.

DEFINE VARIABLE v-dsc_area AS CHARACTER FORMAT "X(256)":U 
     VIEW-AS FILL-IN NATIVE 
     SIZE 53 BY 1
     BGCOLOR 7 FGCOLOR 15  NO-UNDO.

DEFINE VARIABLE v-dsc_cliente AS CHARACTER FORMAT "X(50)" 
     VIEW-AS FILL-IN 
     SIZE 53 BY 1
     BGCOLOR 7 FGCOLOR 15 .

DEFINE VARIABLE v-dsc_empleado AS CHARACTER FORMAT "X(256)":U 
     VIEW-AS FILL-IN NATIVE 
     SIZE 41 BY 1
     BGCOLOR 7 FGCOLOR 15  NO-UNDO.

DEFINE VARIABLE v-pto_venta AS INTEGER FORMAT "9999":U INITIAL 0 
     VIEW-AS FILL-IN 
     SIZE 8 BY 1
     BGCOLOR 15 FGCOLOR 9 FONT 6 NO-UNDO.

DEFINE RECTANGLE RECT-2
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 126 BY 1.91.

DEFINE RECTANGLE RECT-3
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 26 BY 1.91.

/* Query definitions                                                    */
&ANALYZE-SUSPEND
DEFINE QUERY BRW-DETALLE FOR 
      T-Planprod_dt, 
      Articulo SCROLLING.

DEFINE QUERY DEFAULT-FRAME FOR 
      T-Planprod_hd SCROLLING.
&ANALYZE-RESUME

/* Browse definitions                                                   */
DEFINE BROWSE BRW-DETALLE
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _DISPLAY-FIELDS BRW-DETALLE C-Win _STRUCTURED
  QUERY BRW-DETALLE NO-LOCK DISPLAY
      T-Planprod_dt.nro_linea COLUMN-LABEL "Número!Linea" FORMAT ">>9":U
      Articulo.cdg_articulo FORMAT "X(12)":U WIDTH 18.2
      Articulo.descripcion FORMAT "X(50)":U
      T-Planprod_dt.cantidad COLUMN-LABEL "Cantidad!A Producir" FORMAT "->>,>>>,>>9.99":U
            COLUMN-FGCOLOR 9 COLUMN-BGCOLOR 11
      Articulo.cdg_umed FORMAT "X(12)":U
      T-Planprod_dt.granel COLUMN-LABEL "Granel!A Producir" FORMAT "->>,>>>,>>9.99":U
            COLUMN-FGCOLOR 9 COLUMN-BGCOLOR 11
      Articulo.cdg_ugranel FORMAT "X(12)":U
      T-Planprod_dt.cdg_estado COLUMN-LABEL "Es-!tado" FORMAT "X(2)":U
      T-Planprod_dt.observacion COLUMN-LABEL "Observación!de Detalle" FORMAT "X(50)":U
            COLUMN-FGCOLOR 9 COLUMN-BGCOLOR 11
  ENABLE
      T-Planprod_dt.cantidad
      T-Planprod_dt.granel
      T-Planprod_dt.observacion
/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME
    WITH NO-ROW-MARKERS SEPARATORS SIZE 157 BY 16.91
         TITLE "Detalle de artículos a producir en el presente plan" EXPANDABLE.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME DEFAULT-FRAME
     btn_copiar AT ROW 1.48 COL 29
     btn_cancel AT ROW 1.48 COL 54
     btn_anular AT ROW 1.48 COL 79
     btn_imprim AT ROW 1.48 COL 104
     Btn_salir AT ROW 1.48 COL 133
     btn_grabar AT ROW 1.52 COL 4
     T-Planprod_hd.tip_comprob AT ROW 3.62 COL 11 COLON-ALIGNED
          LABEL "Plan"
          VIEW-AS FILL-IN NATIVE 
