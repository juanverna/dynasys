     FIND Parteprod_hd WHERE ROWID(Parteprod_hd) = rid_pedido NO-LOCK.
     DISPLAY Parteprod_hd.nro_comprob @ T-Parteprod_hd.nro_comprob
             WITH FRAME {&FRAME-NAME}.
     RUN traer_documento.
