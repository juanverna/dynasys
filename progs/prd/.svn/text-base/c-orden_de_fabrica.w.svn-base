/* ***********************  Control Definitions  ********************** */

/* Define the widget handle for the window                              */
DEFINE VAR C-Win AS WIDGET-HANDLE NO-UNDO.

/* Definitions of the field level widgets                               */
DEFINE BUTTON btn_anular 
     LABEL "&Anular" 
     SIZE 24 BY 1.33.

DEFINE BUTTON btn_cancel 
     LABEL "&Cancelar" 
     SIZE 24 BY 1.33.

DEFINE BUTTON btn_copiar 
     LABEL "&Copiar" 
     SIZE 24 BY 1.33.

DEFINE BUTTON btn_grabar 
     LABEL "&Grabar" 
     SIZE 24 BY 1.33.

DEFINE BUTTON btn_imprim 
     LABEL "&Reimprimir" 
     SIZE 24 BY 1.33.

DEFINE BUTTON Btn_salir DEFAULT 
     LABEL "&Salir" 
     SIZE 24 BY 1.33
     BGCOLOR 8 .

DEFINE VARIABLE v-anulado AS CHARACTER FORMAT "X(256)":U 
     VIEW-AS FILL-IN 
     SIZE 28 BY 1
     BGCOLOR 15 FGCOLOR 12  NO-UNDO.

DEFINE VARIABLE v-cdg_area AS CHARACTER FORMAT "X(256)":U 
     LABEL "Area" 
     VIEW-AS FILL-IN NATIVE 
     SIZE 18 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-cdg_centrotrabajo AS CHARACTER FORMAT "X(256)":U 
     LABEL "Centro" 
     VIEW-AS FILL-IN NATIVE 
     SIZE 18 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-cdg_empleado AS CHARACTER FORMAT "X(256)":U 
     LABEL "Resp." 
     VIEW-AS FILL-IN NATIVE 
     SIZE 18 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-cdg_insumo AS CHARACTER FORMAT "X(14)" 
     LABEL "Insumo" 
     VIEW-AS FILL-IN NATIVE 
     SIZE 30 BY 1
     BGCOLOR 14 FGCOLOR 12 FONT 6.

DEFINE VARIABLE v-cdg_operacionfabrica AS CHARACTER FORMAT "X(256)":U 
     LABEL "Operación" 
     VIEW-AS FILL-IN NATIVE 
     SIZE 18 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-cdg_producto AS CHARACTER FORMAT "X(14)" 
     LABEL "Producto" 
     VIEW-AS FILL-IN NATIVE 
     SIZE 30 BY 1
     BGCOLOR 14 FGCOLOR 12 FONT 6.

DEFINE VARIABLE v-dsc_area AS CHARACTER FORMAT "X(256)":U 
     VIEW-AS FILL-IN 
     SIZE 48 BY 1
     BGCOLOR 7 FGCOLOR 15  NO-UNDO.

DEFINE VARIABLE v-dsc_centrotrabajo AS CHARACTER FORMAT "X(256)":U 
     VIEW-AS FILL-IN 
     SIZE 48 BY 1
     BGCOLOR 7 FGCOLOR 15  NO-UNDO.

DEFINE VARIABLE v-dsc_empleado AS CHARACTER FORMAT "X(256)":U 
     VIEW-AS FILL-IN 
     SIZE 48 BY 1
     BGCOLOR 7 FGCOLOR 15  NO-UNDO.

DEFINE VARIABLE v-dsc_operacionfabrica AS CHARACTER FORMAT "X(256)":U 
     VIEW-AS FILL-IN 
     SIZE 48 BY 1
     BGCOLOR 7 FGCOLOR 15  NO-UNDO.

DEFINE VARIABLE v-estado AS CHARACTER FORMAT "X(256)":U 
     VIEW-AS FILL-IN 
     SIZE 28 BY 1
     BGCOLOR 15 FGCOLOR 12  NO-UNDO.

DEFINE VARIABLE v-nro_plan AS INTEGER FORMAT ">>>>>>>9":U INITIAL ? 
     VIEW-AS FILL-IN NATIVE 
     SIZE 14 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-prf_plan AS INTEGER FORMAT "9999":U INITIAL 0 
     VIEW-AS FILL-IN NATIVE 
     SIZE 9 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-tip_plan AS CHARACTER FORMAT "X(2)":U 
     LABEL "Plan Nro." 
     VIEW-AS FILL-IN NATIVE 
     SIZE 9 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE RECTANGLE RECT-2
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 126 BY 1.86.

DEFINE RECTANGLE RECT-3
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 26 BY 1.86.

/* Query definitions                                                    */
&ANALYZE-SUSPEND
DEFINE QUERY BRW-COMPONENTES FOR 
      T-Ofabrica_dt, 
      Componente SCROLLING.

DEFINE QUERY BRW-COMPUESTOS FOR 
      T-Ofabrica_dt, 
      Compuesto SCROLLING.

DEFINE QUERY DEFAULT-FRAME FOR 
      T-Ofabrica_hd SCROLLING.
&ANALYZE-RESUME

/* Browse definitions                                                   */
DEFINE BROWSE BRW-COMPONENTES
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _DISPLAY-FIELDS BRW-COMPONENTES C-Win _STRUCTURED
  QUERY BRW-COMPONENTES NO-LOCK DISPLAY
      T-Ofabrica_dt.nro_linea COLUMN-LABEL "Número!Linea" FORMAT ">>9":U
      Componente.cdg_articulo FORMAT "X(12)":U WIDTH 15
      Componente.descripcion FORMAT "X(40)":U
      T-Ofabrica_dt.cantidad COLUMN-LABEL "Cantidad!A Consumir" FORMAT "->>,>>>,>>9.99":U
      T-Ofabrica_dt.cantidad_sol FORMAT "->>,>>>,>>9.99":U
      Componente.cdg_umed FORMAT "X(12)":U WIDTH 6.2
      T-Ofabrica_dt.granel COLUMN-LABEL "Granel!A Consumir" FORMAT "->>,>>>,>>9.99":U
      T-Ofabrica_dt.granel_sol FORMAT "->>,>>>,>>9.99":U
      T-Ofabrica_dt.observacion COLUMN-LABEL "Observaciones!Asociadas" FORMAT "X(300)":U
/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME
    WITH NO-ROW-MARKERS SEPARATORS SIZE 157 BY 9.52
         TITLE "Componentes involucrados en la presente O/Fábrica" EXPANDABLE.

DEFINE BROWSE BRW-COMPUESTOS
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _DISPLAY-FIELDS BRW-COMPUESTOS C-Win _STRUCTURED
  QUERY BRW-COMPUESTOS NO-LOCK DISPLAY
      T-Ofabrica_dt.nro_linea COLUMN-LABEL "Número!Linea" FORMAT ">>9":U
      Compuesto.cdg_articulo FORMAT "X(12)":U WIDTH 15
      Compuesto.descripcion FORMAT "X(40)":U WIDTH 52.2
      T-Ofabrica_dt.cantidad COLUMN-LABEL "Cantidad!Real" FORMAT "->>,>>>,>>9.99":U
      T-Ofabrica_dt.cantidad_sol COLUMN-LABEL "Cantidad!Teórica" FORMAT "->>,>>>,>>9.99":U
            COLUMN-FGCOLOR 9 COLUMN-BGCOLOR 11
      Compuesto.cdg_umed FORMAT "X(12)":U WIDTH 6
      T-Ofabrica_dt.granel COLUMN-LABEL "Granel!Real" FORMAT "->>,>>>,>>9.99":U
      T-Ofabrica_dt.granel_sol COLUMN-LABEL "Granel!Teórico" FORMAT "->>,>>>,>>9.99":U
            COLUMN-FGCOLOR 9 COLUMN-BGCOLOR 11
      T-Ofabrica_dt.cdg_estado COLUMN-LABEL "Es-!tado" FORMAT "X(2)":U
  ENABLE
      T-Ofabrica_dt.cantidad_sol
      T-Ofabrica_dt.granel_sol
/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME
    WITH NO-ASSIGN SEPARATORS SIZE 157 BY 6.67
         TITLE "Resultante de producción de la Orden de Fábrica" EXPANDABLE.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME DEFAULT-FRAME
     btn_copiar AT ROW 1.48 COL 29
