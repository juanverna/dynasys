/* ************************  Control Triggers  ************************ */

&Scoped-define SELF-NAME C-Win
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL C-Win C-Win
ON END-ERROR OF C-Win /* Ordenes de Fábrica */
OR ENDKEY OF {&WINDOW-NAME} ANYWHERE DO:
  /* This case occurs when the user presses the "Esc" key.
     In a persistently run window, just ignore this.  If we did not, the
     application would exit. */
  IF THIS-PROCEDURE:PERSISTENT THEN RETURN NO-APPLY.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL C-Win C-Win
ON WINDOW-CLOSE OF C-Win /* Ordenes de Fábrica */
DO:
  /* This event will close the window and terminate the procedure.  */
  /* APPLY "CLOSE":U TO THIS-PROCEDURE. */
  APPLY "CHOOSE":U TO Btn_salir IN FRAME {&FRAME-NAME}.
  RETURN NO-APPLY.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define BROWSE-NAME BRW-COMPUESTOS
&Scoped-define SELF-NAME BRW-COMPUESTOS
&Scoped-define SELF-NAME T-Ofabrica_dt.cantidad_sol
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL T-Ofabrica_dt.cantidad_sol BRW-COMPUESTOS _BROWSE-COLUMN C-Win
ON LEAVE OF T-Ofabrica_dt.cantidad_sol IN BROWSE BRW-COMPUESTOS /* Cantidad!Teórica */
DO:
  /*
  IF BRW-COLORES:CURRENT-ROW-MODIFIED
  THEN DO:
  */

    DEFINE VARIABLE x-cantidad     LIKE Ofabrica_dt.cantidad_sol.
    DEFINE VARIABLE x-granel       LIKE Ofabrica_dt.granel_sol.
    
    x-cantidad = DECIMAL(T-Ofabrica_dt.cantidad_sol:SCREEN-VALUE IN BROWSE BRW-COMPUESTOS).

    T-Ofabrica_dt.cantidad = x-cantidad.
    T-Ofabrica_dt.cantidad_sol = T-Ofabrica_dt.cantidad.
    DISPLAY T-Ofabrica_dt.cantidad
            WITH BROWSE BRW-COMPUESTOS.

    RUN calcular_componentes ( INPUT T-Ofabrica_dt.nro_articulo, INPUT T-Ofabrica_dt.cantidad ).

    RUN abre_query_compuestos.
    RUN abre_query_componentes.

/*
    MESSAGE "sol:screen-value " T-Ofabrica_dt.cantidad_sol:SCREEN-VALUE IN BROWSE BRW-COMPUESTOS SKIP
            "sol:valor        " T-Ofabrica_dt.cantidad_sol SKIP
            "can:screen-value " T-Ofabrica_dt.cantidad:SCREEN-VALUE IN BROWSE BRW-COMPUESTOS SKIP
            "can:valor        " T-Ofabrica_dt.cantidad SKIP
            VIEW-AS ALERT-BOX MESSAGE TITLE "salimos con estos valores".
  
  END.        
  */  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME btn_anular
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL btn_anular C-Win
ON CHOOSE OF btn_anular IN FRAME DEFAULT-FRAME /* Anular */
DO:

    DEFINE VARIABLE pudo_anular AS INTEGER.
    sino-msg = NO.
    MESSAGE "Desea ANULAR este comprobante" 
            VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO TITLE "Confirmación" UPDATE sino-msg.
    IF sino-msg
    THEN DO:
         RUN anular_comprobante_cliente.p (INPUT ROWID(Fac_header), OUTPUT pudo_anular).
         IF pudo_anular = 0
         THEN DO:
              DO TRANSACTION:
                RUN borrar_tablas_temporales.
              END.
              MESSAGE "El comprobante ha sido anulado" 
                      VIEW-AS ALERT-BOX MESSAGE TITLE "Aviso".
              
         END.
         ASSIGN codigo_salir = CD_GRABAR.
         APPLY "U1":U TO THIS-PROCEDURE.
    END.
  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME btn_cancel
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL btn_cancel C-Win
ON CHOOSE OF btn_cancel IN FRAME DEFAULT-FRAME /* Cancelar */
DO: /*
    sino-msg = NO.
    MESSAGE "Desea cancelar la operación en curso?" 
            VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO TITLE "Confirmación" UPDATE sino-msg.
    IF sino-msg
    THEN DO:

        FOR EACH T-Color:
            DELETE T-Color.
        END.

        FOR EACH T-Ped_detalle:
            DELETE T-Ped_detalle.
        END.

        FOR EACH T-Ofabrica_hd:
            DELETE T-Ofabrica_hd.
        END.

        FOR EACH T-Ped_detalle-bon:
            DELETE T-Ped_detalle-bon.
        END.

        FOR EACH T-Ofabrica_hd-bon:
            DELETE T-Ofabrica_hd-bon.
        END.

        FOR EACH T-Sub_header_vta:
            DELETE T-Sub_header_vta.
        END.

        FOR EACH T-Sub_detalle_vta:
            DELETE T-Sub_detalle_vta.
        END.

        ASSIGN codigo_salir = CD_CANCELAR.
        APPLY "U1" TO THIS-PROCEDURE.

    END.
      */
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME btn_copiar
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL btn_copiar C-Win
ON CHOOSE OF btn_copiar IN FRAME DEFAULT-FRAME /* Copiar */
DO:
/*
  RUN d-seleccionar_pedido.w (INPUT-OUTPUT rid_pedido).
  IF rid_pedido <> ?
  THEN DO:
     FIND Ofabrica_hd WHERE ROWID(Ofabrica_hd) = rid_pedido NO-LOCK.
     DISPLAY Ofabrica_hd.nro_comprob @ T-Ofabrica_hd.nro_comprob
             WITH FRAME {&FRAME-NAME}.
     RUN traer_documento.
  END.  
*/  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME btn_grabar
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL btn_grabar C-Win
ON CHOOSE OF btn_grabar IN FRAME DEFAULT-FRAME /* Grabar */
DO:
  /*
  ASSIGN FRAME {&FRAME-NAME}
         T-Ofabrica_hd.cambio
         T-Ofabrica_hd.fecha
         T-Ofabrica_hd.transportista
         T-Ofabrica_hd.nro_ocm .
         
  RUN validar_datos ( OUTPUT hay_error ).
  IF NOT hay_error
  THEN DO:

       RUN grabar_datos.

       ASSIGN codigo_salir = CD_GRABAR.
       APPLY "U1" TO THIS-PROCEDURE.
  
  END.
  */
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME btn_imprim
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL btn_imprim C-Win
ON CHOOSE OF btn_imprim IN FRAME DEFAULT-FRAME /* Reimprimir */
DO:
    sino-msg = NO.
    MESSAGE "Desea REIMPRIMIR este comprobante?" 
            VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO TITLE "Confirmación" UPDATE sino-msg.
    IF sino-msg
    THEN DO:
         RUN imprimir_planprod.p (ROWID(Planprod_hd)).
    END.
  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME Btn_salir
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL Btn_salir C-Win
ON CHOOSE OF Btn_salir IN FRAME DEFAULT-FRAME /* Salir */
DO:

    sino-msg = NO.
    MESSAGE "Desea abandonar esta función?" 
            VIEW-AS ALERT-BOX QUESTION BUTTONS YES-NO TITLE "Confirmación" UPDATE sino-msg.
    IF sino-msg
    THEN DO:
        &IF DEFINED (adm-panel) <> 0 &THEN
            RUN dispatch IN THIS-PROCEDURE ('exit').
        &ELSE
/*          APPLY "CLOSE":U TO THIS-PROCEDURE.*/
            ASSIGN codigo_salir = CD_SALIR.
            APPLY "U1":U TO THIS-PROCEDURE.

        &ENDIF

    END.
  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME T-Ofabrica_hd.nro_comprob
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL T-Ofabrica_hd.nro_comprob C-Win
ON MOUSE-SELECT-DBLCLICK OF T-Ofabrica_hd.nro_comprob IN FRAME DEFAULT-FRAME /* nro_comprob */
OR MOUSE-MENU-DOWN,"." OF T-Ofabrica_hd.nro_comprob IN FRAME {&FRAME-NAME}
DO:
  DEFINE VARIABLE lista_estados AS CHARACTER.
  DEFINE VARIABLE titulo_window AS CHARACTER.

  CASE modo:
     WHEN MD_ALTA          
     THEN DO:
          titulo_window = "".     /* Esta opcion la contemplamos por unicidad pero no debería producirse nunca */
          lista_estados = "".
     END.
     WHEN MD_MULTIPLE      
     THEN DO:
          titulo_window = "Selección de Ordenes de Fábrica".
          lista_estados = "*".
     END.
     WHEN MD_DEFINIDA             /* Esta opcion la contemplamos por unicidad pero no debería producirse nunca */
     THEN DO:
          titulo_window = "".
          lista_estados = "".
     END.
     WHEN MD_RELACION             /* Esta opcion la contemplamos por unicidad pero no debería producirse nunca */
     THEN DO:
          titulo_window = "".
          lista_estados = "".
     END.
     WHEN MD_READONLY      
     THEN DO:
          titulo_window = "Selección Ordenes de Fábrica".
          lista_estados = "*".
     END.
     WHEN MD_CAMBIO        
     THEN DO:
          titulo_window = "".
          lista_estados = "".
     END.
     WHEN MD_ANULACION        
     THEN DO:
          titulo_window = "Selección de Ordenes de Fábrica".
          lista_estados = "P,E".
     END.
     WHEN MD_EMISION        
     THEN DO:
          titulo_window = "Selección de Ordenes de Fábrica".
          lista_estados = "".
     END.
  END CASE.     

  RUN d-selofabrica.w (INPUT titulo_window, INPUT lista_estados, INPUT "OF", INPUT-OUTPUT rid_ofabrica).
  IF rid_ofabrica <> ?
  THEN DO:
     FIND Ofabrica_hd WHERE ROWID(Ofabrica_hd) = rid_ofabrica NO-LOCK.
     DISPLAY Ofabrica_hd.tip_comprob @ T-Ofabrica_hd.tip_comprob 
             Ofabrica_hd.prf_comprob @ T-Ofabrica_hd.prf_comprob
             Ofabrica_hd.nro_comprob @ T-Ofabrica_hd.nro_comprob
             WITH FRAME {&FRAME-NAME}.
     IF modo = MD_ANULACION AND Ofabrica_hd.anulado
     THEN DO:
          RUN PONMENSJ.P (INPUT "DOCS002").
          RETURN NO-APPLY.
     END.
     ELSE DO:
          RUN traer_documento.
     END.
  END.  
  RETURN NO-APPLY.  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL T-Ofabrica_hd.nro_comprob C-Win
ON RETURN OF T-Ofabrica_hd.nro_comprob IN FRAME DEFAULT-FRAME /* nro_comprob */
DO:

   IF LOOKUP(INPUT FRAME {&FRAME-NAME} T-Ofabrica_hd.tip_comprob,"OF") = 0 
   THEN DO:
      RUN PONMENSJ.P (INPUT "DOCS010").
      RETURN NO-APPLY.
   END.

   FIND Ofabrica_hd 
        WHERE Ofabrica_hd.cdg_empresa = Empresa.cdg_empresa
          AND Ofabrica_hd.tip_comprob = INPUT T-Ofabrica_hd.tip_comprob 
          AND Ofabrica_hd.prf_comprob = INPUT T-Ofabrica_hd.prf_comprob
          AND Ofabrica_hd.nro_comprob = INPUT T-Ofabrica_hd.nro_comprob
              NO-ERROR.

   IF NOT AVAILABLE Ofabrica_hd 
   THEN DO:
        IF LOCKED Ofabrica_hd
           THEN RUN PONMENSJ.P (INPUT "DOCS000").
           ELSE RUN PONMENSJ.P (INPUT "DOCS001").
        RETURN NO-APPLY.
   END.
   ELSE DO:
        rid_Ofabrica = ROWID(Ofabrica_hd).
        RUN traer_documento.
   END.
  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME v-cdg_centrotrabajo
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-cdg_centrotrabajo C-Win
ON MOUSE-SELECT-DBLCLICK OF v-cdg_centrotrabajo IN FRAME DEFAULT-FRAME /* Centro */
OR "." OF v-cdg_centrotrabajo IN FRAME {&FRAME-NAME}
OR MOUSE-MENU-DOWN OF v-cdg_centrotrabajo IN FRAME {&FRAME-NAME}
DO:
   {helptabla.i "centrotrabajo" "cdg_centrotrabajo" "selcentrotrabajo.p"}
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-cdg_centrotrabajo C-Win
ON RETURN OF v-cdg_centrotrabajo IN FRAME DEFAULT-FRAME /* Centro */
DO:
  {traducetabla.i "centrotrabajo" "cdg_centrotrabajo" "cdg_centrotrabajo"}   
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME v-cdg_insumo
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-cdg_insumo C-Win
ON ENTRY OF v-cdg_insumo IN FRAME DEFAULT-FRAME /* Insumo */
DO:
    v-cdg_insumo = "".
    DISPLAY v-cdg_insumo
            WITH FRAME {&FRAME-NAME}.
  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-cdg_insumo C-Win
ON LEFT-MOUSE-DBLCLICK OF v-cdg_insumo IN FRAME DEFAULT-FRAME /* Insumo */
OR "+" OF v-cdg_insumo IN FRAME {&FRAME-NAME}
DO:
  
  DEFINE VARIABLE rid_articulo AS ROWID.
  RUN selartic.p ( INPUT-OUTPUT rid_articulo, INPUT YES).
  IF rid_articulo <> ?
  THEN DO:
       FIND Articulo WHERE ROWID(Articulo) = rid_articulo NO-LOCK.
       DISPLAY Articulo.cdg_articulo @ v-cdg_insumo
               WITH FRAME {&FRAME-NAME}.
       APPLY "RETURN" TO SELF.
       RETURN NO-APPLY.
  END.             
  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-cdg_insumo C-Win
ON MOUSE-MENU-DOWN OF v-cdg_insumo IN FRAME DEFAULT-FRAME /* Insumo */
DO:
  APPLY "LEFT-MOUSE-DBLCLICK" TO v-cdg_insumo IN FRAME {&FRAME-NAME}.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-cdg_insumo C-Win
ON RETURN OF v-cdg_insumo IN FRAME DEFAULT-FRAME /* Insumo */
DO:

  FIND Articulo WHERE Articulo.cdg_articulo = INPUT FRAME {&FRAME-NAME} v-cdg_insumo NO-LOCK NO-ERROR.
  IF NOT AVAILABLE Articulo 
  THEN DO:
       RUN PONMENSJ.P ( 'CLIE020' ).
       RETURN NO-APPLY.
  END.
  ELSE DO:
       FIND FIRST T-Ofabrica_dt WHERE T-Ofabrica_dt.nro_articulo = Articulo.nro_articulo NO-ERROR.
       IF AVAILABLE T-Ofabrica_dt
       THEN DO:
           RUN PONMENSJ.P ( 'CLIE020' ).
           RETURN NO-APPLY.
       END.
       ELSE DO:
           RUN crear_detalle_componente.
       END.

  END.

  v-cdg_insumo = "".
  DISPLAY v-cdg_insumo
          WITH FRAME {&FRAME-NAME}.
  
  APPLY "ENTRY" TO BRW-COMPUESTOS.
  
  RETURN NO-APPLY.

END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME v-cdg_operacionfabrica
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-cdg_operacionfabrica C-Win
