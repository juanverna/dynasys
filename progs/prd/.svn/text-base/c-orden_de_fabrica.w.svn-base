     _Where[1]         = "Temp-Tables.T-Ofabrica_dt.tipo_detalle = ""P"""
     _FldNameList[1]   > Temp-Tables.T-Ofabrica_dt.nro_linea
"T-Ofabrica_dt.nro_linea" "Número!Linea" ? "integer" ? ? ? ? ? ? no ? no no ? yes no no "U" "" ""
