DO:

  FIND Articulo WHERE Articulo.cdg_articulo = INPUT FRAME {&FRAME-NAME} v-cdg_producto NO-LOCK NO-ERROR.
  IF NOT AVAILABLE Articulo 
  THEN DO:
       RUN PONMENSJ.P ( 'CLIE020' ).
       RETURN NO-APPLY.
  END.
  ELSE DO:
