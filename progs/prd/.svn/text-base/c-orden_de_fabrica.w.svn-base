/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME v-nro_plan
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-nro_plan C-Win
ON RETURN OF v-nro_plan IN FRAME DEFAULT-FRAME
DO:

   /*
   IF LOOKUP(INPUT FRAME {&FRAME-NAME} v-tip_plan,"PP") = 0 
   THEN DO:
      RUN PONMENSJ.P (INPUT "DOCS010").
      RETURN NO-APPLY.
   END.
   */

   FIND Planprod_hd 
        WHERE Planprod_hd.cdg_empresa = Empresa.cdg_empresa
          AND Planprod_hd.tip_comprob = INPUT v-tip_plan 
          AND Planprod_hd.prf_comprob = INPUT v-prf_plan
          AND Planprod_hd.nro_comprob = INPUT v-nro_plan
              NO-ERROR.

   IF NOT AVAILABLE Planprod_hd 
   THEN DO:
        IF LOCKED Planprod_hd
           THEN RUN PONMENSJ.P (INPUT "DOCS000").
           ELSE RUN PONMENSJ.P (INPUT "DOCS001").
        RETURN NO-APPLY.
   END.
   ELSE DO:
        rid_planprod = ROWID(Planprod_hd).
        RUN traer_planprod.
   END.
  
END.

