&Scoped-define BROWSE-NAME BRW-COMPONENTES
&UNDEFINE SELF-NAME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CUSTOM _MAIN-BLOCK C-Win 


/* ***************************  Main Block  *************************** */

/* Set CURRENT-WINDOW: this will parent dialog-boxes and frames.        */
ASSIGN CURRENT-WINDOW                = {&WINDOW-NAME} 
       THIS-PROCEDURE:CURRENT-WINDOW = {&WINDOW-NAME}.

/* The CLOSE event can be used from inside or outside the procedure to  */
/* terminate it.                                                        */
ON CLOSE OF THIS-PROCEDURE 
   RUN disable_UI.

{findempresa.i}

/* Best default for GUI applications is...                              */
PAUSE 0 BEFORE-HIDE.

/* Now enable the interface and wait for the exit condition.            */
/* (NOTE: handle ERROR and END-KEY so cleanup code will always fire.    */
MAIN-BLOCK:
REPEAT ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
       ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
  RUN enable_UI.
  RUN iniciar_documento.
  RUN frame_sensitiva ( INPUT NO ).  
  CLEAR FRAME {&FRAME-NAME} ALL.
  RUN crear_registro.
  IF modo = MD_DEFINIDA
     THEN RUN traer_documento.
     ELSE RUN frame_sensitiva ( INPUT YES ).
  /*
  DISPLAY v-ultimo_pedido
          v-ultimo_estado
          WITH FRAME {&FRAME-NAME}.   
  */        
  IF modo = MD_ALTA THEN APPLY "ENTRY" TO v-cdg_operacionfabrica.
  
  WAIT-FOR U1 OF THIS-PROCEDURE.
  CASE codigo_salir:
       WHEN CD_SALIR THEN UNDO,LEAVE.
       WHEN CD_CANCELAR THEN UNDO,RETRY.
       WHEN CD_GRABAR THEN NEXT.
  END CASE.
   
END.
APPLY "CLOSE" TO THIS-PROCEDURE. /* hay que ver si realmente hace falta */

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


/* **********************  Internal Procedures  *********************** */

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE abre_query_componentes C-Win 
PROCEDURE abre_query_componentes :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  OPEN QUERY BRW-COMPONENTES
      FOR EACH T-Ofabrica_dt WHERE T-Ofabrica_dt.tipo_detalle = "C",
          FIRST Componente OF T-Ofabrica_dt.


END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE abre_query_compuestos C-Win 
PROCEDURE abre_query_compuestos :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  OPEN QUERY BRW-COMPUESTOS
      FOR EACH T-Ofabrica_dt WHERE T-Ofabrica_dt.tipo_detalle = "P",
          FIRST Compuesto OF T-Ofabrica_dt.
      
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE calcular_componentes C-Win 
PROCEDURE calcular_componentes :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
 
 DEFINE INPUT PARAMETER p-nro_articulo LIKE Articulo.nro_articulo.
 DEFINE INPUT PARAMETER p-cantidad     LIKE Ofabrica_dt.cantidad.
 
 DEFINE VARIABLE x-coeficiente AS DECIMAL DECIMALS 6.

 FIND FIRST Articulo_operacion OF Operacionfabrica 
     WHERE Articulo_operacion.nro_articulo = p-nro_articulo
       AND Articulo_operacion.rol = "P"
           NO-LOCK.
                               
 x-coeficiente = p-cantidad / Articulo_operacion.cantidad.

 /*-- Borra los registros de consumos agregados anteriormente --*/ 
     
 FOR EACH Articulo_operacion OF Operacionfabrica NO-LOCK:

     FIND FIRST T-Ofabrica_dt 
         WHERE T-Ofabrica_dt.nro_articulo = Articulo_operacion.nro_articulo
           AND T-Ofabrica_dt.tipo_detalle = IF Articulo_operacion.rol = "P" THEN "P" ELSE "C".

     ASSIGN T-Ofabrica_dt.cantidad = Articulo_operacion.cantidad * x-coeficiente
            T-Ofabrica_dt.granel   = Articulo_operacion.granel   * x-coeficiente
            T-Ofabrica_dt.cantidad_sol = T-Ofabrica_dt.cantidad 
            T-Ofabrica_dt.granel_sol   = T-Ofabrica_dt.granel.
 END.
 
/*
  OPEN QUERY BRW-COMPONENTES 
     FOR EACH T-Ofabrica_dt WHERE T-Ofabrica_dt.tipo_detalle = "C",
      EACH Componente OF T-Ofabrica_dt. 
*/
 /*-- Renumera las líneas de producto para que queden arriba --*/ 

/*-- Ahora, agrega los registros de consumos en base a las formulas --*/ 
/*
 FOR EACH B-T-Ofabrica_dt WHERE B-T-Ofabrica_dt.tipo_detalle = "P", 
     FIRST Compuesto OF B-T-Ofabrica_dt,EACH Formula_articulo
                                      WHERE Formula_articulo.nro_art_compuesto = Compuesto.nro_articulo:

     CREATE T-Consumo.
     ASSIGN T-Ofabrica_hd.ultima_linea = T-Ofabrica_hd.ultima_linea + 1
            T-Consumo.nro_linea        = T-Ofabrica_hd.ultima_linea
            T-Consumo.tipo_detalle     = "C"
            T-Consumo.nro_articulo     = Formula_articulo.nro_art_componente
            T-Consumo.cantidad_sol     = B-T-Ofabrica_dt.cantidad_sol / Formula_articulo.cantidad_compuesto * Formula_articulo.cantidad_componente
            T-Consumo.granel_sol       = B-T-Ofabrica_dt.granel_sol / Formula_articulo.granel_compuesto * Formula_articulo.granel_componente.
            
 END.
*/
 /*RUN abre_query_componentes.*/

 MESSAGE "sale calculo componentes"
     VIEW-AS ALERT-BOX INFO BUTTONS OK.



END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE calculos C-Win 
PROCEDURE calculos :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
 
 /*-- Borra los registros de consumos agregados anteriormente --*/ 
     
 FOR EACH B-T-Ofabrica_dt WHERE B-T-Ofabrica_dt.tipo_detalle = "C":
     DELETE B-T-Ofabrica_dt.
 END.
/*
  OPEN QUERY BRW-COMPONENTES 
     FOR EACH T-Ofabrica_dt WHERE T-Ofabrica_dt.tipo_detalle = "C",
      EACH Componente OF T-Ofabrica_dt. 
*/
 /*-- Renumera las líneas de producto para que queden arriba --*/ 

 FOR EACH B-T-Ofabrica_dt WHERE B-T-Ofabrica_dt.nro_linea < 10000:
     B-T-Ofabrica_dt.nro_linea = B-T-Ofabrica_dt.nro_linea + 10000.
 END.

 T-Ofabrica_hd.ultima_linea = 0.
 FOR EACH B-T-Ofabrica_dt WHERE B-T-Ofabrica_dt.nro_linea > 10000:
     T-Ofabrica_hd.ultima_linea = T-Ofabrica_hd.ultima_linea + 1.
     B-T-Ofabrica_dt.nro_linea = T-Ofabrica_hd.ultima_linea.
 END.

/*-- Ahora, agrega los registros de consumos en base a las formulas --*/ 

 FOR EACH B-T-Ofabrica_dt WHERE B-T-Ofabrica_dt.tipo_detalle = "P", 
     FIRST Compuesto OF B-T-Ofabrica_dt,EACH Formula_articulo
                                      WHERE Formula_articulo.nro_art_compuesto = Compuesto.nro_articulo:

     CREATE T-Consumo.
     ASSIGN T-Ofabrica_hd.ultima_linea = T-Ofabrica_hd.ultima_linea + 1
            T-Consumo.nro_linea        = T-Ofabrica_hd.ultima_linea
            T-Consumo.tipo_detalle     = "C"
            T-Consumo.nro_articulo     = Formula_articulo.nro_art_componente
            T-Consumo.cantidad_sol     = B-T-Ofabrica_dt.cantidad_sol / Formula_articulo.cantidad_compuesto * Formula_articulo.cantidad_componente
            T-Consumo.granel_sol       = B-T-Ofabrica_dt.granel_sol / Formula_articulo.granel_compuesto * Formula_articulo.granel_componente.
            
 END.

 RUN abre_query_componentes.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE crear_detalle_componente C-Win 
PROCEDURE crear_detalle_componente :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  CREATE T-Ofabrica_dt.
  ASSIGN T-Ofabrica_hd.ultima_linea = T-Ofabrica_hd.ultima_linea + 1
         T-Ofabrica_dt.nro_linea    = T-Ofabrica_hd.ultima_linea 
         T-Ofabrica_dt.nro_articulo = Articulo.nro_articulo
         T-Ofabrica_dt.tipo_detalle = "C". 

  RUN abre_query_componentes.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE crear_detalle_producto C-Win 
PROCEDURE crear_detalle_producto :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  CREATE T-Ofabrica_dt.
  ASSIGN T-Ofabrica_hd.ultima_linea = T-Ofabrica_hd.ultima_linea + 1
         T-Ofabrica_dt.nro_linea    = T-Ofabrica_hd.ultima_linea 
         T-Ofabrica_dt.nro_articulo = Articulo.nro_articulo
         T-Ofabrica_dt.tipo_detalle = "P". 

  RUN abre_query_compuestos.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE crear_registro C-Win 
PROCEDURE crear_registro :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  DO TRANSACTION:
    
      CREATE T-Ofabrica_hd.
      ASSIGN T-Ofabrica_hd.nro_usuario    = Usuario.nro_usuario 
             T-Ofabrica_hd.cdg_empresa    = Empresa.cdg_empresa
             T-Ofabrica_hd.fecha          = TODAY 
             T-Ofabrica_hd.tip_comprob    = "OF" 
             T-Ofabrica_hd.nro_ofabrica   = 0  
             T-Ofabrica_hd.estado         = "E" 
             T-Ofabrica_hd.cdg_estado     = "AA"              
             T-Ofabrica_hd.nro_comprob    = T-Ofabrica_hd.nro_ofabrica
             T-Ofabrica_hd.prf_comprob    = 0 /* v-pto_venta */
             T-Ofabrica_hd.origen         = "M".
      /*
             v-cdg_moneda                = Moneda.cdg_moneda
             v-dsc_moneda                = Moneda.descripcion
             v-cdg_imputacion            = Imputacion.cdg_imputacion
             v-dsc_imputacion            = Imputacion.dsc_imputacion 
             v-cdg_deposito              = Deposito.cdg_deposito
             v-dsc_deposito              = Deposito.nombre. 
      */      

  END.

  DISPLAY
         T-Ofabrica_hd.tip_comprob
         T-Ofabrica_hd.fecha   
         WITH FRAME {&FRAME-NAME}.

  codigo_salir = ?.

  IF    modo = MD_MULTIPLE
     OR modo = MD_ANULACION
     OR modo = MD_EMISION
  THEN DO:
       DO WITH FRAME {&FRAME-NAME}:
          
          T-Ofabrica_hd.tip_comprob:FGCOLOR = 9.
          T-Ofabrica_hd.tip_comprob:BGCOLOR = 15.

          T-Ofabrica_hd.prf_comprob:FGCOLOR = 9.
          T-Ofabrica_hd.prf_comprob:BGCOLOR = 15.
          
          T-Ofabrica_hd.nro_comprob:FGCOLOR = 9.
          T-Ofabrica_hd.nro_comprob:BGCOLOR = 15.
       END.
  END.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE disable_UI C-Win  _DEFAULT-DISABLE
PROCEDURE disable_UI :
/*------------------------------------------------------------------------------
  Purpose:     DISABLE the User Interface
  Parameters:  <none>
  Notes:       Here we clean-up the user-interface by deleting
               dynamic widgets we have created and/or hide 
               frames.  This procedure is usually called when
               we are ready to "clean-up" after running.
------------------------------------------------------------------------------*/
  /* Delete the WINDOW we created */
  IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(C-Win)
  THEN DELETE WIDGET C-Win.
  IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE enable_UI C-Win  _DEFAULT-ENABLE
PROCEDURE enable_UI :
/*------------------------------------------------------------------------------
  Purpose:     ENABLE the User Interface
  Parameters:  <none>
  Notes:       Here we display/view/enable the widgets in the
               user-interface.  In addition, OPEN all queries
               associated with each FRAME and BROWSE.
               These statements here are based on the "Other 
               Settings" section of the widget Property Sheets.
------------------------------------------------------------------------------*/

  {&OPEN-QUERY-DEFAULT-FRAME}
  GET FIRST DEFAULT-FRAME.
  DISPLAY v-tip_plan v-prf_plan v-nro_plan v-cdg_operacionfabrica 
          v-dsc_operacionfabrica v-cdg_centrotrabajo v-dsc_centrotrabajo 
          v-cdg_area v-dsc_area v-cdg_empleado v-dsc_empleado v-cdg_producto 
          v-estado v-cdg_insumo v-anulado 
      WITH FRAME DEFAULT-FRAME IN WINDOW C-Win.
  IF AVAILABLE T-Ofabrica_hd THEN 
    DISPLAY T-Ofabrica_hd.tip_comprob T-Ofabrica_hd.prf_comprob 
          T-Ofabrica_hd.nro_comprob T-Ofabrica_hd.fecha T-Ofabrica_hd.leyenda 
      WITH FRAME DEFAULT-FRAME IN WINDOW C-Win.
  ENABLE Btn_salir T-Ofabrica_hd.tip_comprob T-Ofabrica_hd.prf_comprob 
         T-Ofabrica_hd.nro_comprob T-Ofabrica_hd.fecha v-cdg_area 
         v-cdg_empleado T-Ofabrica_hd.leyenda BRW-COMPUESTOS BRW-COMPONENTES 
         RECT-2 RECT-3 
      WITH FRAME DEFAULT-FRAME IN WINDOW C-Win.
  {&OPEN-BROWSERS-IN-QUERY-DEFAULT-FRAME}
  VIEW C-Win.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE frame_sensitiva C-Win 
PROCEDURE frame_sensitiva :
/*------------------------------------------------------------------------------
  Purpose: habilita o deshabilita los campos de la frame para el estado inicial
           de la misma que se da cuando comienza el ciclo de transaccion. El es-
           tado definitivo de los campos lo ajusta la rutina habilitar_campos ( INPUT YES ).   
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  DEFINE INPUT PARAMETER habilitado AS LOGICAL.

  DO WITH FRAME {&FRAME-NAME}:

     IF NOT habilitado
     THEN DO:
          ASSIGN
                btn_grabar:SENSITIVE                      = NO
                btn_copiar:SENSITIVE                      = NO
                
                btn_cancel:SENSITIVE                      = NO

                btn_anular:SENSITIVE                      = NO
                btn_imprim:SENSITIVE                      = NO

                T-Ofabrica_hd.tip_comprob:SENSITIVE       = NO
                T-Ofabrica_hd.prf_comprob:SENSITIVE       = NO
                T-Ofabrica_hd.nro_comprob:SENSITIVE       = NO
                T-Ofabrica_hd.fecha:SENSITIVE             = NO
                v-cdg_operacionfabrica:SENSITIVE          = NO
                v-cdg_centrotrabajo:SENSITIVE             = NO
                v-cdg_area:SENSITIVE                      = NO
                v-cdg_empleado:SENSITIVE                  = NO.

     END.
     ELSE DO:

            RUN frame_sensitiva ( NO ).

            CASE modo:
       
                WHEN MD_ALTA          
                THEN DO:
                     ASSIGN
                        btn_grabar:SENSITIVE                      = YES
                        btn_copiar:SENSITIVE                      = YES
                        btn_cancel:SENSITIVE                      = YES
                        btn_imprim:SENSITIVE                      = YES
                        v-cdg_operacionfabrica:SENSITIVE          = YES
                        v-cdg_centrotrabajo:SENSITIVE             = YES
                        v-cdg_area:SENSITIVE                      = YES
                        v-cdg_empleado:SENSITIVE                  = YES.

                END.
                WHEN MD_MULTIPLE      
                THEN DO:
                     ASSIGN
                        T-Ofabrica_hd.tip_comprob:SENSITIVE        = YES
                        T-Ofabrica_hd.prf_comprob:SENSITIVE        = YES
                        T-Ofabrica_hd.nro_comprob:SENSITIVE        = YES.

                END.
                WHEN MD_DEFINIDA      
                THEN DO:
         
                END.
                WHEN MD_RELACION      
                THEN DO:
         
                END.
                WHEN MD_READONLY      
                THEN DO:
         
                END.
                WHEN MD_CAMBIO        
                THEN DO:

                END.
                WHEN MD_ANULACION        
                THEN DO:
                     ASSIGN
                        T-Ofabrica_hd.tip_comprob:SENSITIVE        = YES
                        T-Ofabrica_hd.prf_comprob:SENSITIVE        = YES
                        T-Ofabrica_hd.nro_comprob:SENSITIVE        = YES.
                END.
                WHEN MD_EMISION        
                THEN DO:
                     ASSIGN
                        T-Ofabrica_hd.tip_comprob:SENSITIVE        = YES
                        T-Ofabrica_hd.prf_comprob:SENSITIVE        = YES
                        T-Ofabrica_hd.nro_comprob:SENSITIVE        = YES.
                END.
       
           END CASE.     
     END.
  END.
  
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE habilitar_campos C-Win 
PROCEDURE habilitar_campos :
/*------------------------------------------------------------------------------
  Purpose: habilita o deshabilita los campos de la frame para el estado final
           de la misma que se da cuando se ejecuta el ciclo de transaccion. El es-
           tado inicial de los campos lo ajusta la rutina frame_sensitiva.   
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  DEFINE INPUT PARAMETER habilitado AS LOGICAL.

  DO WITH FRAME {&FRAME-NAME}:

    ASSIGN
          btn_grabar:SENSITIVE                      = NO
          btn_copiar:SENSITIVE                      = NO
          btn_cancel:SENSITIVE                      = NO
          btn_anular:SENSITIVE                      = NO

          btn_imprim:SENSITIVE                      = NO
          T-Ofabrica_hd.tip_comprob:SENSITIVE       = NO
          T-Ofabrica_hd.prf_comprob:SENSITIVE       = NO
          T-Ofabrica_hd.nro_comprob:SENSITIVE       = NO
          T-Ofabrica_hd.fecha:SENSITIVE             = NO
          T-Ofabrica_hd.leyenda:SENSITIVE           = NO
          v-cdg_producto:SENSITIVE                  = NO
          v-cdg_insumo:SENSITIVE                    = NO
          v-cdg_area:SENSITIVE                      = NO
          v-cdg_empleado:SENSITIVE                  = NO
          v-cdg_operacionfabrica:SENSITIVE          = NO
          v-cdg_centrotrabajo:SENSITIVE             = NO
          BRW-COMPUESTOS:READ-ONLY                  = YES
          BRW-COMPONENTES:READ-ONLY                 = YES.

     CASE modo:

       WHEN MD_ALTA          
       THEN DO:
            ASSIGN
                btn_cancel:SENSITIVE                       = YES
                btn_imprim:SENSITIVE                       = YES
                T-Ofabrica_hd.tip_comprob:SENSITIVE        = NO
                T-Ofabrica_hd.prf_comprob:SENSITIVE        = NO
                T-Ofabrica_hd.nro_comprob:SENSITIVE        = NO
                BRW-COMPUESTOS:READ-ONLY                   = NO
                BRW-COMPONENTES:READ-ONLY                  = NO.

       END.
       WHEN MD_MULTIPLE      
       THEN DO:
            ASSIGN
                btn_cancel:SENSITIVE                      = YES

                btn_imprim:SENSITIVE                      = YES
                T-Ofabrica_hd.tip_comprob:SENSITIVE        = NO
                T-Ofabrica_hd.prf_comprob:SENSITIVE        = NO
                T-Ofabrica_hd.nro_comprob:SENSITIVE        = NO.
       END.
       WHEN MD_DEFINIDA      
       THEN DO:
            ASSIGN

                btn_imprim:SENSITIVE                      = YES.
       END.
       WHEN MD_RELACION      
       THEN DO:
            ASSIGN
                btn_imprim:SENSITIVE                      = YES.
       END.
       WHEN MD_READONLY      
       THEN DO:
            ASSIGN
                btn_imprim:SENSITIVE                      = YES.
       END.
       WHEN MD_CAMBIO        
       THEN DO:
            ASSIGN

                btn_imprim:SENSITIVE                      = YES.
       END.
       WHEN MD_ANULACION        
       THEN DO:
            ASSIGN
                btn_anular:SENSITIVE                      = YES
                btn_imprim:SENSITIVE                      = YES.
       END.
       WHEN MD_EMISION        
       THEN DO:
            ASSIGN
                btn_grabar:SENSITIVE                      = YES
                btn_imprim:SENSITIVE                      = YES.

       END.

    END CASE.     

  END.
  
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE iniciar_documento C-Win 
PROCEDURE iniciar_documento :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  RUN titulo_window ("Ordenes de Fábrica").

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE poner_operacion C-Win 
PROCEDURE poner_operacion :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  FOR EACH Articulo_operacion OF Operacionfabrica:

      CREATE T-Ofabrica_dt.
      ASSIGN T-Ofabrica_hd.ultima_linea = T-Ofabrica_hd.ultima_linea + 1
             T-Ofabrica_dt.nro_linea    = T-Ofabrica_hd.ultima_linea 
             T-Ofabrica_dt.nro_articulo = Articulo_operacion.nro_articulo
             T-Ofabrica_dt.cantidad_sol = Articulo_operacion.cantidad 
             T-Ofabrica_dt.cantidad     = Articulo_operacion.cantidad
             T-Ofabrica_dt.granel       = Articulo_operacion.granel
             T-Ofabrica_dt.granel_sol   = Articulo_operacion.granel.
      IF Articulo_operacion.rol = "P" 
          THEN T-Ofabrica_dt.tipo_detalle = "P". 
          ELSE T-Ofabrica_dt.tipo_detalle = "C". 

  END.

  RUN abre_query_compuestos.
  RUN abre_query_componentes.

  v-cdg_operacionfabrica:SENSITIVE IN FRAME {&FRAME-NAME} = NO.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE titulo_window C-Win 
PROCEDURE titulo_window :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

 DEFINE INPUT PARAMETER txtitulo AS CHARACTER.

 DEFINE VARIABLE v-txtitulo AS CHARACTER.

 CASE modo:
    
     WHEN MD_ALTA      THEN v-txtitulo = " Ingreso de " + txtitulo.
     WHEN MD_MULTIPLE  THEN v-txtitulo = " Consulta Múltiple de " + txtitulo.
     WHEN MD_DEFINIDA  THEN v-txtitulo = " Consulta Individual de " + txtitulo.
     WHEN MD_RELACION  THEN v-txtitulo = " Consulta Relacionada de " + txtitulo.
     WHEN MD_READONLY  THEN v-txtitulo = " Consulta Sólo Lectura de " + txtitulo.
     WHEN MD_CAMBIO    THEN v-txtitulo = " Modificación y Reemisión de " + txtitulo.
     WHEN MD_ANULACION THEN v-txtitulo = " Anulación de " + txtitulo.
     WHEN MD_EMISION   THEN v-txtitulo = " Emisión de " + txtitulo + "Pendientes".

 END CASE.     

 {&WINDOW-NAME}:TITLE = "DYNASYS/PRD " + NRO_RELEASE + " - " + Usuario.cdg_empresa + " - " + v-txtitulo + " User:" + USERID("sic").

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE traer_documento C-Win 
PROCEDURE traer_documento :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

   FIND Ofabrica_hd WHERE ROWID(Ofabrica_hd) = rid_ofabrica NO-LOCK.
   BUFFER-COPY Ofabrica_hd TO T-Ofabrica_hd.

   FOR EACH Ofabrica_dt OF Ofabrica_hd:
       CREATE T-Ofabrica_dt.
       BUFFER-COPY Ofabrica_dt TO T-Ofabrica_dt.
   END.    
   
   v-anulado = IF Ofabrica_hd.anulado THEN "ANULADA" ELSE "".

   RUN traer_tablas.
   DISPLAY
        T-Ofabrica_hd.fecha 
        T-Ofabrica_hd.leyenda
        v-cdg_area v-cdg_empleado 
        v-dsc_area v-dsc_empleado
        WITH FRAME {&FRAME-NAME}.

   RUN abre_query_compuestos.
   RUN abre_query_componentes.
       
   RUN habilitar_campos ( INPUT YES ).
   
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE traer_tablas C-Win 
PROCEDURE traer_tablas :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

END PROCEDURE.

