/* ************************  Control Triggers  ************************ */

&Scoped-define SELF-NAME v-des_fecha
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-des_fecha V-table-Win
ON MOUSE-MENU-DOWN OF v-des_fecha IN FRAME F-Main /* Del */
DO:

  fecha_inicial = DATE(v-des_fecha:SCREEN-VALUE IN FRAME {&FRAME-NAME}) NO-ERROR.
  IF fecha_inicial = ? THEN fecha_inicial = TODAY.
  RUN d-calendario.w ( INPUT fecha_inicial, OUTPUT fecha_elegida).
  IF fecha_elegida <> ?
  THEN DO:
       DISPLAY fecha_elegida @ v-des_fecha 
               WITH FRAME {&FRAME-NAME}.
       APPLY "RETURN" TO SELF.        
  END.               
  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-des_fecha V-table-Win
ON RETURN OF v-des_fecha IN FRAME F-Main /* Del */
DO:

    ASSIGN v-des_fecha.
    RUN get-link-handle IN adm-broker-hdl
           (THIS-PROCEDURE, 'RangoFechas-Target':U, OUTPUT c).
    IF NUM-ENTRIES (c) eq 1 
    THEN DO:
        h = WIDGET-HANDLE (c).
        RUN refrescar_browse IN h ( INPUT v-des_fecha, INPUT v-has_fecha ).
    END.
  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME v-has_fecha
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-has_fecha V-table-Win
ON MOUSE-MENU-DOWN OF v-has_fecha IN FRAME F-Main /* al */
DO:

  fecha_inicial = DATE(v-has_fecha:SCREEN-VALUE IN FRAME {&FRAME-NAME}) NO-ERROR.
  IF fecha_inicial = ? THEN fecha_inicial = TODAY.
  RUN d-calendario.w ( INPUT fecha_inicial, OUTPUT fecha_elegida).
  IF fecha_elegida <> ?
  THEN DO:
       DISPLAY fecha_elegida @ v-has_fecha 
               WITH FRAME {&FRAME-NAME}.
       APPLY "TAB" TO SELF.        
  END.               
  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-has_fecha V-table-Win
ON RETURN OF v-has_fecha IN FRAME F-Main /* al */
DO:
    ASSIGN v-has_fecha.
    RUN get-link-handle IN adm-broker-hdl
           (THIS-PROCEDURE, 'RangoFechas-Target':U, OUTPUT c).
    IF NUM-ENTRIES (c) eq 1 
    THEN DO:
        h = WIDGET-HANDLE (c).
        RUN refrescar_browse IN h ( INPUT v-des_fecha, INPUT v-has_fecha ).
    END.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


