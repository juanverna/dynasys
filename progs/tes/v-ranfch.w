     VIEW-AS FILL-IN 
     SIZE 7 BY .75
     BGCOLOR 15 FGCOLOR 9 FONT 4 NO-UNDO.

DEFINE VARIABLE has_fecha_bco AS DATE FORMAT "99/99/99":U INITIAL ? 
     LABEL "Al" 
     VIEW-AS FILL-IN 
     SIZE 7 BY .75
     BGCOLOR 15 FGCOLOR 9 FONT 4 NO-UNDO.

DEFINE VARIABLE t_movs AS DECIMAL FORMAT "->>,>>>,>>9.99":U INITIAL 0 
     LABEL "$" 
     VIEW-AS FILL-IN 
     SIZE 10.56 BY .81
     BGCOLOR 7 FGCOLOR 14 FONT 4 NO-UNDO.

DEFINE RECTANGLE RECT-4
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 43 BY 2.25.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME F-Main
     des_fecha_bco AT ROW 2.5 COL 5 COLON-ALIGNED
     has_fecha_bco AT ROW 2.5 COL 17 COLON-ALIGNED
     t_movs AT ROW 2.5 COL 29 COLON-ALIGNED
