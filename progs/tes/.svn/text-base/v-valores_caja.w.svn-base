     SIZE 81 BY 2.91.

DEFINE RECTANGLE RECT-7
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 53 BY 2.91.

/* Query definitions                                                    */
&ANALYZE-SUSPEND
DEFINE QUERY br_table FOR 
      Valor, 
      Banco SCROLLING.
&ANALYZE-RESUME

/* Browse definitions                                                   */
DEFINE BROWSE br_table
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _DISPLAY-FIELDS br_table B-table-Win _STRUCTURED
  QUERY br_table NO-LOCK DISPLAY
      Valor.numero_cheque FORMAT ">>>>>>>9":U
      Valor.cdg_banco COLUMN-LABEL "Código!Banco" FORMAT "999":U
      Valor.cdg_sucurbanco COLUMN-LABEL "Código!Sucur" FORMAT "999":U
      Banco.abrevia COLUMN-LABEL "Ident!Banco" FORMAT "X(5)":U
      Valor.fecha_deposito FORMAT "99/99/99":U
      Valor.dias_clearing COLUMN-LABEL "Días!Clg" FORMAT ">>9":U
      Valor.importe FORMAT "->>,>>>,>>9.99":U
      Valor.observacion COLUMN-LABEL "Observación!Cheque" FORMAT "X(55)":U
            WIDTH 65.8
/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME
    WITH NO-ASSIGN SEPARATORS SIZE 133 BY 11.43
         BGCOLOR 15 FGCOLOR 9 
         TITLE BGCOLOR 15 FGCOLOR 9 "Valores Pendientes de Depósito" EXPANDABLE.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME F-Main
     v-cdg_caja AT ROW 1.48 COL 12 COLON-ALIGNED
     v-nombre AT ROW 1.48 COL 29 COLON-ALIGNED NO-LABEL
