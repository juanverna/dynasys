     v-des_fecha AT ROW 5.05 COL 12 COLON-ALIGNED
     v-has_fecha AT ROW 5.05 COL 37 COLON-ALIGNED
     v-referencia AT ROW 5.05 COL 60 COLON-ALIGNED
     v-fecha_deposito AT ROW 5.05 COL 117 COLON-ALIGNED
     v-des_importe AT ROW 8.14 COL 12 COLON-ALIGNED
     v-has_importe AT ROW 8.14 COL 56 COLON-ALIGNED
     v-cdg_banco AT ROW 8.14 COL 92 COLON-ALIGNED
     v-numero_cheque AT ROW 8.14 COL 117 COLON-ALIGNED
     btn_depositar AT ROW 10.05 COL 2
     btn_seltodos AT ROW 10.05 COL 17
     btn_desmarcar AT ROW 10.05 COL 32
     btn_verlog AT ROW 10.05 COL 47
     btn_listar AT ROW 10.05 COL 62
     btn_comprobante AT ROW 10.05 COL 77
     v-cantcheques AT ROW 10.05 COL 99 COLON-ALIGNED
     v-totdeposito AT ROW 10.05 COL 113 COLON-ALIGNED
     br_table AT ROW 11.95 COL 2
     RECT-1 AT ROW 1 COL 1
     RECT-2 AT ROW 4.57 COL 1
     RECT-3 AT ROW 9.81 COL 1
     RECT-4 AT ROW 1 COL 112
     RECT-5 AT ROW 11.71 COL 1
     RECT-6 AT ROW 6.71 COL 1
     RECT-7 AT ROW 6.71 COL 84
     "            Modalidad" VIEW-AS TEXT
          SIZE 23 BY 1 AT ROW 1.48 COL 113
          BGCOLOR 5 FGCOLOR 15 
     "   Rango de importe de los valores a considerar:" VIEW-AS TEXT
          SIZE 79 BY 1 AT ROW 6.95 COL 2
          BGCOLOR 5 FGCOLOR 15 
     "   Seleccionar valor con numero y banco:" VIEW-AS TEXT
          SIZE 51 BY 1 AT ROW 6.95 COL 85
          BGCOLOR 5 FGCOLOR 15 
    WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY 
         SIDE-LABELS NO-UNDERLINE THREE-D 
         AT COL 1 ROW 1 SCROLLABLE 
         BGCOLOR 8 FGCOLOR 0 .


/* *********************** Procedure Settings ************************ */

&ANALYZE-SUSPEND _PROCEDURE-SETTINGS
/* Settings for THIS-PROCEDURE
   Type: SmartBrowser
   External Tables: sic.Caja
   Allow: Basic,Browse
   Frames: 1
   Add Fields to: EXTERNAL-TABLES
   Other Settings: PERSISTENT-ONLY COMPILE
 */

/* This procedure should always be RUN PERSISTENT.  Report the error,  */
/* then cleanup and return.                                            */
