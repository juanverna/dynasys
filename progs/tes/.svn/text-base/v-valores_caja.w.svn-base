v-des_fecha v-has_fecha v-referencia v-fecha_deposito v-des_importe ~
v-has_importe v-cdg_banco v-numero_cheque btn_depositar btn_seltodos ~
btn_desmarcar btn_verlog btn_listar btn_comprobante v-cantcheques ~
v-totdeposito br_table RECT-1 RECT-2 RECT-3 RECT-4 RECT-5 RECT-6 RECT-7 
&Scoped-Define DISPLAYED-OBJECTS v-cdg_caja v-nombre v-cdg_cuenta_ban ~
v-denominacion_cta v-depocanje v-des_fecha v-has_fecha v-referencia ~
v-fecha_deposito v-des_importe v-has_importe v-cdg_banco v-numero_cheque ~
v-cantcheques v-totdeposito 

/* Custom List Definitions                                              */
