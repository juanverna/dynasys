    'Keys-Accepted = "",
     Keys-Supplied = ""':U).
/**************************
</EXECUTING-CODE> */   

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


/* ***********************  Control Definitions  ********************** */


/* Definitions of the field level widgets                               */
DEFINE BUTTON btn_desaplica 
     LABEL "&Anular" 
     SIZE 12.8 BY 1.

DEFINE VARIABLE v-anulada AS CHARACTER FORMAT "X(256)":U INITIAL "ANULADA" 
     VIEW-AS FILL-IN 
     SIZE 14 BY 1
     BGCOLOR 9 FGCOLOR 14 FONT 6 NO-UNDO.

DEFINE VARIABLE v-cdg_cliente AS CHARACTER FORMAT "X(256)":U 
     LABEL "Cliente" 
     VIEW-AS FILL-IN 
     SIZE 14 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-cdg_cobrador AS CHARACTER FORMAT "X(8)" 
     LABEL "Cobrador" 
     VIEW-AS FILL-IN NATIVE 
     SIZE 13.6 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-nom_cliente AS CHARACTER FORMAT "X(256)":U 
     VIEW-AS FILL-IN 
     SIZE 39 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-nom_cobrador AS CHARACTER FORMAT "X(256)":U 
     VIEW-AS FILL-IN NATIVE 
     SIZE 74 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE RECTANGLE RECT-2
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL   
     SIZE 155 BY 2.86.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME F-Main
     Rendicion_hd.cant_recibos AT ROW 1.24 COL 10 COLON-ALIGNED
          LABEL "Comprob"
          VIEW-AS FILL-IN NATIVE 
          SIZE 9 BY 1
          BGCOLOR 15 FGCOLOR 9 
     Rendicion_hd.imp_imputado AT ROW 1.24 COL 23 COLON-ALIGNED
          LABEL "$"
          VIEW-AS FILL-IN NATIVE 
          SIZE 15 BY 1
          BGCOLOR 15 FGCOLOR 9 
     v-cdg_cliente AT ROW 1.24 COL 46 COLON-ALIGNED WIDGET-ID 4
     v-nom_cliente AT ROW 1.24 COL 61 COLON-ALIGNED NO-LABEL WIDGET-ID 6
     Rendicion_hd.fch_rendicion AT ROW 1.24 COL 108 COLON-ALIGNED
          LABEL "Fecha"
          VIEW-AS FILL-IN NATIVE 
          SIZE 15 BY 1
          BGCOLOR 15 FGCOLOR 9 
     btn_desaplica AT ROW 1.24 COL 126
     v-anulada AT ROW 1.24 COL 139 COLON-ALIGNED NO-LABEL WIDGET-ID 2
     v-cdg_cobrador AT ROW 2.43 COL 10 COLON-ALIGNED HELP
          "Código del cobrador" WIDGET-ID 8
     v-nom_cobrador AT ROW 2.43 COL 26 COLON-ALIGNED NO-LABEL WIDGET-ID 10
     RECT-2 AT ROW 1 COL 1
    WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY 
         SIDE-LABELS NO-UNDERLINE THREE-D 
         AT COL 1 ROW 1 SCROLLABLE 
         FONT 4.


/* *********************** Procedure Settings ************************ */

&ANALYZE-SUSPEND _PROCEDURE-SETTINGS
/* Settings for THIS-PROCEDURE
   Type: SmartViewer
   External Tables: sic.Rendicion_hd
   Allow: Basic,DB-Fields
   Frames: 1
   Add Fields to: EXTERNAL-TABLES
   Other Settings: PERSISTENT-ONLY COMPILE
 */

/* This procedure should always be RUN PERSISTENT.  Report the error,  */
/* then cleanup and return.                                            */
IF NOT THIS-PROCEDURE:PERSISTENT THEN DO:
  MESSAGE "{&FILE-NAME} should only be RUN PERSISTENT.":U
          VIEW-AS ALERT-BOX ERROR BUTTONS OK.
  RETURN.
END.

&ANALYZE-RESUME _END-PROCEDURE-SETTINGS

