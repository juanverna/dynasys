ON LEAVE OF v-des_importe IN FRAME DEFAULT-FRAME /* Desde */
DO:
    ASSIGN FRAME {&FRAME-NAME} v-des_importe.
    RUN abrir_query_disponibles.
  
END.

/* _UIB-CODE-BLOCK-END */
