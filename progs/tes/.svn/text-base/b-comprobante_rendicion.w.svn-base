&ANALYZE-SUSPEND _UIB-PREPROCESSOR-BLOCK 

/* ********************  Preprocessor Definitions  ******************** */

&Scoped-define PROCEDURE-TYPE SmartBrowser
&Scoped-define DB-AWARE no

&Scoped-define ADM-SUPPORTED-LINKS Record-Source,Record-Target,TableIO-Target

/* Name of first Frame and/or Browse and/or first Query                 */
&Scoped-define FRAME-NAME F-Main
&Scoped-define BROWSE-NAME br_table

/* External Tables                                                      */
&Scoped-define EXTERNAL-TABLES Rendicion_hd
&Scoped-define FIRST-EXTERNAL-TABLE Rendicion_hd


/* Need to scope the external tables to this procedure                  */
DEFINE QUERY external_tables FOR Rendicion_hd.
/* Internal Tables (found by Frame, Query & Browse Queries)             */
&Scoped-define INTERNAL-TABLES comprobante_rendicion fac_header Cliente

/* Define KEY-PHRASE in case it is used by any query. */
&Scoped-define KEY-PHRASE TRUE

/* Definitions for BROWSE br_table                                      */
&Scoped-define FIELDS-IN-QUERY-br_table fac_header.tip_comprob ~
fac_header.prf_comprob fac_header.nro_comprob fac_header.cdg_zonag ~
Fac_header.imp_total comprobante_rendicion.este_pago Cliente.cdg_cliente ~
Cliente.nom_cliente 
&Scoped-define ENABLED-FIELDS-IN-QUERY-br_table 
&Scoped-define QUERY-STRING-br_table FOR EACH comprobante_rendicion OF Rendicion_hd WHERE ~{&KEY-PHRASE} NO-LOCK, ~
      EACH fac_header OF comprobante_rendicion NO-LOCK, ~
      EACH Cliente OF fac_header NO-LOCK ~
    ~{&SORTBY-PHRASE} INDEXED-REPOSITION
&Scoped-define OPEN-QUERY-br_table OPEN QUERY br_table FOR EACH comprobante_rendicion OF Rendicion_hd WHERE ~{&KEY-PHRASE} NO-LOCK, ~
      EACH fac_header OF comprobante_rendicion NO-LOCK, ~
      EACH Cliente OF fac_header NO-LOCK ~
    ~{&SORTBY-PHRASE} INDEXED-REPOSITION.
&Scoped-define TABLES-IN-QUERY-br_table comprobante_rendicion fac_header ~
Cliente
&Scoped-define FIRST-TABLE-IN-QUERY-br_table comprobante_rendicion
&Scoped-define SECOND-TABLE-IN-QUERY-br_table fac_header
&Scoped-define THIRD-TABLE-IN-QUERY-br_table Cliente


/* Definitions for FRAME F-Main                                         */

/* Standard List Definitions                                            */
&Scoped-Define ENABLED-OBJECTS br_table 

/* Custom List Definitions                                              */
/* List-1,List-2,List-3,List-4,List-5,List-6                            */

