            T-Fac_header.imp_descuentos           LABEL "imp_descuentos    "
            T-Fac_header.imp_iva                  LABEL "imp_iva           "
            T-Fac_header.imp_neto                 LABEL "imp_neto          "
            T-Fac_header.imp_total                LABEL "imp_total         "
            T-Fac_header.leyenda                  LABEL "leyenda           " FORMAT "X(30)"
            T-Fac_header.leyenda_cc               LABEL "leyenda_cc        "
            T-Fac_header.localidad                LABEL "localidad         "
            T-Fac_header.localidad_leg            LABEL "localidad_leg     "
            T-Fac_header.mes                      LABEL "mes               "
            T-Fac_header.modo_abasto              LABEL "modo_abasto       "
            T-Fac_header.modo_remito              LABEL "modo_remito       "
            T-Fac_header.monto_letras             LABEL "monto_letras      "
            T-Fac_header.nombre                   LABEL "nombre            "
            T-Fac_header.nombre_domicilio         LABEL "nombre_domicilio  "
            T-Fac_header.nombre_leg               LABEL "nombre_leg        "
            T-Fac_header.nro_cliente              LABEL "nro_cliente       "
            T-Fac_header.nro_cndventa             LABEL "nro_cndventa      "
            T-Fac_header.nro_comprob              LABEL "nro_comprob       "
            T-Fac_header.nro_contrato             LABEL "nro_contrato      "
            T-Fac_header.nro_domicilio            LABEL "nro_domicilio     "
            T-Fac_header.nro_entidad              LABEL "nro_entidad       "
            T-Fac_header.nro_factura              LABEL "nro_factura       "
            T-Fac_header.nro_moneda               LABEL "nro_moneda        "
            T-Fac_header.nro_obra                 LABEL "nro_obra          "
            T-Fac_header.nro_ocm                  LABEL "nro_ocm           "
            T-Fac_header.nro_remito               LABEL "nro_remito        "
            T-Fac_header.nro_transaccion          LABEL "nro_transaccion   "
            T-Fac_header.nro_usuario              LABEL "nro_usuario       "
            T-Fac_header.nro_vendedor             LABEL "nro_vendedor      "
            T-Fac_header.num_sucursal             LABEL "num_sucursal      "
            T-Fac_header.observacion              LABEL "observacion       "
            T-Fac_header.origen                   LABEL "origen            "
            T-Fac_header.pc_name                  LABEL "pc_name           "
            T-Fac_header.prc_canje                LABEL "prc_canje         "
            T-Fac_header.prf_comprob              LABEL "prf_comprob       "
            T-Fac_header.proc_estad               LABEL "proc_estad        "
            T-Fac_header.rige_hasta               LABEL "rige_hasta        "
            T-Fac_header.tip_comprob              LABEL "tip_comprob       "
            T-Fac_header.ultima_linea             LABEL "ultima_linea      "
            WITH SIDE-LABELS 4 COLUMNS STREAM-IO TITLE "Encabezado de factura" WIDTH 192.

    FOR EACH T-Fac_header-bon OF T-Fac_header:
        DISPLAY 
            T-Fac_header-bon EXCEPT nro_factura WITH STREAM-IO
              TITLE "Bonificaciones de cabecera".
    END.

    FOR EACH T-Fac_header_impuesto OF T-Fac_header:
        DISPLAY 
            T-Fac_header_impuesto EXCEPT nro_factura WITH STREAM-IO
              TITLE "Impuestos de cabecera".
    END.

    FOR EACH T-Fac_detalle OF T-Fac_header:

        DISPLAY 
            T-Fac_detalle.nro_linea                  COLUMN-LABEL "nro!linea"   
            T-Fac_detalle.nro_articulo               COLUMN-LABEL "nro!articulo"
            T-Fac_detalle.nro_partida                COLUMN-LABEL "nro!partida"
            T-Fac_detalle.cantidad                   COLUMN-LABEL "canti-!dad"
            T-Fac_detalle.precio                     COLUMN-LABEL "precio!neto"
            T-Fac_detalle.precio_cf                  COLUMN-LABEL "precio!cf"
            T-Fac_detalle.subtotal_general           COLUMN-LABEL "subtotal!general"
            T-Fac_detalle.subtotal_gral_cf           COLUMN-LABEL "subtotal!gral_cf"
            T-Fac_detalle.subtotal_bruto             COLUMN-LABEL "subtotal!bruto"
            T-Fac_detalle.subtotal_bruto_cf          COLUMN-LABEL "subtotal!bruto_cf"
            T-Fac_detalle.subtotal_neto              COLUMN-LABEL "subtotal!neto"
            T-Fac_detalle.subtotal_neto_cf           COLUMN-LABEL "subtotal!neto_cf"
             WITH STREAM-IO TITLE "Detalle de factura" WIDTH 192.

    END.

    FOR EACH T-Fac_detalle-bon OF T-Fac_header:
        DISPLAY 
            T-Fac_detalle-bon EXCEPT nro_factura WITH STREAM-IO
              TITLE "Bonificaciones de detalle".
    END.

    FOR EACH T-Fac_detalle_impuesto OF T-Fac_header:
        DISPLAY  T-Fac_detalle_impuesto EXCEPT nro_factura WITH STREAM-IO
              TITLE "Impuestos de detalle".
    END.

    OUTPUT CLOSE .

    RUN veresult.w ( INPUT "c:\sic-temp\dumpfactura.txt", INPUT 22 ).
    */

END PROCEDURE.

PROCEDURE calcular_asiento_contable:
   
   FIND Tipocomprobante OF T-Fac_header NO-LOCK.  
   FIND FIRST T-Sub_header_vta.

   FIND Cliente OF T-Fac_header NO-LOCK NO-ERROR.
   CREATE T-Asn_header.
   ASSIGN T-Asn_header.anulado           = NO
          T-Asn_header.cdg_empresa       = T-Sub_header_vta.cdg_empresa
          T-Asn_header.cdg_sigla-sic     = "FAC"
          T-Asn_header.nro_idcabecera    = T-Fac_header.nro_factura 
          T-Asn_header.cdg_librocontable = T-Fac_header.cdg_librocontable
          T-Asn_header.tabla_comprobante = "Fac_header"
          T-Asn_header.posteo            = "0"
          
          T-Asn_header.reexpresa_saldos  = Tipocomprobante.reexpresa_movimiento
          T-Asn_header.cambio            = T-Sub_header_vta.cambio
          T-Asn_header.cambio_dolar      = T-Sub_header_vta.cambio_dolar
          T-Asn_header.fecha             = T-Sub_header_vta.fecha
          T-Asn_header.leyenda           = T-Sub_header_vta.tip_comprob + " " +
                                           STRING(T-Sub_header_vta.prf_comprob,"9999") + " " +
                                           STRING(T-Sub_header_vta.nro_comprob,"99999999") +  " " +
                                           IF AVAILABLE Cliente 
                                              THEN "[" + Cliente.cdg_cliente + "] " + Cliente.nom_cliente
                                              ELSE ""
          T-Asn_header.nro_asiento       = 0
          T-Asn_header.nro_comprob       = 0
          T-Asn_header.nro_usuario       = Usuario.nro_usuario
          T-Asn_header.origen            = "A"
          T-Asn_header.tip_comprob       = "AS"
          T-Asn_header.estado            = IF T-Sub_header_vta.contable THEN "*" ELSE "P".
          

   IF Tipocomprobante.debita  /* Debitamos encabezado si corresponde */
   THEN DO: 
       FIND Obra WHERE Obra.cdg_obra = T-Fac_header.cdg_empresa NO-LOCK.
       CREATE T-Asn_detalle.
       ASSIGN T-Asn_header.ultima_linea       = T-Asn_header.ultima_linea + 1
              T-Asn_detalle.cdg_empresa       = T-Asn_header.cdg_empresa
              T-Asn_detalle.credito           = 0
              T-Asn_detalle.debito            = T-Sub_header_vta.imp_total
              T-Asn_detalle.cambio            = T-Sub_header_vta.cambio
              T-Asn_detalle.cambio_dolar      = 1
              T-Asn_detalle.fecha_mayor       = T-Asn_header.fecha
              T-Asn_detalle.nro_asiento       = T-Asn_header.nro_asiento
              T-Asn_detalle.nro_cuenta        = T-Sub_header_vta.nro_cuenta
              T-Asn_detalle.nro_entidad       = T-Sub_header_vta.nro_entidad
              T-Asn_detalle.nro_linea         = T-Asn_header.ultima_linea
              T-Asn_detalle.nro_moneda        = T-Sub_header_vta.nro_moneda
              T-Asn_detalle.cdg_sigla-sic     = T-Asn_header.cdg_sigla-sic
              T-Asn_detalle.cdg_librocontable = T-Asn_header.cdg_librocontable
              T-Asn_detalle.leyen_detalle     = T-Asn_header.leyenda
              T-Asn_detalle.nro_obra          = Obra.nro_obra
              T-Asn_detalle.nro_subcuenta     = 0.

   END.     

   FOR EACH T-Sub_detalle_vta WHERE T-Sub_detalle_vta.cdg_empresa   = T-Sub_header_vta.cdg_empresa
                                AND T-Sub_detalle_vta.tip_comprob   = T-Sub_header_vta.tip_comprob
                                AND T-Sub_detalle_vta.prf_comprob   = T-Sub_header_vta.prf_comprob
                                AND T-Sub_detalle_vta.nro_comprob   = T-Sub_header_vta.nro_comprob
                                    EXCLUSIVE-LOCK, Cuenta OF T-Sub_detalle_vta:

       CREATE T-Asn_detalle.
       ASSIGN T-Asn_header.ultima_linea       = T-Asn_header.ultima_linea + 1
              T-Asn_detalle.cdg_empresa       = T-Asn_header.cdg_empresa
              T-Asn_detalle.fecha_mayor       = T-Asn_header.fecha
              T-Asn_detalle.leyen_detalle     = T-Asn_header.leyenda
              T-Asn_detalle.nro_asiento       = T-Asn_header.nro_asiento
              T-Asn_detalle.nro_cuenta        = T-Sub_detalle_vta.nro_cuenta
              T-Asn_detalle.nro_entidad       = T-Sub_detalle_vta.nro_entidad
              T-Asn_detalle.nro_linea         = T-Asn_header.ultima_linea
              T-Asn_detalle.nro_moneda        = T-Sub_header_vta.nro_moneda
              T-Asn_detalle.nro_obra          = T-Sub_detalle_vta.nro_obra  
              T-Asn_detalle.cdg_sigla-sic     = T-Asn_header.cdg_sigla-sic
              T-Asn_detalle.cdg_librocontable = T-Asn_header.cdg_librocontable
              T-Asn_detalle.leyen_detalle     = T-Asn_header.leyenda
              T-Asn_detalle.nro_subcuenta     = 0
              T-Asn_detalle.cambio            = T-Sub_header_vta.cambio
              T-Asn_detalle.cambio_dolar      = 1.

       IF Tipocomprobante.debita
       THEN DO:
           T-Asn_detalle.credito  = T-Sub_detalle_vta.valor.
           T-Asn_detalle.debito   = 0.
       END.
       ELSE DO:
           T-Asn_detalle.credito  = 0.
           T-Asn_detalle.debito   = T-Sub_detalle_vta.valor.
       END.


   END. /* De los detalles de subdiario de Compras */
       
   IF NOT Tipocomprobante.debita /* Acreditamos encabezado si corresponde */
   THEN DO: 
       FIND Obra WHERE Obra.cdg_obra = T-Fac_header.cdg_empresa NO-LOCK.
       CREATE T-Asn_detalle.
       ASSIGN T-Asn_header.ultima_linea       = T-Asn_header.ultima_linea + 1
              T-Asn_detalle.cdg_empresa       = T-Asn_header.cdg_empresa
              T-Asn_detalle.credito           = T-Sub_header_vta.imp_total
              T-Asn_detalle.debito            = 0
                                              
              T-Asn_detalle.cambio            = T-Sub_header_vta.cambio
              T-Asn_detalle.cambio_dolar      = 1
                                              
              T-Asn_detalle.fecha_mayor       = T-Asn_header.fecha
              T-Asn_detalle.leyen_detalle     = T-Asn_header.leyenda
              T-Asn_detalle.nro_asiento       = T-Asn_header.nro_asiento
              T-Asn_detalle.nro_cuenta        = T-Sub_header_vta.nro_cuenta
              T-Asn_detalle.nro_entidad       = T-Sub_header_vta.nro_entidad
              T-Asn_detalle.nro_linea         = T-Asn_header.ultima_linea
              T-Asn_detalle.nro_moneda        = T-Sub_header_vta.nro_moneda
              T-Asn_detalle.cdg_sigla-sic     = T-Asn_header.cdg_sigla-sic
              T-Asn_detalle.cdg_librocontable = T-Asn_header.cdg_librocontable
              T-Asn_detalle.leyen_detalle     = T-Asn_header.leyenda
              T-Asn_detalle.nro_obra          = Obra.nro_obra
              T-Asn_detalle.nro_subcuenta     = 0.

    END.     

    RUN reexpresar_asiento.p ( INPUT-OUTPUT TABLE T-Asn_header,
                               INPUT-OUTPUT TABLE T-Asn_detalle,
                               INPUT-OUTPUT TABLE T-Asn_totales).
    FIND FIRST T-Asn_header.
    
    T-Sub_header_vta.contable = YES.

END PROCEDURE.

