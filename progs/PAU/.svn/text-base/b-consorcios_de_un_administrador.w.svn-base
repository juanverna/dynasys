&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE tcalcular_analitico B-table-Win 
PROCEDURE tcalcular_analitico :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

   DEFINE OUTPUT PARAMETER saldo AS DECIMAL.

   DEFINE VARIABLE tot_debitogr AS DECIMAL.
   DEFINE VARIABLE tot_creditogr AS DECIMAL.
   DEF BUFFER bcta_cte FOR cta_cte.
   DEF BUFFER bcliente FOR cliente.
   tot_debitogr = 0.
   tot_creditogr = 0.

   /* Busca por Movimiento en el rango de fechas */
   FOR EACH bcliente WHERE bcliente.nro_administrador = cliente.nro_administrador:
   
       FOR EACH bcta_cte WHERE bcta_cte.nro_cliente = bcliente.nro_cliente
            AND bcta_cte.nro_moneda = moneda.nro_moneda
            AND bcta_cte.debito <> bCta_cte.credito :
    
            tot_debitogr  = tot_debitogr  + bcta_cte.debito.
            tot_creditogr = tot_creditogr + bcta_cte.credito.
    
       END.
   END.

   saldo = tot_debitogr - tot_creditogr.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

