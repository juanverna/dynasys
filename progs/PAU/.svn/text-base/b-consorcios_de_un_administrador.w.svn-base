   /* Busca por Movimiento desde principio de mes a la fecha */
   FOR EACH bcliente WHERE bcliente.nro_administrador = cliente.nro_administrador:

    FOR EACH bcta_cte WHERE bcta_cte.nro_cliente = bcliente.nro_cliente

        AND bcta_cte.nro_moneda = moneda.nro_moneda:
        IF CAN-DO(str_debitan,bcta_cte.tip_comprob)
         THEN DO: tot_debitogr  = tot_debitogr + bcta_cte.debito.
         END.
         ELSE DO: tot_creditogr = tot_creditogr + bcta_cte.credito.
         END.

   END.
