/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


/* ***********************  Control Definitions  ********************** */


/* Definitions of the field level widgets                               */
DEFINE BUTTON btn_consolidado 
     LABEL "&Consolidado" 
     SIZE 19 BY 1.14.

DEFINE BUTTON btn_credito 
     LABEL "&Estado Crediticio" 
     SIZE 19 BY 1.14.

DEFINE BUTTON btn_imprimir 
     LABEL "&Imprimir" 
     SIZE 19 BY 1.14.

DEFINE BUTTON btn_integral 
     LABEL "&Integral" 
     SIZE 17 BY 1.19.

DEFINE BUTTON bzoom 
     LABEL "Zoom" 
     SIZE 17.2 BY 1.14.

DEFINE VARIABLE id_moneda AS INTEGER FORMAT ">>9":U INITIAL ? 
     LABEL "Moneda" 
     VIEW-AS COMBO-BOX INNER-LINES 5
     LIST-ITEM-PAIRS "Item 1",1
     DROP-DOWN-LIST
     SIZE 27 BY 1
     BGCOLOR 15 FGCOLOR 9 FONT 4 NO-UNDO.

DEFINE VARIABLE des_fecha AS DATE FORMAT "99/99/9999":U 
     LABEL "Del" 
     VIEW-AS FILL-IN NATIVE 
     SIZE 16 BY 1
     BGCOLOR 14 FGCOLOR 12  NO-UNDO.

DEFINE VARIABLE has_fecha AS DATE FORMAT "99/99/9999":U 
     LABEL "al" 
     VIEW-AS FILL-IN NATIVE 
     SIZE 16 BY 1
     BGCOLOR 14 FGCOLOR 12  NO-UNDO.

DEFINE VARIABLE ficha AS INTEGER INITIAL 2 
     VIEW-AS RADIO-SET VERTICAL
     RADIO-BUTTONS 
          "Histórico", 0,
"Analítico", 1,
"Vencido", 2
     SIZE 16 BY 2.14 NO-UNDO.

/* Query definitions                                                    */
&ANALYZE-SUSPEND
DEFINE QUERY br_table FOR 
      cliente SCROLLING.
&ANALYZE-RESUME

/* Browse definitions                                                   */
DEFINE BROWSE br_table
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _DISPLAY-FIELDS br_table B-table-Win _FREEFORM
  QUERY br_table NO-LOCK DISPLAY
      Cliente.direccion FORMAT "X(45)":U
      fcalcular_vencido() @ vencido COLUMN-LABEL "Vencido" FORMAT "->>>,>>9.99":U
            WIDTH 13.4
      fcalcular_analitico() @ analitico COLUMN-LABEL "Analitico" FORMAT "->>>,>>9.99":U
            WIDTH 13.2
      fcalcular_historico() @ historico COLUMN-LABEL "Historico" FORMAT "->>>,>>9.99":U
            WIDTH 13.2
      Cliente.cdg_cliente FORMAT "X(8)":U
      Cliente.nom_cliente FORMAT "X(40)":U
/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME
    WITH NO-ASSIGN SEPARATORS SIZE 146 BY 5.48 ROW-HEIGHT-CHARS .71.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME F-Main
     ficha AT ROW 1.19 COL 2.2 NO-LABEL WIDGET-ID 14
     des_fecha AT ROW 1.19 COL 27 COLON-ALIGNED WIDGET-ID 12
     has_fecha AT ROW 1.24 COL 46 COLON-ALIGNED WIDGET-ID 8
     btn_credito AT ROW 1.24 COL 86.8 WIDGET-ID 20
     btn_imprimir AT ROW 1.24 COL 106.8 WIDGET-ID 22
     btn_integral AT ROW 1.24 COL 126.8 WIDGET-ID 24
     id_moneda AT ROW 2.43 COL 27 COLON-ALIGNED WIDGET-ID 4
     btn_consolidado AT ROW 2.43 COL 106.8 WIDGET-ID 18
     bzoom AT ROW 2.43 COL 126.8 WIDGET-ID 26
     br_table AT ROW 4.1 COL 1
    WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY 
         SIDE-LABELS NO-UNDERLINE THREE-D 
         AT COL 1 ROW 1 SCROLLABLE  WIDGET-ID 100.


/* *********************** Procedure Settings ************************ */

&ANALYZE-SUSPEND _PROCEDURE-SETTINGS
/* Settings for THIS-PROCEDURE
   Type: SmartBrowser
   Allow: Basic,Browse
   Frames: 1
   Add Fields to: EXTERNAL-TABLES
   Other Settings: PERSISTENT-ONLY COMPILE
 */

/* This procedure should always be RUN PERSISTENT.  Report the error,  */
/* then cleanup and return.                                            */
IF NOT THIS-PROCEDURE:PERSISTENT THEN DO:
  MESSAGE "{&FILE-NAME} should only be RUN PERSISTENT.":U
          VIEW-AS ALERT-BOX ERROR BUTTONS OK.
  RETURN.
END.

&ANALYZE-RESUME _END-PROCEDURE-SETTINGS

/* *************************  Create Window  ************************** */

