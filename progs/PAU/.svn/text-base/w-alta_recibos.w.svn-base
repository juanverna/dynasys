    BY Fac_header.direccion ~
       BY Fac_header.fecha INDEXED-REPOSITION
&Scoped-define OPEN-QUERY-BROWSE-1 OPEN QUERY BROWSE-1 FOR EACH T-comprobante_rendicion OF T-Rendicion_hd NO-LOCK, ~
