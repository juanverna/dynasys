DEFINE FRAME fMain
     T-Rendicion_hd.cant_recibos AT ROW 1.48 COL 13 COLON-ALIGNED WIDGET-ID 16
          LABEL "Facturas" FORMAT ">>9"
          VIEW-AS FILL-IN 
