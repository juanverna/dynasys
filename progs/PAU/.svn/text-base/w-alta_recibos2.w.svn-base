    DEFINE VARIABLE rid_tabla AS ROWID.
    DEF TEMP-TABLE rinde
        FIELD rid AS ROWID.
DEFINE VAR evento_curso AS INT.
{tiempo.i}
DEFINE VAR pnro_tarea LIKE tarea.nro_tarea NO-UNDO.
DEFINE VAR pobservaciones AS CHAR.
DEFINE VAR pleyenda AS CHAR.
{advtexto.i}

/* _UIB-CODE-BLOCK-END */
