DEFINE VARIABLE v-hh-alta AS INTEGER FORMAT "99":U INITIAL 0 
     LABEL "Pedido" 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-hh-arrbase AS INTEGER FORMAT "99":U INITIAL 0 
     LABEL "Arribo a Base" 
