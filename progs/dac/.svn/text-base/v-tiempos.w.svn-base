&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-enable-fields V-table-Win 
PROCEDURE local-enable-fields :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'enable-fields':U ) .

  /* Code placed here will execute AFTER standard behavior.    */

  DO WITH FRAME {&FRAME-NAME}:
  
     {sensithorasi.i "ingreso" "YES"}
     {sensithorasi.i "alta" "YES"}
     {sensithorasi.i "despacho" "YES"}
     {sensithorasi.i "salbase" "YES"}
     {sensithorasi.i "despacho" "YES"}
     {sensithorasi.i "salbase" "YES"}
     {sensithorasi.i "arrdom" "YES"}
     {sensithorasi.i "saldom" "YES"}
     {sensithorasi.i "arrhosp" "YES"}
     {sensithorasi.i "salhosp" "YES"}
     {sensithorasi.i "arrbase" "YES"}
     {sensithorasi.i "disponible" "YES"}
     {sensithorasi.i "cierre" "YES"}

  END.

END PROCEDURE.

