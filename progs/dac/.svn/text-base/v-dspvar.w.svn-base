/* ***********************  Control Definitions  ********************** */


/* Definitions of the field level widgets                               */
DEFINE VARIABLE v-hh-arrbase AS INTEGER FORMAT "99":U INITIAL 0 
     LABEL "Arribo a Base" 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9 .

DEFINE VARIABLE v-hh-arrdom AS INTEGER FORMAT "99":U INITIAL 0 
     LABEL "Arribo a Domicilio" 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9 .

DEFINE VARIABLE v-hh-arrhosp AS INTEGER FORMAT "99":U INITIAL 0 
     LABEL "Arribo a Hospital" 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9 .

DEFINE VARIABLE v-hh-cierre AS INTEGER FORMAT "99":U INITIAL 0 
     LABEL "Cierre Ficha" 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9 .

DEFINE VARIABLE v-hh-despacho AS INTEGER FORMAT "99":U INITIAL 0 
     LABEL "Despacho" 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9 .

DEFINE VARIABLE v-hh-disponible AS INTEGER FORMAT "99":U INITIAL 0 
     LABEL "Móvil Disponible" 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9 .

