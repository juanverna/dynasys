     LABEL "Salida de Domicilio" 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9 .

DEFINE VARIABLE v-hh-salhosp AS INTEGER FORMAT "99":U INITIAL 0 
     LABEL "Salida de Hospital" 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9 .

DEFINE VARIABLE v-mm-arrbase AS INTEGER FORMAT "99":U INITIAL 0 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9 .

DEFINE VARIABLE v-mm-arrdom AS INTEGER FORMAT "99":U INITIAL 0 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9 .

DEFINE VARIABLE v-mm-arrhosp AS INTEGER FORMAT "99":U INITIAL 0 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9 .

DEFINE VARIABLE v-mm-cierre AS INTEGER FORMAT "99":U INITIAL 0 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9 .

DEFINE VARIABLE v-mm-despacho AS INTEGER FORMAT "99":U INITIAL 0 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9 .

DEFINE VARIABLE v-mm-disponible AS INTEGER FORMAT "99":U INITIAL 0 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9 .

DEFINE VARIABLE v-mm-salbase AS INTEGER FORMAT "99":U INITIAL 0 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9 .

DEFINE VARIABLE v-mm-saldom AS INTEGER FORMAT "99":U INITIAL 0 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9 .

DEFINE VARIABLE v-mm-salhosp AS INTEGER FORMAT "99":U INITIAL 0 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9 .

DEFINE RECTANGLE RECT-14
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 36 BY 13.46.

DEFINE RECTANGLE RECT-2
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 25 BY 13.46.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME F-Main
     Ficha.cdg_base AT ROW 1.81 COL 10 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 5.72 BY 1
          BGCOLOR 15 FGCOLOR 9 
     Ficha.cdg_movil AT ROW 3.15 COL 10 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 5.14 BY 1
          BGCOLOR 15 FGCOLOR 9 
     Ficha.leg_despacha AT ROW 5.85 COL 10 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 6.29 BY 1
          BGCOLOR 15 FGCOLOR 9 
     Ficha.leg_receptor AT ROW 4.5 COL 10 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 6.29 BY 1
          BGCOLOR 15 FGCOLOR 9 
     Ficha.leg_chofer AT ROW 7.46 COL 10 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 6.29 BY 1
          BGCOLOR 15 FGCOLOR 9 
     Ficha.leg_enfermero AT ROW 8.81 COL 10 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 6.29 BY 1
          BGCOLOR 15 FGCOLOR 9 
     Ficha.leg_medico AT ROW 10.15 COL 10 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 6.29 BY 1
          BGCOLOR 15 FGCOLOR 9 
     Ficha.fch_alta AT ROW 1.81 COL 45 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 11 BY 1
          BGCOLOR 15 FGCOLOR 9 
     v-hh-despacho AT ROW 3.15 COL 45 COLON-ALIGNED AUTO-RETURN 
     v-mm-despacho AT ROW 3.15 COL 52 COLON-ALIGNED NO-LABEL AUTO-RETURN 
     v-hh-salbase AT ROW 4.23 COL 45 COLON-ALIGNED AUTO-RETURN 
     v-mm-salbase AT ROW 4.23 COL 52 COLON-ALIGNED NO-LABEL AUTO-RETURN 
     v-hh-arrdom AT ROW 5.31 COL 45 COLON-ALIGNED AUTO-RETURN 
     v-mm-arrdom AT ROW 5.31 COL 52 COLON-ALIGNED NO-LABEL AUTO-RETURN 
     v-hh-saldom AT ROW 6.38 COL 45 COLON-ALIGNED AUTO-RETURN 
     v-mm-saldom AT ROW 6.38 COL 52 COLON-ALIGNED NO-LABEL AUTO-RETURN 
     v-hh-arrhosp AT ROW 7.46 COL 45 COLON-ALIGNED AUTO-RETURN 
     v-mm-arrhosp AT ROW 7.46 COL 52 COLON-ALIGNED NO-LABEL AUTO-RETURN 
     v-hh-salhosp AT ROW 8.54 COL 45 COLON-ALIGNED AUTO-RETURN 
     v-mm-salhosp AT ROW 8.54 COL 52 COLON-ALIGNED NO-LABEL AUTO-RETURN 
     v-hh-arrbase AT ROW 9.62 COL 45 COLON-ALIGNED AUTO-RETURN 
     v-mm-arrbase AT ROW 9.62 COL 52 COLON-ALIGNED NO-LABEL AUTO-RETURN 
     v-hh-disponible AT ROW 10.69 COL 45 COLON-ALIGNED AUTO-RETURN 
     v-mm-disponible AT ROW 10.69 COL 52 COLON-ALIGNED NO-LABEL AUTO-RETURN 
     v-hh-cierre AT ROW 12.04 COL 45 COLON-ALIGNED AUTO-RETURN 
     v-mm-cierre AT ROW 12.04 COL 52 COLON-ALIGNED NO-LABEL AUTO-RETURN 
     Ficha.num_ficha AT ROW 12.58 COL 1 COLON-ALIGNED NO-LABEL
          VIEW-AS FILL-IN 
          SIZE 11 BY 1
          BGCOLOR 15 FGCOLOR 12 FONT 5
     Ficha.abierta AT ROW 12.58 COL 15 COLON-ALIGNED NO-LABEL
          VIEW-AS FILL-IN 
          SIZE 4 BY 1
          BGCOLOR 15 FGCOLOR 12 
     RECT-14 AT ROW 1 COL 28
     RECT-2 AT ROW 1 COL 1
    WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY 
         SIDE-LABELS NO-UNDERLINE THREE-D 
         AT COL 1 ROW 1 SCROLLABLE .


