/* ************************  Control Triggers  ************************ */

&Scoped-define SELF-NAME Ficha.cdg_movil
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL Ficha.cdg_movil V-table-Win
ON LEAVE OF Ficha.cdg_movil IN FRAME F-Main /* Móvil */
DO:
  FIND Movil WHERE Movil.cdg_movil = INPUT FRAME F-Main Ficha.cdg_movil NO-LOCK NO-ERROR.
  IF AVAILABLE Movil 
  THEN DO:
       DO WITH FRAME F-Main:
          ASSIGN
               Ficha.leg_chofer:SCREEN-VALUE     = STRING(Movil.leg_chofer)
               Ficha.leg_medico:SCREEN-VALUE     = STRING(Movil.leg_medico)
               Ficha.leg_enfermero:SCREEN-VALUE  = STRING(Movil.leg_enfermero).
       END.   
  END.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME v-mm-arrdom
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-mm-arrdom V-table-Win
ON LEAVE OF v-mm-arrdom IN FRAME F-Main
DO:
  FIND CURRENT Ficha EXCLUSIVE-LOCK.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&UNDEFINE SELF-NAME

