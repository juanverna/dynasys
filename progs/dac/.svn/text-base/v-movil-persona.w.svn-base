&ANALYZE-RESUME


/* ***********************  Control Definitions  ********************** */


/* Definitions of the field level widgets                               */
DEFINE RECTANGLE RECT-5
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 92 BY 10.5.

DEFINE RECTANGLE RECT-6
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 14 BY 2.15.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME F-Main
     Movil-persona.nombre AT ROW 1.54 COL 12 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 52 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-persona.tipo_persona AT ROW 1.54 COL 74 NO-LABEL
          VIEW-AS RADIO-SET VERTICAL
          RADIO-BUTTONS 
                    "Contratado", "C",
"Titular", "T",
"Chofer", "F"
          SIZE 12 BY 1.62
     Movil-persona.calle AT ROW 2.62 COL 12 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 32 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-persona.nropta AT ROW 2.62 COL 53 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 11 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-persona.piso AT ROW 3.69 COL 12 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 7.72 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-persona.depto AT ROW 3.69 COL 36 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 8 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-persona.casa AT ROW 3.69 COL 53 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 11 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-persona.monoblk AT ROW 3.69 COL 79 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 6 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-persona.localidad AT ROW 4.77 COL 12 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 32 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-persona.barrio AT ROW 4.77 COL 53 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 32 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-persona.entre1 AT ROW 5.85 COL 12 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 32 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-persona.entre2 AT ROW 5.85 COL 53 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 32 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-persona.prefijotel AT ROW 6.92 COL 12 COLON-ALIGNED
          LABEL "Teléfono"
          VIEW-AS FILL-IN NATIVE 
          SIZE 8.72 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-persona.telefono AT ROW 6.92 COL 22 COLON-ALIGNED NO-LABEL
          VIEW-AS FILL-IN NATIVE 
          SIZE 22 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-persona.cuit_cnt AT ROW 6.92 COL 53 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 32 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-persona.refer AT ROW 8 COL 12 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 73 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-persona.fch_alta AT ROW 9.08 COL 12 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 10.86 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-persona.fch_baja AT ROW 9.08 COL 33 COLON-ALIGNED
          LABEL "Baja"
          VIEW-AS FILL-IN NATIVE 
          SIZE 10.86 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-persona.numdoc AT ROW 9.08 COL 53 COLON-ALIGNED
          LABEL "Docum."
          VIEW-AS FILL-IN NATIVE 
          SIZE 31.72 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-persona.registro AT ROW 10.15 COL 12 COLON-ALIGNED
          LABEL "Registro"
          VIEW-AS FILL-IN NATIVE 
          SIZE 16.72 BY .81
          BGCOLOR 15 FGCOLOR 9 
.
/* DEFINE FRAME statement is approaching 4K Bytes.  Breaking it up   */
DEFINE FRAME F-Main
     Movil-persona.expide_reg AT ROW 10.15 COL 40 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 16.72 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-persona.fch_venceregistro AT ROW 10.15 COL 73 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 12 BY .81
          BGCOLOR 15 FGCOLOR 9 
     RECT-5 AT ROW 1 COL 1
     RECT-6 AT ROW 1.27 COL 73
    WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY 
         SIDE-LABELS NO-UNDERLINE THREE-D 
         AT COL 1 ROW 1 SCROLLABLE .


