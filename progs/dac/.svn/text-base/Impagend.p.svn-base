DEF VAR Desde AS DATE.
DEF VAR Hasta AS DATE.

DEF VAR cdesd AS CHAR.
DEF VAR chast AS CHAR.

DEF VAR parms AS CHAR.
DEF VAR filtr AS CHAR.

FIND LAST Problema NO-LOCK.
Hasta = fecha_reportado.

UPDATE Desde Hasta WITH SIDE-LABELS THREE-D VIEW-AS DIALOG-BOX TITLE "Indique período".

RUN rbfecha.p (INPUT Desde, OUTPUT cdesd).
RUN rbfecha.p (INPUT Hasta, OUTPUT chast).

parms = "Desde = " + STRING(Desde,"99/99/99") + "~n" +
        "Hasta = " + STRING(Hasta,"99/99/99") + "~n".
        
filtr = "fecha_reportado <= " + chast + " AND " +
        "fecha_reportado >= " + cdesd.
        
RUN exreport-agenda.p ( INPUT "reports.prl",
                        INPUT "Novedades Reportadas",
                        INPUT filtr,
                        INPUT "D",
                        INPUT SESSION:PRINTER-NAME,
                        INPUT parms ).

