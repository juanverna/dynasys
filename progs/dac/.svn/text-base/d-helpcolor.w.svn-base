/* ************************  Frame Definitions  *********************** */

DEFINE FRAME Dialog-Frame
     Btn_OK AT ROW 5.04 COL 2
     v-color AT ROW 5.04 COL 21 COLON-ALIGNED NO-LABEL
     Btn_Cancel AT ROW 5.04 COL 44
     RECT-11 AT ROW 3.15 COL 16
     RECT-12 AT ROW 3.15 COL 23
     RECT-4 AT ROW 1.54 COL 23
     RECT-5 AT ROW 1.54 COL 30
     RECT-6 AT ROW 1.54 COL 37
     RECT-7 AT ROW 1.54 COL 44
     RECT-8 AT ROW 1.54 COL 51
     RECT-9 AT ROW 3.15 COL 2
     RECT-10 AT ROW 3.15 COL 9
     RECT-13 AT ROW 3.15 COL 30
     RECT-14 AT ROW 3.15 COL 37
     RECT-15 AT ROW 3.15 COL 44
     RECT-16 AT ROW 3.15 COL 51
     RECT-2 AT ROW 1.54 COL 9
     RECT-3 AT ROW 1.54 COL 16
     RECT-1 AT ROW 1.54 COL 2
     SPACE(50.85) SKIP(3.79)
    WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER 
         SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE 
         TITLE "Apunte con el mouse el color deseado"
         DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.


/* *********************** Procedure Settings ************************ */

