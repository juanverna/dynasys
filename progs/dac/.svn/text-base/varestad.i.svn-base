DEFINE VARIABLE  tot_amarillo-tarde        AS INTEGER FORMAT ">>>>>9".
DEFINE VARIABLE  tot_amarillo-muytarde     AS INTEGER FORMAT ">>>>>9".
DEFINE VARIABLE  tot_celeste               AS INTEGER FORMAT ">>>>>9".
