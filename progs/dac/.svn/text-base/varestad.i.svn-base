DEFINE VARIABLE  tot_verdeadu-tarde        AS INTEGER FORMAT ">>>>>9".
DEFINE VARIABLE  tot_verdeadu-muytarde     AS INTEGER FORMAT ">>>>>9".
DEFINE VARIABLE  tot_verdeped              AS INTEGER FORMAT ">>>>>9".
DEFINE VARIABLE  tot_verdeped-tarde        AS INTEGER FORMAT ">>>>>9".
DEFINE VARIABLE  tot_verdeped-muytarde     AS INTEGER FORMAT ">>>>>9".

DEFINE VARIABLE  tot_marron                AS INTEGER FORMAT ">>>>>9" LABEL "Trasl".
DEFINE VARIABLE  tot_naranja               AS INTEGER FORMAT ">>>>>9" LABEL "Enferm".
DEFINE VARIABLE  tot_azul                  AS INTEGER FORMAT ">>>>>9" LABEL "Seguim".
DEFINE VARIABLE  tot_gris                  AS INTEGER FORMAT ">>>>>9" LABEL "Evento".
DEFINE VARIABLE  tot_otros                 AS INTEGER FORMAT ">>>>>9" LABEL "Evento".

