DEFINE VARIABLE  cnt_verdeped-muytarde     AS INTEGER FORMAT ">>>>>9" LABEL "> 3H.".

DEFINE VARIABLE  cnt_marron                AS INTEGER FORMAT ">>>>>9" LABEL "Seguim".
DEFINE VARIABLE  cnt_naranja               AS INTEGER FORMAT ">>>>>9" LABEL "Enferm".
DEFINE VARIABLE  cnt_azul                  AS INTEGER FORMAT ">>>>>9" LABEL "Trasl".
DEFINE VARIABLE  cnt_gris                  AS INTEGER FORMAT ">>>>>9" LABEL "Evento".
DEFINE VARIABLE  cnt_otros                 AS INTEGER FORMAT ">>>>>9" LABEL "Otros".

DEFINE VARIABLE  tot_rojo                  AS INTEGER FORMAT ">>>>>9".
DEFINE VARIABLE  tot_rojo-tarde            AS INTEGER FORMAT ">>>>>9".
DEFINE VARIABLE  tot_rojo-muytarde         AS INTEGER FORMAT ">>>>>9".
