DEFINE VARIABLE  act_amarillo              AS INTEGER FORMAT ">>>>>9" LABEL "Amar.".
DEFINE VARIABLE  act_celeste               AS INTEGER FORMAT ">>>>>9" LABEL "Celes.".
DEFINE VARIABLE  act_verdeadu              AS INTEGER FORMAT ">>>>>9" LABEL "Adulto".
DEFINE VARIABLE  act_verdeped              AS INTEGER FORMAT ">>>>>9" LABEL "Pediat".

DEFINE VARIABLE  act_marron                AS INTEGER FORMAT ">>>>>9" LABEL "Seguim".
DEFINE VARIABLE  act_naranja               AS INTEGER FORMAT ">>>>>9" LABEL "Enferm".
DEFINE VARIABLE  act_azul                  AS INTEGER FORMAT ">>>>>9" LABEL "Trasl".
DEFINE VARIABLE  act_gris                  AS INTEGER FORMAT ">>>>>9" LABEL "Gris".
