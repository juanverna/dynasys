/*          DEFINICION DE VARIABLES NECESARIAS PARA CALCULO DE ESTADISTICA DIARIA           */
/*------------------------------------------------------------------------------------------*/

DEFINE VARIABLE  tr                        AS INTEGER.

DEFINE VARIABLE  cnt_incid                 AS INTEGER FORMAT ">>>>>9" LABEL "Total".
DEFINE VARIABLE  cnt_rojo                  AS INTEGER FORMAT ">>>>>9" LABEL "Rojo".
DEFINE VARIABLE  cnt_rojo-tarde            AS INTEGER FORMAT ">>>>>9" LABEL "> 10'".
DEFINE VARIABLE  cnt_rojo-muytarde         AS INTEGER FORMAT ">>>>>9" LABEL "> 15'".
DEFINE VARIABLE  cnt_amarillo              AS INTEGER FORMAT ">>>>>9" LABEL "Amarill".
DEFINE VARIABLE  cnt_amarillo-tarde        AS INTEGER FORMAT ">>>>>9" LABEL "> 20'".
DEFINE VARIABLE  cnt_amarillo-muytarde     AS INTEGER FORMAT ">>>>>9" LABEL "> 30'".
DEFINE VARIABLE  cnt_celeste               AS INTEGER FORMAT ">>>>>9" LABEL "Celeste".
