DEFINE VARIABLE  cnt_celeste-muytarde      AS INTEGER FORMAT ">>>>>9" LABEL "> 60'".
DEFINE VARIABLE  cnt_verdeadu              AS INTEGER FORMAT ">>>>>9" LABEL "Adulto".
