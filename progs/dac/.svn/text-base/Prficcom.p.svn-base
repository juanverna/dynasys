/*============================================================================================*/
/*                           IMPRESION DE FICHAS DE DESPACHO                                  */
/*============================================================================================*/

DEFINE INPUT PARAMETER rid_ficha AS ROWID.

DEFINE VARIABLE archivo   AS CHARACTER.
DEFINE VARIABLE P_PRINTED AS LOGICAL.
DEFINE VARIABLE tono      AS CHARACTER EXTENT 10 
       INITIAL ["S/A","ROJO","AMARILLO","VERDE","AZUL","OTROS"].
DEFINE VARIABLE que_tono  AS CHARACTER.

DEFINE VARIABLE rydespac  AS CHARACTER LABEL "Despacho" INITIAL "__________________".
DEFINE VARIABLE rysalbas  AS CHARACTER LABEL "Salida Base" INITIAL "__________________".
DEFINE VARIABLE ryarrdom  AS CHARACTER LABEL "Arribo Domicilio" INITIAL "__________________".
DEFINE VARIABLE rysaldom  AS CHARACTER LABEL "Salida Domicilio" INITIAL "__________________".
DEFINE VARIABLE ryarrhsp  AS CHARACTER LABEL "Arribo Hospital" INITIAL "__________________".
DEFINE VARIABLE rysalhsp  AS CHARACTER LABEL "Salida Hospital" INITIAL "__________________".
DEFINE VARIABLE ryarrbas  AS CHARACTER LABEL "Arribo Base" INITIAL "__________________".
DEFINE VARIABLE rymovdsp  AS CHARACTER LABEL "Disponible" INITIAL "__________________".
DEFINE VARIABLE rytangod  AS CHARACTER LABEL "T.Delta" INITIAL "__________________".


FORM
      "FICHA DE DESPACHO NUMERO "  Ficha.num_ficha NO-LABEL SPACE(3) 
      que_tono NO-LABEL
      Ficha.fch_alta LABEL "RECIBIDO"  COLON 65
      Ficha.hms_alta LABEL "A las"     COLON 65
      SKIP(2)      
      Ficha.calle_emr     COLON 15
      Ficha.nropta_emr 
      Ficha.piso_emr 
      Ficha.depto_emr 
      SKIP(1)
      Ficha.monoblk_emr  FORMAT "X(3)" COLON 15
      Ficha.barrio_emr 
      SKIP(1)
      Ficha.entre1_emr    COLON 15
      Ficha.entre2_emr 
      SKIP(1)
      Localidad.dsc_localidad LABEL "Localidad" COLON 15
      SKIP(1)
      Ficha.observacion    COLON 15 LABEL "Ref."
      SKIP(1)      
      Ficha.prefijotel_emr LABEL "Tel."  COLON 15
      Ficha.telefono_emr NO-LABEL
      Ficha.edad_pac 
      Ficha.sexo_pac 
      SKIP(1)
      Motivo.dsc_motivo   COLON 15 LABEL "Motivo"
      SKIP
      Ficha.casa_emr      NO-LABEL AT 17 FORMAT "X(62)"
      SKIP(1)
      Cliente.nom_cliente LABEL "Socio de" COLON 15
      SKIP(1)      
      Ficha.nombre_pac    COLON 15
      SKIP(1)
      Ficha.nroafi_pac    COLON 15
      Ficha.imp_coseguro  LABEL "Importe Coseguro"
      SKIP
      "==========================================================================="
      SKIP(1)
      rydespac  COLON 17  SPACE(2)     Ficha.hospital_int LABEL "INSTITUCION"
      SKIP(1)
      rysalbas  COLON 17  SPACE(2)
      SKIP(1)
      ryarrdom  COLON 17  SPACE(2)     "---------------< DESTINO FINAL >---------------"
      SKIP(1)
      rysaldom  COLON 17  SPACE(2)     Destemer.dsc_destino NO-LABEL
      SKIP(1)
      ryarrhsp  COLON 17  SPACE(2)     "-------------< DIAGNOSTICO FINAL >-------------"
      SKIP(1)
      rysalhsp  COLON 17  SPACE(2)     Diagnostico.dsc_diagnostico NO-LABEL
      SKIP(1)
      ryarrbas  COLON 17  SPACE(2)     
      SKIP(1)
      rymovdsp  COLON 17  SPACE(2)     
      SKIP(1)
      rytangod  COLON 17  SPACE(2)     
      SKIP
      "==========================================================================="
      SKIP(1)
      Ficha.cdg_base LABEL "Base" SPACE(2) 
      Ficha.cdg_movil LABEL "Movil" SPACE(2)
      Ficha.leg_medico LABEL "Medico" SPACE(2)
      Ficha.leg_enfermero LABEL "Enf." SPACE(2)
      Ficha.leg_chofer LABEL "Chofer" SPACE(2)
      SKIP(1)
      Ficha.leg_receptor LABEL "Receptor" SPACE(2)
      Ficha.leg_despacha LABEL "Despachador" SPACE(2)
      Ficha.linea LABEL "Linea Nro." 
      WITH FRAME frm-ficha SIDE-LABELS STREAM-IO.
      
FIND Ficha WHERE ROWID(Ficha) = rid_ficha NO-LOCK.
FIND Motivo      OF Ficha  NO-LOCK NO-ERROR.
FIND Localidad   OF Ficha  NO-LOCK NO-ERROR.
FIND Cliente     OF Ficha  NO-LOCK NO-ERROR.
FIND Destemer    OF Ficha  NO-LOCK NO-ERROR.
FIND Demora      OF Ficha  NO-LOCK NO-ERROR.
FIND Diagnostico OF Ficha  NO-LOCK NO-ERROR.

que_tono = TONO [ INTEGER(Ficha.cdg_tipoemr) + 1 ].

archivo = ".\TEMPDSP\FD" + STRING(Ficha.num_ficha,"999999"). 

OUTPUT TO VALUE(archivo) PAGED.

ASSIGN
 rydespac  = STRING(Ficha.hor_despacho,"HH:MM:SS")
 rysalbas  = STRING(Ficha.hor_salbas,"HH:MM:SS")
 ryarrdom  = STRING(Ficha.hor_arrdom,"HH:MM:SS")
 rysaldom  = STRING(Ficha.hor_saldom,"HH:MM:SS")
 ryarrhsp  = STRING(Ficha.hor_arrhosp,"HH:MM:SS")
 rysalhsp  = STRING(Ficha.hor_salhosp,"HH:MM:SS")
 ryarrbas  = STRING(Ficha.hor_arrbas,"HH:MM:SS")
 rymovdsp  = STRING(Ficha.hor_disponible,"HH:MM:SS").
/* rytangod  = STRING(Ficha.hor_disponible -  ,"HH:MM:SS").*/

DISPLAY       
      Ficha.num_ficha
      que_tono
      Ficha.fch_alta
      Ficha.hms_alta 
      Ficha.calle_emr
      Ficha.nropta_emr 
      Ficha.piso_emr 
      Ficha.depto_emr 
      Ficha.casa_emr
      Ficha.monoblk_emr 
      Ficha.barrio_emr 
      Ficha.entre1_emr
      Ficha.entre2_emr 
      Localidad.dsc_localidad WHEN AVAILABLE Localidad
      Ficha.observacion
      Ficha.prefijotel_emr
      Ficha.telefono_emr
      Ficha.edad_pac 
      Ficha.sexo_pac 
      Ficha.imp_coseguro
      Motivo.dsc_motivo WHEN AVAILABLE Motivo
      Ficha.nombre_pac
      Cliente.nom_cliente WHEN AVAILABLE Cliente
      Ficha.nroafi_pac
      Ficha.cdg_base 
      Ficha.cdg_movil
      Ficha.leg_medico
      Ficha.leg_enfermero
      Ficha.leg_chofer
      Ficha.leg_receptor
      Ficha.leg_despacha
      Ficha.linea 
      Ficha.hospital_int
      Destemer.dsc_destino        WHEN AVAILABLE Destemer
      Diagnostico.dsc_diagnostico WHEN AVAILABLE Diagnostico
      rydespac
      rysalbas
      ryarrdom
      rysaldom
      ryarrhsp
      rysalhsp
      ryarrbas
      rymovdsp
      rytangod
      SKIP(2)
      WITH FRAME frm-ficha.      
 
OUTPUT CLOSE.      

RUN _osprint.p ( INPUT  CURRENT-WINDOW:HANDLE,
                 INPUT  archivo,
                 INPUT  10,
                 INPUT  0,
                 INPUT  56,
                 INPUT  0,
                 OUTPUT  p_Printed ).
