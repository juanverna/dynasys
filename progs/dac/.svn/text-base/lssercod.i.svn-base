/*===================================================================================*/
/*             Emite el listado de servicios prestados POR o PARA                    */
/*===================================================================================*/

DEFINE INPUT PARAMETER p-des_cliente    LIKE {&TABLA}.{&CDG_TABLA}. 
DEFINE INPUT PARAMETER p-has_cliente    LIKE {&TABLA}.{&CDG_TABLA}. 
DEFINE INPUT PARAMETER p-des_color      LIKE Tipcolor.cdg_tipoemr.
DEFINE INPUT PARAMETER p-has_color      LIKE Tipcolor.cdg_tipoemr. 
DEFINE INPUT PARAMETER p-des_movil      LIKE Tipcolor.cdg_tipoemr. 
DEFINE INPUT PARAMETER p-has_movil      LIKE Tipcolor.cdg_tipoemr. 
DEFINE INPUT PARAMETER p-des_fecha      AS DATE. 
DEFINE INPUT PARAMETER p-has_fecha      AS DATE. 
DEFINE INPUT PARAMETER p-lista_empresas AS CHARACTER.


DEFINE VARIABLE tr  AS INTEGER.
DEFINE VARIABLE ctr AS CHARACTER LABEL "T.Resp.".
DEFINE VARIABLE que_{&TABLA} LIKE {&TABLA}.cdg_{&TABLA} LABEL "{&TABLA}".
DEFINE VARIABLE chr_{&TABLA} LIKE {&TABLA}.nom_{&TABLA}.
DEFINE VARIABLE des_movil    LIKE Movil.cdg_movil LABEL "De Móvil" FORMAT ">>9".
DEFINE VARIABLE has_movil    LIKE Movil.cdg_movil LABEL "A Móvil" FORMAT ">>9".

{defvarcolores.i}

DEFINE VARIABLE v-domicilio  AS CHARACTER FORMAT "X(25)" LABEL "Domicilio".
DEFINE VARIABLE v-telefono   AS CHARACTER LABEL "Telefono" FORMAT "X(12)".
DEFINE VARIABLE v-importe    AS DECIMAL   COLUMN-LABEL "Importe".

DEFINE VARIABLE tot_importe  AS DECIMAL   COLUMN-LABEL "Importe".
DEFINE VARIABLE tot_coseguro AS DECIMAL   COLUMN-LABEL "Importe".
DEFINE VARIABLE tot_fichas   AS INTEGER.

DEFINE VARIABLE tcl_importe  AS DECIMAL   COLUMN-LABEL "Importe".
DEFINE VARIABLE tcl_coseguro AS DECIMAL   COLUMN-LABEL "Importe".
DEFINE VARIABLE tcl_fichas   AS INTEGER.

DEFINE FRAME frm-titulo HEADER
  que_empresa 
  "{&TITULO-LST}" AT 52 
  "Pagina:" AT 130 PAGE-NUMBER FORMAT ">9" AT 137
  SKIP
  "Filtro:"
  tit_filtro
  des_fecha AT 52
  "al"
  has_fecha
  "/"
  deshas_color 
  fecha_lis AT 130
  SKIP
  chr_{&TABLA} AT 52
  hora_lis AT 130
  SKIP(1)
  WITH WIDTH 150 FRAME frm-titulo TOP-ONLY PAGE-TOP STREAM-IO.

FORM
  Ficha.fch_alta 
  Ficha.num_ficha 
  v-telefono
  Ficha.nombre_pac FORMAT "X(20)"
  {&FICHA-CAMPO}
  Ficha.hms_alta
  v-domicilio
  Ficha.cdg_motivo COLUMN-LABEL "Mtv."
  Ficha.cdg_diagnostico COLUMN-LABEL "Diagn."
  Ficha.cdg_destino COLUMN-LABEL "Dst."
  Ficha.cdg_proveedor COLUMN-LABEL "(M)" 
  Ficha.imp_coseguro
  v-importe
  WITH WIDTH 150 DOWN CENTERED FRAME frm-listado USE-TEXT STREAM-IO.

{setvarimpre.i}

FIND {&TABLA} WHERE {&TABLA}.cdg_{&TABLA} = que_{&TABLA} NO-LOCK.
ASSIGN chr_{&TABLA} = {&TABLA}.nom_{&TABLA}.

tot_coseguro = 0.
tot_importe  = 0.
tot_fichas   = 0.

tcl_coseguro = 0.
tcl_importe  = 0.
tcl_fichas   = 0.

{deshascolor.i}

tit_filtro = lista_empresas + " - " + STRING(des_movil) + "-" + STRING(has_movil).

{cargaempresas.i}

ASSIGN
  des_cliente = p-des_cliente
  has_cliente = p-has_cliente
  des_tipoemr = p-des_tipoemr
  has_tipoemr = p-has_tipoemr
  des_fecha   = p-des_fecha
  has_fecha   = p-has_fecha.

ASSIGN chr_cliente = STRING(des_cliente) + " - " + STRING(has_cliente) .
IF lista_estados = "" THEN lista_estados = ",0,1".

{drsalida.i "55"} /* Direcciona la salida de impresión */

{setvarimpre.i}

FOR EACH Ficha USE-INDEX por_fecha
    WHERE Ficha.fch_alta    <= has_fecha 
      AND Ficha.fch_alta    >= des_fecha
      AND Ficha.cdg_tipoemr <= has_tipoemr 
      AND Ficha.cdg_tipoemr >= des_tipoemr
      AND Ficha.cdg_cliente <= has_cliente
      AND Ficha.cdg_cliente >= des_cliente
      AND Ficha.cdg_movil   >= des_movil
      AND Ficha.cdg_movil   <= has_movil
      AND LOOKUP(Ficha.cdg_empresa,lista_empresas) <> 0
      AND Ficha.cdg_destino <> "A" NO-LOCK USE-INDEX por_fecha
      BREAK BY Ficha.cdg_cliente
            BY Ficha.cdg_subconvenio
            BY Ficha.cdg_tipoemr
            BY Ficha.fch_alta 
            BY Ficha.num_ficha WITH FRAME f-listado:

    VIEW FRAME frm-titulo.

    FIND Movil       OF Ficha NO-LOCK NO-ERROR.
    FIND Diagnostico OF Ficha NO-LOCK NO-ERROR.
    FIND Motivo      OF Ficha NO-LOCK NO-ERROR.
    FIND Destemer    OF Ficha NO-LOCK NO-ERROR.
    FIND Localidad   OF Ficha NO-LOCK NO-ERROR.

    v-domicilio = Ficha.calle_emr + " " + Ficha.nropta_emr + "-" + Localidad.dsc_localidad.
    v-telefono =  Ficha.prefijotel_emr + "-" + Ficha.telefono_emr.

    v-importe = 0.
    IF Ficha.cdg_tipoemr <> "0" 
    THEN DO:
         FIND FIRST {&TABLA_TARIFAS} OF {&TABLA} WHERE  {&TABLA_TARIFAS}.cdg_tipoemr = Ficha.cdg_tipoemr NO-LOCK NO-ERROR.
         IF Localidad.dentro_zona 
            THEN v-importe = {&TABLA_TARIFAS}.imp_dentro-zona.
            ELSE v-importe = {&TABLA_TARIFAS}.imp_fuera-zona.
    END.         

    tot_fichas = tot_fichas + 1.
    tot_coseguro = tot_coseguro + imp_coseguro.
    tot_importe = tot_importe + v-importe.

    tcl_fichas = tcl_fichas + 1.
    tcl_coseguro = tcl_coseguro + imp_coseguro.
    tcl_importe = tcl_importe + v-importe.

    DISPLAY Ficha.fch_alta   WHEN FIRST-OF(Ficha.fch_alta)
            Ficha.num_ficha 
            v-telefono
            Ficha.nombre_pac FORMAT "X(20)"
            {&FICHA-CAMPO}
            Ficha.hms_alta
            v-domicilio
            Ficha.cdg_motivo COLUMN-LABEL "Mtv."
            Ficha.cdg_diagnostico COLUMN-LABEL "Diagn."
            Ficha.cdg_destino COLUMN-LABEL "Dst."
            Ficha.cdg_proveedor COLUMN-LABEL "(M)" 
            Ficha.imp_coseguro
            v-importe
            WITH FRAME frm-listado.

    DOWN WITH FRAME frm-listado.        

    IF LAST-OF(Ficha.cdg_tipoemr)
    THEN DO:

         UNDERLINE Ficha.fch_alta
                   Ficha.num_ficha 
                   v-telefono
                   Ficha.nombre_pac
                   {&FICHA-CAMPO}
                   Ficha.hms_alta
                   v-domicilio
                   Ficha.cdg_motivo
                   Ficha.cdg_diagnostico
                   Ficha.cdg_destino
                   Ficha.cdg_proveedor
                   Ficha.imp_coseguro
                   v-importe
                   WITH FRAME frm-listado.

         
         FIND Tipcolor OF Ficha NO-LOCK.

         DISPLAY   tcl_fichas @ Ficha.num_ficha 
                   Tipcolor.color_emr @ v-telefono
                   tcl_coseguro @ Ficha.imp_coseguro 
                   tcl_importe @ v-importe 
                   WITH FRAME frm-listado.

         tcl_fichas = 0.
         tcl_coseguro = 0 .
         tcl_importe = 0 .

         IF NOT LAST(Ficha.cdg_tipoemr) THEN PAGE.

    END.

END.            

UNDERLINE Ficha.fch_alta
          Ficha.num_ficha 
          v-telefono
          Ficha.nombre_pac
          {&FICHA-CAMPO}
          Ficha.hms_alta
          v-domicilio
          Ficha.cdg_motivo
          Ficha.cdg_diagnostico
          Ficha.cdg_destino
          Ficha.cdg_proveedor
          Ficha.imp_coseguro
          v-importe
          WITH FRAME frm-listado.

DISPLAY   tot_fichas @ Ficha.num_ficha 
          "TOTAL"    @ v-telefono
          tot_coseguro @ Ficha.imp_coseguro 
          tot_importe @ v-importe 
          WITH FRAME frm-listado.

OUTPUT CLOSE.

   /* Visualiza en pantalla el archivo de salida */

RUN veresult.w ( INPUT  arch_salida ,  /* Archivo */
                 INPUT 8 ).            /* FONT a utilizar por default */               
           
