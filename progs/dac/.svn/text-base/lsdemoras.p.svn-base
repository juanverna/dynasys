/*============================================================================================*/
/*                           IMPRESION DE SERVICIOS DEMORADOS                                 */
/*============================================================================================*/


DEFINE VARIABLE v-filtro AS CHARACTER.
DEFINE VARIABLE v-params AS CHARACTER.

DEFINE VARIABLE des_fecha  AS DATE LABEL "Desde Fecha".
DEFINE VARIABLE has_fecha  AS DATE LABEL "Hasta Fecha".
DEFINE VARIABLE que_color  LIKE Tipcolor.cdg_tipoemr LABEL "Color".
DEFINE VARIABLE que_demora AS CHAR.

DEFINE VARIABLE chdes_fecha AS CHARACTER.
DEFINE VARIABLE chhas_fecha AS CHARACTER.

UPDATE des_fecha has_fecha que_color SKIP
  /*   des_demora has_demora  */
       WITH SIDE-LABELS FRAME cesar VIEW-AS DIALOG-BOX
       THREE-D TITLE "Indique período y color".

RUN rbfecha.p ( INPUT des_fecha, OUTPUT chdes_fecha).
RUN rbfecha.p ( INPUT has_fecha, OUTPUT chhas_fecha).

v-params = "p-tipcolor=" + que_color + "~n" +
           "p-desfecha=" + STRING(des_fecha,"99/99/99") + "~n" +
           "p-hasfecha=" + STRING(has_fecha,"99/99/99") + "~n".

v-filtro = "Ficha.fch_alta <= " + 
            chhas_fecha + 
            " AND Ficha.fch_alta >= " + 
            chdes_fecha  + " AND Ficha.cdg_tipoemr = '" + 
            que_color + "' " +
            "AND (( Ficha.hor_arrdomi - Ficha.hor_alta > Tipcolor.hor_cobertura * 90 " +
            "AND Ficha.hor_arrdomi >  Ficha.hor_alta ) " +
            "OR ( Ficha.hor_arrdomi - Ficha.hor_alta + 86400 > Tipcolor.hor_cobertura * 90 " +
            "AND Ficha.hor_arrdomi <= Ficha.hor_alta )) ".

RUN exreport.p (  INPUT  "imagenes\raséc.prl",   /* Librería desde la que se ejecuta */
                  INPUT "Demoras",                   /* Nombre del reporte a ejecutar    */
                  INPUT  v-filtro,                   /* Filtro de registros a imponer    */
                  INPUT  "D",                        /* Salida de datos    (ver cPrinter)*/
                  INPUT  SESSION:PRINTER-NAME,       /* Impresora de destino del listado */
                  INPUT  v-params                    /* Parametros de Ejecucion          */
               ).
