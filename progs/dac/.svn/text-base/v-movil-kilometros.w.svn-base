&ANALYZE-SUSPEND _VERSION-NUMBER UIB_v8r12 GUI
&ANALYZE-RESUME
/* Connected Databases 
          despacho         PROGRESS
*/
&Scoped-define WINDOW-NAME CURRENT-WINDOW
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CUSTOM _DEFINITIONS V-table-Win 
/*------------------------------------------------------------------------

  File:

  Description: from VIEWER.W - Template for SmartViewer Objects

  Input Parameters:
      <none>

  Output Parameters:
      <none>

------------------------------------------------------------------------*/
/*          This .W file was created with the Progress UIB.             */
/*----------------------------------------------------------------------*/

/* Create an unnamed pool to store all the widgets created 
     by this procedure. This is a good default which assures
     that this procedure's triggers and internal procedures 
     will execute in this procedure's storage, and that proper
     cleanup will occur on deletion of the procedure. */

CREATE WIDGET-POOL.

/* ***************************  Definitions  ************************** */

/* Parameters Definitions ---                                           */

/* Local Variable Definitions ---                                       */

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-PREPROCESSOR-BLOCK 

/* ********************  Preprocessor Definitions  ******************** */

&Scoped-define PROCEDURE-TYPE SmartViewer

&Scoped-define ADM-SUPPORTED-LINKS Record-Source,Record-Target,TableIO-Target

/* Name of first Frame and/or Browse and/or first Query                 */
&Scoped-define FRAME-NAME F-Main

/* External Tables                                                      */
&Scoped-define EXTERNAL-TABLES Movil-kilometros Movil-motivo
&Scoped-define FIRST-EXTERNAL-TABLE Movil-kilometros


/* Need to scope the external tables to this procedure                  */
DEFINE QUERY external_tables FOR Movil-kilometros, Movil-motivo.
/* Standard List Definitions                                            */
&Scoped-Define ENABLED-FIELDS Movil-kilometros.kilometros ~
Movil-kilometros.tarifa Movil-kilometros.tar-nocturno ~
Movil-kilometros.tar-feriado Movil-kilometros.tar-ferynoc ~
Movil-kilometros.prc_capital Movil-kilometros.imp_capital 
&Scoped-define FIELD-PAIRS~
 ~{&FP1}kilometros ~{&FP2}kilometros ~{&FP3}~
 ~{&FP1}tarifa ~{&FP2}tarifa ~{&FP3}~
 ~{&FP1}tar-nocturno ~{&FP2}tar-nocturno ~{&FP3}~
 ~{&FP1}tar-feriado ~{&FP2}tar-feriado ~{&FP3}~
 ~{&FP1}tar-ferynoc ~{&FP2}tar-ferynoc ~{&FP3}~
 ~{&FP1}prc_capital ~{&FP2}prc_capital ~{&FP3}~
 ~{&FP1}imp_capital ~{&FP2}imp_capital ~{&FP3}
&Scoped-define ENABLED-TABLES Movil-kilometros
&Scoped-define FIRST-ENABLED-TABLE Movil-kilometros
&Scoped-Define ENABLED-OBJECTS RECT-15 
&Scoped-Define DISPLAYED-FIELDS Movil-kilometros.kilometros ~
Movil-kilometros.tarifa Movil-kilometros.tar-nocturno ~
Movil-kilometros.tar-feriado Movil-kilometros.tar-ferynoc ~
Movil-kilometros.prc_capital Movil-kilometros.imp_capital 

/* Custom List Definitions                                              */
/* ADM-CREATE-FIELDS,ADM-ASSIGN-FIELDS,List-3,List-4,List-5,List-6      */

/* _UIB-PREPROCESSOR-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _XFTR "Foreign Keys" V-table-Win _INLINE
/* Actions: ? adm/support/keyedit.w ? ? ? */
/* STRUCTURED-DATA
<KEY-OBJECT>
THIS-PROCEDURE
</KEY-OBJECT>
<FOREIGN-KEYS>
</FOREIGN-KEYS> 
<EXECUTING-CODE>
**************************
* Set attributes related to FOREIGN KEYS
*/
RUN set-attribute-list (
    'Keys-Accepted = "",
     Keys-Supplied = ""':U).
/**************************
</EXECUTING-CODE> */   

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


/* ***********************  Control Definitions  ********************** */


/* Definitions of the field level widgets                               */
DEFINE BUTTON btn_todos 
     LABEL "Iguales" 
     SIZE 10 BY .81.

DEFINE RECTANGLE RECT-15
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 55 BY 3.5.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME F-Main
     Movil-kilometros.kilometros AT ROW 1.27 COL 3.43
          LABEL "Km" FORMAT ">>,>>9.99"
          VIEW-AS FILL-IN NATIVE 
          SIZE 10 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-kilometros.tarifa AT ROW 1.27 COL 24 COLON-ALIGNED
          LABEL "Diurno"
          VIEW-AS FILL-IN NATIVE 
          SIZE 10 BY .81
          BGCOLOR 15 FGCOLOR 9 
     btn_todos AT ROW 1.27 COL 45
     Movil-kilometros.tar-nocturno AT ROW 2.35 COL 5 COLON-ALIGNED
          LABEL "Noct."
          VIEW-AS FILL-IN NATIVE 
          SIZE 10 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-kilometros.tar-feriado AT ROW 2.35 COL 24 COLON-ALIGNED
          LABEL "Feriado"
          VIEW-AS FILL-IN NATIVE 
          SIZE 10 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-kilometros.tar-ferynoc AT ROW 2.35 COL 43 COLON-ALIGNED
          LABEL "F.y Noc."
          VIEW-AS FILL-IN NATIVE 
          SIZE 10 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-kilometros.prc_capital AT ROW 3.42 COL 24 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 10 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-kilometros.imp_capital AT ROW 3.42 COL 43 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 10 BY .81
          BGCOLOR 15 FGCOLOR 9 
     RECT-15 AT ROW 1 COL 1
    WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY 
         SIDE-LABELS NO-UNDERLINE THREE-D 
         AT COL 1 ROW 1 SCROLLABLE .


/* *********************** Procedure Settings ************************ */

&ANALYZE-SUSPEND _PROCEDURE-SETTINGS
/* Settings for THIS-PROCEDURE
   Type: SmartViewer
   External Tables: despacho.Movil-kilometros,despacho.Movil-motivo
   Allow: Basic,DB-Fields
   Frames: 1
   Add Fields to: EXTERNAL-TABLES
   Other Settings: PERSISTENT-ONLY COMPILE
 */

/* This procedure should always be RUN PERSISTENT.  Report the error,  */
/* then cleanup and return.                                            */
IF NOT THIS-PROCEDURE:PERSISTENT THEN DO:
  MESSAGE "{&FILE-NAME} should only be RUN PERSISTENT."
          VIEW-AS ALERT-BOX ERROR BUTTONS OK.
  RETURN.
END.

&ANALYZE-RESUME _END-PROCEDURE-SETTINGS

