/*===================================================================================*/
/*             Emite el listado de servicios prestados POR o PARA                    */
/*===================================================================================*/

DEFINE VARIABLE tr  AS INTEGER.
DEFINE VARIABLE ctr AS CHARACTER LABEL "T.Resp.".
DEFINE VARIABLE que_{&TABLA} LIKE {&TABLA}.cdg_{&TABLA} LABEL "{&TABLA}".
DEFINE VARIABLE chr_{&TABLA} LIKE {&TABLA}.nom_{&TABLA}.
DEFINE VARIABLE des_fecha AS DATE LABEL "De Fecha".
DEFINE VARIABLE has_fecha AS DATE LABEL "A Fecha".
DEFINE VARIABLE des_tipoemr AS CHARACTER LABEL "De Color" FORMAT "X(1)".
DEFINE VARIABLE has_tipoemr AS CHARACTER LABEL "A Color" FORMAT "X(1)".
DEFINE VARIABLE lista_empresas AS CHARACTER LABEL "Empresas".
DEFINE VARIABLE deshas_color AS CHARACTER LABEL "De Color" FORMAT "X(15)".

DEFINE VARIABLE fecha_lis    AS DATE.
DEFINE VARIABLE hora_lis     AS CHARACTER.
DEFINE VARIABLE p_printed    AS LOGICAL.
DEFINE VARIABLE v-domicilio  AS CHARACTER FORMAT "X(30)" LABEL "Domicilio".
DEFINE VARIABLE v-telefono   AS CHARACTER LABEL "Telefono"  FORMAT "X(12)".
DEFINE VARIABLE v-importe    AS DECIMAL   COLUMN-LABEL "Importe".

DEFINE VARIABLE tot_importe  AS DECIMAL   COLUMN-LABEL "Importe".
DEFINE VARIABLE tot_coseguro AS DECIMAL   COLUMN-LABEL "Importe".
DEFINE VARIABLE tot_fichas   AS INTEGER.

DEFINE VARIABLE tcl_importe  AS DECIMAL   COLUMN-LABEL "Importe".
DEFINE VARIABLE tcl_coseguro AS DECIMAL   COLUMN-LABEL "Importe".
DEFINE VARIABLE tcl_fichas   AS INTEGER.

DEFINE VARIABLE tarifa       AS DECIMAL EXTENT 6 
       LABEL "Rojo","Amarillo","Verde","Azul","Lila","Negro".

DEFINE VARIABLE color_emr    AS CHARACTER EXTENT 6 
       INITIAL ["Rojo","Amarillo","Verde","Azul","Lila","Negro"].


DEFINE FRAME frm-titulo HEADER
  que_empresa 
  "{&TITULO-LST}" AT 52 
  "Pagina:" AT 130 PAGE-NUMBER FORMAT ">9" AT 137
  SKIP
  des_fecha AT 52
  "al"
  has_fecha
  "/"
  deshas_color 
  fecha_lis AT 130
  SKIP
  chr_{&TABLA} AT 52
  hora_lis AT 130
  SKIP(1)
  WITH WIDTH 150 FRAME frm-titulo TOP-ONLY PAGE-TOP STREAM-IO.

FORM
  Ficha.fch_alta 
  Ficha.num_ficha 
  v-telefono
  Ficha.nombre_pac FORMAT "X(20)"
  {&FICHA-CAMPO}
  Ficha.hms_alta
  v-domicilio
  Ficha.cdg_motivo COLUMN-LABEL "Mtv."
  Ficha.cdg_diagnostico COLUMN-LABEL "Diagn."
  Ficha.cdg_destino COLUMN-LABEL "Dst."
  Ficha.cdg_proveedor COLUMN-LABEL "(M)" 
  Ficha.imp_coseguro
  v-importe
  WITH WIDTH 150 DOWN CENTERED FRAME frm-listado USE-TEXT STREAM-IO.

UPDATE des_fecha /* COLON 10 */ has_fecha que_{&TABLA} SKIP 
       des_tipoemr /* COLON 10 */ has_tipoemr lista_empresas 
       tarifa [ 1 ] /* COLON 10 */ tarifa [ 2 ] tarifa [ 3 ]
       tarifa [ 4 ] /* COLON 10 */ tarifa [ 5 ] tarifa [ 6 ]
       WITH FRAME aa SIDE-LABELS THREE-D VIEW-AS DIALOG-BOX WIDTH 90 3 COLUMNS CENTERED
            TITLE "Ingrese parametros del listado: {&TITULO-LST}".

fecha_lis = TODAY.
hora_lis = STRING(TIME,"HH:MM:SS").
FIND {&TABLA} WHERE {&TABLA}.cdg_{&TABLA} = que_{&TABLA} NO-LOCK.
ASSIGN chr_{&TABLA} = {&TABLA}.nom_{&TABLA}.

tot_coseguro = 0.
tot_importe  = 0.
tot_fichas   = 0.

tcl_coseguro = 0.
tcl_importe  = 0.
tcl_fichas   = 0.

deshas_color = color_emr [ INTEGER(des_tipoemr) ] + "-" + color_emr [ INTEGER(has_tipoemr) ].


OUTPUT TO ".\TEMPDSP\A" PAGE-SIZE 55. 

FOR EACH Ficha 
    WHERE Ficha.fch_alta <= has_fecha 
      AND Ficha.fch_alta >= des_fecha
      AND Ficha.cdg_tipoemr <= has_tipoemr 
      AND Ficha.cdg_tipoemr >= des_tipoemr
      AND LOOKUP(Ficha.cdg_empresa,lista_empresas) <> 0
      BREAK BY Ficha.cdg_tipoemr
            BY Ficha.fch_alta 
            BY Ficha.num_ficha WITH FRAME f-listado:

    VIEW FRAME frm-titulo.

    FIND Movil       OF Ficha NO-LOCK NO-ERROR.
    FIND Diagnostico OF Ficha NO-LOCK NO-ERROR.
    FIND Motivo      OF Ficha NO-LOCK NO-ERROR.
    FIND Destemer    OF Ficha NO-LOCK NO-ERROR.
    FIND Localidad   OF Ficha NO-LOCK NO-ERROR.

    v-domicilio = Ficha.calle_emr + " " + Ficha.nropta_emr + "-" + Localidad.dsc_localidad.
    v-telefono =  Ficha.prefijotel_emr + "-" + Ficha.telefono_emr.
    v-importe = IF INTEGER(Ficha.cdg_tipoemr) <> 0 
                   THEN tarifa [ INTEGER(Ficha.cdg_tipoemr) ] 
                   ELSE 0.
    tot_fichas = tot_fichas + 1.
    tot_coseguro = tot_coseguro + imp_coseguro.
    tot_importe = tot_importe + v-importe.

    tcl_fichas = tcl_fichas + 1.
    tcl_coseguro = tcl_coseguro + imp_coseguro.
    tcl_importe = tcl_importe + v-importe.

    DISPLAY Ficha.fch_alta   WHEN FIRST-OF(Ficha.fch_alta)
            Ficha.num_ficha 
            v-telefono
            Ficha.nombre_pac FORMAT "X(20)"
            {&FICHA-CAMPO}
            Ficha.hms_alta
            v-domicilio
            Ficha.cdg_motivo COLUMN-LABEL "Mtv."
            Ficha.cdg_diagnostico COLUMN-LABEL "Diagn."
            Ficha.cdg_destino COLUMN-LABEL "Dst."
            Ficha.cdg_proveedor COLUMN-LABEL "(M)" 
            Ficha.imp_coseguro
            v-importe
            WITH FRAME frm-listado.

    DOWN WITH FRAME frm-listado.        

END.            

UNDERLINE Ficha.fch_alta
          Ficha.num_ficha 
          v-telefono
          Ficha.nombre_pac
          {&FICHA-CAMPO}
          Ficha.hms_alta
          v-domicilio
          Ficha.cdg_motivo
          Ficha.cdg_diagnostico
          Ficha.cdg_destino
          Ficha.cdg_proveedor
          Ficha.imp_coseguro
          v-importe
          WITH FRAME frm-listado.

DISPLAY   tot_fichas @ Ficha.num_ficha 
          "TOTAL"    @ v-telefono
          tot_coseguro @ Ficha.imp_coseguro 
          tot_importe @ v-importe 
          WITH FRAME frm-listado.

OUTPUT CLOSE.

RUN _osprint.p ( INPUT  CURRENT-WINDOW:HANDLE, /* HANDLE de la WINDOW    */
                 INPUT  ".\TEMPDSP\A",        /* Archivo a imprimir     */
                 INPUT  8,                     /* FONT a utilizar        */
                 INPUT  2,                     /* Print Flags 2=Apaisado */
                 INPUT  55,                    /* Lineas por Pagina      */
                 INPUT  0,                     /* 0= Todo, <>0 seleccion */
                 OUTPUT  p_Printed ).          /* Se imprimió o no       */

           
