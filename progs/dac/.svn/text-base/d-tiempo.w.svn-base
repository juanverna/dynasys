/* ***********************  Control Definitions  ********************** */

/* Define a dialog box                                                  */

/* Definitions of the field level widgets                               */
DEFINE BUTTON Btn_Cancel AUTO-END-KEY 
     LABEL "Cancel" 
     SIZE 14 BY 1.15
     BGCOLOR 8 .

DEFINE BUTTON Btn_OK AUTO-GO 
     LABEL "OK" 
     SIZE 14 BY 1.15
     BGCOLOR 8 .

DEFINE VARIABLE v-hh-arrbase AS INTEGER FORMAT "99":U INITIAL 0 
     LABEL "Arribo a Base" 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-hh-arrdom AS INTEGER FORMAT "99":U INITIAL 0 
     LABEL "Arribo a Domicilio" 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-hh-arrhosp AS INTEGER FORMAT "99":U INITIAL 0 
     LABEL "Arribo a Hospital" 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-hh-cierre AS INTEGER FORMAT "99":U INITIAL 0 
     LABEL "Cierre Ficha" 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-hh-despacho AS INTEGER FORMAT "99":U INITIAL 0 
     LABEL "Despacho" 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-hh-disponible AS INTEGER FORMAT "99":U INITIAL 0 
     LABEL "Móvil Disponible" 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-hh-salbase AS INTEGER FORMAT "99":U INITIAL 0 
     LABEL "Salida Base" 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-hh-saldom AS INTEGER FORMAT "99":U INITIAL 0 
     LABEL "Salida de Domicilio" 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-hh-salhosp AS INTEGER FORMAT "99":U INITIAL 0 
     LABEL "Salida de Hospital" 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-mm-arrbase AS INTEGER FORMAT "99":U INITIAL 0 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-mm-arrdom AS INTEGER FORMAT "99":U INITIAL 0 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-mm-arrhosp AS INTEGER FORMAT "99":U INITIAL 0 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-mm-cierre AS INTEGER FORMAT "99":U INITIAL 0 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-mm-despacho AS INTEGER FORMAT "99":U INITIAL 0 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-mm-disponible AS INTEGER FORMAT "99":U INITIAL 0 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-mm-salbase AS INTEGER FORMAT "99":U INITIAL 0 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-mm-saldom AS INTEGER FORMAT "99":U INITIAL 0 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-mm-salhosp AS INTEGER FORMAT "99":U INITIAL 0 
     VIEW-AS FILL-IN 
     SIZE 4 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE RECTANGLE RECT-13
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 38 BY 13.46.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME D-Dialog
     v-hh-despacho AT ROW 2.08 COL 23 COLON-ALIGNED AUTO-RETURN 
     v-mm-despacho AT ROW 2.08 COL 30 COLON-ALIGNED NO-LABEL AUTO-RETURN 
     v-hh-salbase AT ROW 3.15 COL 23 COLON-ALIGNED AUTO-RETURN 
     v-mm-salbase AT ROW 3.15 COL 30 COLON-ALIGNED NO-LABEL AUTO-RETURN 
     v-hh-arrdom AT ROW 4.23 COL 23 COLON-ALIGNED AUTO-RETURN 
     v-mm-arrdom AT ROW 4.23 COL 30 COLON-ALIGNED NO-LABEL AUTO-RETURN 
     v-hh-saldom AT ROW 5.31 COL 23 COLON-ALIGNED AUTO-RETURN 
     v-mm-saldom AT ROW 5.31 COL 30 COLON-ALIGNED NO-LABEL AUTO-RETURN 
     v-hh-arrhosp AT ROW 6.38 COL 23 COLON-ALIGNED AUTO-RETURN 
     v-mm-arrhosp AT ROW 6.38 COL 30 COLON-ALIGNED NO-LABEL AUTO-RETURN 
     v-hh-salhosp AT ROW 7.46 COL 23 COLON-ALIGNED AUTO-RETURN 
     v-mm-salhosp AT ROW 7.46 COL 30 COLON-ALIGNED NO-LABEL AUTO-RETURN 
     v-hh-arrbase AT ROW 8.54 COL 23 COLON-ALIGNED AUTO-RETURN 
     v-mm-arrbase AT ROW 8.54 COL 30 COLON-ALIGNED NO-LABEL AUTO-RETURN 
     v-hh-disponible AT ROW 9.62 COL 23 COLON-ALIGNED AUTO-RETURN 
     v-mm-disponible AT ROW 9.62 COL 30 COLON-ALIGNED NO-LABEL AUTO-RETURN 
     v-hh-cierre AT ROW 10.69 COL 23 COLON-ALIGNED AUTO-RETURN 
     v-mm-cierre AT ROW 10.69 COL 30 COLON-ALIGNED NO-LABEL AUTO-RETURN 
     Btn_OK AT ROW 12.85 COL 7
     Btn_Cancel AT ROW 12.85 COL 22
     RECT-13 AT ROW 1.27 COL 3
     SPACE(2.13) SKIP(0.53)
    WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER 
         SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE 
         TITLE "Completar Tiempos a Mano"
         DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.


