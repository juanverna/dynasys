/* ************************  Control Triggers  ************************ */

&Scoped-define SELF-NAME D-Dialog
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL D-Dialog D-Dialog
ON WINDOW-CLOSE OF FRAME D-Dialog /* Completar Tiempos a Mano */
DO:  
  /* Add Trigger to equate WINDOW-CLOSE to END-ERROR. */
  APPLY "END-ERROR":U TO SELF.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME v-mm-arrdom
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-mm-arrdom D-Dialog
ON LEAVE OF v-mm-arrdom IN FRAME D-Dialog
DO:
  FIND CURRENT Ficha EXCLUSIVE-LOCK.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&UNDEFINE SELF-NAME

