&ANALYZE-SUSPEND _VERSION-NUMBER UIB_v8r12 GUI
&ANALYZE-RESUME
&Scoped-define WINDOW-NAME CURRENT-WINDOW
&Scoped-define FRAME-NAME Dialog-Frame
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CUSTOM _DEFINITIONS Dialog-Frame 
/*------------------------------------------------------------------------

  File: 

  Description: 

  Input Parameters:
      <none>

  Output Parameters:
      <none>

  Author: 

  Created: 
------------------------------------------------------------------------*/
/*          This .W file was created with the Progress UIB.             */
/*----------------------------------------------------------------------*/

/* ***************************  Definitions  ************************** */

/* Parameters Definitions ---                                           */

/* Local Variable Definitions ---                                       */

DEFINE VARIABLE que_color AS INTEGER.

&IF DEFINED(UIB_is_Running) &THEN
DEFINE VARIABLE p-color_item   AS INTEGER INITIAL 1.
DEFINE VARIABLE p-color_menu   AS INTEGER INITIAL 2.
DEFINE VARIABLE p-color_browse AS INTEGER INITIAL 3.
DEFINE VARIABLE puso_ok        AS LOGICAL.
&ELSE
DEFINE INPUT-OUTPUT PARAMETER p-color_item   AS INTEGER.
DEFINE INPUT-OUTPUT PARAMETER p-color_menu   AS INTEGER.
DEFINE INPUT-OUTPUT PARAMETER p-color_browse AS INTEGER.
DEFINE OUTPUT       PARAMETER puso_ok        AS LOGICAL.
&ENDIF

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-PREPROCESSOR-BLOCK 

/* ********************  Preprocessor Definitions  ******************** */

&Scoped-define PROCEDURE-TYPE DIALOG-BOX

/* Name of first Frame and/or Browse and/or first Query                 */
&Scoped-define FRAME-NAME Dialog-Frame

/* Standard List Definitions                                            */
&Scoped-Define ENABLED-OBJECTS RECT-17 v-color_item v-color_menu ~
v-color_browse Btn_OK Btn_Cancel 
&Scoped-Define DISPLAYED-OBJECTS v-color_item v-item v-color_menu v-menu ~
v-color_browse v-browse 

/* Custom List Definitions                                              */
/* List-1,List-2,List-3,List-4,List-5,List-6                            */

/* _UIB-PREPROCESSOR-BLOCK-END */
&ANALYZE-RESUME



/* ***********************  Control Definitions  ********************** */

/* Define a dialog box                                                  */

/* Definitions of the field level widgets                               */
DEFINE BUTTON Btn_Cancel AUTO-END-KEY 
     LABEL "Cancel" 
     SIZE 15 BY 1.15
     BGCOLOR 8 .

DEFINE BUTTON Btn_OK AUTO-GO 
     LABEL "OK" 
     SIZE 15 BY 1.15
     BGCOLOR 8 .

DEFINE VARIABLE v-browse AS CHARACTER FORMAT "X(256)":U 
     VIEW-AS FILL-IN 
     SIZE 21 BY .81 NO-UNDO.

DEFINE VARIABLE v-color_browse AS INTEGER FORMAT "->,>>>,>>9" INITIAL 0 
     LABEL "Color de Browse" 
     VIEW-AS FILL-IN NATIVE 
     SIZE 4.72 BY .81
     BGCOLOR 15 FGCOLOR 9 .

DEFINE VARIABLE v-color_item AS INTEGER FORMAT "->,>>>,>>9" INITIAL 0 
     LABEL "Color de Item" 
     VIEW-AS FILL-IN NATIVE 
     SIZE 4.72 BY .81
     BGCOLOR 15 FGCOLOR 9 .

DEFINE VARIABLE v-color_menu AS INTEGER FORMAT "->,>>>,>>9" INITIAL 0 
     LABEL "Color de Menu" 
     VIEW-AS FILL-IN NATIVE 
     SIZE 4.72 BY .81
     BGCOLOR 15 FGCOLOR 9 .

DEFINE VARIABLE v-item AS CHARACTER FORMAT "X(256)":U 
     VIEW-AS FILL-IN 
     SIZE 21 BY .81 NO-UNDO.

DEFINE VARIABLE v-menu AS CHARACTER FORMAT "X(256)":U 
     VIEW-AS FILL-IN 
     SIZE 21 BY .81 NO-UNDO.

DEFINE RECTANGLE RECT-17
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 48 BY 6.19.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME Dialog-Frame
     v-color_item AT ROW 2.08 COL 18 COLON-ALIGNED
     v-item AT ROW 2.08 COL 24 COLON-ALIGNED NO-LABEL
     v-color_menu AT ROW 3.15 COL 18 COLON-ALIGNED
     v-menu AT ROW 3.15 COL 24 COLON-ALIGNED NO-LABEL
     v-color_browse AT ROW 4.23 COL 18 COLON-ALIGNED
     v-browse AT ROW 4.23 COL 24 COLON-ALIGNED NO-LABEL
     Btn_OK AT ROW 5.85 COL 5
     Btn_Cancel AT ROW 5.85 COL 32
     RECT-17 AT ROW 1.27 COL 2
     SPACE(1.13) SKIP(0.34)
    WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER 
         SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE 
         TITLE "Seleccione los colores de pantalla".


/* *********************** Procedure Settings ************************ */

&ANALYZE-SUSPEND _PROCEDURE-SETTINGS
/* Settings for THIS-PROCEDURE
   Type: DIALOG-BOX
   Allow: Basic,Browse,DB-Fields,Query
   Other Settings: COMPILE
 */
&ANALYZE-RESUME _END-PROCEDURE-SETTINGS


/* ***************  Runtime Attributes and UIB Settings  ************** */

&ANALYZE-SUSPEND _RUN-TIME-ATTRIBUTES
/* SETTINGS FOR DIALOG-BOX Dialog-Frame
                                                                        */
ASSIGN 
       FRAME Dialog-Frame:SCROLLABLE       = FALSE
       FRAME Dialog-Frame:HIDDEN           = TRUE.

/* SETTINGS FOR FILL-IN v-browse IN FRAME Dialog-Frame
   NO-ENABLE                                                            */
/* SETTINGS FOR FILL-IN v-item IN FRAME Dialog-Frame
   NO-ENABLE                                                            */
/* SETTINGS FOR FILL-IN v-menu IN FRAME Dialog-Frame
   NO-ENABLE                                                            */
/* _RUN-TIME-ATTRIBUTES-END */
&ANALYZE-RESUME

 




/* ************************  Control Triggers  ************************ */

&Scoped-define SELF-NAME Dialog-Frame
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL Dialog-Frame Dialog-Frame
ON WINDOW-CLOSE OF FRAME Dialog-Frame /* Seleccione los colores de pantalla */
DO:
  APPLY "END-ERROR":U TO SELF.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME Btn_Cancel
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL Btn_Cancel Dialog-Frame
ON CHOOSE OF Btn_Cancel IN FRAME Dialog-Frame /* Cancel */
DO:
  puso_ok = NO.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME Btn_OK
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL Btn_OK Dialog-Frame
ON CHOOSE OF Btn_OK IN FRAME Dialog-Frame /* OK */
DO:

   ASSIGN FRAME {&FRAME-NAME}
        v-color_item
        v-color_menu
        v-color_browse.

   ASSIGN
        p-color_item   = v-color_item
        p-color_menu   = v-color_menu
        p-color_browse = v-color_browse
        puso_ok        = YES.
  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME v-color_browse
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-color_browse Dialog-Frame
ON LEAVE OF v-color_browse IN FRAME Dialog-Frame /* Color de Browse */
DO:
    RUN color_browse.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-color_browse Dialog-Frame
ON MOUSE-MENU-DOWN OF v-color_browse IN FRAME Dialog-Frame /* Color de Browse */
DO:
  que_color = INTEGER(v-color_browse:SCREEN-VALUE IN FRAME {&FRAME-NAME}).
  RUN d-helpcolor.w ( INPUT-OUTPUT que_color ).
  IF que_color <> ?
  THEN DO:
       DISPLAY que_color @ v-color_browse
               WITH FRAME {&FRAME-NAME}.
       APPLY "LEAVE" TO v-color_browse IN FRAME {&FRAME-NAME}.        
       RETURN NO-APPLY.
  END.
  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME v-color_item
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-color_item Dialog-Frame
ON LEAVE OF v-color_item IN FRAME Dialog-Frame /* Color de Item */
DO:
  RUN color_item.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-color_item Dialog-Frame
ON MOUSE-MENU-DOWN OF v-color_item IN FRAME Dialog-Frame /* Color de Item */
DO:
  que_color = INTEGER(v-color_item:SCREEN-VALUE IN FRAME {&FRAME-NAME}).
  RUN d-helpcolor.w ( INPUT-OUTPUT que_color ).
  IF que_color <> ?
  THEN DO:
       DISPLAY que_color @ v-color_item
               WITH FRAME {&FRAME-NAME}.
       APPLY "LEAVE" TO v-color_item IN FRAME {&FRAME-NAME}.        
       RETURN NO-APPLY.
  END.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME v-color_menu
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-color_menu Dialog-Frame
ON LEAVE OF v-color_menu IN FRAME Dialog-Frame /* Color de Menu */
DO:
    RUN color_menu.  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-color_menu Dialog-Frame
ON MOUSE-MENU-DOWN OF v-color_menu IN FRAME Dialog-Frame /* Color de Menu */
DO:
  que_color = INTEGER(v-color_menu:SCREEN-VALUE IN FRAME {&FRAME-NAME}).
  RUN d-helpcolor.w ( INPUT-OUTPUT que_color ).
  IF que_color <> ?
  THEN DO:
       DISPLAY que_color @ v-color_menu
               WITH FRAME {&FRAME-NAME}.
       APPLY "LEAVE" TO v-color_menu IN FRAME {&FRAME-NAME}.        
       RETURN NO-APPLY.
  END.
  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&UNDEFINE SELF-NAME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CUSTOM _MAIN-BLOCK Dialog-Frame 


/* ***************************  Main Block  *************************** */

/* Parent the dialog-box to the ACTIVE-WINDOW, if there is no parent.   */
IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME {&FRAME-NAME}:PARENT eq ?
THEN FRAME {&FRAME-NAME}:PARENT = ACTIVE-WINDOW.


/* Now enable the interface and wait for the exit condition.            */
/* (NOTE: handle ERROR and END-KEY so cleanup code will always fire.    */
MAIN-BLOCK:
DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
   ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:
  RUN enable_UI.
  RUN iniciar_valores.
  WAIT-FOR GO OF FRAME {&FRAME-NAME}.
END.
RUN disable_UI.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


/* **********************  Internal Procedures  *********************** */

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE color_browse Dialog-Frame 
PROCEDURE color_browse :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  DO WITH FRAME {&FRAME-NAME}:
     v-browse:BGCOLOR = INTEGER(v-color_browse:SCREEN-VALUE).
  END.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE color_item Dialog-Frame 
PROCEDURE color_item :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  DO WITH FRAME {&FRAME-NAME}:
     v-item:BGCOLOR = INTEGER(v-color_item:SCREEN-VALUE).
  END.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE color_menu Dialog-Frame 
PROCEDURE color_menu :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  DO WITH FRAME {&FRAME-NAME}:
     v-menu:BGCOLOR = INTEGER(v-color_menu:SCREEN-VALUE).
  END.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE disable_UI Dialog-Frame _DEFAULT-DISABLE
PROCEDURE disable_UI :
/*------------------------------------------------------------------------------
  Purpose:     DISABLE the User Interface
  Parameters:  <none>
  Notes:       Here we clean-up the user-interface by deleting
               dynamic widgets we have created and/or hide 
               frames.  This procedure is usually called when
               we are ready to "clean-up" after running.
------------------------------------------------------------------------------*/
  /* Hide all frames. */
  HIDE FRAME Dialog-Frame.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE enable_UI Dialog-Frame _DEFAULT-ENABLE
PROCEDURE enable_UI :
/*------------------------------------------------------------------------------
  Purpose:     ENABLE the User Interface
  Parameters:  <none>
  Notes:       Here we display/view/enable the widgets in the
               user-interface.  In addition, OPEN all queries
               associated with each FRAME and BROWSE.
               These statements here are based on the "Other 
               Settings" section of the widget Property Sheets.
------------------------------------------------------------------------------*/
  DISPLAY v-color_item v-item v-color_menu v-menu v-color_browse v-browse 
      WITH FRAME Dialog-Frame.
  ENABLE RECT-17 v-color_item v-color_menu v-color_browse Btn_OK Btn_Cancel 
      WITH FRAME Dialog-Frame.
  VIEW FRAME Dialog-Frame.
  {&OPEN-BROWSERS-IN-QUERY-Dialog-Frame}
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE iniciar_valores Dialog-Frame 
PROCEDURE iniciar_valores :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

   ASSIGN
        v-color_item   = p-color_item
        v-color_menu   = p-color_menu
        v-color_browse = p-color_browse
        puso_ok        = YES.

   DISPLAY 
        v-color_item   
        v-color_menu   
        v-color_browse 
        WITH FRAME {&FRAME-NAME}.
        
   RUN color_item.
   RUN color_menu.
   RUN color_browse.     

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


