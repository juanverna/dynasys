&ANALYZE-SUSPEND _VERSION-NUMBER UIB_v8r12 GUI
&ANALYZE-RESUME
/* Connected Databases 
          despacho         PROGRESS
*/
&Scoped-define WINDOW-NAME CURRENT-WINDOW
&Scoped-define FRAME-NAME D-Dialog
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CUSTOM _DEFINITIONS D-Dialog 
/*------------------------------------------------------------------------

  File: 

  Description: from cntnrdlg.w - ADM SmartDialog Template

  Input Parameters:
      <none>

  Output Parameters:
      <none>

  Author: 

  Created: 
------------------------------------------------------------------------*/
/*          This .W file was created with the Progress UIB.             */
/*----------------------------------------------------------------------*/

/* Create an unnamed pool to store all the widgets created 
     by this procedure. This is a good default which assures
     that this procedure's triggers and internal procedures 
     will execute in this procedure's storage, and that proper
     cleanup will occur on deletion of the procedure. */

CREATE WIDGET-POOL.

/* ***************************  Definitions  ************************** */

/* Parameters Definitions ---                                           */

&IF DEFINED(UIB_IS_RUNNING) EQ 0 
&THEN 
DEFINE INPUT-OUTPUT PARAMETER rid_ficha AS ROWID.
DEFINE OUTPUT PARAMETER que_hizo  AS LOGICAL.
&ELSE
DEFINE VARIABLE rid_ficha AS ROWID.
DEFINE VARIABLE que_hizo  AS LOGICAL.
&ENDIF

/* Local Variable Definitions ---                                       */

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-PREPROCESSOR-BLOCK 

/* ********************  Preprocessor Definitions  ******************** */

&Scoped-define PROCEDURE-TYPE SmartDialog

&Scoped-define ADM-CONTAINER DIALOG-BOX

/* Name of first Frame and/or Browse and/or first Query                 */
&Scoped-define FRAME-NAME D-Dialog

/* Internal Tables (found by Frame, Query & Browse Queries)             */
&Scoped-define INTERNAL-TABLES Ficha

/* Definitions for DIALOG-BOX D-Dialog                                  */
&Scoped-define FIELDS-IN-QUERY-D-Dialog Ficha.nropta_emr Ficha.calle_emr ~
Ficha.piso_emr Ficha.depto_emr Ficha.prefijotel_emr Ficha.telefono_emr ~
Ficha.entre1_emr Ficha.entre2_emr Ficha.edad_pac Ficha.sexo_pac ~
Ficha.nombre_pac Ficha.num_referencia 
&Scoped-define OPEN-QUERY-D-Dialog OPEN QUERY D-Dialog FOR EACH Ficha SHARE-LOCK.
&Scoped-define TABLES-IN-QUERY-D-Dialog Ficha
&Scoped-define FIRST-TABLE-IN-QUERY-D-Dialog Ficha


/* Standard List Definitions                                            */
&Scoped-Define ENABLED-OBJECTS RECT-1 RECT-14 Btn_OK v_num_ficha Btn_Cancel 
&Scoped-Define DISPLAYED-FIELDS Ficha.nropta_emr Ficha.calle_emr ~
Ficha.piso_emr Ficha.depto_emr Ficha.prefijotel_emr Ficha.telefono_emr ~
Ficha.entre1_emr Ficha.entre2_emr Ficha.edad_pac Ficha.sexo_pac ~
Ficha.nombre_pac Ficha.num_referencia 
&Scoped-Define DISPLAYED-OBJECTS v_num_ficha 

/* Custom List Definitions                                              */
/* List-1,List-2,List-3,List-4,List-5,List-6                            */

/* _UIB-PREPROCESSOR-BLOCK-END */
&ANALYZE-RESUME



/* ***********************  Control Definitions  ********************** */

/* Define a dialog box                                                  */

/* Definitions of the field level widgets                               */
DEFINE BUTTON Btn_Cancel AUTO-END-KEY 
     LABEL "Cancel" 
     SIZE 14 BY 1.15
     BGCOLOR 8 .

DEFINE BUTTON Btn_OK AUTO-GO 
     LABEL "OK" 
     SIZE 14 BY 1.15
     BGCOLOR 8 .

DEFINE VARIABLE v_num_ficha AS INTEGER FORMAT ">>>>>>9" INITIAL 0 
     VIEW-AS FILL-IN 
     SIZE 9.72 BY 1.

DEFINE RECTANGLE RECT-1
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 23 BY 2.96.

DEFINE RECTANGLE RECT-14
     EDGE-PIXELS 4 GRAPHIC-EDGE  NO-FILL 
     SIZE 18 BY 2.96.

/* Query definitions                                                    */
&ANALYZE-SUSPEND
DEFINE QUERY D-Dialog FOR 
      Ficha SCROLLING.
&ANALYZE-RESUME

/* ************************  Frame Definitions  *********************** */

DEFINE FRAME D-Dialog
     Btn_OK AT ROW 1.27 COL 37
     v_num_ficha AT ROW 2.35 COL 14 COLON-ALIGNED HELP
          "Número de ficha de despacho" NO-LABEL
     Btn_Cancel AT ROW 2.62 COL 37
     Ficha.nropta_emr AT ROW 4.77 COL 41 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 10 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Ficha.calle_emr AT ROW 4.81 COL 9 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 26.72 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Ficha.piso_emr AT ROW 5.85 COL 9 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 7.72 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Ficha.depto_emr AT ROW 5.85 COL 28 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 7.72 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Ficha.prefijotel_emr AT ROW 6.92 COL 9 COLON-ALIGNED
          LABEL "Tel."
          VIEW-AS FILL-IN 
          SIZE 8.72 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Ficha.telefono_emr AT ROW 6.92 COL 20 COLON-ALIGNED NO-LABEL
          VIEW-AS FILL-IN 
          SIZE 15.72 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Ficha.entre1_emr AT ROW 8 COL 9 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 26.72 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Ficha.entre2_emr AT ROW 9.08 COL 9 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 26.72 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Ficha.edad_pac AT ROW 10.15 COL 9 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 5.14 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Ficha.sexo_pac AT ROW 10.15 COL 22 NO-LABEL
          VIEW-AS RADIO-SET HORIZONTAL
          RADIO-BUTTONS 
                    "Mas", "M":U,
"Fem", "F":U
          SIZE 15.57 BY .77
     Ficha.nombre_pac AT ROW 11.23 COL 3.14
          VIEW-AS FILL-IN 
          SIZE 42 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Ficha.num_referencia AT ROW 12.31 COL 9 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 10.72 BY .81
          BGCOLOR 15 FGCOLOR 9 
     RECT-1 AT ROW 1 COL 11
     RECT-14 AT ROW 1 COL 35
     "Buscar Ficha Numero" VIEW-AS TEXT
          SIZE 20 BY .62 AT ROW 1.27 COL 13
     SPACE(22.71) SKIP(12.75)
    WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER 
         SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE 
         TITLE "Busqueda de Incidentes"
         DEFAULT-BUTTON Btn_OK CANCEL-BUTTON Btn_Cancel.


/* *********************** Procedure Settings ************************ */

&ANALYZE-SUSPEND _PROCEDURE-SETTINGS
/* Settings for THIS-PROCEDURE
   Type: SmartDialog
   Allow: Basic,Browse,DB-Fields,Query,Smart
 */
&ANALYZE-RESUME _END-PROCEDURE-SETTINGS


/* ***************  Runtime Attributes and UIB Settings  ************** */

&ANALYZE-SUSPEND _RUN-TIME-ATTRIBUTES
/* SETTINGS FOR DIALOG-BOX D-Dialog
                                                                        */
ASSIGN 
       FRAME D-Dialog:SCROLLABLE       = FALSE
       FRAME D-Dialog:HIDDEN           = TRUE.

/* SETTINGS FOR FILL-IN Ficha.calle_emr IN FRAME D-Dialog
   NO-ENABLE                                                            */
/* SETTINGS FOR FILL-IN Ficha.depto_emr IN FRAME D-Dialog
   NO-ENABLE                                                            */
/* SETTINGS FOR FILL-IN Ficha.edad_pac IN FRAME D-Dialog
   NO-ENABLE                                                            */
/* SETTINGS FOR FILL-IN Ficha.entre1_emr IN FRAME D-Dialog
   NO-ENABLE                                                            */
/* SETTINGS FOR FILL-IN Ficha.entre2_emr IN FRAME D-Dialog
   NO-ENABLE                                                            */
/* SETTINGS FOR FILL-IN Ficha.nombre_pac IN FRAME D-Dialog
   NO-ENABLE ALIGN-L                                                    */
/* SETTINGS FOR FILL-IN Ficha.nropta_emr IN FRAME D-Dialog
   NO-ENABLE                                                            */
/* SETTINGS FOR FILL-IN Ficha.num_referencia IN FRAME D-Dialog
   NO-ENABLE                                                            */
/* SETTINGS FOR FILL-IN Ficha.piso_emr IN FRAME D-Dialog
   NO-ENABLE                                                            */
/* SETTINGS FOR FILL-IN Ficha.prefijotel_emr IN FRAME D-Dialog
   NO-ENABLE EXP-LABEL                                                  */
/* SETTINGS FOR RADIO-SET Ficha.sexo_pac IN FRAME D-Dialog
   NO-ENABLE                                                            */
/* SETTINGS FOR FILL-IN Ficha.telefono_emr IN FRAME D-Dialog
   NO-ENABLE                                                            */
/* _RUN-TIME-ATTRIBUTES-END */
&ANALYZE-RESUME


/* Setting information for Queries and Browse Widgets fields            */

&ANALYZE-SUSPEND _QUERY-BLOCK DIALOG-BOX D-Dialog
/* Query rebuild information for DIALOG-BOX D-Dialog
     _TblList          = "despacho.Ficha"
     _Options          = "SHARE-LOCK"
     _Query            is NOT OPENED
*/  /* DIALOG-BOX D-Dialog */
&ANALYZE-RESUME

 


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CUSTOM _INCLUDED-LIB D-Dialog 
/* ************************* Included-Libraries *********************** */

{src/adm/method/containr.i}

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME




/* ************************  Control Triggers  ************************ */

&Scoped-define SELF-NAME D-Dialog
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL D-Dialog D-Dialog
ON WINDOW-CLOSE OF FRAME D-Dialog /* Busqueda de Incidentes */
DO:  
  /* Add Trigger to equate WINDOW-CLOSE to END-ERROR. */
  APPLY "END-ERROR":U TO SELF.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME v_num_ficha
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v_num_ficha D-Dialog
ON RETURN OF v_num_ficha IN FRAME D-Dialog
DO:
  ASSIGN v_num_ficha.
  FIND Ficha WHERE Ficha.num_ficha = v_num_ficha NO-LOCK NO-ERROR.
  IF AVAILABLE Ficha
  THEN DO:
       ASSIGN
             rid_ficha = ROWID(Ficha)
             que_hizo = YES. 
       DISPLAY 
             Ficha.calle_emr 
             Ficha.depto_emr 
             Ficha.edad_pac 
             Ficha.entre1_emr 
             Ficha.entre2_emr 
             Ficha.nombre_pac 
             Ficha.nropta_emr 
             Ficha.num_referencia 
             Ficha.piso_emr 
             Ficha.prefijotel_emr 
             Ficha.sexo_pac 
             Ficha.telefono_emr 
             WITH FRAME {&FRAME-NAME}.

  END.
  ELSE DO:
       ASSIGN
             rid_ficha = ?
             que_hizo = NO. 
       DISPLAY 
             " " @ Ficha.calle_emr 
             " " @ Ficha.depto_emr 
             " " @ Ficha.edad_pac 
             " " @ Ficha.entre1_emr 
             " " @ Ficha.entre2_emr 
             " " @ Ficha.nombre_pac 
             " " @ Ficha.nropta_emr 
             " " @ Ficha.num_referencia 
             " " @ Ficha.piso_emr 
             " " @ Ficha.prefijotel_emr 
             " " @ Ficha.telefono_emr 
             WITH FRAME {&FRAME-NAME}.


  END.
      
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&UNDEFINE SELF-NAME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CUSTOM _MAIN-BLOCK D-Dialog 


/* ***************************  Main Block  *************************** */

SESSION:DATA-ENTRY-RETURN = YES.

{src/adm/template/dialogmn.i}

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


/* **********************  Internal Procedures  *********************** */

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE adm-create-objects D-Dialog _ADM-CREATE-OBJECTS
PROCEDURE adm-create-objects :
/*------------------------------------------------------------------------------
  Purpose:     Create handles for all SmartObjects used in this procedure.
               After SmartObjects are initialized, then SmartLinks are added.
  Parameters:  <none>
------------------------------------------------------------------------------*/

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE adm-row-available D-Dialog _ADM-ROW-AVAILABLE
PROCEDURE adm-row-available :
/*------------------------------------------------------------------------------
  Purpose:     Dispatched to this procedure when the Record-
               Source has a new row available.  This procedure
               tries to get the new row (or foriegn keys) from
               the Record-Source and process it.
  Parameters:  <none>
------------------------------------------------------------------------------*/

  /* Define variables needed by this internal procedure.             */
  {src/adm/template/row-head.i}

  /* Process the newly available records (i.e. display fields,
     open queries, and/or pass records on to any RECORD-TARGETS).    */
  {src/adm/template/row-end.i}

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE disable_UI D-Dialog _DEFAULT-DISABLE
PROCEDURE disable_UI :
/*------------------------------------------------------------------------------
  Purpose:     DISABLE the User Interface
  Parameters:  <none>
  Notes:       Here we clean-up the user-interface by deleting
               dynamic widgets we have created and/or hide 
               frames.  This procedure is usually called when
               we are ready to "clean-up" after running.
------------------------------------------------------------------------------*/
  /* Hide all frames. */
  HIDE FRAME D-Dialog.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE enable_UI D-Dialog _DEFAULT-ENABLE
PROCEDURE enable_UI :
/*------------------------------------------------------------------------------
  Purpose:     ENABLE the User Interface
  Parameters:  <none>
  Notes:       Here we display/view/enable the widgets in the
               user-interface.  In addition, OPEN all queries
               associated with each FRAME and BROWSE.
               These statements here are based on the "Other 
               Settings" section of the widget Property Sheets.
------------------------------------------------------------------------------*/
  DISPLAY v_num_ficha 
      WITH FRAME D-Dialog.
  IF AVAILABLE Ficha THEN 
    DISPLAY Ficha.nropta_emr Ficha.calle_emr Ficha.piso_emr Ficha.depto_emr 
          Ficha.prefijotel_emr Ficha.telefono_emr Ficha.entre1_emr 
          Ficha.entre2_emr Ficha.edad_pac Ficha.sexo_pac Ficha.nombre_pac 
          Ficha.num_referencia 
      WITH FRAME D-Dialog.
  ENABLE RECT-1 RECT-14 Btn_OK v_num_ficha Btn_Cancel 
      WITH FRAME D-Dialog.
  VIEW FRAME D-Dialog.
  {&OPEN-BROWSERS-IN-QUERY-D-Dialog}
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE send-records D-Dialog _ADM-SEND-RECORDS
PROCEDURE send-records :
/*------------------------------------------------------------------------------
  Purpose:     Send record ROWID's for all tables used by
               this file.
  Parameters:  see template/snd-head.i
------------------------------------------------------------------------------*/

  /* Define variables needed by this internal procedure.               */
  {src/adm/template/snd-head.i}

  /* For each requested table, put it's ROWID in the output list.      */
  {src/adm/template/snd-list.i "Ficha"}

  /* Deal with any unexpected table requests before closing.           */
  {src/adm/template/snd-end.i}

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE state-changed D-Dialog 
PROCEDURE state-changed :
/* -----------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
-------------------------------------------------------------*/
  DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
  DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
END PROCEDURE.

