/*======================================================================================*/
/*      REALIZA LA CONECCION (OPCIONAL) DE LA BASE DE AFILIADOS E INVOCA DESPACHO       */
/*======================================================================================*/

DEFINE VARIABLE hubo_logon AS LOGICAL.

SESSION:TIME-SOURCE = "despacho".
SESSION:DATA-ENTRY-RETURN = YES.

RUN c-logon.w (OUTPUT hubo_logon).
IF hubo_logon THEN RUN w-interface-xml.w.
QUIT.
