&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE adm-row-available V-table-Win _ADM-ROW-AVAILABLE
PROCEDURE adm-row-available :
/*------------------------------------------------------------------------------
  Purpose:     Dispatched to this procedure when the Record-
               Source has a new row available.  This procedure
               tries to get the new row (or foriegn keys) from
               the Record-Source and process it.
  Parameters:  <none>
------------------------------------------------------------------------------*/

  /* Define variables needed by this internal procedure.             */
  {src/adm/template/row-head.i}

  /* Process the newly available records (i.e. display fields,
     open queries, and/or pass records on to any RECORD-TARGETS).    */
  {src/adm/template/row-end.i}

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE contar_veces V-table-Win 
PROCEDURE contar_veces :
/*------------------------------------------------------------------------------
  Purpose: DADO UN VALOR DE DATO DETERMINADO, CUENTA LA CANTIDAD DE OCURRENCIAS DEL MISMO    
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    
    DEFINE INPUT  PARAMETER p-cadena    AS CHARACTER.
    DEFINE INPUT  PARAMETER p-rotulo    AS CHARACTER.
    DEFINE OUTPUT PARAMETER p-jotaesima AS INTEGER.
    
    DEFINE VARIABLE p1                  AS INTEGER.
    DEFINE VARIABLE p2                  AS INTEGER.
    DEFINE VARIABLE k                   AS INTEGER.
    DEFINE VARIABLE straux              AS CHARACTER.
    
          /* Averiguamos la posicion de comienzo del valor en el string de entrada */
    
    straux = p-cadena.
    p-jotaesima = 0.
    DO WHILE straux <> "":
        p1 = INDEX(straux,"<" + p-rotulo + ">").
        IF p1 <> 0 
        THEN DO:
             p2 = INDEX(straux,"</" + p-rotulo + ">").
             straux = SUBSTRING(straux,p2 + LENGTH("</" + p-rotulo + ">")).
             p-jotaesima = p-jotaesima + 1.
        END.
        ELSE DO:
             straux = "".
        END.     
    END.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE control_load V-table-Win _CONTROL-LOAD
PROCEDURE control_load :
/*------------------------------------------------------------------------------
  Purpose:     Load the OCXs    
  Parameters:  <none>
  Notes:       Here we load, initialize and make visible the 
               OCXs in the interface.                        
------------------------------------------------------------------------------*/

&IF "{&OPSYS}" = "WIN32":U AND "{&WINDOW-SYSTEM}" NE "TTY":U &THEN
DEFINE VARIABLE UIB_S    AS LOGICAL    NO-UNDO.
DEFINE VARIABLE OCXFile  AS CHARACTER  NO-UNDO.

OCXFile = SEARCH( "v-prueba-suma.wrx":U ).
IF OCXFile = ? THEN
  OCXFile = SEARCH(SUBSTRING(THIS-PROCEDURE:FILE-NAME, 1,
                     R-INDEX(THIS-PROCEDURE:FILE-NAME, ".":U), "CHARACTER":U) + "wrx":U).

IF OCXFile <> ? THEN
DO:
  ASSIGN
    chCtrlFrame = CtrlFrame:COM-HANDLE
    UIB_S = chCtrlFrame:LoadControls( OCXFile, "CtrlFrame":U)
    chCtrlFrame-2 = CtrlFrame-2:COM-HANDLE
    UIB_S = chCtrlFrame-2:LoadControls( OCXFile, "CtrlFrame-2":U)
  .
  RUN DISPATCH IN THIS-PROCEDURE("initialize-controls":U) NO-ERROR.
END.
ELSE MESSAGE "v-prueba-suma.wrx":U SKIP(1)
             "The binary control file could not be found. The controls cannot be loaded."
             VIEW-AS ALERT-BOX TITLE "Controls Not Loaded".

&ENDIF

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE disable_UI V-table-Win _DEFAULT-DISABLE
PROCEDURE disable_UI :
/*------------------------------------------------------------------------------
  Purpose:     DISABLE the User Interface
  Parameters:  <none>
  Notes:       Here we clean-up the user-interface by deleting
               dynamic widgets we have created and/or hide 
               frames.  This procedure is usually called when
               we are ready to "clean-up" after running.
------------------------------------------------------------------------------*/
  /* Hide all frames. */
  HIDE FRAME F-Main.
  IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE get_lista_incidentes V-table-Win 
PROCEDURE get_lista_incidentes :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  DEFINE VARIABLE n-mensajes AS INTEGER.
  DEFINE VARIABLE j-mensaje  AS INTEGER.
  
  DEFINE VARIABLE v-mensaje AS CHARACTER.

  RUN poner_estado ( INPUT "Recuperando lista de incidentes...." ).

  RUN get_pagina ( INPUT "mensajesrecurso" , INPUT "", OUTPUT v-resultado).

  RUN contar_veces ( INPUT v-resultado,
                     INPUT "MensajeRecurso",
                     OUTPUT n-mensajes).

      MESSAGE "Mensajes:" STRING(n-mensajes)
              VIEW-AS ALERT-BOX MESSAGE.
  DO j-mensaje = 1 TO n-mensajes:
   
     RUN get_valor  ( INPUT v-resultado,
                      INPUT "MensajeRecurso",
                      INPUT j-mensaje,
                      OUTPUT v-mensaje ).
                      
     MESSAGE v-mensaje VIEW-AS ALERT-BOX MESSAGE TITLE STRING(j-mensaje).                 
                      
  END.

/*
  RUN get_valor  ( INPUT v-resultado,
                   INPUT "MensajeRecurso",
                   INPUT 1,
                   OUTPUT v-idsesion ).

  RUN get_valor  ( INPUT v-resultado,
                   INPUT "Clavesesion",
                   INPUT 1,
                   OUTPUT v-clavesesion ).

  ASSIGN
     d-idsesion = v-idsesion
     d-clavesesion = v-clavesesion.
                    
  DISPLAY v-resultado 
          v-valor
          d-idsesion
          d-clavesesion          
          WITH FRAME  {&FRAME-NAME}.

  RUN poner_estado ( INPUT "SESION INICIADA" ).
*/
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE get_pagina V-table-Win 
PROCEDURE get_pagina :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  DEFINE INPUT PARAMETER   nombre_pagina       AS CHARACTER.
  DEFINE INPUT PARAMETER   parametros_pagina   AS CHARACTER.
  DEFINE OUTPUT PARAMETER  p-resultado         AS CHARACTER.
  
  DEFINE VARIABLE x-url AS CHARACTER.

  x-url = "file://d:\desa\dac\r3.8\ihs\xml\" + nombre_pagina + ".xml" .
  IF parametros_pagina <> ""
     THEN x-url = x-url + "?" + parametros_pagina.

  chctrlframe:inetihs:URL = x-url.

  p-resultado = chctrlframe:inetihs:openURL.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE get_valor V-table-Win 
PROCEDURE get_valor :
/*------------------------------------------------------------------------------
  Purpose: DADO UN VALOR DE DATO DETERMINADO, DEVUELVE EL VALOR ASOCIADO    
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    DEFINE INPUT  PARAMETER p-cadena    AS CHARACTER.
    DEFINE INPUT  PARAMETER p-rotulo    AS CHARACTER.
    DEFINE INPUT  PARAMETER p-jotaesima AS INTEGER.
    DEFINE OUTPUT PARAMETER p-valor     AS CHARACTER.
    
    DEFINE VARIABLE pos-start           AS INTEGER.
    DEFINE VARIABLE pos-valor           AS INTEGER.
    DEFINE VARIABLE len-valor           AS INTEGER.
    DEFINE VARIABLE p1                  AS INTEGER.
    DEFINE VARIABLE p2                  AS INTEGER.
    DEFINE VARIABLE k                   AS INTEGER.
    DEFINE VARIABLE straux              AS CHARACTER.
    
          /* Averiguamos la posicion de comienzo del valor en el string de entrada */
    
    straux = p-cadena.
    DO k = 1 TO p-jotaesima - 1:
        p1 = INDEX(straux,"<" + p-rotulo + ">").
        IF p1 <> 0 
        THEN DO:
             p2 = INDEX(straux,"</" + p-rotulo + ">").
             straux = SUBSTRING(straux,p2 + LENGTH("</" + p-rotulo + ">")).
        END.
        ELSE DO:
             straux = "".
        END.     
    END.
    
    p1 = INDEX(straux,"<" + p-rotulo + ">").
    IF p1 <> 0
    THEN DO:
       p2 = INDEX(straux,"</" + p-rotulo + ">").
       IF p2 <> 0
       THEN DO:
            pos-valor = p1 + LENGTH("<" + p-rotulo + ">").
            len-valor = p2 - pos-valor.
            p-valor = SUBSTRING(straux,pos-valor,len-valor).
       END.
       ELSE DO:
            p-valor = ?.
       END.      
    END.
    ELSE DO:
       p-valor = ?.
    END.   


END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE iniciar_sesion V-table-Win 
PROCEDURE iniciar_sesion :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  RUN poner_estado ( INPUT "Iniciando sesion...." ).

  /*
  chctrlframe:inetihs:URL = 
  "http://devihsawww/infoemerdatos/ingresoclaverecurso.asp?tiporadio=rcdmovil&claverecurso=31022010".
  */

  chctrlframe:inetihs:URL = "file://d:\desa\dac\r3.8\ihs\xml\ingresoclaverecurso.xml".

  v-resultado = chctrlframe:inetihs:openURL.
  
  RUN getvalor.p ( INPUT v-resultado,
                   INPUT "Idsesion",
                   INPUT 1,
                   OUTPUT v-idsesion ).

  RUN getvalor.p ( INPUT v-resultado,
                   INPUT "Clavesesion",
                   INPUT 1,
                   OUTPUT v-clavesesion ).

  ASSIGN
     d-idsesion = v-idsesion
     d-clavesesion = v-clavesesion.
                    
  DISPLAY v-resultado 
          v-valor
          d-idsesion
          d-clavesesion          
          WITH FRAME  {&FRAME-NAME}.

  RUN poner_estado ( INPUT "SESION INICIADA" ).

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE poner_estado V-table-Win 
PROCEDURE poner_estado :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  DEFINE INPUT PARAMETER p-estado AS CHARACTER.
  
  v-estado = p-estado.
  DISPLAY v-estado
          WITH FRAME {&FRAME-NAME}.


END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


