       ROW          = 13.12
       COLUMN       = 77
       HEIGHT       = 1.08
       WIDTH        = 4
       HIDDEN       = yes
       SENSITIVE    = yes.

PROCEDURE adm-create-controls:
      CtrlFrame:NAME = "CtrlFrame":U .
