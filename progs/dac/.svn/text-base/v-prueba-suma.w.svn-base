/* Definitions of the field level widgets                               */
DEFINE BUTTON btn_logear 
     LABEL "&Login" 
     SIZE 29 BY 1.12.

DEFINE BUTTON btn_ver 
     LABEL "&Ver" 
     SIZE 29 BY 1.12.

DEFINE VARIABLE v-resultado AS CHARACTER 
     VIEW-AS EDITOR SCROLLBAR-VERTICAL LARGE
     SIZE 63 BY 4.31
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE d-clavesesion AS CHARACTER FORMAT "X(256)":U 
     LABEL "Clave" 
     VIEW-AS FILL-IN 
     SIZE 14 BY 1 NO-UNDO.

DEFINE VARIABLE d-idsesion AS CHARACTER FORMAT "X(256)":U 
     LABEL "Id" 
     VIEW-AS FILL-IN 
     SIZE 14 BY 1 NO-UNDO.

DEFINE VARIABLE v-estado AS CHARACTER FORMAT "X(256)":U 
     LABEL "Estado" 
     VIEW-AS FILL-IN NATIVE 
     SIZE 63.29 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-valor AS CHARACTER FORMAT "X(256)":U 
     LABEL "Valor" 
     VIEW-AS FILL-IN 
     SIZE 63 BY 1 NO-UNDO.

DEFINE RECTANGLE RECT-1
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 82 BY 14.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME F-Main
     v-estado AT ROW 3.15 COL 10 COLON-ALIGNED
     d-idsesion AT ROW 4.77 COL 10 COLON-ALIGNED
     d-clavesesion AT ROW 4.77 COL 31 COLON-ALIGNED
     v-resultado AT ROW 6.12 COL 12 NO-LABEL
     v-valor AT ROW 10.96 COL 10 COLON-ALIGNED
     btn_logear AT ROW 13.12 COL 12
     btn_ver AT ROW 13.12 COL 45
     RECT-1 AT ROW 1 COL 1
    WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY 
         SIDE-LABELS NO-UNDERLINE THREE-D 
         AT COL 1 ROW 1 SCROLLABLE .


