DEFINE VARIABLE arch_salida     AS CHARACTER.
DEFINE VARIABLE salida_resumen  AS CHARACTER.

DEFINE VARIABLE que_empresa     AS CHARACTER FORMAT "X(35)" 
       INITIAL "UCREM/URMED".
DEFINE VARIABLE fecha_lis       AS CHARACTER.
DEFINE VARIABLE hora_lis        AS CHARACTER.
DEFINE VARIABLE p_printed       AS LOGICAL.
DEFINE VARIABLE tit_filtro      AS CHARACTER FORMAT "X(25)".
DEFINE VARIABLE lista_empresas  AS CHARACTER LABEL "Empresas".
DEFINE VARIABLE lista_traslados AS CHARACTER LABEL "Traslados".
DEFINE VARIABLE ctl_salto       AS LOGICAL LABEL "{&MODO-LISTADO}"
       VIEW-AS RADIO-SET RADIO-BUTTONS "Todos Juntos", NO, "Uno por hoja", YES.
