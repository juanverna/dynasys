/*==================================================================================*/
/*               MENSAJE DE CONFIRMACION PARA EJECUTAR EL PROCEDIMIENTO             */
/*               DE ACTUALIZACION DEL  PADRON DE UCREM                              */
/*==================================================================================*/

DEFINE OUTPUT PARAMETER sino AS LOGICAL.

MESSAGE "Este proceso actualiza el padron de UCREM. Para que pueda ejecutarse correctamente" 
        "debe procederse de la siguiente forma:" SKIP(1)
        "      1.- Copiar el archivo EXPORT.AZU debajo del directorio D:\TXTS" SKIP(1) 
        "      2.- Ejecutar el procedimiento lee_padron_ucrem" SKIP(1)
        "      3.- Borrar el archivo del directorio D:\TXTS" SKIP(1)
        "Indique si desea proceder a ejecutarlo" SKIP(2)
         VIEW-AS ALERT-BOX MESSAGE BUTTONS YES-NO TITLE "Actualizacion de padron UCREM" 
         SET sino.
