"Movil.cdg_movil" "Código!Móvil" ? "integer" ? ? ? ? ? ? no ?
     _FldNameList[2]   > despacho.Movil.dsc_movil
"Movil.dsc_movil" "Descripción!del móvil" "X(35)" "character" ? ? ? ? ? ? no ?
