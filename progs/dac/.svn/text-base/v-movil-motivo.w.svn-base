&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CUSTOM _DEFINITIONS V-table-Win 
/*------------------------------------------------------------------------

  File:

  Description: from VIEWER.W - Template for SmartViewer Objects

  Input Parameters:
      <none>

  Output Parameters:
      <none>

------------------------------------------------------------------------*/
/*          This .W file was created with the Progress UIB.             */
/*----------------------------------------------------------------------*/

/* Create an unnamed pool to store all the widgets created 
     by this procedure. This is a good default which assures
     that this procedure's triggers and internal procedures 
     will execute in this procedure's storage, and that proper
     cleanup will occur on deletion of the procedure. */

CREATE WIDGET-POOL.

/* ***************************  Definitions  ************************** */

/* Parameters Definitions ---                                           */

/* Local Variable Definitions ---                                       */

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-PREPROCESSOR-BLOCK 

/* ********************  Preprocessor Definitions  ******************** */

&Scoped-define PROCEDURE-TYPE SmartViewer

&Scoped-define ADM-SUPPORTED-LINKS Record-Source,Record-Target,TableIO-Target

/* Name of first Frame and/or Browse and/or first Query                 */
&Scoped-define FRAME-NAME F-Main

/* External Tables                                                      */
&Scoped-define EXTERNAL-TABLES Movil-motivo Movil
&Scoped-define FIRST-EXTERNAL-TABLE Movil-motivo


/* Need to scope the external tables to this procedure                  */
DEFINE QUERY external_tables FOR Movil-motivo, Movil.
/* Standard List Definitions                                            */
&Scoped-Define ENABLED-FIELDS Movil-motivo.cdg_motivo ~
Movil-motivo.espera_sincargo Movil-motivo.tarifa_espera ~
Movil-motivo.fraccion_espera Movil-motivo.kilometro_adicional ~
Movil-motivo.prc_regreso Movil-motivo.prc_oxigeno Movil-motivo.modo_sabado ~
Movil-motivo.restaescala_sino Movil-motivo.restalocalid_sino ~
Movil-motivo.descartable_sino Movil-motivo.medicamentos_sino 
&Scoped-define FIELD-PAIRS~
 ~{&FP1}cdg_motivo ~{&FP2}cdg_motivo ~{&FP3}~
 ~{&FP1}espera_sincargo ~{&FP2}espera_sincargo ~{&FP3}~
 ~{&FP1}tarifa_espera ~{&FP2}tarifa_espera ~{&FP3}~
 ~{&FP1}fraccion_espera ~{&FP2}fraccion_espera ~{&FP3}~
 ~{&FP1}kilometro_adicional ~{&FP2}kilometro_adicional ~{&FP3}~
 ~{&FP1}prc_regreso ~{&FP2}prc_regreso ~{&FP3}~
 ~{&FP1}prc_oxigeno ~{&FP2}prc_oxigeno ~{&FP3}
&Scoped-define ENABLED-TABLES Movil-motivo
&Scoped-define FIRST-ENABLED-TABLE Movil-motivo
&Scoped-Define ENABLED-OBJECTS RECT-13 RECT-12 
&Scoped-Define DISPLAYED-FIELDS Movil-motivo.cdg_motivo ~
Movil-motivo.espera_sincargo Movil-motivo.tarifa_espera ~
Movil-motivo.fraccion_espera Movil-motivo.kilometro_adicional ~
Movil-motivo.prc_regreso Movil-motivo.prc_oxigeno Movil-motivo.modo_sabado ~
Movil-motivo.restaescala_sino Movil-motivo.restalocalid_sino ~
Movil-motivo.descartable_sino Movil-motivo.medicamentos_sino 

/* Custom List Definitions                                              */
/* ADM-CREATE-FIELDS,ADM-ASSIGN-FIELDS,List-3,List-4,List-5,List-6      */

/* _UIB-PREPROCESSOR-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _XFTR "Foreign Keys" V-table-Win _INLINE
/* Actions: ? adm/support/keyedit.w ? ? ? */
/* STRUCTURED-DATA
<KEY-OBJECT>
THIS-PROCEDURE
</KEY-OBJECT>
<FOREIGN-KEYS>
</FOREIGN-KEYS> 
<EXECUTING-CODE>
**************************
* Set attributes related to FOREIGN KEYS
*/
RUN set-attribute-list (
    'Keys-Accepted = "",
     Keys-Supplied = ""':U).
/**************************
</EXECUTING-CODE> */   

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


/* ***********************  Control Definitions  ********************** */


/* Definitions of the field level widgets                               */
DEFINE RECTANGLE RECT-12
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 25 BY 11.85.

DEFINE RECTANGLE RECT-13
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 25 BY 1.62.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME F-Main
     Movil-motivo.cdg_motivo AT ROW 1.27 COL 13 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 9 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-motivo.espera_sincargo AT ROW 2.08 COL 13 COLON-ALIGNED
          LABEL "Espera S/C"
          VIEW-AS FILL-IN NATIVE 
          SIZE 9 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-motivo.tarifa_espera AT ROW 2.88 COL 13 COLON-ALIGNED
          LABEL "$ Espera"
          VIEW-AS FILL-IN NATIVE 
          SIZE 9 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-motivo.fraccion_espera AT ROW 3.69 COL 13 COLON-ALIGNED
          LABEL "Fracción"
          VIEW-AS FILL-IN NATIVE 
          SIZE 9 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-motivo.kilometro_adicional AT ROW 4.5 COL 13 COLON-ALIGNED
          LABEL "Km Adic."
          VIEW-AS FILL-IN NATIVE 
          SIZE 9 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-motivo.prc_regreso AT ROW 5.31 COL 13 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 9 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-motivo.prc_oxigeno AT ROW 6.12 COL 13 COLON-ALIGNED
          LABEL "% O2"
          VIEW-AS FILL-IN NATIVE 
          SIZE 9 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Movil-motivo.modo_sabado AT ROW 8 COL 2 NO-LABEL
          VIEW-AS RADIO-SET HORIZONTAL
          RADIO-BUTTONS 
                    "No", "",
"13 Hs.", "M":U,
"Si", "C":U
          SIZE 23 BY .81
     Movil-motivo.restaescala_sino AT ROW 9.35 COL 3
          LABEL "Restar de la Escala"
          VIEW-AS TOGGLE-BOX
          SIZE 22 BY .77
     Movil-motivo.restalocalid_sino AT ROW 10.15 COL 3
          LABEL "Restar Localidades"
          VIEW-AS TOGGLE-BOX
          SIZE 21 BY .77
     Movil-motivo.descartable_sino AT ROW 10.96 COL 3
          LABEL "Descartables S/Carg"
          VIEW-AS TOGGLE-BOX
          SIZE 22 BY .77
     Movil-motivo.medicamentos_sino AT ROW 11.77 COL 3
          LABEL "Medicamentos S/Cargo"
          VIEW-AS TOGGLE-BOX
          SIZE 22 BY .77
     "  Sábado Feriado" VIEW-AS TEXT
          SIZE 16 BY .62 AT ROW 7.19 COL 5
     RECT-13 AT ROW 7.46 COL 1
     RECT-12 AT ROW 1 COL 1
    WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY 
         SIDE-LABELS NO-UNDERLINE THREE-D 
         AT COL 1 ROW 1 SCROLLABLE .


/* *********************** Procedure Settings ************************ */

&ANALYZE-SUSPEND _PROCEDURE-SETTINGS
/* Settings for THIS-PROCEDURE
   Type: SmartViewer
   External Tables: despacho.Movil-motivo,despacho.Movil
   Allow: Basic,DB-Fields
   Frames: 1
   Add Fields to: EXTERNAL-TABLES
   Other Settings: PERSISTENT-ONLY COMPILE
 */

/* This procedure should always be RUN PERSISTENT.  Report the error,  */
/* then cleanup and return.                                            */
IF NOT THIS-PROCEDURE:PERSISTENT THEN DO:
  MESSAGE "{&FILE-NAME} should only be RUN PERSISTENT."
          VIEW-AS ALERT-BOX ERROR BUTTONS OK.
  RETURN.
END.

