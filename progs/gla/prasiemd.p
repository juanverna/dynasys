/*=================================================================================*/
/*                                    PARAMETROS                                   */
/*=================================================================================*/

DEFINE INPUT PARAMETER act_asiento  AS ROWID.

/*=================================================================================*/
/*                           VARIABLES, FRAMES, Y SUBMENUES                        */
/*=================================================================================*/

{VRSHARED.I }

/*=================================================================================*/
/*                                    IMPRESION                                    */
/*=================================================================================*/

FIND Parametro "NFASIMOD" NO-LOCK NO-ERROR.
IF AVAILABLE Parametro
   THEN RUN VALUE("PRAMD" + STRING(Parametro.valor_n, "999") + ".P") (INPUT act_asiento).
   ELSE RUN VALUE("PRAMD000.P") (INPUT act_asiento).


