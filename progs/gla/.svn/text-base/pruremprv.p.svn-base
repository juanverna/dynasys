COMPILE prrp.p SAVE.
FOR EACH Rem_header_prv 
     where tip_comprob = "RM"
       AND prf_comprob = 676
       and nro_comprob = 221
       and cdg_empresa = "M":
    


    run prrp.p ( input rowid(Rem_header_prv)).                                     
                                                                                    
END.                                                                                
                                                                                    
                                                                                    
                                                                                    
                                
