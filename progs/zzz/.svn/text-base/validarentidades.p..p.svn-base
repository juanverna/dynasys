     "42" CAN-FIND(FIRST Sub_detalle_bco WHERE Sub_detalle_bco.nro_entidad = Entidad.nro_entidad) 
     "43" CAN-FIND(FIRST Sub_detalle_inv WHERE Sub_detalle_inv.nro_entidad = Entidad.nro_entidad) 
     "44" CAN-FIND(FIRST Sub_detalle_prv WHERE Sub_detalle_prv.nro_entidad = Entidad.nro_entidad) 
     "45" CAN-FIND(FIRST Sub_detalle_syj WHERE Sub_detalle_syj.nro_entidad = Entidad.nro_entidad) 
     "46" CAN-FIND(FIRST Sub_detalle_vta WHERE Sub_detalle_vta.nro_entidad = Entidad.nro_entidad) 
     "47" CAN-FIND(FIRST Sub_header_bco WHERE Sub_header_bco.nro_entidad = Entidad.nro_entidad) 
     "48" CAN-FIND(FIRST Sub_header_inv WHERE Sub_header_inv.nro_entidad = Entidad.nro_entidad) 
     "49" CAN-FIND(FIRST Sub_header_prv WHERE Sub_header_prv.nro_entidad = Entidad.nro_entidad) SKIP
     "50" CAN-FIND(FIRST Sub_header_syj WHERE Sub_header_syj.nro_entidad = Entidad.nro_entidad) 
     "51" CAN-FIND(FIRST Sub_header_vta WHERE Sub_header_vta.nro_entidad = Entidad.nro_entidad) 
     "52" CAN-FIND(FIRST Transdep_dt WHERE Transdep_dt.nro_entidad = Entidad.nro_entidad) 
     "53" CAN-FIND(FIRST Transdep_hd WHERE Transdep_hd.nro_entidad = Entidad.nro_entidad) 
     "54" CAN-FIND(FIRST Valeinv_dt WHERE Valeinv_dt.nro_entidad = Entidad.nro_entidad) 
     "55" CAN-FIND(FIRST Valeinv_hd WHERE Valeinv_hd.nro_entidad = Entidad.nro_entidad)
     VIEW-AS ALERT-BOX MESSAGE TITLE Entidad.cdg_entidad + "-" + Entidad.dsc_entidad.
else delete entidad.

end.
