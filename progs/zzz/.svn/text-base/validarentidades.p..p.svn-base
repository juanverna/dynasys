     "33" CAN-FIND(FIRST Opg_header WHERE Opg_header.nro_entidad = Entidad.nro_entidad) 
     "34" CAN-FIND(FIRST Ped_header WHERE Ped_header.nro_entidad = Entidad.nro_entidad) 
     "35" CAN-FIND(FIRST Proveedor  WHERE Proveedor.nro_entidad = Entidad.nro_entidad) 
