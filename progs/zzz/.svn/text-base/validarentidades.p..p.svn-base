COMPILE VLB-ENTIDADES.P SAVE.
define variable EN_USO as logical.
FOR EACH Entidad:


  run vlb-entidades.p (INPUT ROWID(Entidad) , OUTPUT en_uso).
if en_uso then
MESSAGE 
     "00" CAN-FIND(FIRST Acumulado_ctapsp WHERE Acumulado_ctapsp.nro_entidad = Entidad.nro_entidad) 
     "01" CAN-FIND(FIRST Acumulado_cuenta WHERE Acumulado_cuenta.nro_entidad = Entidad.nro_entidad) 
     "02" CAN-FIND(FIRST Ajusteinv_dt WHERE Ajusteinv_dt.nro_entidad = Entidad.nro_entidad) 
     "03" CAN-FIND(FIRST Ajusteinv_hd WHERE Ajusteinv_hd.nro_entidad = Entidad.nro_entidad) 
     "04" CAN-FIND(FIRST Amd_detalle WHERE Amd_detalle.nro_entidad = Entidad.nro_entidad) 
     "00" CAN-FIND(FIRST Amp_detalle WHERE Amp_detalle.nro_entidad = Entidad.nro_entidad) 
     "06" CAN-FIND(FIRST Aps_detalle WHERE Aps_detalle.nro_entidad = Entidad.nro_entidad) 
     "07" CAN-FIND(FIRST Aps_header WHERE Aps_header.nro_entidad = Entidad.nro_entidad) 
     "08" CAN-FIND(FIRST Area WHERE Area.nro_entidad = Entidad.nro_entidad) 
     "09" CAN-FIND(FIRST Asn_detalle WHERE Asn_detalle.nro_entidad = Entidad.nro_entidad) SKIP
     "10" CAN-FIND(FIRST Asn_header WHERE Asn_header.nro_entidad = Entidad.nro_entidad) 
     "11" CAN-FIND(FIRST Caj_detalle WHERE Caj_detalle.nro_entidad = Entidad.nro_entidad) 
     "12" CAN-FIND(FIRST Caj_header WHERE Caj_header.nro_entidad = Entidad.nro_entidad) 
/*   "13" CAN-FIND(FIRST Cct_stock WHERE Cct_stock.nro_entidad = Entidad.nro_entidad) */
     "13" "**"
     "14" CAN-FIND(FIRST Cliente WHERE Cliente.nro_entidad = Entidad.nro_entidad) 
     "15" CAN-FIND(FIRST Concepto-cuenta WHERE Concepto-cuenta.nro_entidad = Entidad.nro_entidad) 
     "16" CAN-FIND(FIRST Deposito WHERE Deposito.nro_entidad = Entidad.nro_entidad) 
     "17" CAN-FIND(FIRST Destino WHERE Destino.nro_entidad = Entidad.nro_entidad) 
