     "20" CAN-FIND(FIRST Emb_header_prv WHERE Emb_header_prv.nro_entidad = Entidad.nro_entidad) 
     "21" CAN-FIND(FIRST Emb_prv-gasto WHERE Emb_prv-gasto.nro_entidad = Entidad.nro_entidad) 
     "22" CAN-FIND(FIRST Empleado WHERE Empleado.nro_entidad = Entidad.nro_entidad) 
     "23" CAN-FIND(FIRST Empleado-entidad WHERE Empleado-entidad.nro_entidad = Entidad.nro_entidad) 
     "24" CAN-FIND(FIRST Fac_cli-gasto WHERE Fac_cli-gasto.nro_entidad = Entidad.nro_entidad) 
     "25" CAN-FIND(FIRST Fac_detalle WHERE Fac_detalle.nro_entidad = Entidad.nro_entidad) 
     "26" CAN-FIND(FIRST Fac_detalle_prv WHERE Fac_detalle_prv.nro_entidad = Entidad.nro_entidad) 
     "27" CAN-FIND(FIRST Fac_header WHERE Fac_header.nro_entidad = Entidad.nro_entidad) 
     "28" CAN-FIND(FIRST Fac_header_prv WHERE Fac_header_prv.nro_entidad = Entidad.nro_entidad) 
