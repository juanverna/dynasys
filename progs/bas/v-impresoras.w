&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-assign-statement V-table-Win 
PROCEDURE local-assign-statement :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */
  
    
     IF INPUT FRAME {&FRAME-NAME} Impresora.cdg_impresora = 0 
     THEN DO:
        RUN PONMENSJ.P (INPUT "IMPR004").
        RETURN ERROR.
     END.                
    
     IF INPUT FRAME {&FRAME-NAME} impresora.nombre = "" 
     THEN DO:
        RUN PONMENSJ.P (INPUT "IMPR001").
        RETURN ERROR.
     END.            

     IF CAN-FIND(FIRST B-Impresora
                       WHERE B-Impresora.cdg_impresora = INPUT FRAME {&FRAME-NAME} Impresora.cdg_impresora
                         AND ROWID(B-Impresora) <> ROWID(Impresora) )
     THEN DO:
        RUN PONMENSJ.P (INPUT "IMPR002").
        RETURN ERROR.
     END.              

/*     IF CAN-FIND(FIRST B-Impresora
                       WHERE B-Impresora.nombre = INPUT FRAME {&FRAME-NAME} Impresora.nombre
                         AND ROWID(B-Impresora) <> ROWID(Impresora) )
     THEN DO:
        RUN PONMENSJ.P (INPUT "IMPR003").
        RETURN ERROR.
     END.              */

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'assign-statement':U ) .


  /* Code placed here will execute AFTER standard behavior.    */

  IF NEW Impresora AND x-cdg_impresora <> 0
  THEN DO:
      FOR EACH B-Ctrl_impresora WHERE B-Ctrl_impresora.cdg_impresora = x-cdg_impresora:
          CREATE Ctrl_impresora.
          BUFFER-COPY B-Ctrl_impresora TO Ctrl_impresora
              ASSIGN Ctrl_impresora.cdg_impresora = Impresora.cdg_impresora.
      END.
  END.


END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

