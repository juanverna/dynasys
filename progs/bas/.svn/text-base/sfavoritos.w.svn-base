/* ************************  Control Triggers  ************************ */

&Scoped-define SELF-NAME btn_borrar
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL btn_borrar sObject
ON CHOOSE OF btn_borrar IN FRAME F-Main /* B */
DO:
  DEFINE VARIABLE sino-msg AS LOGICAL.
  sino-msg = NO.
  RUN mensajepregunta.p ( INPUT "", INPUT "PREG051", INPUT-OUTPUT sino-msg).
  IF sino-msg
  THEN DO:
      DO TRANSACTION:
          FOR EACH Mfavorito 
              WHERE Mfavorito.nro_usuario = Usuario.nro_usuario 
                AND Mfavorito.cdg_empresa = Usuario.cdg_empresa:
              Mfavorito.opcion = "E".
          END.
          RUN borrar_favoritos.
          btn_borrar:SENSITIVE IN FRAME {&FRAME-NAME} = NO.
      END.
  END.
END.

