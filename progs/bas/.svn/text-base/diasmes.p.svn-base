/*=======================================================================================================*/
/*            DEVUELVE LA CANTIDAD DE DIAS DEL MES PARA UN MES DADO DE UN AÑO DADO                       */
/*=======================================================================================================*/

DEFINE INPUT PARAMETER  p-mes   AS INTEGER.
DEFINE INPUT PARAMETER  p-ano   AS INTEGER.
DEFINE OUTPUT PARAMETER p-dias  AS INTEGER.

/*=======================================================================================================*/
/*                                          VARIABLES                                                    */
/*=======================================================================================================*/

DEFINE VARIABLE dias_mes AS INTEGER FORMAT ">9" EXTENT 12 INITIAL [31,28,31,30,31,30,31,31,30,31,30,31].

/*=======================================================================================================*/
/*                                          PROCESO                                                      */
/*=======================================================================================================*/

IF p-ano MOD 4 = 0
   THEN IF p-ano MOD 100 <> 0
           THEN dias_mes [ 2 ] = 29. 

p-dias = dias_mes [ p-mes ]. 
