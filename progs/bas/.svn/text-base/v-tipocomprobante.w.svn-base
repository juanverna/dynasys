DEFINE BUTTON btn_prevcolorfondo 
     IMAGE-UP FILE "adeicon\prev-au":U
     LABEL "btn_prevcolorletra 2" 
     SIZE 4 BY 1.

DEFINE BUTTON btn_prevcolorletra 
