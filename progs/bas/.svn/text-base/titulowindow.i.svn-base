  CASE modo:
     WHEN MD_ALTA          
     THEN DO:
          {ponertitulo.i "{1}" "Ingreso de " + {2}}
     END.
     WHEN MD_MULTIPLE      
     THEN DO:
          {ponertitulo.i "{1}" "Consulta Múltiple de " + {2}}
     END.
     WHEN MD_DEFINIDA      
     THEN DO:
          {ponertitulo.i "{1}" "Consulta Individual de " + {2}}
     END.
     WHEN MD_RELACION      
     THEN DO:
          {ponertitulo.i "{1}" "Consulta Relacionada de " + {2}}
     END.
     WHEN MD_READONLY      
     THEN DO:
          {ponertitulo.i "{1}" "Consulta Sólo Lectura de " + {2}}
     END.
     WHEN MD_CAMBIO        
     THEN DO:
          {ponertitulo.i "{1}" "Modificación y Reemisión de " + {2}}
     END.
     WHEN MD_ANULACION        
     THEN DO:
          {ponertitulo.i "{1}" "Anulación de " + {2}}
     END.
     WHEN MD_EMISION        
     THEN DO:
          {ponertitulo.i "{1}" "Emisión de {2} Pendientes"}
     END.
  END CASE.     
