DEFINE VARIABLE mensaje    AS CHARACTER FORMAT "X(40)".

DEFINE BUTTON btn_proceso
     LABEL "&Procesar":L 
     SIZE 10 BY 1 FONT 4.
     
DEFINE BUTTON btn_salir
     LABEL "&Salir":L 
     SIZE 10 BY 1 FONT 4.
     
DEFINE BUTTON btn_imprimir
     LABEL "&Imprimir":L 
     SIZE 10 BY 1 FONT 4.

DEFINE BUTTON btn_verdatos
     LABEL "&Ver":L 
     SIZE 10 BY 1 FONT 4.

FORM 
     mensaje NO-LABEL
     WITH FRAME frm-espere OVERLAY
          TITLE "Aguarde un momento por favor" FONT 8
          CENTERED ROW 7 FGCOLOR 14 BGCOLOR 1.
