ASSIGN
         {1}:ROW     = ( SESSION:HEIGHT-PIXELS - {1}:HEIGHT-PIXELS ) / 
                                 SESSION:PIXELS-PER-ROW / 2  
         {1}:COLUMN  = ( SESSION:WIDTH-PIXELS  - {1}:WIDTH-PIXELS  ) / 
                                 SESSION:PIXELS-PER-COLUMN / 2.

IF {1}:COLUMN = 0  THEN {1}:COLUMN = 1.                                 