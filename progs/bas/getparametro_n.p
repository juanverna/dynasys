/*=================================================================================*/
/*                  DEVUELVE EL VALOR ENTERO DE UN PARAMETRO                       */
/*=================================================================================*/

/*=================================================================================*/
/*                              PARAMETROS                                         */
/*=================================================================================*/

DEFINE INPUT  PARAMETER p-cdg_parametro AS CHARACTER.
DEFINE OUTPUT PARAMETER p-valor_n       AS INTEGER.

/*=================================================================================*/
/*                          VARIABLES Y BUFFERS                                    */
/*=================================================================================*/

{parlocales.i}

/*=================================================================================*/
/*                            BLOQUE PRINCIPAL                                     */
/*=================================================================================*/
    
RUN getparametro.p (  INPUT  p-cdg_parametro,
                      OUTPUT v-valor_c,
                      OUTPUT v-valor_d,
                      OUTPUT v-valor_l,
                      OUTPUT v-valor_n,
                      OUTPUT v-observacion ).

p-valor_n = v-valor_n.

