&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-assign-statement V-table-Win 
PROCEDURE local-assign-statement :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  DEFINE BUFFER B-Tipo_puntovta FOR Tipo_puntovta.
  {findempresa.i}

  /* Code placed here will execute PRIOR to standard behavior. */

  IF lEsAlta = TRUE 
      THEN DO:
           FIND FIRST B-Tipo_puntovta 
                 WHERE B-Tipo_puntovta.cdg_comprobante = Tipocomprobante.cdg_comprobante AND
                   B-Tipo_puntovta.cdg_empresa     = Empresa.cdg_empresa             AND
                   B-Tipo_puntovta.cdg_puntovta    = INTEGER(Tipo_puntovta.cdg_puntovta:SCREEN-VALUE IN FRAME {&FRAME-NAME})
                 NO-LOCK NO-ERROR.
      IF AVAILABLE B-Tipo_puntovta THEN DO:
          RUN ponmensj.p (INPUT "PVTA005").
          RETURN ERROR.
      END.
  END.

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'assign-statement':U ) .

  /* Code placed here will execute AFTER standard behavior.    */

 

  IF NEW Tipo_puntovta
  THEN DO:
      ASSIGN 
         Tipo_puntovta.cdg_comprobante = Tipocomprobante.cdg_comprobante
         Tipo_puntovta.cdg_empresa     = Empresa.cdg_empresa.
  END.

  IF Tipo_puntovta.preferido
  THEN DO:
      FOR EACH B-Tipo_puntovta OF Tipocomprobante 
          WHERE B-Tipo_puntovta.cdg_empresa = Tipo_puntovta.cdg_empresa
            AND ROWID(B-Tipo_puntovta) <> ROWID(Tipo_puntovta):
          B-Tipo_puntovta.preferido = NO.
      END.
  END.

END PROCEDURE.

