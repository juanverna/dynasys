/* ***********************  Control Definitions  ********************** */


/* Definitions of the field level widgets                               */
DEFINE VARIABLE v-cantidad_pen AS DECIMAL FORMAT "->>>,>>9.99":U INITIAL 0 
     VIEW-AS FILL-IN NATIVE 
     SIZE 16 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-cdg_articulo AS CHARACTER FORMAT "X(16)":U 
     LABEL "Artículo" 
     VIEW-AS FILL-IN NATIVE 
     SIZE 16 BY 1
     BGCOLOR 15 FGCOLOR 9 FONT 4 NO-UNDO.

DEFINE VARIABLE v-cdg_partida AS CHARACTER FORMAT "X(256)":U 
     LABEL "Partida" 
     VIEW-AS FILL-IN NATIVE 
     SIZE 16 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE VARIABLE v-descripcion-estado AS CHARACTER FORMAT "X(256)":U 
     VIEW-AS FILL-IN 
     SIZE 44 BY 1
     BGCOLOR 7 FGCOLOR 14  NO-UNDO.

DEFINE VARIABLE v-dsc_articulo AS CHARACTER FORMAT "X(256)":U 
     VIEW-AS FILL-IN 
     SIZE 66 BY 1
     BGCOLOR 7 FGCOLOR 15 FONT 4 NO-UNDO.

DEFINE VARIABLE v-dsc_partida AS CHARACTER FORMAT "X(256)":U 
     VIEW-AS FILL-IN 
     SIZE 66 BY 1
     BGCOLOR 7 FGCOLOR 15  NO-UNDO.

DEFINE VARIABLE v-granel_pen AS DECIMAL FORMAT "->>>,>>9.99":U INITIAL 0 
     VIEW-AS FILL-IN NATIVE 
     SIZE 16 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE RECTANGLE RECT-2
     EDGE-PIXELS 6 GRAPHIC-EDGE  NO-FILL 
     SIZE 101 BY 12.62.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME F-Main
     v-cdg_articulo AT ROW 1.48 COL 13 COLON-ALIGNED AUTO-RETURN 
     v-dsc_articulo AT ROW 1.48 COL 30 COLON-ALIGNED NO-LABEL
     v-cdg_partida AT ROW 2.67 COL 13 COLON-ALIGNED
     v-dsc_partida AT ROW 2.67 COL 30 COLON-ALIGNED NO-LABEL
     Rqs_detalle.cdg_estado AT ROW 3.86 COL 13 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 16 BY 1
          BGCOLOR 15 FGCOLOR 9 
     v-descripcion-estado AT ROW 3.86 COL 30 COLON-ALIGNED NO-LABEL
     Rqs_detalle.costo AT ROW 3.86 COL 83 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 13 BY 1
          BGCOLOR 15 FGCOLOR 9 
     Rqs_detalle.cantidad AT ROW 6.19 COL 13 COLON-ALIGNED
          LABEL "Cantidad"
          VIEW-AS FILL-IN NATIVE 
          SIZE 16 BY 1
          BGCOLOR 15 FGCOLOR 9 
     Rqs_detalle.cantidad_cum AT ROW 6.24 COL 30 COLON-ALIGNED NO-LABEL
          VIEW-AS FILL-IN NATIVE 
          SIZE 16 BY 1
          BGCOLOR 15 FGCOLOR 9 
     v-cantidad_pen AT ROW 6.24 COL 47 COLON-ALIGNED NO-LABEL
     Rqs_detalle.fecha_temprana AT ROW 6.24 COL 80 COLON-ALIGNED
          LABEL "Desde el"
          VIEW-AS FILL-IN NATIVE 
          SIZE 16 BY 1
          BGCOLOR 15 FGCOLOR 9 
     Rqs_detalle.granel AT ROW 7.38 COL 13 COLON-ALIGNED
          LABEL "Granel"
          VIEW-AS FILL-IN NATIVE 
          SIZE 16 BY 1
          BGCOLOR 15 FGCOLOR 9 
     Rqs_detalle.granel_cum AT ROW 7.43 COL 30 COLON-ALIGNED NO-LABEL
          VIEW-AS FILL-IN NATIVE 
          SIZE 16 BY 1
          BGCOLOR 15 FGCOLOR 9 
     v-granel_pen AT ROW 7.43 COL 47 COLON-ALIGNED NO-LABEL
     Rqs_detalle.fecha_tardia AT ROW 7.43 COL 80 COLON-ALIGNED
          LABEL "Hasta el"
          VIEW-AS FILL-IN NATIVE 
          SIZE 16 BY 1
          BGCOLOR 15 FGCOLOR 9 
     Rqs_detalle.observacion AT ROW 9.71 COL 3 NO-LABEL
          VIEW-AS EDITOR SCROLLBAR-VERTICAL
          SIZE 95 BY 3.24
          BGCOLOR 15 FGCOLOR 7 
     RECT-2 AT ROW 1 COL 1
     "   Observaciones del item de pedido" VIEW-AS TEXT
          SIZE 95 BY 1 AT ROW 8.62 COL 3
          BGCOLOR 7 FGCOLOR 15 
     " Fechas de Entrega" VIEW-AS TEXT
          SIZE 20 BY 1 AT ROW 5.05 COL 78
          BGCOLOR 7 FGCOLOR 15 
     "   Solicitado" VIEW-AS TEXT
          SIZE 16 BY 1 AT ROW 5 COL 15
          BGCOLOR 7 FGCOLOR 15 
     "   Pendiente" VIEW-AS TEXT
          SIZE 16 BY 1 AT ROW 5.05 COL 49
          BGCOLOR 7 FGCOLOR 15 
     "   Cumplido" VIEW-AS TEXT
          SIZE 16 BY 1 AT ROW 5.05 COL 32
          BGCOLOR 7 FGCOLOR 15 
    WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY 
         SIDE-LABELS NO-UNDERLINE THREE-D 
         AT COL 1 ROW 1 SCROLLABLE 
         FONT 4.


