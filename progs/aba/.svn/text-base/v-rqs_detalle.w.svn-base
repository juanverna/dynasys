     _Options          = "NO-LOCK"
     _Query            is NOT OPENED
*/  /* FRAME F-Main */
&ANALYZE-RESUME

 



/* ************************  Control Triggers  ************************ */

&Scoped-define SELF-NAME Rqs_detalle.cdg_estado
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL Rqs_detalle.cdg_estado V-table-Win
ON LEAVE OF Rqs_detalle.cdg_estado IN FRAME F-Main /* Estado */
DO:
  DEFINE VARIABLE Cdg-estado LIKE Estado_pedido.cdg_estado.
  
  ASSIGN Cdg-estado = Rqs_detalle.cdg_estado.
  FIND CURRENT Rqs_detalle EXCLUSIVE-LOCK.
       ASSIGN Rqs_detalle.cdg_estado.
  FIND CURRENT Rqs_detalle NO-LOCK.         

  FIND Estado_pedido WHERE Estado_pedido.cdg_estado = Rqs_detalle.cdg_estado NO-LOCK NO-ERROR.
  IF AVAILABLE Estado_pedido THEN DO:
     ASSIGN v-descripcion-estado = Estado_pedido.descripcion.
     RUN dispatch IN THIS-PROCEDURE ('local-display-fields').
  END.   
  ELSE DO:
       MESSAGE "Area inexistente" VIEW-AS ALERT-BOX.
       FIND CURRENT Rqs_detalle EXCLUSIVE-LOCK.
            ASSIGN Rqs_detalle.cdg_estado = Cdg-Estado.
       FIND CURRENT Rqs_detalle NO-LOCK.         
  
  END.     
  

END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME Rqs_detalle.fecha_temprana
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL Rqs_detalle.fecha_temprana V-table-Win
ON LEAVE OF Rqs_detalle.fecha_temprana IN FRAME F-Main /* Desde el */
DO:
  IF Rqs_detalle.fecha_temprana:INPUT-VALUE <> ? AND Rqs_detalle.fecha_tardia:INPUT-VALUE = ?
  THEN DO:
      DISPLAY Rqs_detalle.fecha_temprana:INPUT-VALUE @ Rqs_detalle.fecha_tardia
          WITH FRAME {&FRAME-NAME}.
  END.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME v-cdg_articulo
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-cdg_articulo V-table-Win
ON MOUSE-MENU-DOWN OF v-cdg_articulo IN FRAME F-Main /* Artículo */
OR "+" OF v-cdg_articulo IN FRAME {&FRAME-NAME}
DO:
   
  &SCOPED-DEFINE ROWID_TABLA        rid_articulo
  &SCOPED-DEFINE SELECCION          SELARTIC.P
  &SCOPED-DEFINE TABLA              Articulo
  &SCOPED-DEFINE CDG_TABLA          cdg_articulo
  &SCOPED-DEFINE DSC_TABLA          descripcion    
  &SCOPED-DEFINE V-CDG_TABLA        v-cdg_articulo

  &SCOPED-DEFINE MOSTRAR_DSC        YES
  &SCOPED-DEFINE V-DSC_TABLA        v-dsc_articulo    

  {hlptabla-var.i}


END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-cdg_articulo V-table-Win
ON RETURN OF v-cdg_articulo IN FRAME F-Main /* Artículo */
DO:

  &SCOPED-DEFINE ROWID_TABLA        rid_articulo
  &SCOPED-DEFINE TABLA              Articulo
  &SCOPED-DEFINE CDG_TABLA          cdg_articulo
  &SCOPED-DEFINE DSC_TABLA          descripcion
  &SCOPED-DEFINE V-DSC_TABLA        v-dsc_articulo    
  &SCOPED-DEFINE CAMPO-FRAME        v-cdg_articulo   
  &SCOPED-DEFINE MOSTRAR_DSC        YES

  {trdtabla.i}  

          
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME v-cdg_partida
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-cdg_partida V-table-Win
ON MOUSE-SELECT-DBLCLICK OF v-cdg_partida IN FRAME F-Main /* Partida */
OR "." OF v-cdg_partida IN FRAME {&FRAME-NAME}
OR MOUSE-MENU-DOWN OF v-cdg_partida IN FRAME {&FRAME-NAME}
DO:
  DEFINE VARIABLE x-cdg_partida LIKE Partida.cdg_partida.
  RUN d-seleccionar_partida-deposito.w ( INPUT  Articulo.nro_articulo,
                                         INPUT  Rqs_header.cdg_deposito,
                                         OUTPUT x-cdg_partida ).
  IF x-cdg_partida <> ?
  THEN DO:
     DISPLAY x-cdg_partida @ v-cdg_partida 
             WITH FRAME {&FRAME-NAME}.
     APPLY "RETURN" TO v-cdg_partida IN FRAME {&FRAME-NAME}.        
     RETURN NO-APPLY.
  END.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-cdg_partida V-table-Win
ON RETURN OF v-cdg_partida IN FRAME F-Main /* Partida */
OR TAB OF v-cdg_partida  IN FRAME {&FRAME-NAME}
DO:

   FIND FIRST Partida NO-LOCK 
        WHERE Partida.cdg_empresa  = Rqs_header.cdg_empresa
          AND Partida.nro_articulo = Articulo.nro_articulo
          AND Partida.cdg_partida  = INPUT FRAME {&FRAME-NAME} v-cdg_partida NO-ERROR.

   IF NOT AVAILABLE Partida
   THEN DO:
        RUN ponmensj.p ( INPUT "ARTI008" ).
        RETURN NO-APPLY.
   END.
   ELSE DO:
         v-dsc_partida = Partida.descripcion.
         DISPLAY v-dsc_partida
                 WITH FRAME {&FRAME-NAME}.
    END.

END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&UNDEFINE SELF-NAME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CUSTOM _MAIN-BLOCK V-table-Win 


/* ***************************  Main Block  *************************** */

  &IF DEFINED(UIB_IS_RUNNING) <> 0 &THEN          
    RUN dispatch IN THIS-PROCEDURE ('initialize':U).        
  &ENDIF         
  
  /************************ INTERNAL PROCEDURES ********************/

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


/* **********************  Internal Procedures  *********************** */

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE adm-row-available V-table-Win  _ADM-ROW-AVAILABLE
PROCEDURE adm-row-available :
/*------------------------------------------------------------------------------
  Purpose:     Dispatched to this procedure when the Record-
               Source has a new row available.  This procedure
               tries to get the new row (or foriegn keys) from
               the Record-Source and process it.
  Parameters:  <none>
------------------------------------------------------------------------------*/

  /* Define variables needed by this internal procedure.             */
  {src/adm/template/row-head.i}

  /* Create a list of all the tables that we need to get.            */
  {src/adm/template/row-list.i "Rqs_header"}
  {src/adm/template/row-list.i "Rqs_detalle"}

  /* Get the record ROWID's from the RECORD-SOURCE.                  */
  {src/adm/template/row-get.i}

  /* FIND each record specified by the RECORD-SOURCE.                */
  {src/adm/template/row-find.i "Rqs_header"}
  {src/adm/template/row-find.i "Rqs_detalle"}

  /* Process the newly available records (i.e. display fields,
     open queries, and/or pass records on to any RECORD-TARGETS).    */
  {src/adm/template/row-end.i}

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE disable_UI V-table-Win  _DEFAULT-DISABLE
PROCEDURE disable_UI :
/*------------------------------------------------------------------------------
  Purpose:     DISABLE the User Interface
  Parameters:  <none>
  Notes:       Here we clean-up the user-interface by deleting
               dynamic widgets we have created and/or hide 
               frames.  This procedure is usually called when
               we are ready to "clean-up" after running.
------------------------------------------------------------------------------*/
  /* Hide all frames. */
  HIDE FRAME F-Main.
  IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-add-record V-table-Win 
PROCEDURE local-add-record :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'add-record':U ) .

  /* Code placed here will execute AFTER standard behavior.    */

 ASSIGN
       v-descripcion-estado = ""
       v-cdg_articulo = ""
       v-dsc_articulo  = ""
       v-cdg_partida  = ""
       v-dsc_partida  = ""
       v-dsc_articulo:FGCOLOR IN FRAME {&FRAME-NAME} = 15
       v-cantidad_pen = 0
       v-granel_pen = 0.


  DISPLAY v-descripcion-estado
          v-cdg_articulo
          v-dsc_articulo
          v-cdg_partida
          v-dsc_partida
          v-cantidad_pen
          v-granel_pen
          WITH FRAME {&FRAME-NAME}.

  DISPLAY Rqs_header.fecha @ Rqs_detalle.fecha_temprana
      WITH FRAME {&FRAME-NAME}.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-assign-statement V-table-Win 
PROCEDURE local-assign-statement :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

   IF DATE(Rqs_detalle.fecha_temprana:SCREEN-VALUE IN FRAME {&FRAME-NAME}) = DATE("") OR
      DATE(Rqs_detalle.fecha_tardia:SCREEN-VALUE IN FRAME {&FRAME-NAME}) = DATE("")
   THEN DO:
        RUN PONMENSJ.P ( INPUT "REQU050").
        RETURN ERROR. 
   END.
   
   IF DATE(Rqs_detalle.fecha_temprana:SCREEN-VALUE IN FRAME {&FRAME-NAME}) >
      DATE(Rqs_detalle.fecha_tardia:SCREEN-VALUE IN FRAME {&FRAME-NAME})
   THEN DO:
        RUN PONMENSJ.P ( INPUT "REQU051").
        RETURN ERROR. 
   END.

   &SCOPED-DEFINE TABLA-MAESTRA  Rqs_detalle

   {validartabla.i "Articulo" "cdg_articulo" "descripcion" "REQU052"} 


   &UNDEFINE TABLA-MAESTRA
   
   FIND Partida WHERE Partida.nro_articulo = Articulo.nro_articulo
                  AND Partida.cdg_partida  = v-cdg_partida:SCREEN-VALUE IN FRAME {&FRAME-NAME}
                  AND Partida.cdg_empresa  = Rqs_header.cdg_empresa
                      NO-LOCK NO-ERROR.
   IF NOT AVAILABLE Partida
   THEN DO:
        RUN PONMENSJ.P ( INPUT "FAPR033" ).
        RETURN.
   END.                             

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'assign-statement':U ) .

  /* Code placed here will execute AFTER standard behavior.    */

   &SCOPED-DEFINE TABLA-MAESTRA  Rqs_detalle

   {asignartabla.i "Articulo" "nro_articulo" "nro_articulo"} 

   Rqs_detalle.nro_partida = Partida.nro_partida.

    IF NEW Rqs_detalle
    THEN DO:
        Rqs_detalle.nro_requisicion = Rqs_header.nro_requisicion.
        FIND CURRENT Rqs_header EXCLUSIVE-LOCK.
        Rqs_header.ultima_linea = Rqs_header.ultima_linea + 1.
        Rqs_detalle.nro_linea = Rqs_header.ultima_linea.
        Rqs_detalle.cdg_estado = "IN".
        FIND CURRENT Rqs_header NO-LOCK.
        CREATE Rqs_detalle_ent.
        BUFFER-COPY Rqs_detalle TO Rqs_detalle_entr
            ASSIGN Rqs_detalle_entr.nro_entrega = 1
                   Rqs_detalle.ultima_entrega = 1.
    END.
    
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-disable-fields V-table-Win 
PROCEDURE local-disable-fields :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

  RUN dispatch IN THIS-PROCEDURE ( INPUT 'disable-fields':U ) .

  /* Code placed here will execute AFTER standard behavior.    */

  v-cdg_articulo:FGCOLOR IN FRAME {&FRAME-NAME} = 7.
  v-cdg_articulo:SENSITIVE IN FRAME {&FRAME-NAME} = NO.
  v-cdg_partida:SENSITIVE IN FRAME {&FRAME-NAME} = NO.
  Rqs_detalle.observacion:FGCOLOR IN FRAME {&FRAME-NAME} = 7.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-display-fields V-table-Win 
PROCEDURE local-display-fields :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'display-fields':U ) .

  /* Code placed here will execute AFTER standard behavior.    */

  IF AVAILABLE Rqs_detalle
  THEN DO:

        FIND Estado_pedido OF Rqs_detalle NO-LOCK.
        ASSIGN
             v-descripcion-estado = Estado_pedido.descripcion.

        &SCOPED-DEFINE TABLA-MAESTRA  Rqs_detalle
     
        {displaytabla.i "articulo" "cdg_articulo" "descripcion" "nro_articulo" "nro_articulo"} 
      
        &UNDEFINE TABLA-MAESTRA
        
        FIND Partida OF Rqs_detalle NO-LOCK.
        ASSIGN v-cdg_partida = Partida.cdg_partida
               v-dsc_partida = Partida.descripcion.

        ASSIGN
             v-granel_pen = Rqs_detalle.granel - Rqs_detalle.granel_cum
             v-cantidad_pen = Rqs_detalle.cantidad - Rqs_detalle.cantidad_cum.
      
      
        DISPLAY v-descripcion-estado
                v-cdg_articulo
                v-dsc_articulo
                v-granel_pen
                v-cantidad_pen
                v-cdg_partida
                v-dsc_partida
                WITH FRAME {&FRAME-NAME}.
  END.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-enable-fields V-table-Win 
PROCEDURE local-enable-fields :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

  RUN dispatch IN THIS-PROCEDURE ( INPUT 'enable-fields':U ) .
  
  /* Code placed here will execute AFTER standard behavior.    */

   v-cdg_articulo:FGCOLOR IN FRAME {&FRAME-NAME} = 9.
   v-cdg_articulo:SENSITIVE IN FRAME {&FRAME-NAME} = YES.
   v-cdg_partida:SENSITIVE IN FRAME {&FRAME-NAME} = YES.
   Rqs_detalle.observacion:FGCOLOR IN FRAME {&FRAME-NAME} = 9.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE send-records V-table-Win  _ADM-SEND-RECORDS
PROCEDURE send-records :
/*------------------------------------------------------------------------------
  Purpose:     Send record ROWID's for all tables used by
               this file.
  Parameters:  see template/snd-head.i
------------------------------------------------------------------------------*/

  /* Define variables needed by this internal procedure.               */
  {src/adm/template/snd-head.i}

  /* For each requested table, put it's ROWID in the output list.      */
  {src/adm/template/snd-list.i "Rqs_header"}
  {src/adm/template/snd-list.i "Rqs_detalle"}

  /* Deal with any unexpected table requests before closing.           */
  {src/adm/template/snd-end.i}

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE state-changed V-table-Win 
PROCEDURE state-changed :
/* -----------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
-------------------------------------------------------------*/
  DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE    NO-UNDO.
  DEFINE INPUT PARAMETER p-state      AS CHARACTER NO-UNDO.

  CASE p-state:
      /* Object instance CASEs can go here to replace standard behavior
         or add new cases. */
      {src/adm/template/vstates.i}
  END CASE.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

