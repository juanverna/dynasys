/* Definitions of the field level widgets                               */
DEFINE VARIABLE que_cupon AS CHARACTER FORMAT "X(14)":U 
     LABEL "Recibo Número" 
     VIEW-AS FILL-IN NATIVE 
     SIZE 29 BY 1
     BGCOLOR 14 FGCOLOR 12  NO-UNDO.

DEFINE VARIABLE v-nom_cobrador AS CHARACTER FORMAT "X(256)":U 
     VIEW-AS FILL-IN 
     SIZE 54 BY 1 NO-UNDO.

DEFINE VARIABLE v-nom_tiporend AS CHARACTER FORMAT "X(256)":U 
     VIEW-AS FILL-IN 
     SIZE 54 BY 1 NO-UNDO.

DEFINE RECTANGLE RECT-4
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 86 BY 2.67.

DEFINE RECTANGLE RECT-5
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 52 BY 1.1.

DEFINE RECTANGLE RECT-6
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 86 BY 1.86.

DEFINE RECTANGLE RECT-7
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 52 BY 3.52.

/* Query definitions                                                    */
&ANALYZE-SUSPEND
DEFINE QUERY BROWSE-1 FOR 
      T-comprobante_rendicion, 
      Cupon, 
      Cliente SCROLLING.

DEFINE QUERY Dialog-Frame FOR 
      T-Rendicion_hd SCROLLING.
&ANALYZE-RESUME

/* Browse definitions                                                   */
DEFINE BROWSE BROWSE-1
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _DISPLAY-FIELDS BROWSE-1 Dialog-Frame _STRUCTURED
  QUERY BROWSE-1 NO-LOCK DISPLAY
      Cupon.tip_cupon COLUMN-LABEL "Tipo!Cte." FORMAT "X(2)":U
      Cupon.prf_cupon COLUMN-LABEL "Pto!Vta" FORMAT "9999":U
      Cupon.nro_cupon FORMAT "99999999":U
      Cupon.cdg_zonag FORMAT "X(8)":U
      Cupon.importe_cuota FORMAT "->>>,>>9.99":U
      Cupon.cdg_motbaja FORMAT "X(1)":U
      Cliente.cdg_cliente FORMAT "X(8)":U WIDTH 18.6
      Cliente.nom_cliente FORMAT "X(40)":U WIDTH 54.2
/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME
    WITH NO-ROW-MARKERS SEPARATORS SIZE 138 BY 18.95
         BGCOLOR 11 FGCOLOR 9 FONT 6.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME Dialog-Frame
     T-Rendicion_hd.cant_recibos AT ROW 1.24 COL 14 COLON-ALIGNED
          LABEL "Recibos"
          VIEW-AS FILL-IN 
          SIZE 14 BY 1
          FONT 6
     v-nom_tiporend AT ROW 1.24 COL 29 COLON-ALIGNED NO-LABEL
     T-Rendicion_hd.imp_imputado AT ROW 2.43 COL 14 COLON-ALIGNED
          LABEL "Importe"
          VIEW-AS FILL-IN 
          SIZE 14 BY 1
          FONT 6
     v-nom_cobrador AT ROW 2.43 COL 29 COLON-ALIGNED NO-LABEL
     que_cupon AT ROW 4.1 COL 29 COLON-ALIGNED
     BROWSE-1 AT ROW 5.86 COL 1
     RECT-4 AT ROW 1 COL 1
     RECT-5 AT ROW 1 COL 87
     RECT-6 AT ROW 3.67 COL 1
     RECT-7 AT ROW 2.1 COL 87
     "F4 - Eliminar un Recibo de esta Rendición" VIEW-AS TEXT
          SIZE 48 BY .62 AT ROW 4.76 COL 90
     "F2 - Listar los Recibos de la Rendición" VIEW-AS TEXT
          SIZE 48 BY .62 AT ROW 3.14 COL 90
     "F3 - Cancelar  la Rendición Actual" VIEW-AS TEXT
          SIZE 48 BY .62 AT ROW 3.95 COL 90
     "F1 - Finalizar el Ingreso de Recibos" VIEW-AS TEXT
          SIZE 48 BY .62 AT ROW 2.33 COL 90
     "Oprima estas teclas para estas funciones" VIEW-AS TEXT
          SIZE 49 BY .62 AT ROW 1.29 COL 89
     SPACE(2.99) SKIP(22.99)
    WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER 
         SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE 
         FONT 6
         TITLE "Boca".


