&ANALYZE-RESUME


/* Setting information for Queries and Browse Widgets fields            */

&ANALYZE-SUSPEND _QUERY-BLOCK BROWSE BROWSE-1
/* Query rebuild information for BROWSE BROWSE-1
     _TblList          = "Temp-Tables.T-comprobante_rendicion,sic.Cupon OF Temp-Tables.T-comprobante_rendicion,sic.Cliente OF sic.Cupon"
     _Options          = "NO-LOCK INDEXED-REPOSITION"
     _FldNameList[1]   > sic.Cupon.tip_cupon
"Cupon.tip_cupon" "Tipo!Cte." ? "character" ? ? ? ? ? ? no ? no no ? yes no no "U" "" ""
     _FldNameList[2]   > sic.Cupon.prf_cupon
"Cupon.prf_cupon" "Pto!Vta" ? "integer" ? ? ? ? ? ? no ? no no ? yes no no "U" "" ""
     _FldNameList[3]   = sic.Cupon.nro_cupon
     _FldNameList[4]   = sic.Cupon.cdg_zonag
     _FldNameList[5]   = sic.Cupon.importe_cuota
     _FldNameList[6]   = sic.Cupon.cdg_motbaja
     _FldNameList[7]   > sic.Cliente.cdg_cliente
"Cliente.cdg_cliente" ? ? "character" ? ? ? ? ? ? no ? no no "18.6" yes no no "U" "" ""
     _FldNameList[8]   > sic.Cliente.nom_cliente
"Cliente.nom_cliente" ? ? "character" ? ? ? ? ? ? no ? no no "54.2" yes no no "U" "" ""
     _Query            is OPENED
*/  /* BROWSE BROWSE-1 */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _QUERY-BLOCK DIALOG-BOX Dialog-Frame
/* Query rebuild information for DIALOG-BOX Dialog-Frame
     _TblList          = "Temp-Tables.T-Rendicion_hd"
     _Options          = "SHARE-LOCK"
     _Query            is NOT OPENED
*/  /* DIALOG-BOX Dialog-Frame */
&ANALYZE-RESUME

 



/* ************************  Control Triggers  ************************ */

&Scoped-define SELF-NAME Dialog-Frame
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL Dialog-Frame Dialog-Frame
ON WINDOW-CLOSE OF FRAME Dialog-Frame /* Boca */
DO:
  APPLY "END-ERROR":U TO SELF.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define BROWSE-NAME BROWSE-1
&Scoped-define SELF-NAME BROWSE-1
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL BROWSE-1 Dialog-Frame
ON F1 OF BROWSE-1 IN FRAME Dialog-Frame
DO:
  APPLY "F1" TO que_cupon IN FRAME {&FRAME-NAME}.
  RETURN NO-APPLY.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL BROWSE-1 Dialog-Frame
ON F2 OF BROWSE-1 IN FRAME Dialog-Frame
DO:
  APPLY "F2" TO que_cupon IN FRAME {&FRAME-NAME}.
  RETURN NO-APPLY.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL BROWSE-1 Dialog-Frame
ON F3 OF BROWSE-1 IN FRAME Dialog-Frame
DO:
  APPLY "F3" TO que_cupon IN FRAME {&FRAME-NAME}.
  RETURN NO-APPLY.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL BROWSE-1 Dialog-Frame
ON F4 OF BROWSE-1 IN FRAME Dialog-Frame
DO:
  APPLY "F4" TO que_cupon IN FRAME {&FRAME-NAME}.
  RETURN NO-APPLY.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME que_cupon
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL que_cupon Dialog-Frame
ON ENTRY OF que_cupon IN FRAME Dialog-Frame /* Recibo Número */
DO:
  que_cupon:BGCOLOR IN FRAME {&FRAME-NAME} = 14.
  que_cupon:FGCOLOR IN FRAME {&FRAME-NAME} = 12.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL que_cupon Dialog-Frame
ON F1 OF que_cupon IN FRAME Dialog-Frame /* Recibo Número */
DO:
    
  DEFINE VARIABLE sino AS LOGICAL.
  sino = NO.
  MESSAGE "Se dispone a cerrar la Rendición. Luego no podrán ingresarse mas recibos en la misma."
          "Confirma que desa cerrar esta rendición? " VIEW-AS ALERT-BOX 
          BUTTONS YES-NO SET sino.
  IF sino
  THEN DO:
       DO TRANSACTION:
          RUN cierrarendicion.p ( INPUT rid_rendicion ).

       END.   
      APPLY "GO":U TO SELF.
  END.
  RETURN NO-APPLY.
  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL que_cupon Dialog-Frame
ON F2 OF que_cupon IN FRAME Dialog-Frame /* Recibo Número */
DO:
  sino = NO.
  MESSAGE "Desea imprimir la rendicion?" VIEW-AS ALERT-BOX 
          BUTTONS YES-NO SET sino.
  IF sino
  THEN DO:
       RUN prinrendicion.p ( INPUT ROWID(Rendicion_hd) ).
  END.        
  RETURN NO-APPLY.
  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL que_cupon Dialog-Frame
ON F3 OF que_cupon IN FRAME Dialog-Frame /* Recibo Número */
DO:
  sino = NO.
  MESSAGE "Desea CANCELAR la rendicion?" VIEW-AS ALERT-BOX 
          BUTTONS YES-NO SET sino.
  IF sino
  THEN DO:
       IF CAN-FIND(FIRST Cupon WHERE Cupon.nro_rendicion = Rendicion_hd.nro_rendicion)
       THEN DO:
            RUN PONMENSJ.P ( INPUT "CUPO026" ).
            RETURN NO-APPLY.
       END.
       ELSE DO:
            DO TRANSACTION:
               FIND CURRENT Rendicion_hd EXCLUSIVE-LOCK.
               DELETE Rendicion_hd.
            END.
            APPLY "END-ERROR":U TO SELF.
       END. 

  END.          
  RETURN NO-APPLY.

END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL que_cupon Dialog-Frame
ON F4 OF que_cupon IN FRAME Dialog-Frame /* Recibo Número */
DO:

  IF AVAILABLE T-comprobante_rendicion
  THEN DO:
      DO TRANSACTION:
          DELETE T-comprobante_rendicion.
          RUN poner_totales.
          RUN open-query.
      END.
  END.
  ELSE DO:
       MESSAGE "No hay cupones ingresados"
               VIEW-AS ALERT-BOX ERROR.
  END.
  RETURN NO-APPLY.
  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL que_cupon Dialog-Frame
ON LEAVE OF que_cupon IN FRAME Dialog-Frame /* Recibo Número */
DO:
  que_cupon:BGCOLOR IN FRAME {&FRAME-NAME} = 12.
  que_cupon:FGCOLOR IN FRAME {&FRAME-NAME} = 14.

END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL que_cupon Dialog-Frame
ON RETURN OF que_cupon IN FRAME Dialog-Frame /* Recibo Número */
DO:

    ASSIGN FRAME {&FRAME-NAME} que_cupon.
    FIND Cupon 
         WHERE Cupon.cdg_empresa = Rendicion_hd.cdg_empresa
           AND Cupon.tip_cupon = SUBSTRING(que_cupon,1,2)
           AND Cupon.prf_cupon = INTEGER(SUBSTRING(que_cupon,3,4))
           AND Cupon.nro_cupon = INTEGER(SUBSTRING(que_cupon,7,8)) 
               NO-LOCK NO-ERROR.
           
    IF NOT AVAILABLE Cupon
    THEN DO:
         RUN PONMENSJ.P ( INPUT "CUPO001" ).
    END.
    ELSE DO:

         IF Rendicion_hd.nro_cobrador = 0
         THEN DO:
              DO TRANSACTION:
                    FIND CURRENT Rendicion_hd EXCLUSIVE-LOCK.
                    FIND Cobrador OF Cupon NO-LOCK.
                    Rendicion_hd.nro_cobrador = Cobrador.nro_cobrador.
                    FIND CURRENT Rendicion_hd NO-LOCK.
              END.
         END.
         
         IF Cupon.nro_cobrador <> Cobrador.nro_cobrador
         THEN DO:
              RUN PONMENSJ.P ( INPUT "CUPO002" ).
         END.
         ELSE DO:
              IF (Cupon.estado = "1" OR Cupon.estado = "3" ) OR
                 (Cupon.estado = "2" AND Cupon.nro_rendicion = Rendicion_hd.nro_rendicion ) OR
                 (Cupon.estado = "4" AND Cupon.nro_rendicion = Rendicion_hd.nro_rendicion )
              THEN DO:
                   RUN PONMENSJ.P ( INPUT "CUPO003" ).
              END.
              ELSE DO:
                   IF Cupon.estado = "0" AND Cupon.nro_rendicion <> 0 
                   THEN DO:
                        RUN PONMENSJ.P ( INPUT "CUPO004" ).
                   END.
                   ELSE DO:
                        DO TRANSACTION:
    
                            FIND CURRENT Cupon EXCLUSIVE-LOCK.

                            Cupon.nro_rendicion = Rendicion_hd.nro_rendicion.
                            IF Rendicion_hd.tipo = "3"
                            THEN DO:
                                 UPDATE Cupon.cdg_motbaja LABEL "Código Baja"
                                        WITH SIDE-LABELS FONT 4 THREE-D TITLE "Ingrese Motivo de Baja"
                                        VIEW-AS DIALOG-BOX.
                                        
                            END.
                            
                            FIND CURRENT Cupon NO-LOCK.
    
                            FIND CURRENT Rendicion_hd EXCLUSIVE-LOCK.
                            Rendicion_hd.imp_imputado = Rendicion_hd.imp_imputado + 
                                                        Cupon.importe_cuota.
                            Rendicion_hd.cant_recibos = Rendicion_hd.cant_recibos + 1.                            
                            FIND CURRENT Rendicion_hd NO-LOCK.

                            RUN poner_totales.

                        END.
                        RUN open-query.
                   END.
              END.
         END.
    END.
             
    que_cupon = "".
    SELF:SCREEN-VALUE = "".
    APPLY "ENTRY" TO SELF.
    RETURN NO-APPLY.
    
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&UNDEFINE SELF-NAME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CUSTOM _MAIN-BLOCK Dialog-Frame 


/* ***************************  Main Block  *************************** */

/* Parent the dialog-box to the ACTIVE-WINDOW, if there is no parent.   */
IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME {&FRAME-NAME}:PARENT eq ?
THEN FRAME {&FRAME-NAME}:PARENT = ACTIVE-WINDOW.


/* Now enable the interface and wait for the exit condition.            */
/* (NOTE: handle ERROR and END-KEY so cleanup code will always fire.    */
MAIN-BLOCK:
DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
   ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:

  FIND Rendicion_hd WHERE ROWID(Rendicion_hd) = rid_rendicion NO-LOCK. 
  CASE Rendicion_hd.tipo:
       WHEN "1" THEN v-nom_tiporend = "CUPONES COBRADOS".
       WHEN "2" THEN v-nom_tiporend = "CUPONES MOROSOS".
       WHEN "3" THEN v-nom_tiporend = "CUPONES DE BAJA".
       WHEN "4" THEN v-nom_tiporend = "CUPONES DEVUELTOS".
  END CASE.
  FIND Empresa OF Rendicion_hd NO-LOCK.
  v-nom_tiporend = v-nom_tiporend + " - " + Empresa.nombre + ":" + STRING(Rendicion_hd.nro_rendicion).
  RUN poner_totales.
  FRAME {&FRAME-NAME}:TITLE = "Ingreso de Cupones - SIC/AFI " + NRO_RELEASE.
  RUN enable_UI.
  WAIT-FOR GO OF FRAME {&FRAME-NAME}.
END.
RUN disable_UI.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


/* **********************  Internal Procedures  *********************** */

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE disable_UI Dialog-Frame  _DEFAULT-DISABLE
PROCEDURE disable_UI :
/*------------------------------------------------------------------------------
  Purpose:     DISABLE the User Interface
  Parameters:  <none>
  Notes:       Here we clean-up the user-interface by deleting
               dynamic widgets we have created and/or hide 
               frames.  This procedure is usually called when
               we are ready to "clean-up" after running.
------------------------------------------------------------------------------*/
  /* Hide all frames. */
  HIDE FRAME Dialog-Frame.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE enable_UI Dialog-Frame  _DEFAULT-ENABLE
PROCEDURE enable_UI :
/*------------------------------------------------------------------------------
  Purpose:     ENABLE the User Interface
  Parameters:  <none>
  Notes:       Here we display/view/enable the widgets in the
               user-interface.  In addition, OPEN all queries
               associated with each FRAME and BROWSE.
               These statements here are based on the "Other 
               Settings" section of the widget Property Sheets.
------------------------------------------------------------------------------*/
  DISPLAY v-nom_tiporend v-nom_cobrador que_cupon 
      WITH FRAME Dialog-Frame.
  IF AVAILABLE T-Rendicion_hd THEN 
    DISPLAY T-Rendicion_hd.cant_recibos T-Rendicion_hd.imp_imputado 
      WITH FRAME Dialog-Frame.
  ENABLE T-Rendicion_hd.cant_recibos T-Rendicion_hd.imp_imputado que_cupon 
         BROWSE-1 RECT-4 RECT-5 RECT-6 RECT-7 
      WITH FRAME Dialog-Frame.
  VIEW FRAME Dialog-Frame.
  {&OPEN-BROWSERS-IN-QUERY-Dialog-Frame}
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE open-query Dialog-Frame 
PROCEDURE open-query :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  OPEN QUERY {&BROWSE-NAME} 
       FOR EACH T-comprobante_rendicion OF T-Rendicion_hd,
           FIRST Cupon OF T-comprobante_rendicion NO-LOCK, 
           FIRST Cliente OF Cupon NO-LOCK.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE poner_totales Dialog-Frame 
PROCEDURE poner_totales :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  FIND Cobrador OF T-Rendicion_hd NO-LOCK NO-ERROR.
  v-nom_cobrador = IF AVAILABLE Cobrador THEN Cobrador.nom_cobrador ELSE "??".

  ASSIGN T-Rendicion_hd.cant_recibos = 0
         T-Rendicion_hd.imp_imputado = 0.

  FOR EACH T-comprobante_rendicion, FIRST Cupon OF T-comprobante_rendicion:

      ASSIGN T-Rendicion_hd.cant_recibos = T-Rendicion_hd.cant_recibos + 1
             T-Rendicion_hd.imp_imputado = T-Rendicion_hd.imp_imputado + Cupon.importe_cuota.
  END.

  DISPLAY T-Rendicion_hd.cant_recibos 
          T-Rendicion_hd.imp_imputado
          v-nom_cobrador 
          WITH FRAME {&FRAME-NAME}.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

