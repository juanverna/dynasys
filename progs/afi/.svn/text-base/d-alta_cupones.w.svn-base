FIND FIRST Rendicion_hd WHERE Rendicion_hd.abierta NO-LOCK.
rid_rendicion = ROWID(Rendicion_hd).
              /* MESSAGE "Levanta Rendicion:" string(Rendicion_hd.nro_rendicion,">>>>9")
