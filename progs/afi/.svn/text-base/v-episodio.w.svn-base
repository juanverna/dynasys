    'Keys-Accepted = "",
     Keys-Supplied = ""':U).
/**************************
</EXECUTING-CODE> */   

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


/* ***********************  Control Definitions  ********************** */


/* Definitions of the field level widgets                               */
DEFINE BUTTON btn_consulta 
     LABEL "&Consultar Despacho" 
     SIZE 26 BY 1.12.

DEFINE VARIABLE v-estado AS CHARACTER FORMAT "X(256)":U 
     VIEW-AS COMBO-BOX INNER-LINES 5
     LIST-ITEMS " "
     SIZE 26 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE RECTANGLE RECT-2
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 79 BY 8.62.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME F-Main
     Episodio.nro_episodio AT ROW 1.27 COL 13 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 10 BY .77
          BGCOLOR 15 FGCOLOR 9 FONT 0
     Episodio.nro_referencia AT ROW 1.27 COL 36 COLON-ALIGNED
          LABEL "Nro.Ref."
          VIEW-AS FILL-IN 
          SIZE 12 BY .77
          BGCOLOR 15 FGCOLOR 9 
     Episodio.referencia_txt AT ROW 1.27 COL 64 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 12 BY .77
          BGCOLOR 15 FGCOLOR 9 
     Episodio.reportado_por AT ROW 2.35 COL 13 COLON-ALIGNED
          LABEL "Abrió"
          VIEW-AS FILL-IN 
          SIZE 10 BY .77
          BGCOLOR 15 FGCOLOR 9 
     Episodio.fecha_apertura AT ROW 2.35 COL 36 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 12 BY .77
          BGCOLOR 15 FGCOLOR 9 
     Episodio.hms_apertura AT ROW 2.35 COL 64 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 12 BY .77
          BGCOLOR 15 FGCOLOR 9 
     Episodio.resuelto_por AT ROW 3.42 COL 13 COLON-ALIGNED
          LABEL "Cerró"
          VIEW-AS FILL-IN 
          SIZE 10 BY .77
          BGCOLOR 15 FGCOLOR 9 
     Episodio.fecha_cierre AT ROW 3.42 COL 36 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 12 BY .77
          BGCOLOR 15 FGCOLOR 9 
     Episodio.hms_cierre AT ROW 3.42 COL 64 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 12 BY .77
          BGCOLOR 15 FGCOLOR 9 
     Episodio.comentario AT ROW 5.31 COL 3 NO-LABEL
          VIEW-AS EDITOR
          SIZE 47 BY 3.77
          BGCOLOR 15 FGCOLOR 9 
     Episodio.fecha_prevista AT ROW 5.31 COL 64 COLON-ALIGNED
          VIEW-AS FILL-IN 
          SIZE 12 BY .77
          BGCOLOR 15 FGCOLOR 9 
     v-estado AT ROW 6.65 COL 50 COLON-ALIGNED NO-LABEL
     btn_consulta AT ROW 8 COL 52
     RECT-2 AT ROW 1 COL 1
     "Comentario" VIEW-AS TEXT
          SIZE 11 BY .62 AT ROW 4.5 COL 21
    WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY 
         SIDE-LABELS NO-UNDERLINE THREE-D 
         AT COL 1 ROW 1 SCROLLABLE 
         FONT 4.


