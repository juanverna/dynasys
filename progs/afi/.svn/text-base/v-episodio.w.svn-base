/* **********************  Internal Procedures  *********************** */

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE adm-row-available V-table-Win _ADM-ROW-AVAILABLE
PROCEDURE adm-row-available :
/*------------------------------------------------------------------------------
  Purpose:     Dispatched to this procedure when the Record-
               Source has a new row available.  This procedure
               tries to get the new row (or foriegn keys) from
               the Record-Source and process it.
  Parameters:  <none>
------------------------------------------------------------------------------*/

  /* Define variables needed by this internal procedure.             */
  {src/adm/template/row-head.i}

  /* Create a list of all the tables that we need to get.            */
  {src/adm/template/row-list.i "Afiliado"}
  {src/adm/template/row-list.i "Episodio"}

  /* Get the record ROWID's from the RECORD-SOURCE.                  */
  {src/adm/template/row-get.i}

  /* FIND each record specified by the RECORD-SOURCE.                */
  {src/adm/template/row-find.i "Afiliado"}
  {src/adm/template/row-find.i "Episodio"}

  /* Process the newly available records (i.e. display fields,
     open queries, and/or pass records on to any RECORD-TARGETS).    */
  {src/adm/template/row-end.i}

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE carga_combo V-table-Win 
PROCEDURE carga_combo :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  DO WITH FRAME {&FRAME-NAME}:

     DEFINE VARIABLE xx AS CHARACTER.
     DEFINE VARIABLE ok AS LOGICAL.

     OPEN QUERY q_estados FOR EACH St_episodio.
     GET FIRST q_estados.
     IF AVAILABLE St_episodio /* Si hay estados, llenamos el COMBO con la tabla */
     THEN DO:
            xx = St_episodio.dsc_stepisodio. /* Guarda el primero para usar como default */
            /*v-que_filtro = St_episodio.cdg_filtro.*/
            
            ASSIGN v-estado:DELIMITER = "!".
                   
            DO WHILE AVAILABLE St_episodio:
               ok = v-estado:ADD-LAST(St_episodio.dsc_stepisodio).
               GET NEXT q_estados.
            END.

            ASSIGN v-estado:SCREEN-VALUE = xx.

     END.

  END.          


END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE disable_UI V-table-Win _DEFAULT-DISABLE
PROCEDURE disable_UI :
/*------------------------------------------------------------------------------
  Purpose:     DISABLE the User Interface
  Parameters:  <none>
  Notes:       Here we clean-up the user-interface by deleting
               dynamic widgets we have created and/or hide 
               frames.  This procedure is usually called when
               we are ready to "clean-up" after running.
------------------------------------------------------------------------------*/
  /* Hide all frames. */
  HIDE FRAME F-Main.
  IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE iniciar_registro V-table-Win 
PROCEDURE iniciar_registro :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  DO WITH FRAME {&FRAME-NAME}:

     ASSIGN
        v-fecha_apertura = TODAY
        v-hms_apertura = STRING(TIME,"HH:MM:SS")
        v-reportado_por = USERID("despacho").

     ASSIGN
        Episodio.fecha_apertura:SCREEN-VALUE = STRING(v-fecha_apertura,Episodio.fecha_apertura:FORMAT)
        Episodio.hms_apertura:SCREEN-VALUE = v-hms_apertura
        Episodio.reportado_por:SCREEN-VALUE = v-reportado_por
        v-estado:SCREEN-VALUE = "Ingresado".

  END.


END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-add-record V-table-Win 
PROCEDURE local-add-record :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'add-record':U ) .

  /* Code placed here will execute AFTER standard behavior.    */

  RUN iniciar_registro.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-assign-statement V-table-Win 
PROCEDURE local-assign-statement :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'assign-statement':U ) .

  /* Code placed here will execute AFTER standard behavior.    */


  IF NEW Episodio
  THEN DO:
        ASSIGN
            Episodio.fecha_apertura = v-fecha_apertura
            Episodio.hms_apertura = v-hms_apertura
            Episodio.reportado_por = v-reportado_por
            Episodio.nro_afiliado = Afiliado.nro_afiliado.
            Episodio.nro_episodio   = NEXT-VALUE(proximo_episodio).
            Episodio.cdg_stepisodio = "IN".

        CREATE Hst_episodio.
        ASSIGN Hst_episodio.cdg_stepisodio  = "IN"
               Hst_episodio.fecha_cambio    = v-fecha_apertura
               Hst_episodio.hms_cambio      = v-hms_apertura
               Hst_episodio.hst_comentario  = ""
               Hst_episodio.nro_episodio    = Episodio.nro_episodio
               Hst_episodio.Usuario         = USERID("despacho").

        RELEASE Hst_episodio.    
  END.
  ELSE DO:

        FIND St_episodio WHERE St_episodio.dsc_stepisodio = v-estado:SCREEN-VALUE IN FRAME {&FRAME-NAME} NO-LOCK.
        Episodio.cdg_stepisodio = St_episodio.cdg_stepisodio.

        IF v-org-estado <> v-estado:SCREEN-VALUE IN FRAME {&FRAME-NAME}
        THEN DO:
            CREATE Hst_episodio.
            ASSIGN Hst_episodio.cdg_stepisodio  = Episodio.cdg_stepisodio
                   Hst_episodio.fecha_cambio    = TODAY
                   Hst_episodio.hms_cambio      = STRING(TIME,"HH:MM:SS")
                   Hst_episodio.hst_comentario  = ""
                   Hst_episodio.nro_episodio    = Episodio.nro_episodio
                   Hst_episodio.Usuario         = USERID("despacho").
            RELEASE Hst_episodio.    

        END.

  END.       


END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-copy-record V-table-Win 
PROCEDURE local-copy-record :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'copy-record':U ) .

  /* Code placed here will execute AFTER standard behavior.    */

  RUN iniciar_registro.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-disable-fields V-table-Win 
PROCEDURE local-disable-fields :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'disable-fields':U ) .

  /* Code placed here will execute AFTER standard behavior.    */

  v-estado:SENSITIVE IN FRAME {&FRAME-NAME} = NO. 

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-display-fields V-table-Win 
PROCEDURE local-display-fields :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

  IF v-estado:NUM-ITEMS IN FRAME {&FRAME-NAME} = 0
  THEN DO:
       RUN carga_combo.
  END.

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'display-fields':U ) .

  /* Code placed here will execute AFTER standard behavior.    */

  IF AVAILABLE Episodio AND v-estado:NUM-ITEMS IN FRAME {&FRAME-NAME} <> 0
  THEN DO:

       FIND St_episodio OF Episodio NO-LOCK.
       v-estado:SCREEN-VALUE IN FRAME {&FRAME-NAME} = St_episodio.dsc_stepisodio.

  END.


END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-enable-fields V-table-Win 
PROCEDURE local-enable-fields :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'enable-fields':U ) .

  /* Code placed here will execute AFTER standard behavior.    */

  v-estado:SENSITIVE IN FRAME {&FRAME-NAME} = YES. 
  v-org-estado = v-estado:SCREEN-VALUE IN FRAME {&FRAME-NAME}.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE send-records V-table-Win _ADM-SEND-RECORDS
PROCEDURE send-records :
/*------------------------------------------------------------------------------
  Purpose:     Send record ROWID's for all tables used by
               this file.
  Parameters:  see template/snd-head.i
------------------------------------------------------------------------------*/

  /* Define variables needed by this internal procedure.               */
  {src/adm/template/snd-head.i}

  /* For each requested table, put it's ROWID in the output list.      */
  {src/adm/template/snd-list.i "Afiliado"}
  {src/adm/template/snd-list.i "Episodio"}

  /* Deal with any unexpected table requests before closing.           */
  {src/adm/template/snd-end.i}

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


