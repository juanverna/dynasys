PROCEDURE bajar_datos:
/*
   FOR EACH T-Grupofam:
       CREATE Grupofam.
       BUFFER-COPY T-Grupofam TO Grupofam.
   END.

   FOR EACH T-Afiliado:
       CREATE Afiliado.
       BUFFER-COPY T-Afiliado TO Afiliado.
   END.

   FOR EACH T-Cliente:
       CREATE Cliente.
       BUFFER-COPY T-Cliente TO Cliente.
   END.
*/
   FOR EACH T-Grupo-domicilio:
       CREATE Grupo-domicilio.
       BUFFER-COPY T-Grupo-domicilio TO Grupo-domicilio.
   END.
/*
   FOR EACH T-Domicilio:
       CREATE Domicilio.
       BUFFER-COPY T-Domicilio TO Domicilio.
   END.

   FOR EACH T-Pedido_credencial:
       CREATE Pedido_credencial.
       BUFFER-COPY T-Pedido_credencial TO Pedido_credencial.
   END.
*/
END PROCEDURE.
