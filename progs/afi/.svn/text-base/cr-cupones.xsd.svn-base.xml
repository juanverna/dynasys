<?xml version="1.0"?>
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns="" xmlns:prodata="urn:schemas-progress-com:xml-prodata:0001">
  <xsd:element name="dset" prodata:proDataSet="true">
    <xsd:complexType>
      <xsd:sequence>
        <xsd:element name="ttcupon" minOccurs="0" maxOccurs="unbounded" prodata:undo="true">
          <xsd:complexType>
            <xsd:sequence>
              <xsd:element name="cdg_empresa" type="xsd:string" nillable="true" prodata:label="Empresa" prodata:columnLabel="Código!Empresa" prodata:help="Código de empresa del grupo familiar"/>
              <xsd:element name="nro_cobrador" type="xsd:int" nillable="true" prodata:label="Nro.Interno" prodata:columnLabel="Número!Interno" prodata:help="Número interno del cobrador independiente del código"/>
              <xsd:element name="importe_cuota" type="xsd:decimal" nillable="true" prodata:format="->>>,>>9.99" prodata:label="Importe de Cuota" prodata:columnLabel="Importe!Cuota" prodata:help="Importe de la cuota mensual" prodata:decimals="2"/>
              <xsd:element name="cdg_localidad" type="xsd:string" nillable="true" prodata:format="X(2)" prodata:label="Localidad" prodata:columnLabel="Localidad" prodata:help="Código de localidad"/>
              <xsd:element name="cdg_zonag" type="xsd:string" nillable="true" prodata:label="Zona" prodata:columnLabel="Zona!Cobro" prodata:help="Zona de Cobranzas"/>
              <xsd:element name="mes_imputa" type="xsd:int" nillable="true" prodata:format="99" prodata:label="Imputa Mes" prodata:columnLabel="Imputa!Mes" prodata:help="Corresponde a período"/>
              <xsd:element name="ano_imputa" type="xsd:int" nillable="true" prodata:format="9999" prodata:label="Imputa Año" prodata:columnLabel="Imputa!Año" prodata:help="Corresponde a período"/>
              <xsd:element name="tip_comprob" type="xsd:string" nillable="true" prodata:format="X(2)" prodata:label="Tipo Comprobante" prodata:columnLabel="Tipo!Compbte" prodata:help="Tipo de Comprobante"/>
              <xsd:element name="prf_comprob" type="xsd:int" nillable="true" prodata:format="9999" prodata:label="Pto.Vta." prodata:columnLabel="Punto!Venta" prodata:help="Punto de Venta"/>
              <xsd:element name="nro_comprob" type="xsd:int" nillable="true" prodata:format="99999999" prodata:label="Nro.Comprob." prodata:columnLabel="Número!Comprobte." prodata:help="Número de Comprobte."/>
              <xsd:element name="fecha_emision" type="xsd:date" nillable="true" prodata:format="99/99/9999" prodata:label="Fecha Emisión" prodata:columnLabel="Fecha!Emisión" prodata:help="Fecha de Emisión"/>
              <xsd:element name="fecha_alta" type="xsd:date" nillable="true" prodata:format="99/99/9999" prodata:label="Fecha Alta" prodata:columnLabel="Fecha!Alta" prodata:help="Fecha de Alta"/>
              <xsd:element name="nro_rendicion" type="xsd:int" nillable="true" prodata:label="Rendicion de Pago" prodata:columnLabel="Rendicion!Pago" prodata:help="Rendicion en la que se ingreso el pago"/>
              <xsd:element name="estado" type="xsd:string" nillable="true" prodata:format="X(1)" prodata:label="Estado" prodata:columnLabel="Es-!tado" prodata:help="Estado del cupón. &quot;&quot; Ingresado, &quot;P&quot; Procesado"/>
              <xsd:element name="tip_cupon" type="xsd:string" nillable="true" prodata:format="X(2)" prodata:label="Tipo Comprobante" prodata:columnLabel="Tipo!Compbte" prodata:help="Tipo de Comprobante"/>
              <xsd:element name="prf_cupon" type="xsd:int" nillable="true" prodata:format="9999" prodata:label="Pto.Vta." prodata:columnLabel="Punto!Venta" prodata:help="Punto de Venta"/>
              <xsd:element name="nro_cupon" type="xsd:int" nillable="true" prodata:format="99999999" prodata:label="Nro.Comprob." prodata:columnLabel="Número!Comprobte." prodata:help="Número de Comprobte."/>
              <xsd:element name="id_lote" type="xsd:string" nillable="true" prodata:label="Código Lote" prodata:columnLabel="Código!Lote" prodata:help="Código de lote dentro de una misma fecha de emisión"/>
              <xsd:element name="cdg_motbaja" type="xsd:string" nillable="true" prodata:format="X(1)" prodata:label="Motivo Baja" prodata:columnLabel="Motivo!Baja" prodata:help="Código de Motivo de Baja"/>
              <xsd:element name="usuario-sel" type="xsd:string" nillable="true" prodata:label="Seleccionado" prodata:columnLabel="Usuario!Selec." prodata:help="Usuario que selecciona el cupón para imprimir"/>
              <xsd:element name="nro_cliente" type="xsd:int" nillable="true" prodata:format=">>>>>9" prodata:label="Nro.interno" prodata:columnLabel="Nro.Int." prodata:help="Ingrese el Nro. Interno del cliente."/>
              <xsd:element name="nro_administrador" type="xsd:int" nillable="true" prodata:label="Nro. Adminis" prodata:columnLabel="Nro.!Adminis" prodata:help="Número de cliente administrador"/>
              <xsd:element name="importe_pagado" type="xsd:decimal" nillable="true" prodata:format="->>>,>>9.99" prodata:label="Importe Pagado" prodata:columnLabel="Importe!Pagado" prodata:help="Importe cancelado" prodata:decimals="2"/>
              <xsd:element name="cdg_administrador" type="xsd:string" nillable="true" prodata:label="C.Adm" prodata:columnLabel="Código!Administrador" prodata:help="Codigo de Administrador"/>
              <xsd:element name="cdg_cliente" type="xsd:string" nillable="true" prodata:label="C.Cliente" prodata:columnLabel="Código!Cliente" prodata:help="Codigo de Cliente"/>
              <xsd:element name="cdg_postal" type="xsd:string" nillable="true" prodata:label="Codigo Postal" prodata:columnLabel="CP" prodata:help="Ingrese el Codigo postal"/>
              <xsd:element name="direccion" type="xsd:string" nillable="true" prodata:format="X(45)" prodata:label="Direccion" prodata:columnLabel="Direc." prodata:help="Ingrese la direccion del cliente"/>
              <xsd:element name="direccion_administrador" type="xsd:string" nillable="true" prodata:format="X(45)" prodata:label="Direccion" prodata:columnLabel="Direccion" prodata:help="Direccion"/>
              <xsd:element name="cuit" type="xsd:string" nillable="true" prodata:format="X(15)" prodata:label="C.U.I.T." prodata:columnLabel="C.U.I.T." prodata:help="C.U.I.T."/>
              <xsd:element name="fecha" type="xsd:date" nillable="true" prodata:format="99/99/9999" prodata:label="Fecha" prodata:columnLabel="Fecha" prodata:help="Fecha de emision"/>
              <xsd:element name="nombre" type="xsd:string" nillable="true" prodata:format="X(40)" prodata:label="Razon Social" prodata:columnLabel="Razon Social" prodata:help="Razon Social del cliente"/>
              <xsd:element name="monto_letras" type="xsd:string" nillable="true" prodata:format="X(60)" prodata:label="Monto en Letras" prodata:columnLabel="Monto en!Letras" prodata:help="Monto en letras"/>
              <xsd:element name="nom_Administrador" type="xsd:string" nillable="true" prodata:format="X(40)" prodata:label="Razón Social" prodata:columnLabel="Razón!Social" prodata:help="Razon Social del Administrador"/>
              <xsd:element name="localidad_administrador" type="xsd:string" nillable="true" prodata:format="X(30)" prodata:label="Localidad" prodata:columnLabel="Localidad" prodata:help="Localidad"/>
              <xsd:element name="mostrar_admin" type="xsd:boolean" nillable="true" default="true" prodata:format="Si/No" prodata:label="Mostrar Addmin" prodata:columnLabel="Mostrar!Admin"/>
              <xsd:element name="ListaArticulos" type="xsd:string" nillable="true" prodata:format="X(20)"/>
            </xsd:sequence>
          </xsd:complexType>
        </xsd:element>
      </xsd:sequence>
    </xsd:complexType>
    <xsd:unique name="por_comprobante">
      <xsd:selector xpath=".//ttcupon"/>
      <xsd:field xpath="cdg_empresa"/>
      <xsd:field xpath="tip_comprob"/>
      <xsd:field xpath="prf_comprob"/>
      <xsd:field xpath="nro_comprob"/>
    </xsd:unique>
    <xsd:unique name="por_cupon" prodata:primaryIndex="true">
      <xsd:selector xpath=".//ttcupon"/>
      <xsd:field xpath="cdg_empresa"/>
      <xsd:field xpath="tip_cupon"/>
      <xsd:field xpath="prf_cupon"/>
      <xsd:field xpath="nro_cupon"/>
    </xsd:unique>
  </xsd:element>
  <xsd:annotation>
    <xsd:appinfo>
      <prodata:index name="estado">
        <prodata:table name="ttcupon"/>
        <prodata:field name="estado"/>
      </prodata:index>
      <prodata:index name="por_administrador">
        <prodata:table name="ttcupon"/>
        <prodata:field name="nro_administrador"/>
      </prodata:index>
      <prodata:index name="por_cliente">
        <prodata:table name="ttcupon"/>
        <prodata:field name="nro_cliente"/>
        <prodata:field name="ano_imputa"/>
        <prodata:field name="mes_imputa"/>
      </prodata:index>
      <prodata:index name="por_cobrador">
        <prodata:table name="ttcupon"/>
        <prodata:field name="nro_cobrador"/>
        <prodata:field name="cdg_empresa"/>
        <prodata:field name="ano_imputa"/>
        <prodata:field name="mes_imputa"/>
        <prodata:field name="cdg_zonag"/>
      </prodata:index>
      <prodata:index name="por_rendicion">
        <prodata:table name="ttcupon"/>
        <prodata:field name="nro_rendicion"/>
        <prodata:field name="tip_comprob"/>
        <prodata:field name="prf_comprob"/>
        <prodata:field name="nro_comprob"/>
      </prodata:index>
    </xsd:appinfo>
  </xsd:annotation>
</xsd:schema>
