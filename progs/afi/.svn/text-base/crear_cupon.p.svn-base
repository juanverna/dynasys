/* ============================================================================================ */    
/*                CREA UN CUPON DE COBRANZA A PARTIR DE UNA FACTURA EXISTENTE                   */
/* ============================================================================================ */    
    
    DEFINE INPUT PARAMETER p-rid_factura AS ROWID.

/* ============================================================================================ */    
/*                                        PROCESO                                               */
/* ============================================================================================ */    
    
    FIND Fac_header WHERE ROWID(Fac_header) = p-rid_factura NO-LOCK.
    FIND cliente WHERE cliente.nro_cliente = fac_header.nro_cliente NO-ERROR.
    CREATE Cupon.
        ASSIGN Cupon.ano_imputa    = Fac_header.ano
               Cupon.nro_cobrador  = IF NOT AVAILABLE cliente THEN 1 ELSE cliente.nro_cobrador
               Cupon.cdg_empresa   = Fac_header.cdg_empresa
               Cupon.nro_cliente   = Fac_header.nro_cliente
               Cupon.cdg_localidad = Fac_header.localidad
               Cupon.fecha_emision = Fac_header.fecha
               Cupon.importe_cuota = Fac_header.imp_total
               Cupon.mes_imputa    = Fac_header.mes
               Cupon.nro_comprob   = Fac_header.nro_comprob
               Cupon.prf_comprob   = Fac_header.prf_comprob
               Cupon.tip_comprob   = Fac_header.tip_comprob
               Cupon.estado        = "P"
               Cupon.tip_cupon     = Cupon.tip_comprob
               Cupon.prf_cupon     = Cupon.prf_comprob
               Cupon.nro_cupon     = Cupon.nro_comprob
               cupon.nro_administrador = fac_header.nro_administrador.
    FIND tipocomprobante WHERE tipocomprobante.cdg_empresa = fac_header.cdg_empresa AND
        tipocomprobante.cdg_comprobante = fac_header.cdg_comprobante NO-LOCK.
    IF tipocomprobante.es_interno THEN cupon.estado = "0".
    IF fac_header.anulado  THEN cupon.estado = "5".

    
