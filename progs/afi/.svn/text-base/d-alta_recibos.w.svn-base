/* ************************  Control Triggers  ************************ */

&Scoped-define SELF-NAME Dialog-Frame
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL Dialog-Frame Dialog-Frame
ON WINDOW-CLOSE OF FRAME Dialog-Frame /* Ingreso de Recibos */
DO:
  APPLY "END-ERROR":U TO SELF.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define BROWSE-NAME BROWSE-1
&Scoped-define SELF-NAME BROWSE-1
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL BROWSE-1 Dialog-Frame
ON F1 OF BROWSE-1 IN FRAME Dialog-Frame
DO:
  APPLY "F1" TO que_cupon IN FRAME {&FRAME-NAME}.
  RETURN NO-APPLY.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL BROWSE-1 Dialog-Frame
ON F2 OF BROWSE-1 IN FRAME Dialog-Frame
DO:
  APPLY "F2" TO que_cupon IN FRAME {&FRAME-NAME}.
  RETURN NO-APPLY.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL BROWSE-1 Dialog-Frame
ON F3 OF BROWSE-1 IN FRAME Dialog-Frame
DO:
  APPLY "F3" TO que_cupon IN FRAME {&FRAME-NAME}.
  RETURN NO-APPLY.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL BROWSE-1 Dialog-Frame
ON F4 OF BROWSE-1 IN FRAME Dialog-Frame
DO:
  APPLY "F4" TO que_cupon IN FRAME {&FRAME-NAME}.
  RETURN NO-APPLY.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME bVer-2
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL bVer-2 Dialog-Frame
ON CHOOSE OF bVer-2 IN FRAME Dialog-Frame /* Ver */
DO:
  DEFINE BUFFER badminis FOR cliente.
  FIND badminis WHERE badminis.nro_cliente = cliente.nro_administrador NO-LOCK NO-ERROR.
  RUN w-zoom_cliente.w ( INPUT ROWID(badminis) ).
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME que_cupon
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL que_cupon Dialog-Frame
ON ENTRY OF que_cupon IN FRAME Dialog-Frame /* Recibo Número */
DO:
  que_cupon:BGCOLOR IN FRAME {&FRAME-NAME} = 14.
  que_cupon:FGCOLOR IN FRAME {&FRAME-NAME} = 12.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL que_cupon Dialog-Frame
ON F1 OF que_cupon IN FRAME Dialog-Frame /* Recibo Número */
DO:
    
    IF NOT AVAILABLE T-Caj_header
    THEN DO:
      RUN crear_caja.
    END.
    ELSE DO:
      RUN asignar_caja.
    END.   
    
    RUN d-valores_movimiento.w ( INPUT-OUTPUT TABLE T-Caj_header,
                                 INPUT-OUTPUT TABLE T-Caj_detalle,
                                 INPUT-OUTPUT TABLE T-Caja-imputacion,
                                 INPUT-OUTPUT TABLE T-Cheque,
                                 INPUT-OUTPUT TABLE T-Valor,
                                 INPUT 0).
    
    FIND FIRST T-Caj_header EXCLUSIVE-LOCK.
    IF T-Caj_header.importe <> T-Caj_header.ingreso THEN RETURN NO-APPLY.
    
    DEFINE VARIABLE sino AS LOGICAL.
    sino = NO.
    MESSAGE "Se dispone a cerrar la Rendición. Luego no podrán ingresarse mas recibos en la misma."
          "Confirma que desa cerrar esta rendición? " VIEW-AS ALERT-BOX 
          BUTTONS YES-NO SET sino.
    IF sino
    THEN DO:
      RUN cierrarendicion.
      APPLY "GO":U TO SELF.
    END.
    RETURN NO-APPLY.
  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL que_cupon Dialog-Frame
ON F2 OF que_cupon IN FRAME Dialog-Frame /* Recibo Número */
DO:
  sino = NO.
  MESSAGE "Desea imprimir la rendicion?" VIEW-AS ALERT-BOX 
          BUTTONS YES-NO SET sino.
  IF sino
  THEN DO:
       RUN prinrendicion.
  END.        
  que_cupon:BGCOLOR IN FRAME {&FRAME-NAME} = 14.
  que_cupon:FGCOLOR IN FRAME {&FRAME-NAME} = 12.
  RETURN NO-APPLY.
  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL que_cupon Dialog-Frame
ON F3 OF que_cupon IN FRAME Dialog-Frame /* Recibo Número */
DO:
  sino = NO.
  RUN mensajepregunta.p ( INPUT "", INPUT "PREG300", OUTPUT sino ).
  IF sino
  THEN DO:
      DO TRANSACTION:
          FIND CURRENT T-Rendicion_hd EXCLUSIVE-LOCK.
          DELETE T-Rendicion_hd.
      END.
      APPLY "END-ERROR":U TO SELF.
  END.          
  RETURN NO-APPLY.

END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL que_cupon Dialog-Frame
ON F4 OF que_cupon IN FRAME Dialog-Frame /* Recibo Número */
DO:

  IF AVAILABLE T-comprobante_rendicion
  THEN DO:
      DO TRANSACTION:
          DELETE T-comprobante_rendicion.
          RUN poner_totales.
          RUN open-query.
      END.
  END.
  ELSE DO:
       MESSAGE "No hay Recibos ingresados"
               VIEW-AS ALERT-BOX ERROR.
  END.
  RETURN NO-APPLY.
  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL que_cupon Dialog-Frame
ON LEAVE OF que_cupon IN FRAME Dialog-Frame /* Recibo Número */
DO:
  que_cupon:BGCOLOR IN FRAME {&FRAME-NAME} = 12.
  que_cupon:FGCOLOR IN FRAME {&FRAME-NAME} = 14.

END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL que_cupon Dialog-Frame
ON RETURN OF que_cupon IN FRAME Dialog-Frame /* Recibo Número */
DO:

    ASSIGN FRAME {&FRAME-NAME} que_cupon.
    FIND Cupon 
         WHERE Cupon.cdg_empresa = T-Rendicion_hd.cdg_empresa
           AND Cupon.tip_cupon = SUBSTRING(que_cupon,1,2)
           AND Cupon.prf_cupon = INTEGER(SUBSTRING(que_cupon,3,4))
           AND Cupon.nro_cupon = INTEGER(SUBSTRING(que_cupon,7,8)) 
               NO-LOCK NO-ERROR.
           
    IF NOT AVAILABLE Cupon
    THEN DO:
         RUN PONMENSJ.P ( INPUT "CUPO001" ).
         RETURN NO-APPLY.
    END.

    IF T-Rendicion_hd.nro_cobrador = 0
    THEN DO:
        FIND Cobrador OF Cupon NO-LOCK.
        T-Rendicion_hd.nro_cobrador = Cobrador.nro_cobrador.
    END.

    IF Cupon.nro_cobrador <> Cobrador.nro_cobrador
    THEN DO:
        RUN PONMENSJ.P ( INPUT "CUPO002" ).
        RETURN NO-APPLY.
    END.

    IF v-cdg_administrador = ""
    THEN DO:
        FIND Cliente OF Cupon NO-LOCK.
        FIND Administrador WHERE Administrador.nro_cliente = Cliente.nro_administrador NO-LOCK.
        ASSIGN v-cdg_administrador = Administrador.cdg_cliente
               v-dsc_administrador = Administrador.nom_cliente.
        DISPLAY
               v-cdg_administrador
               v-dsc_administrador
               WITH FRAME {&FRAME-NAME}.

    END.

    FIND Cliente OF Cupon NO-LOCK.
    FIND Administrador WHERE Administrador.nro_cliente = Cliente.nro_administrador NO-LOCK.
    IF v-cdg_administrador <> Administrador.cdg_cliente
    THEN DO:
        RUN PONMENSJ.P ( INPUT "CUPO552" ).
        RETURN NO-APPLY.
    END.

    IF (Cupon.estado = "1" OR Cupon.estado = "3" ) OR
       (Cupon.estado = "2" AND Cupon.nro_rendicion = T-Rendicion_hd.nro_rendicion ) OR
       (Cupon.estado = "4" AND Cupon.nro_rendicion = T-Rendicion_hd.nro_rendicion )
    THEN DO:
        RUN PONMENSJ.P ( INPUT "CUPO003" ).
        RETURN NO-APPLY.
    END.

    IF CAN-FIND(FIRST T-comprobante_rendicion OF Cupon)
    THEN DO:
        RUN PONMENSJ.P ( INPUT "CUPO004" ).
        RETURN NO-APPLY.
    END.

    CREATE T-comprobante_rendicion.
    BUFFER-COPY Cupon TO T-comprobante_rendicion.
        
    RUN poner_totales.
    RUN open-query.
             
    que_cupon = "".
    SELF:SCREEN-VALUE = "".
    APPLY "ENTRY" TO SELF.
    RETURN NO-APPLY.
    
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME v-cdg_administrador
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-cdg_administrador Dialog-Frame
ON MOUSE-SELECT-DBLCLICK OF v-cdg_administrador IN FRAME Dialog-Frame /* Administ. */
OR "." OF v-cdg_administrador IN FRAME {&FRAME-NAME}
OR MOUSE-MENU-DOWN OF v-cdg_administrador IN FRAME {&FRAME-NAME}
DO:
   {helptabla.i "Administrador" "cdg_cliente" "SELCLIEN.P"}
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL v-cdg_administrador Dialog-Frame
ON RETURN OF v-cdg_administrador IN FRAME Dialog-Frame /* Administ. */
DO:
    &SCOPED-DEFINE PONER-TABLA RUN poner_administrador.
   {traducetabla.i "Administrador" "cdg_cliente" "nom_cliente"} 
    &UNDEFINE PONER-TABLA
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&UNDEFINE SELF-NAME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CUSTOM _MAIN-BLOCK Dialog-Frame 


/* ***************************  Main Block  *************************** */

/* Parent the dialog-box to the ACTIVE-WINDOW, if there is no parent.   */
IF VALID-HANDLE(ACTIVE-WINDOW) AND FRAME {&FRAME-NAME}:PARENT eq ?
THEN FRAME {&FRAME-NAME}:PARENT = ACTIVE-WINDOW.


{findempresa.i}

/* Now enable the interface and wait for the exit condition.            */
/* (NOTE: handle ERROR and END-KEY so cleanup code will always fire.    */
MAIN-BLOCK:
DO ON ERROR   UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK
   ON END-KEY UNDO MAIN-BLOCK, LEAVE MAIN-BLOCK:

  CREATE T-Rendicion_hd.
  ASSIGN T-Rendicion_hd.tipo = "1"
         T-Rendicion_hd.cdg_empresa = Empresa.cdg_empresa
         T-Rendicion_hd.fch_rendicion  = TODAY
         T-Rendicion_hd.abierta        = YES
         v-cdg_administrador = ""
         v-dsc_administrador = "".

  RUN poner_totales.
  FRAME {&FRAME-NAME}:TITLE = "Ingreso de Recibos - DYNASYS/AFI " + NRO_RELEASE.
  RUN enable_UI.
  WAIT-FOR GO OF FRAME {&FRAME-NAME}.
END.
RUN disable_UI.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


/* **********************  Internal Procedures  *********************** */

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE asignar_caja Dialog-Frame 
PROCEDURE asignar_caja :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    ASSIGN T-Caj_header.importe         = T-Rendicion_hd.imp_imputado.

    EMPTY TEMP-TABLE T-Caja-imputacion.
    RUN crear_caja_imputacion.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE cierrarendicion Dialog-Frame 
PROCEDURE cierrarendicion :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  DO TRANSACTION:
      
      RUN completar_auditoria.p ( OUTPUT T-Rendicion_hd.nro_usuario,
                                  OUTPUT T-Rendicion_hd.fecha_grab,
                                  OUTPUT T-Rendicion_hd.hora_grab,
                                  OUTPUT T-Rendicion_hd.pc_name).

      RUN cierrarendicion.p ( INPUT-OUTPUT TABLE T-Rendicion_hd,
                              INPUT-OUTPUT TABLE T-comprobante_rendicion).
          
  END.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE crear_caja Dialog-Frame 
PROCEDURE crear_caja :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    DEFINE VARIABLE que_caja LIKE Caja.cdg_caja.

    RUN getparametro_n.p (  INPUT  "DFNROCAJ", OUTPUT que_caja ).
    FIND Caja WHERE Caja.cdg_caja = que_caja NO-LOCK.

    FIND Administrador WHERE Administrador.cdg_cliente = v-cdg_administrador NO-LOCK.
    FIND Familia_cliente OF Administrador NO-LOCK.

    CREATE T-Caj_header.
    BUFFER-COPY T-Rendicion_hd TO T-Caj_header
        ASSIGN T-Caj_header.fecha               = TODAY
               T-Caj_header.hora                = TIME
               T-Caj_header.ultima_linea        = 0
               T-Caj_header.nro_transaccion     = NEXT-VALUE(proxima_txncaja)
               T-Caj_header.importe             = T-Rendicion_hd.imp_imputado
               T-Caj_header.emitir              = NO
               T-Caj_header.cdg_caja            = Caja.cdg_caja
               T-Caj_header.nro_cuenta          = Familia_cliente.nro_cuenta
               T-Caj_header.observacion         = Administrador.cdg_cliente + "-" + Administrador.nom_cliente
               T-Caj_header.tipo_mov            = "I"
               T-Rendicion_hd.nro_transaccion   = T-Caj_header.nro_transaccion.

    EMPTY TEMP-TABLE T-Caja-imputacion.
    RUN crear_caja_imputacion.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE crear_caja_imputacion Dialog-Frame 
PROCEDURE crear_caja_imputacion :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    CREATE T-Caja-imputacion.
    ASSIGN T-Caja-imputacion.nro_cuenta       = Familia_cliente.nro_cuenta
           T-Caja-imputacion.nro_entidad      = Caja.nro_entidad
           T-Caja-imputacion.nro_obra         = 0
           T-Caja-imputacion.nro_transaccion  = T-Caj_header.nro_transaccion
           T-Caja-imputacion.observacion      = ""
           T-Caja-imputacion.valor            = T-Caj_header.importe.


END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE disable_UI Dialog-Frame  _DEFAULT-DISABLE
PROCEDURE disable_UI :
/*------------------------------------------------------------------------------
  Purpose:     DISABLE the User Interface
  Parameters:  <none>
  Notes:       Here we clean-up the user-interface by deleting
               dynamic widgets we have created and/or hide 
               frames.  This procedure is usually called when
               we are ready to "clean-up" after running.
------------------------------------------------------------------------------*/
  /* Hide all frames. */
  HIDE FRAME Dialog-Frame.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE enable_UI Dialog-Frame  _DEFAULT-ENABLE
PROCEDURE enable_UI :
/*------------------------------------------------------------------------------
  Purpose:     ENABLE the User Interface
  Parameters:  <none>
  Notes:       Here we display/view/enable the widgets in the
               user-interface.  In addition, OPEN all queries
               associated with each FRAME and BROWSE.
               These statements here are based on the "Other 
               Settings" section of the widget Property Sheets.
------------------------------------------------------------------------------*/
  DISPLAY v-nom_cobrador v-cdg_administrador v-dsc_administrador que_cupon 
      WITH FRAME Dialog-Frame.
  IF AVAILABLE T-Rendicion_hd THEN 
    DISPLAY T-Rendicion_hd.tipo T-Rendicion_hd.cant_recibos 
          T-Rendicion_hd.imp_imputado 
      WITH FRAME Dialog-Frame.
  ENABLE RECT-4 RECT-5 RECT-6 RECT-7 T-Rendicion_hd.tipo v-cdg_administrador 
         que_cupon bVer-2 BROWSE-1 
      WITH FRAME Dialog-Frame.
  VIEW FRAME Dialog-Frame.
  {&OPEN-BROWSERS-IN-QUERY-Dialog-Frame}
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE open-query Dialog-Frame 
PROCEDURE open-query :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  OPEN QUERY {&BROWSE-NAME} 
       FOR EACH T-comprobante_rendicion OF T-Rendicion_hd,
           FIRST Cupon OF T-comprobante_rendicion NO-LOCK, 
           FIRST Cliente OF Cupon NO-LOCK.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE poner_administrador Dialog-Frame 
PROCEDURE poner_administrador :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  FIND Cobrador OF Administrador NO-LOCK.
  T-Rendicion_hd.nro_cobrador = Cobrador.nro_cobrador.

  FOR EACH Cliente WHERE Cliente.nro_administrador = Administrador.nro_cliente NO-LOCK,
      EACH Cupon OF Cliente WHERE Cupon.estado = "0":

      CREATE T-comprobante_rendicion.
      BUFFER-COPY Cupon TO T-comprobante_rendicion.
  END.
  
  RUN poner_totales.
  RUN open-query.

  v-cdg_administrador:SENSITIVE IN FRAME {&FRAME-NAME} = NO.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE poner_totales Dialog-Frame 
PROCEDURE poner_totales :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  FIND Cobrador OF T-Rendicion_hd NO-LOCK NO-ERROR.
  v-nom_cobrador = IF AVAILABLE Cobrador THEN Cobrador.nom_cobrador ELSE "??".

  ASSIGN T-Rendicion_hd.cant_recibos = 0
         T-Rendicion_hd.imp_imputado = 0.

  FOR EACH T-comprobante_rendicion, FIRST Cupon OF T-comprobante_rendicion:

      ASSIGN T-Rendicion_hd.cant_recibos = T-Rendicion_hd.cant_recibos + 1
             T-Rendicion_hd.imp_imputado = T-Rendicion_hd.imp_imputado + Cupon.importe_cuota.
  END.

  DISPLAY T-Rendicion_hd.cant_recibos 
          T-Rendicion_hd.imp_imputado
          v-nom_cobrador 
          WITH FRAME {&FRAME-NAME}.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE prinrendicion Dialog-Frame 
PROCEDURE prinrendicion :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

    /*=================================================================================*/
    /*                     IMPRESION DE RENDICIONES DE COBRADORES                      */
    /*=================================================================================*/
    
    
    /*=================================================================================*/
    /*                           VARIABLES, FRAMES, Y SUBMENUES                        */
    /*=================================================================================*/
    
    DEFINE VARIABLE nt_lineas       AS INTEGER.
    DEFINE VARIABLE total_chars     AS INTEGER.
    DEFINE VARIABLE ancho_linea     AS INTEGER INITIAL 40.
    DEFINE VARIABLE total_recibos   AS INTEGER.
    DEFINE VARIABLE total_rendicion AS DECIMAL FORMAT "->>>,>>9.99 $".
    DEFINE VARIABLE que_empresa     LIKE Empresa.nombre.
    DEFINE VARIABLE fecha_lis       AS DATE.
    DEFINE VARIABLE hora_lis        AS CHARACTER.
    DEFINE VARIABLE titulo_det      AS CHARACTER FORMAT "X(40)".
    DEFINE VARIABLE titulo_lis      AS CHARACTER FORMAT "X(40)".
    DEFINE VARIABLE v-tipo          AS CHARACTER FORMAT "X(20)".
    
    DEFINE VARIABLE que_archivo     AS CHARACTER.
    DEFINE VARIABLE p_printed       AS LOGICAL.
    
    DEFINE FRAME frm-titulo HEADER
           que_empresa
           titulo_lis AT 37
           "Página:" AT 103 PAGE-NUMBER FORMAT ">>9" AT 111
           SKIP  
           fecha_lis       
           hora_lis AT 103
           SKIP
           titulo_det AT 37  
           SKIP(1)
           WITH WIDTH 135 FRAME frm-titulo PAGE-TOP USE-TEXT STREAM-IO.
        
    FORM
            Cupon.tip_comprob     COLUMN-LABEL "Tip!Comp"
            Cupon.prf_comprob 
            Cupon.nro_comprob 
            Cliente.cdg_cliente 
            Cliente.nom_cliente 
            Cupon.fecha_emision 
            Cupon.mes_imputa     COLUMN-LABEL "Mes!Imp" 
            Cupon.importe_cuota FORMAT "->>>,>>9.99"
            Cupon.cdg_motbaja    COLUMN-LABEL "Mot!Baja" 
            WITH WIDTH 135 DOWN FRAME frm-listado USE-TEXT STREAM-IO .
    
    fecha_lis = TODAY.
    hora_lis = STRING(TIME,"HH:MM:SS").
    
    FIND Cobrador OF T-Rendicion_hd NO-LOCK.
    FIND Empresa OF T-Rendicion_hd.
    que_empresa = Empresa.nombre.
    
    v-tipo = T-Rendicion_hd.tipo.
    CASE T-Rendicion_hd.tipo:
         WHEN "1" THEN v-tipo = "Recibos Cobrados".
         WHEN "2" THEN v-tipo = "Recibos En Mora".
         WHEN "3" THEN v-tipo = "Recibos de Baja".
         WHEN "4" THEN v-tipo = "Recibos Devueltos".
    END CASE.
    
    titulo_det =  Cobrador.cdg_cobrador + " " + Cobrador.nom_cobrador + " - " + v-tipo.
    
    titulo_lis = "Rendición de Cobradores Nro." + STRING(T-Rendicion_hd.nro_rendicion,"999999").
    que_archivo = "C:\SIC-TEMP\prinrendicion.txt".
    
    OUTPUT TO VALUE(que_archivo) PAGED.
    
    FOR EACH T-comprobante_rendicion OF T-Rendicion_hd, FIRST Cupon OF T-comprobante_rendicion NO-LOCK, FIRST Cliente NO-LOCK OF Cupon:
    
        VIEW FRAME frm-titulo.
    
        DISPLAY
            Cupon.tip_comprob 
            Cupon.prf_comprob 
            Cupon.nro_comprob 
            Cliente.cdg_cliente 
            Cliente.nom_cliente 
            Cupon.fecha_emision 
            Cupon.mes_imputa 
            Cupon.importe_cuota
            Cupon.cdg_motbaja
            WITH FRAME frm-listado USE-TEXT STREAM-IO DOWN.
            
        DOWN WITH FRAME frm-listado.
        
        total_rendicion = total_rendicion + Cupon.importe_cuota.
        total_Recibos   = total_Recibos   + 1.
    
    END.
    
    
    /*---------------------------------------------------------------------------------*/
    /*                                       PIE                                       */
    /*---------------------------------------------------------------------------------*/
    
    UNDERLINE
            Cupon.tip_comprob 
            Cupon.prf_comprob 
            Cupon.nro_comprob 
            Cliente.cdg_cliente 
            Cliente.nom_cliente 
            Cupon.fecha_emision 
            Cupon.mes_imputa 
            Cupon.importe_cuota
            Cupon.cdg_motbaja
            WITH FRAME frm-listado USE-TEXT STREAM-IO DOWN.
    
    
    DISPLAY
        "<---  TOTAL  --->"   @ Cliente.nom_cliente
        total_Recibos   @ Cupon.prf_comprob
        total_rendicion @ Cupon.importe_cuota
        WITH DOWN FRAME frm-listado USE-TEXT STREAM-IO.
        DOWN WITH DOWN FRAME frm-listado.
    
    UNDERLINE
            Cupon.tip_comprob 
            Cupon.prf_comprob 
            Cupon.nro_comprob 
            Cliente.cdg_cliente 
            Cliente.nom_cliente 
            Cupon.fecha_emision 
            Cupon.mes_imputa 
            Cupon.importe_cuota
            Cupon.cdg_motbaja
            WITH FRAME frm-listado USE-TEXT STREAM-IO DOWN.
    
    
    /*=================================================================================*/
    /*                                       FIN                                       */
    /*=================================================================================*/
    
    OUTPUT CLOSE.
    
    RUN veresult.w ( INPUT que_archivo, INPUT 22 ).

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

