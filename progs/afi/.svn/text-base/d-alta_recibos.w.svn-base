/* ***********************  Control Definitions  ********************** */

/* Define a dialog box                                                  */

/* Definitions of the field level widgets                               */
DEFINE BUTTON bVer-2 
     LABEL "Ver" 
     SIZE 10 BY 1.

DEFINE VARIABLE que_cupon AS CHARACTER FORMAT "X(14)":U 
     LABEL "Recibo Número" 
     VIEW-AS FILL-IN NATIVE 
     SIZE 29 BY 1
     BGCOLOR 14 FGCOLOR 12  NO-UNDO.

DEFINE VARIABLE v-cdg_administrador AS CHARACTER FORMAT "X(8)" 
     LABEL "Administ." 
     VIEW-AS FILL-IN NATIVE 
     SIZE 14 BY 1
     BGCOLOR 15 FGCOLOR 9 .

DEFINE VARIABLE v-dsc_administrador AS CHARACTER FORMAT "X(35)" 
     VIEW-AS FILL-IN 
     SIZE 54 BY 1
     BGCOLOR 7 FGCOLOR 15 .

DEFINE VARIABLE v-nom_cobrador AS CHARACTER FORMAT "X(256)":U 
     LABEL "Cobrador" 
     VIEW-AS FILL-IN 
     SIZE 45 BY 1
     BGCOLOR 15 FGCOLOR 9  NO-UNDO.

DEFINE RECTANGLE RECT-4
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL   
     SIZE 86 BY 4.05.

DEFINE RECTANGLE RECT-5
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL   
     SIZE 52 BY 1.43.

DEFINE RECTANGLE RECT-6
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL   
     SIZE 86 BY 1.43.

DEFINE RECTANGLE RECT-7
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL   
     SIZE 52 BY 4.05.

/* Query definitions                                                    */
&ANALYZE-SUSPEND
DEFINE QUERY BROWSE-1 FOR 
      T-comprobante_rendicion, 
      Cupon, 
      Cliente SCROLLING.

DEFINE QUERY Dialog-Frame FOR 
      T-Rendicion_hd SCROLLING.
&ANALYZE-RESUME

/* Browse definitions                                                   */
DEFINE BROWSE BROWSE-1
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _DISPLAY-FIELDS BROWSE-1 Dialog-Frame _STRUCTURED
  QUERY BROWSE-1 NO-LOCK DISPLAY
      Cupon.tip_cupon COLUMN-LABEL "Tipo!Cte." FORMAT "X(2)":U
      Cupon.prf_cupon COLUMN-LABEL "Pto!Vta" FORMAT "9999":U
      Cupon.nro_cupon FORMAT "99999999":U
      Cupon.cdg_zonag FORMAT "X(8)":U
      Cupon.importe_cuota FORMAT "->>>,>>9.99":U
      Cupon.cdg_motbaja FORMAT "X(1)":U
      Cliente.cdg_cliente FORMAT "X(8)":U WIDTH 18.6
      Cliente.nom_cliente FORMAT "X(40)":U WIDTH 54.2
/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME
    WITH NO-ROW-MARKERS SEPARATORS SIZE 138 BY 18.1
         BGCOLOR 11 FGCOLOR 9 FONT 6.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME Dialog-Frame
     T-Rendicion_hd.tipo AT ROW 1.24 COL 14 COLON-ALIGNED WIDGET-ID 2
          LABEL "Tipo"
          VIEW-AS COMBO-BOX INNER-LINES 5
          LIST-ITEM-PAIRS "Recibos COBRADOS","1  ",
                     "Recibos MOROSOS","2   ",
                     "Recibos DE BAJA","3   ",
                     "Recibos DEVUELTOS","4"
          DROP-DOWN-LIST
          SIZE 45 BY 1
          BGCOLOR 15 FGCOLOR 9 
     T-Rendicion_hd.cant_recibos AT ROW 1.24 COL 71 COLON-ALIGNED
          LABEL "Recibos"
          VIEW-AS FILL-IN 
          SIZE 12 BY 1
          BGCOLOR 15 FGCOLOR 9 FONT 6
     v-nom_cobrador AT ROW 2.43 COL 14 COLON-ALIGNED
     T-Rendicion_hd.imp_imputado AT ROW 2.43 COL 71 COLON-ALIGNED
          LABEL "Importe"
          VIEW-AS FILL-IN 
          SIZE 12 BY 1
          BGCOLOR 15 FGCOLOR 9 FONT 6
     v-cdg_administrador AT ROW 3.62 COL 14 COLON-ALIGNED
     v-dsc_administrador AT ROW 3.62 COL 29 COLON-ALIGNED HELP
          "Denominacion" NO-LABEL
     que_cupon AT ROW 5.29 COL 29 COLON-ALIGNED
     bVer-2 AT ROW 5.29 COL 75
     BROWSE-1 AT ROW 6.71 COL 1
     "F1 - Finalizar el Ingreso de Recibos" VIEW-AS TEXT
          SIZE 48 BY .62 AT ROW 2.67 COL 89
     "F4 - Eliminar un Recibo de esta Rendición" VIEW-AS TEXT
          SIZE 48 BY .62 AT ROW 5.52 COL 89
     "F2 - Listar los Recibos de la Rendición" VIEW-AS TEXT
          SIZE 48 BY .62 AT ROW 3.62 COL 89
     "F3 - Cancelar  la Rendición Actual" VIEW-AS TEXT
          SIZE 48 BY .62 AT ROW 4.57 COL 89
     "  Oprima estas teclas para estas funciones" VIEW-AS TEXT
          SIZE 50 BY 1 AT ROW 1.24 COL 88
          BGCOLOR 5 FGCOLOR 15 
     RECT-4 AT ROW 1 COL 1
     RECT-5 AT ROW 1 COL 87
     RECT-6 AT ROW 5.05 COL 1
     RECT-7 AT ROW 2.43 COL 87
     SPACE(1.99) SKIP(18.42)
    WITH VIEW-AS DIALOG-BOX KEEP-TAB-ORDER 
         SIDE-LABELS NO-UNDERLINE THREE-D  SCROLLABLE 
         FONT 6
         TITLE "Ingreso de Recibos".


