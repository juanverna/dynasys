&ANALYZE-SUSPEND _VERSION-NUMBER UIB_v8r12 GUI ADM1
&ANALYZE-RESUME
/* Connected Databases 
*/
&Scoped-define WINDOW-NAME W-Win
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CUSTOM _DEFINITIONS W-Win 
/*------------------------------------------------------------------------

  File: 

  Description: from cntnrwin.w - ADM SmartWindow Template

  Input Parameters:
      <none>

  Output Parameters:
      <none>

  History: 
          
------------------------------------------------------------------------*/
/*          This .W file was created with the Progress UIB.             */
/*----------------------------------------------------------------------*/

/* Create an unnamed pool to store all the widgets created 
     by this procedure. This is a good default which assures
     that this procedure's triggers and internal procedures 
     will execute in this procedure's storage, and that proper
     cleanup will occur on deletion of the procedure. */

CREATE WIDGET-POOL.

/* ***************************  Definitions  ************************** */

/* Parameters Definitions ---                                           */

/* Local Variable Definitions ---                                       */

{nrorelea.i}

DEFINE VARIABLE txn_activa AS LOGICAL.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-PREPROCESSOR-BLOCK 

/* ********************  Preprocessor Definitions  ******************** */

&Scoped-define PROCEDURE-TYPE SmartWindow
&Scoped-define DB-AWARE no

&Scoped-define ADM-CONTAINER WINDOW

/* Name of first Frame and/or Browse and/or first Query                 */
&Scoped-define FRAME-NAME F-Main

/* Standard List Definitions                                            */
&Scoped-Define ENABLED-OBJECTS Btn_Done RECT-1 

/* Custom List Definitions                                              */
/* List-1,List-2,List-3,List-4,List-5,List-6                            */

/* _UIB-PREPROCESSOR-BLOCK-END */
&ANALYZE-RESUME



/* ***********************  Control Definitions  ********************** */

/* Define the widget handle for the window                              */
DEFINE VAR W-Win AS WIDGET-HANDLE NO-UNDO.

/* Menu Definitions                                                     */
DEFINE MENU MENU-BAR-W-Win MENUBAR
       MENU-ITEM m_Archivo      LABEL "&Archivo"      .


/* Definitions of handles for SmartObjects                              */
DEFINE VARIABLE h_b-afiliados AS HANDLE NO-UNDO.
DEFINE VARIABLE h_b-cobertura_int AS HANDLE NO-UNDO.
DEFINE VARIABLE h_b-consumo-medicamentos AS HANDLE NO-UNDO.
DEFINE VARIABLE h_b-consumo-nomenclador AS HANDLE NO-UNDO.
DEFINE VARIABLE h_b-ctacte-cli-afi AS HANDLE NO-UNDO.
DEFINE VARIABLE h_b-domicilios AS HANDLE NO-UNDO.
DEFINE VARIABLE h_b-grupofam AS HANDLE NO-UNDO.
DEFINE VARIABLE h_b-hst-domicilio AS HANDLE NO-UNDO.
DEFINE VARIABLE h_b-hst-grupofam AS HANDLE NO-UNDO.
DEFINE VARIABLE h_folder AS HANDLE NO-UNDO.
DEFINE VARIABLE h_p-navico AS HANDLE NO-UNDO.
DEFINE VARIABLE h_p-updspa AS HANDLE NO-UNDO.
DEFINE VARIABLE h_p-updspa-2 AS HANDLE NO-UNDO.
DEFINE VARIABLE h_p-updspa-3 AS HANDLE NO-UNDO.
DEFINE VARIABLE h_p-updspa-4 AS HANDLE NO-UNDO.
DEFINE VARIABLE h_p-updspa-5 AS HANDLE NO-UNDO.
DEFINE VARIABLE h_q-empresa AS HANDLE NO-UNDO.
DEFINE VARIABLE h_q-grupocliente AS HANDLE NO-UNDO.
DEFINE VARIABLE h_v-afiliados AS HANDLE NO-UNDO.
DEFINE VARIABLE h_v-cobertura_int AS HANDLE NO-UNDO.
DEFINE VARIABLE h_v-ctacte-afi AS HANDLE NO-UNDO.
DEFINE VARIABLE h_v-domicilio AS HANDLE NO-UNDO.
DEFINE VARIABLE h_v-empresa AS HANDLE NO-UNDO.
DEFINE VARIABLE h_v-grupofam AS HANDLE NO-UNDO.
DEFINE VARIABLE h_v-hst-domicilio AS HANDLE NO-UNDO.
DEFINE VARIABLE h_v-hst-observacion AS HANDLE NO-UNDO.
DEFINE VARIABLE h_v-id-afiliado AS HANDLE NO-UNDO.
DEFINE VARIABLE h_v-id-afiliado-2 AS HANDLE NO-UNDO.

/* Definitions of the field level widgets                               */
DEFINE BUTTON Btn_Done DEFAULT 
     LABEL "&Salir" 
     SIZE 11 BY 1.1
     BGCOLOR 8 .

DEFINE RECTANGLE RECT-1
     EDGE-PIXELS 4 GRAPHIC-EDGE  NO-FILL 
     SIZE 14 BY 1.62.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME F-Main
     Btn_Done AT ROW 1.52 COL 101
     RECT-1 AT ROW 1.29 COL 99
    WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY 
         SIDE-LABELS NO-UNDERLINE THREE-D 
         AT COL 1 ROW 1
         SIZE 154.6 BY 21.24.


/* *********************** Procedure Settings ************************ */

&ANALYZE-SUSPEND _PROCEDURE-SETTINGS
/* Settings for THIS-PROCEDURE
   Type: SmartWindow
   Allow: Basic,Browse,DB-Fields,Query,Smart,Window
   Design Page: 2
   Other Settings: COMPILE
 */
&ANALYZE-RESUME _END-PROCEDURE-SETTINGS

/* *************************  Create Window  ************************** */

&ANALYZE-SUSPEND _CREATE-WINDOW
IF SESSION:DISPLAY-TYPE = "GUI":U THEN
  CREATE WINDOW W-Win ASSIGN
         HIDDEN             = YES
         TITLE              = "Mantenimiento de Grupos Familiares"
         HEIGHT             = 21.24
         WIDTH              = 154.6
         MAX-HEIGHT         = 21.62
         MAX-WIDTH          = 154.6
         VIRTUAL-HEIGHT     = 21.62
         VIRTUAL-WIDTH      = 154.6
         RESIZE             = no
         SCROLL-BARS        = no
         STATUS-AREA        = no
         BGCOLOR            = ?
         FGCOLOR            = ?
         THREE-D            = yes
         MESSAGE-AREA       = no
         SENSITIVE          = yes.
ELSE {&WINDOW-NAME} = CURRENT-WINDOW.

ASSIGN {&WINDOW-NAME}:MENUBAR    = MENU MENU-BAR-W-Win:HANDLE.
/* END WINDOW DEFINITION                                                */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CUSTOM _INCLUDED-LIB W-Win 
/* ************************* Included-Libraries *********************** */

{src/adm/method/containr.i}

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME




/* ***********  Runtime Attributes and AppBuilder Settings  *********** */

&ANALYZE-SUSPEND _RUN-TIME-ATTRIBUTES
/* SETTINGS FOR WINDOW W-Win
  VISIBLE,,RUN-PERSISTENT                                               */
/* SETTINGS FOR FRAME F-Main
                                                                        */
IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(W-Win)
THEN W-Win:HIDDEN = yes.

/* _RUN-TIME-ATTRIBUTES-END */
&ANALYZE-RESUME

 



/* ************************  Control Triggers  ************************ */

&Scoped-define SELF-NAME W-Win
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL W-Win W-Win
ON END-ERROR OF W-Win /* Mantenimiento de Grupos Familiares */
OR ENDKEY OF {&WINDOW-NAME} ANYWHERE DO:
  /* This case occurs when the user presses the "Esc" key.
     In a persistently run window, just ignore this.  If we did not, the
     application would exit. */
  IF THIS-PROCEDURE:PERSISTENT THEN RETURN NO-APPLY.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL W-Win W-Win
ON WINDOW-CLOSE OF W-Win /* Mantenimiento de Grupos Familiares */
DO:
  /* This ADM code must be left here in order for the SmartWindow
     and its descendents to terminate properly on exit. */


  RUN verificar_txn ( OUTPUT txn_activa ).
  IF NOT txn_activa
  THEN DO: 
        APPLY "CLOSE":U TO THIS-PROCEDURE.
  END.

  RETURN NO-APPLY.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL W-Win W-Win
ON WINDOW-MINIMIZED OF W-Win /* Mantenimiento de Grupos Familiares */
DO:
  RUN get-attribute ('ADM-TRANSACTION').
  IF RETURN-VALUE = "YES"
  THEN DO:
       MESSAGE "No debe minimizar esta ventana con una actualización pendiente"
               VIEW-AS ALERT-BOX WARNING TITLE "CUIDADO!!!".
       RETURN NO-APPLY.
       {&WINDOW-NAME}:WINDOW-STATE = 1.
  END.
  
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME Btn_Done
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL Btn_Done W-Win
ON CHOOSE OF Btn_Done IN FRAME F-Main /* Salir */
DO:
  RUN verificar_txn ( OUTPUT txn_activa ).
  IF NOT txn_activa
  THEN DO: 
  &IF DEFINED (adm-panel) <> 0 &THEN
      RUN dispatch IN THIS-PROCEDURE ('exit').
  &ELSE
      APPLY "CLOSE":U TO THIS-PROCEDURE.
  &ENDIF
  END.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&UNDEFINE SELF-NAME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CUSTOM _MAIN-BLOCK W-Win 


/* ***************************  Main Block  *************************** */

/* Include custom  Main Block code for SmartWindows. */
{src/adm/template/windowmn.i}

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


/* **********************  Internal Procedures  *********************** */

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE adm-create-objects W-Win  _ADM-CREATE-OBJECTS
PROCEDURE adm-create-objects :
/*------------------------------------------------------------------------------
  Purpose:     Create handles for all SmartObjects used in this procedure.
               After SmartObjects are initialized, then SmartLinks are added.
  Parameters:  <none>
------------------------------------------------------------------------------*/
  DEFINE VARIABLE adm-current-page  AS INTEGER NO-UNDO.

  RUN get-attribute IN THIS-PROCEDURE ('Current-Page':U).
  ASSIGN adm-current-page = INTEGER(RETURN-VALUE).

  CASE adm-current-page: 

    WHEN 0 THEN DO:
       RUN init-object IN THIS-PROCEDURE (
             INPUT  'v-id-empresa.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Layout = ':U ,
             OUTPUT h_v-empresa ).
       RUN set-position IN h_v-empresa ( 1.29 , 2.00 ) NO-ERROR.
       /* Size in UIB:  ( 1.43 , 57.00 ) */

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'adm/objects/p-navico.r':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Edge-Pixels = 2,
                     SmartPanelType = NAV-ICON,
                     Right-to-Left = First-On-Left':U ,
             OUTPUT h_p-navico ).
       RUN set-position IN h_p-navico ( 1.29 , 52.00 ) NO-ERROR.
       RUN set-size IN h_p-navico ( 1.33 , 31.00 ) NO-ERROR.

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'b-grupofam.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Layout = ':U ,
             OUTPUT h_b-grupofam ).
       RUN set-position IN h_b-grupofam ( 3.43 , 2.00 ) NO-ERROR.
       RUN set-size IN h_b-grupofam ( 18.05 , 23.00 ) NO-ERROR.

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'adm/objects/folder.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'FOLDER-LABELS = ':U + 'Grupos|Domicilios|Afiliados|Hs.Grupos|Hs.Dom.|Cta.Cte.|Cob.Int.|Consumos' + ',
                     FOLDER-TAB-TYPE = 2':U ,
             OUTPUT h_folder ).
       RUN set-position IN h_folder ( 3.43 , 26.00 ) NO-ERROR.
       RUN set-size IN h_folder ( 18.29 , 104.00 ) NO-ERROR.

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'q-empresa.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  '':U ,
             OUTPUT h_q-empresa ).
       RUN set-position IN h_q-empresa ( 1.00 , 86.00 ) NO-ERROR.
       /* Size in UIB:  ( 1.76 , 8.20 ) */

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'q-grupocliente.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  '':U ,
             OUTPUT h_q-grupocliente ).
       RUN set-position IN h_q-grupocliente ( 1.29 , 90.00 ) NO-ERROR.
       /* Size in UIB:  ( 1.76 , 8.20 ) */

       /* Links to SmartViewer h_v-empresa. */
       RUN add-link IN adm-broker-hdl ( h_q-empresa , 'Record':U , h_v-empresa ).

       /* Links to SmartBrowser h_b-grupofam. */
       RUN add-link IN adm-broker-hdl ( h_q-empresa , 'Record':U , h_b-grupofam ).

       /* Links to SmartFolder h_folder. */
       RUN add-link IN adm-broker-hdl ( h_folder , 'Page':U , THIS-PROCEDURE ).

       /* Links to SmartQuery h_q-empresa. */
       RUN add-link IN adm-broker-hdl ( h_p-navico , 'Navigation':U , h_q-empresa ).

       /* Links to SmartQuery h_q-grupocliente. */
       RUN add-link IN adm-broker-hdl ( h_b-grupofam , 'Record':U , h_q-grupocliente ).

    END. /* Page 0 */

    WHEN 1 THEN DO:
       RUN init-object IN THIS-PROCEDURE (
             INPUT  'v-grupofam.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Layout = ':U ,
             OUTPUT h_v-grupofam ).
       RUN set-position IN h_v-grupofam ( 5.05 , 29.00 ) NO-ERROR.
       /* Size in UIB:  ( 13.14 , 83.00 ) */

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'p-updspa.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Edge-Pixels = 2,
                     SmartPanelType = Update-Trans,
                     AddFunction = One-Record':U ,
             OUTPUT h_p-updspa ).
       RUN set-position IN h_p-updspa ( 18.52 , 29.00 ) NO-ERROR.
       RUN set-size IN h_p-updspa ( 2.43 , 83.00 ) NO-ERROR.

       /* Links to SmartViewer h_v-grupofam. */
       RUN add-link IN adm-broker-hdl ( h_b-grupofam , 'Record':U , h_v-grupofam ).
       RUN add-link IN adm-broker-hdl ( h_p-updspa , 'TableIO':U , h_v-grupofam ).

    END. /* Page 1 */

    WHEN 2 THEN DO:
       RUN init-object IN THIS-PROCEDURE (
             INPUT  'b-domicilios.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Layout = ':U ,
             OUTPUT h_b-domicilios ).
       RUN set-position IN h_b-domicilios ( 5.86 , 32.00 ) NO-ERROR.
       RUN set-size IN h_b-domicilios ( 10.24 , 12.00 ) NO-ERROR.

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'v-domicilio.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Layout = ':U ,
             OUTPUT h_v-domicilio ).
       RUN set-position IN h_v-domicilio ( 5.86 , 45.00 ) NO-ERROR.
       /* Size in UIB:  ( 10.24 , 69.00 ) */

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'p-updspa.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Edge-Pixels = 2,
                     SmartPanelType = Update-Trans,
                     AddFunction = One-Record':U ,
             OUTPUT h_p-updspa-2 ).
       RUN set-position IN h_p-updspa-2 ( 16.33 , 32.00 ) NO-ERROR.
       RUN set-size IN h_p-updspa-2 ( 2.14 , 74.00 ) NO-ERROR.

       /* Links to SmartBrowser h_b-domicilios. */
       RUN add-link IN adm-broker-hdl ( h_b-grupofam , 'Record':U , h_b-domicilios ).

       /* Links to SmartViewer h_v-domicilio. */
       RUN add-link IN adm-broker-hdl ( h_b-domicilios , 'Record':U , h_v-domicilio ).
       RUN add-link IN adm-broker-hdl ( h_p-updspa-2 , 'TableIO':U , h_v-domicilio ).

    END. /* Page 2 */

    WHEN 3 THEN DO:
       RUN init-object IN THIS-PROCEDURE (
             INPUT  'b-afiliados.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Layout = ':U ,
             OUTPUT h_b-afiliados ).
       RUN set-position IN h_b-afiliados ( 5.33 , 29.00 ) NO-ERROR.
       RUN set-size IN h_b-afiliados ( 13.19 , 13.00 ) NO-ERROR.

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'v-afiliados.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Layout = ':U ,
             OUTPUT h_v-afiliados ).
       RUN set-position IN h_v-afiliados ( 5.33 , 44.00 ) NO-ERROR.
       /* Size in UIB:  ( 13.19 , 67.00 ) */

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'p-updspa.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Edge-Pixels = 2,
                     SmartPanelType = Update-Trans,
                     AddFunction = One-Record':U ,
             OUTPUT h_p-updspa-3 ).
       RUN set-position IN h_p-updspa-3 ( 18.76 , 29.00 ) NO-ERROR.
       RUN set-size IN h_p-updspa-3 ( 2.05 , 82.00 ) NO-ERROR.

       /* Links to SmartBrowser h_b-afiliados. */
       RUN add-link IN adm-broker-hdl ( h_b-grupofam , 'Record':U , h_b-afiliados ).

       /* Links to SmartViewer h_v-afiliados. */
       RUN add-link IN adm-broker-hdl ( h_b-afiliados , 'Record':U , h_v-afiliados ).
       RUN add-link IN adm-broker-hdl ( h_p-updspa-3 , 'TableIO':U , h_v-afiliados ).

    END. /* Page 3 */

    WHEN 4 THEN DO:
       RUN init-object IN THIS-PROCEDURE (
             INPUT  'b-hst-grupofam.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Layout = ':U ,
             OUTPUT h_b-hst-grupofam ).
       RUN set-position IN h_b-hst-grupofam ( 5.05 , 30.00 ) NO-ERROR.
       RUN set-size IN h_b-hst-grupofam ( 8.62 , 80.00 ) NO-ERROR.

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'v-hst-observacion.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Layout = ':U ,
             OUTPUT h_v-hst-observacion ).
       RUN set-position IN h_v-hst-observacion ( 14.19 , 30.00 ) NO-ERROR.
       /* Size in UIB:  ( 5.76 , 81.00 ) */

       /* Links to SmartBrowser h_b-hst-grupofam. */
       RUN add-link IN adm-broker-hdl ( h_b-grupofam , 'Record':U , h_b-hst-grupofam ).

       /* Links to SmartViewer h_v-hst-observacion. */
       RUN add-link IN adm-broker-hdl ( h_b-hst-grupofam , 'Record':U , h_v-hst-observacion ).

    END. /* Page 4 */

    WHEN 5 THEN DO:
       RUN init-object IN THIS-PROCEDURE (
             INPUT  'b-hst-domicilio.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Layout = ':U ,
             OUTPUT h_b-hst-domicilio ).
       RUN set-position IN h_b-hst-domicilio ( 5.05 , 30.00 ) NO-ERROR.
       RUN set-size IN h_b-hst-domicilio ( 4.57 , 82.00 ) NO-ERROR.

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'v-hst-domicilio.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Layout = ':U ,
             OUTPUT h_v-hst-domicilio ).
       RUN set-position IN h_v-hst-domicilio ( 10.14 , 43.00 ) NO-ERROR.
       /* Size in UIB:  ( 10.24 , 60.00 ) */

       /* Initialize other pages that this page requires. */
       RUN init-pages IN THIS-PROCEDURE ('4') NO-ERROR.

       /* Links to SmartBrowser h_b-hst-domicilio. */
       RUN add-link IN adm-broker-hdl ( h_b-hst-grupofam , 'Record':U , h_b-hst-domicilio ).

       /* Links to SmartViewer h_v-hst-domicilio. */
       RUN add-link IN adm-broker-hdl ( h_b-hst-domicilio , 'Record':U , h_v-hst-domicilio ).

    END. /* Page 5 */

    WHEN 6 THEN DO:
       RUN init-object IN THIS-PROCEDURE (
             INPUT  'b-ctacte-cli-afi.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Layout = ':U ,
             OUTPUT h_b-ctacte-cli-afi ).
       RUN set-position IN h_b-ctacte-cli-afi ( 5.05 , 28.00 ) NO-ERROR.
       RUN set-size IN h_b-ctacte-cli-afi ( 12.38 , 84.00 ) NO-ERROR.

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'v-ctacte-afi.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Layout = ':U ,
             OUTPUT h_v-ctacte-afi ).
       RUN set-position IN h_v-ctacte-afi ( 17.67 , 28.00 ) NO-ERROR.
       /* Size in UIB:  ( 1.33 , 85.00 ) */

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'p-updspa.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Edge-Pixels = 2,
                     SmartPanelType = Update-Trans,
                     AddFunction = One-Record':U ,
             OUTPUT h_p-updspa-4 ).
       RUN set-position IN h_p-updspa-4 ( 19.33 , 28.00 ) NO-ERROR.
       RUN set-size IN h_p-updspa-4 ( 1.76 , 84.00 ) NO-ERROR.

       /* Links to SmartBrowser h_b-ctacte-cli-afi. */
       RUN add-link IN adm-broker-hdl ( h_q-grupocliente , 'Record':U , h_b-ctacte-cli-afi ).

       /* Links to SmartViewer h_v-ctacte-afi. */
       RUN add-link IN adm-broker-hdl ( h_b-ctacte-cli-afi , 'Record':U , h_v-ctacte-afi ).
       RUN add-link IN adm-broker-hdl ( h_p-updspa-4 , 'TableIO':U , h_v-ctacte-afi ).

    END. /* Page 6 */

    WHEN 7 THEN DO:
       RUN init-object IN THIS-PROCEDURE (
             INPUT  'v-id-afiliado.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Layout = ':U ,
             OUTPUT h_v-id-afiliado ).
       RUN set-position IN h_v-id-afiliado ( 5.33 , 27.20 ) NO-ERROR.
       /* Size in UIB:  ( 1.38 , 82.00 ) */

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'b-cobertura_int.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Layout = ':U ,
             OUTPUT h_b-cobertura_int ).
       RUN set-position IN h_b-cobertura_int ( 7.19 , 28.00 ) NO-ERROR.
       RUN set-size IN h_b-cobertura_int ( 7.52 , 25.00 ) NO-ERROR.

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'v-cobertura_int.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Layout = ':U ,
             OUTPUT h_v-cobertura_int ).
       RUN set-position IN h_v-cobertura_int ( 7.19 , 55.00 ) NO-ERROR.
       /* Size in UIB:  ( 2.95 , 54.00 ) */

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'p-updspa.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Edge-Pixels = 2,
                     SmartPanelType = Update-Trans,
                     AddFunction = One-Record':U ,
             OUTPUT h_p-updspa-5 ).
       RUN set-position IN h_p-updspa-5 ( 11.52 , 55.00 ) NO-ERROR.
       RUN set-size IN h_p-updspa-5 ( 3.24 , 54.00 ) NO-ERROR.

       /* Initialize other pages that this page requires. */
       RUN init-pages IN THIS-PROCEDURE ('3') NO-ERROR.

       /* Links to SmartViewer h_v-id-afiliado. */
       RUN add-link IN adm-broker-hdl ( h_b-afiliados , 'Record':U , h_v-id-afiliado ).

       /* Links to SmartBrowser h_b-cobertura_int. */
       RUN add-link IN adm-broker-hdl ( h_b-afiliados , 'Record':U , h_b-cobertura_int ).

       /* Links to SmartViewer h_v-cobertura_int. */
       RUN add-link IN adm-broker-hdl ( h_b-cobertura_int , 'Record':U , h_v-cobertura_int ).
       RUN add-link IN adm-broker-hdl ( h_p-updspa-5 , 'TableIO':U , h_v-cobertura_int ).

    END. /* Page 7 */

    WHEN 8 THEN DO:
       RUN init-object IN THIS-PROCEDURE (
             INPUT  'v-id-afiliado.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  'Layout = ':U ,
             OUTPUT h_v-id-afiliado-2 ).
       RUN set-position IN h_v-id-afiliado-2 ( 4.76 , 29.00 ) NO-ERROR.
       /* Size in UIB:  ( 1.38 , 82.00 ) */

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'b-consumo-medicamentos.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  '':U ,
             OUTPUT h_b-consumo-medicamentos ).
       /* Position in AB:  ( 6.38 , 29.00 ) */
       /* Size in UIB:  ( 7.52 , 82.00 ) */

       RUN init-object IN THIS-PROCEDURE (
             INPUT  'b-consumo-nomenclador.w':U ,
             INPUT  FRAME F-Main:HANDLE ,
             INPUT  '':U ,
             OUTPUT h_b-consumo-nomenclador ).
       /* Position in AB:  ( 14.19 , 29.00 ) */
       /* Size in UIB:  ( 6.67 , 81.00 ) */

       /* Initialize other pages that this page requires. */
       RUN init-pages IN THIS-PROCEDURE ('3') NO-ERROR.

       /* Links to SmartViewer h_v-id-afiliado-2. */
       RUN add-link IN adm-broker-hdl ( h_b-afiliados , 'Record':U , h_v-id-afiliado-2 ).

       /* Links to  h_b-consumo-medicamentos. */
       RUN add-link IN adm-broker-hdl ( h_b-afiliados , 'Record':U , h_b-consumo-medicamentos ).

       /* Links to  h_b-consumo-nomenclador. */
       RUN add-link IN adm-broker-hdl ( h_b-afiliados , 'Record':U , h_b-consumo-nomenclador ).

       /* Adjust the tab order of the smart objects. */
    END. /* Page 8 */

  END CASE.
  /* Select a Startup page. */
  IF adm-current-page eq 0 
  THEN RUN select-page IN THIS-PROCEDURE ( 1 ).

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE adm-row-available W-Win  _ADM-ROW-AVAILABLE
PROCEDURE adm-row-available :
/*------------------------------------------------------------------------------
  Purpose:     Dispatched to this procedure when the Record-
               Source has a new row available.  This procedure
               tries to get the new row (or foriegn keys) from
               the Record-Source and process it.
  Parameters:  <none>
------------------------------------------------------------------------------*/

  /* Define variables needed by this internal procedure.             */
  {src/adm/template/row-head.i}

  /* Process the newly available records (i.e. display fields,
     open queries, and/or pass records on to any RECORD-TARGETS).    */
  {src/adm/template/row-end.i}

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE disable_UI W-Win  _DEFAULT-DISABLE
PROCEDURE disable_UI :
/*------------------------------------------------------------------------------
  Purpose:     DISABLE the User Interface
  Parameters:  <none>
  Notes:       Here we clean-up the user-interface by deleting
               dynamic widgets we have created and/or hide 
               frames.  This procedure is usually called when
               we are ready to "clean-up" after running.
------------------------------------------------------------------------------*/
  /* Delete the WINDOW we created */
  IF SESSION:DISPLAY-TYPE = "GUI":U AND VALID-HANDLE(W-Win)
  THEN DELETE WIDGET W-Win.
  IF THIS-PROCEDURE:PERSISTENT THEN DELETE PROCEDURE THIS-PROCEDURE.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE enable_UI W-Win  _DEFAULT-ENABLE
PROCEDURE enable_UI :
/*------------------------------------------------------------------------------
  Purpose:     ENABLE the User Interface
  Parameters:  <none>
  Notes:       Here we display/view/enable the widgets in the
               user-interface.  In addition, OPEN all queries
               associated with each FRAME and BROWSE.
               These statements here are based on the "Other 
               Settings" section of the widget Property Sheets.
------------------------------------------------------------------------------*/
  ENABLE Btn_Done RECT-1 
      WITH FRAME F-Main IN WINDOW W-Win.
  {&OPEN-BROWSERS-IN-QUERY-F-Main}
  VIEW W-Win.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-exit W-Win 
PROCEDURE local-exit :
/* -----------------------------------------------------------
  Purpose:  Starts an "exit" by APPLYing CLOSE event, which starts "destroy".
  Parameters:  <none>
  Notes:    If activated, should APPLY CLOSE, *not* dispatch adm-exit.   
-------------------------------------------------------------*/

  RUN verificar_txn ( OUTPUT txn_activa ).
  IF txn_activa
  THEN DO:
       RETURN NO-APPLY.
  END.     
  ELSE DO:
       APPLY "CLOSE":U TO THIS-PROCEDURE.
       RETURN.
  END.     

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-view W-Win 
PROCEDURE local-view :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'view':U ) .

  /* Code placed here will execute AFTER standard behavior.    */

  {setwintit.i "SIC/AFI"  "Mantenimiento de Grupos Familiares"}

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE send-records W-Win  _ADM-SEND-RECORDS
PROCEDURE send-records :
/*------------------------------------------------------------------------------
  Purpose:     Send record ROWID's for all tables used by
               this file.
  Parameters:  see template/snd-head.i
------------------------------------------------------------------------------*/

  /* SEND-RECORDS does nothing because there are no External
     Tables specified for this SmartWindow, and there are no
     tables specified in any contained Browse, Query, or Frame. */

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE set-estado-folders W-Win 
PROCEDURE set-estado-folders :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/
    DEFINE INPUT PARAMETER p-operacion AS CHARACTER.
/**/
    DEFINE VARIABLE folder-labels AS CHARACTER.
    DEFINE VARIABLE page-hdl      AS CHARACTER.
    DEFINE VARIABLE j-pagina      AS INTEGER.

    RUN get-attribute IN h_folder ('FOLDER-LABELS':U).
    ASSIGN folder-labels   = IF RETURN-VALUE = ? THEN "":U
                             ELSE RETURN-VALUE.

    RUN get-link-handle IN adm-broker-hdl
                      (THIS-PROCEDURE, 'PAGE-TARGET',OUTPUT page-hdl).

    DO j-pagina = 1 TO NUM-ENTRIES(folder-labels,'|':U):                             

/*
       IF p-operacion = "HABILITAR"
          THEN RUN enable-folder-page  IN WIDGET-HANDLE(page-hdl) (j-pagina).
          ELSE RUN disable-folder-page IN WIDGET-HANDLE(page-hdl) (j-pagina).
*/
       IF p-operacion = "HABILITAR"
          THEN RUN enable-folder-page  IN h_folder (j-pagina).
          ELSE RUN disable-folder-page IN h_folder (j-pagina).

    END.
/**/
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE state-changed W-Win 
PROCEDURE state-changed :
/* -----------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
-------------------------------------------------------------*/
  DEFINE INPUT PARAMETER p-issuer-hdl AS HANDLE NO-UNDO.
  DEFINE INPUT PARAMETER p-state AS CHARACTER NO-UNDO.
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE verificar_txn W-Win 
PROCEDURE verificar_txn :
/*------------------------------------------------------------------------------
  Purpose:     
  Parameters:  <none>
  Notes:       
------------------------------------------------------------------------------*/

  DEFINE OUTPUT PARAMETER p-estado AS LOGICAL.

  RUN get-attribute ('ADM-TRANSACTION').
  IF RETURN-VALUE = "YES"
  THEN DO:
       MESSAGE "No puede salir de esta pantalla con una actualización pendiente"
               VIEW-AS ALERT-BOX ERROR.
       p-estado = YES.
  END.
  ELSE DO:
       p-estado = NO.   /* Function return value. */
  END.
  
END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

