&ANALYZE-SUSPEND _UIB-CODE-BLOCK _PROCEDURE local-assign-statement V-table-Win 
PROCEDURE local-assign-statement :
/*------------------------------------------------------------------------------
  Purpose:     Override standard ADM method
  Notes:       
------------------------------------------------------------------------------*/

  /* Code placed here will execute PRIOR to standard behavior. */

  DEFINE VARIABLE hubo_error AS LOGICAL INITIAL NO. 
  DEFINE BUFFER B-Cobrador_ptovta FOR Cobrador_ptovta.


  RUN valida_empresa.p (INPUT  INPUT FRAME {&FRAME-NAME} Cobrador_ptovta.cdg_empresa,
                        INPUT  hubo_error,
                        OUTPUT hubo_error).

  RUN valida_ptovta.p (INPUT  INPUT FRAME {&FRAME-NAME} Cobrador_ptovta.cdg_empresa,
                       INPUT  INPUT FRAME {&FRAME-NAME} Cobrador_ptovta.cdg_puntovta,
                       INPUT  hubo_error,
                       OUTPUT hubo_error).

  IF CAN-FIND(FIRST B-Cobrador_ptovta
                     WHERE B-Cobrador_ptovta.cdg_empresa  = INPUT FRAME {&FRAME-NAME} Cobrador_ptovta.cdg_empresa
                       AND B-Cobrador_ptovta.cdg_puntovta = INPUT FRAME {&FRAME-NAME} Cobrador_ptovta.cdg_puntovta
                       AND ROWID(B-Cobrador_ptovta) <> ROWID(Cobrador_ptovta))
  THEN DO:
       RUN PONMENSJ.P (INPUT "PTVT002").
       hubo_error = YES.
  END.

  IF hubo_error THEN
      RETURN ERROR.

  /* Dispatch standard ADM method.                             */
  RUN dispatch IN THIS-PROCEDURE ( INPUT 'assign-statement':U ) .

  /* Code placed here will execute AFTER standard behavior.    */

  Cobrador_ptovta.nro_cobrador = Cobrador.nro_cobrador.

END PROCEDURE.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

