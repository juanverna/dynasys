 2  662     PROCEDURE set-position :
 2  663     /* -----------------------------------------------------------
 2  664       Purpose:     Moves an object to a specified position.
 2  665       Parameters:  ROW and COLUMN 
 2  666       Notes:       
 2  667     -------------------------------------------------------------*/
 2  668       
 2  669         DEFINE INPUT PARAMETER p-row    AS DECIMAL NO-UNDO.
 2  670         DEFINE INPUT PARAMETER p-col    AS DECIMAL NO-UNDO.
 2  671     
 2  672         IF VALID-HANDLE(adm-object-hdl) THEN
 2  673   1     DO:     
 2  674           /* If this is a Window or a Dialog box which is being position
 2  674   1 ed,
 2  675   1          then the special value 0 means to center the object in that
 2  676              dimension (0,0 means center on the screen - 0 can be used t
 2  676   1 o
 2  677              signal this because 0 is an invalid row or column position)
 2  677   1 . */
 2  678   1       &IF "{&ADM-CONTAINER}":U NE "":U &THEN
 2  679   1         DEFINE VARIABLE parent-hdl AS HANDLE NO-UNDO.
 2  680   1         IF adm-object-hdl:TYPE = "WINDOW":U THEN
 2  681   1         DO:
 2  682   1           IF p-row = 0 THEN p-row = 
 2  683                 (SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 2
 2  683   1 .
 2  684   1           IF p-col = 0 THEN p-col = 
 2  685   1             (SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2.
 2  686   1         END.
 2  687             /* A Dialog naturally centers on its parent and positions re
 2  687   1 lative
 2  688   1            to its parent, so we must adjust for that. */
 2  689   1         ELSE IF adm-object-hdl:TYPE = "DIALOG-BOX":U THEN
 2  690   1         DO:
 2  691   1           parent-hdl = adm-object-hdl:PARENT.
 2  692   1           IF p-row = 0 THEN p-row = 
 2  693                 ((SESSION:HEIGHT-CHARS - adm-object-hdl:HEIGHT-CHARS) / 
 2  693   1 2) -
 2  694   1               parent-hdl:ROW.
 2  695   1           IF p-col = 0 THEN p-col = 
 2  696                 ((SESSION:WIDTH-CHARS - adm-object-hdl:WIDTH-CHARS) / 2)
 2  696   1  -
 2  697   1               parent-hdl:COL.
 2  698   1         END.
 2  699             /* If the row or column wound up being between 0 and 1 after
 2  699   1  the 
 2  700                calculation, change it, because otherwise Progress will c
 2  700   1 omplain. */
 2  701   1         IF p-row GE 0 AND p-row < 1 THEN p-row = 1.
 2  702   1         IF p-col GE 0 AND p-col < 1 THEN p-col = 1.
 2  703   1       &ENDIF
