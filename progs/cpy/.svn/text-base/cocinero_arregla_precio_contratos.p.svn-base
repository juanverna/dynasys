     DEFINE VAR p-has_fecha AS DATE NO-UNDO.
    DEFINE VAR p-des_fecha AS DATE NO-UNDO.
    DEFINE VAR p-fecha AS DATE NO-UNDO. 
    DEFINE VAR p-des_punto AS int NO-UNDO INITIAL 1.
    DEFINE VAR flag AS LOGICAL .
    p-fecha = today.
    UPDATE p-fecha LABEL "Desde fecha Creacion cliente" 
    p-des_fecha = p-fecha.
    p-has_fecha = 01/01/3000.


FOR EACH Contrato_hd 
    WHERE contrato_hd.estado = "A" AND ( Contrato_hd.rige_desde <= p-has_fecha  
      AND Contrato_hd.rige_hasta >= p-des_fecha ) 
      AND Contrato_hd.cant_periodos = 0  
      AND Contrato_hd.prf_contrato >= p-des_punto AND anulado = FALSE:

      flag = FALSE.
      FOR EACH contrato_dt OF contrato_hd:
        FIND articulo OF contrato_dt.
        flag = flag OR LOOKUP(articulo.cdg_articulo,"36,33,26,26,08,20,15,22,23,21,13,14,07,12,34" ) <> 0.
        IF flag THEN NEXT.
      END.
      IF flag THEN NEXT.

      ASSIGN        Contrato_hd.imp_bruto = 0
                    Contrato_hd.imp_iva = 0
                    Contrato_hd.imp_neto = 0
                    Contrato_hd.imp_total = 0.
    

    contrato_hd.prf_contrato = 1.
    
    FOR EACH contrato_dt OF contrato_hd:
        IF contrato_hd.cdg_condiva = 1 THEN DO: /*es una A*/
                    ASSIGN     
                        contrato_dt.precio = round( contrato_dt.precio , 2 ).
                END.
                ELSE DO:
                        ASSIGN 
                            contrato_dt.precio = IF contrato_hd.prf_contrato = 1 THEN ROUND(contrato_dt.subtotal_gral, 0 ) / 1.21 
                            ELSE ROUND(contrato_dt.subtotal_gral, 0 ).
                END.
        ASSIGN
                contrato_dt.precio_cf = ROUND( contrato_dt.precio * (IF contrato_hd.prf_contrato = 1 THEN 1.21 ELSE 1) , IF contrato_hd.cdg_condiva = 1 THEN 2 ELSE 0) 
                contrato_dt.subtotal_bruto = contrato_dt.precio
                contrato_dt.subtotal_bruto_cf = contrato_dt.precio_cf
                contrato_dt.subtotal_neto_cf = contrato_dt.precio_cf
                contrato_dt.subtotal_gral = contrato_dt.subtotal_bruto_cf
                contrato_dt.subtotal_neto = contrato_dt.precio
                contrato_dt.subtotal_neto_cf = contrato_dt.precio_cf
                contrato_hd.imp_bruto = contrato_hd.imp_bruto + contrato_dt.subtotal_bruto
                contrato_hd.imp_iva = contrato_hd.imp_iva + contrato_dt.precio_cf - contrato_dt.precio
                contrato_hd.imp_neto = contrato_hd.imp_neto + contrato_dt.subtotal_neto
                contrato_hd.imp_total = contrato_hd.imp_total + contrato_dt.subtotal_gral.
    END.
END.

