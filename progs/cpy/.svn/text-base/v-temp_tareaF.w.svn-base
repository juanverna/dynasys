&ANALYZE-RESUME

/* ************************  Function Implementations ***************** */

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _FUNCTION cerrar V-table-Win 
FUNCTION cerrar RETURNS LOGICAL
  ( hh AS WIDGET-HANDLE ) :
/*------------------------------------------------------------------------------
  Purpose:  
    Notes:  
------------------------------------------------------------------------------*/
IF VALID-HANDLE(hh) THEN   do:
    RUN dispatch IN hh ( INPUT 'destroy':U ) . 
    RETURN TRUE.
END.
ELSE RETURN FALSE.   /* Function return value. */

END FUNCTION.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

&ANALYZE-SUSPEND _UIB-CODE-BLOCK _FUNCTION ver_prf V-table-Win 
FUNCTION ver_prf RETURNS CHARACTER
  ( /* parameter-definitions */ ) :
/*------------------------------------------------------------------------------
  Purpose:  
    Notes:  
------------------------------------------------------------------------------*/
DEFINE VAR listaprf AS CHAR NO-UNDO.
listaprf = "".
/*FOR EACH canal WHERE sic.canal.nro_tipo_evento = tarea.nro_tipo_evento AND
         canal.nro_cliente = tarea.nro_cliente:
      IF LOOKUP( string(canal.cdg_puntovta) , listaprf ) = 0 THEN
     listaprf = listaprf + "," + string(canal.cdg_puntovta).
END.
FOR EACH canal WHERE sic.canal.nro_tipo_evento = tarea.nro_tipo_evento AND
         canal.nro_cliente = tarea.nro_admin:
      IF LOOKUP( string(canal.cdg_puntovta) , listaprf ) = 0 THEN
     listaprf = listaprf + "," + string(canal.cdg_puntovta).
END. */
/*
IF listaprf="" THEN DO: /*todos los prf posibles*/
  FOR EACH Punto-venta WHERE Punto-venta.Habilitado:
      listaprf = listaprf + "," + string(Punto-venta.cdg_puntovta).
  END.
END.
*/
FOR EACH punto-venta WHERE Punto-venta.Habilitado AND Punto-venta.cdg_empresa = Empresa.cdg_empresa:
   listaprf = listaprf + "," + string(Punto-venta.cdg_puntovta).
END.
  RETURN substring(listaprf,2).   /* Function return value. */

END FUNCTION.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME

