&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CUSTOM _DEFINITIONS V-table-Win 
/*------------------------------------------------------------------------

  File:

  Description: from VIEWER.W - Template for SmartViewer Objects

  Input Parameters:
      <none>

  Output Parameters:
      <none>

------------------------------------------------------------------------*/
/*          This .W file was created with the Progress UIB.             */
/*----------------------------------------------------------------------*/

/* Create an unnamed pool to store all the widgets created 
     by this procedure. This is a good default which assures
     that this procedure's triggers and internal procedures 
     will execute in this procedure's storage, and that proper
     cleanup will occur on deletion of the procedure. */

CREATE WIDGET-POOL.

/* ***************************  Definitions  ************************** */

/* Parameters Definitions ---                                           */

/* Local Variable Definitions ---                                       */

DEFINE BUFFER B-Problema FOR Problema.

DEFINE VARIABLE rid_tema AS ROWID.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&ANALYZE-SUSPEND _UIB-PREPROCESSOR-BLOCK 

/* ********************  Preprocessor Definitions  ******************** */

&Scoped-define PROCEDURE-TYPE SmartViewer

&Scoped-define ADM-SUPPORTED-LINKS Record-Source,Record-Target,TableIO-Target

/* Name of first Frame and/or Browse and/or first Query                 */
&Scoped-define FRAME-NAME F-Main

/* External Tables                                                      */
&Scoped-define EXTERNAL-TABLES Tema Problema
&Scoped-define FIRST-EXTERNAL-TABLE Tema


/* Need to scope the external tables to this procedure                  */
DEFINE QUERY external_tables FOR Tema, Problema.
/* Standard List Definitions                                            */
&Scoped-Define ENABLED-FIELDS Problema.titulo Problema.version-reporte ~
Problema.reportado_por Problema.fecha_reportado Problema.horas_estimadas ~
Problema.version-arreglo Problema.cdg_recurso Problema.fecha_resuelto ~
Problema.horas_reales Problema.tipo Problema.reportado_ref Problema.estado ~
Problema.fecha_prevista Problema.descripcion Problema.accion 
&Scoped-define FIELD-PAIRS~
 ~{&FP1}titulo ~{&FP2}titulo ~{&FP3}~
 ~{&FP1}version-reporte ~{&FP2}version-reporte ~{&FP3}~
 ~{&FP1}reportado_por ~{&FP2}reportado_por ~{&FP3}~
 ~{&FP1}fecha_reportado ~{&FP2}fecha_reportado ~{&FP3}~
 ~{&FP1}horas_estimadas ~{&FP2}horas_estimadas ~{&FP3}~
 ~{&FP1}version-arreglo ~{&FP2}version-arreglo ~{&FP3}~
 ~{&FP1}cdg_recurso ~{&FP2}cdg_recurso ~{&FP3}~
 ~{&FP1}fecha_resuelto ~{&FP2}fecha_resuelto ~{&FP3}~
 ~{&FP1}horas_reales ~{&FP2}horas_reales ~{&FP3}~
 ~{&FP1}reportado_ref ~{&FP2}reportado_ref ~{&FP3}~
 ~{&FP1}fecha_prevista ~{&FP2}fecha_prevista ~{&FP3}
&Scoped-define ENABLED-TABLES Problema
&Scoped-define FIRST-ENABLED-TABLE Problema
&Scoped-Define ENABLED-OBJECTS RECT-6 
&Scoped-Define DISPLAYED-FIELDS Problema.titulo Problema.version-reporte ~
Problema.reportado_por Problema.fecha_reportado Problema.horas_estimadas ~
Problema.version-arreglo Problema.cdg_recurso Problema.fecha_resuelto ~
Problema.horas_reales Problema.tipo Problema.reportado_ref Problema.estado ~
Problema.fecha_prevista Problema.descripcion Problema.accion 

/* Custom List Definitions                                              */
/* ADM-CREATE-FIELDS,ADM-ASSIGN-FIELDS,List-3,List-4,List-5,List-6      */

/* _UIB-PREPROCESSOR-BLOCK-END */
&ANALYZE-RESUME



/* ***********************  Control Definitions  ********************** */


/* Definitions of the field level widgets                               */
DEFINE RECTANGLE RECT-6
     EDGE-PIXELS 2 GRAPHIC-EDGE  NO-FILL 
     SIZE 87 BY 9.15.


/* ************************  Frame Definitions  *********************** */

DEFINE FRAME F-Main
     Problema.titulo AT ROW 1.27 COL 13 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 72 BY .77
          BGCOLOR 15 FGCOLOR 9 
     Problema.version-reporte AT ROW 2.35 COL 13 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 8 BY .77
          BGCOLOR 15 FGCOLOR 9 
     Problema.reportado_por AT ROW 2.35 COL 33 COLON-ALIGNED
          LABEL "Reportó"
          VIEW-AS FILL-IN NATIVE 
          SIZE 10 BY .77
          BGCOLOR 15 FGCOLOR 9 
     Problema.fecha_reportado AT ROW 2.35 COL 56 COLON-ALIGNED
          LABEL "F. Reporte"
          VIEW-AS FILL-IN NATIVE 
          SIZE 9 BY .77
          BGCOLOR 15 FGCOLOR 9 
     Problema.horas_estimadas AT ROW 2.35 COL 76 COLON-ALIGNED
          LABEL "H.Estim."
          VIEW-AS FILL-IN NATIVE 
          SIZE 9 BY .77
          BGCOLOR 15 FGCOLOR 9 
     Problema.version-arreglo AT ROW 3.42 COL 13 COLON-ALIGNED
          LABEL "En Release"
          VIEW-AS FILL-IN NATIVE 
          SIZE 8 BY .77
          BGCOLOR 15 FGCOLOR 9 
     Problema.cdg_recurso AT ROW 3.42 COL 33 COLON-ALIGNED
          LABEL "Recurso"
          VIEW-AS FILL-IN NATIVE 
          SIZE 10 BY .81
          BGCOLOR 15 FGCOLOR 9 
     Problema.fecha_resuelto AT ROW 3.42 COL 56 COLON-ALIGNED
          LABEL "F.Resuelto"
          VIEW-AS FILL-IN NATIVE 
          SIZE 9 BY .77
          BGCOLOR 15 FGCOLOR 9 
     Problema.horas_reales AT ROW 3.42 COL 76 COLON-ALIGNED
          LABEL "H.Reales"
          VIEW-AS FILL-IN NATIVE 
          SIZE 9 BY .77
          BGCOLOR 15 FGCOLOR 9 
     Problema.tipo AT ROW 4.5 COL 4 NO-LABEL
          VIEW-AS RADIO-SET HORIZONTAL
          RADIO-BUTTONS 
                    "Arreglo", "A":U,
"Cambio", "C":U,
"Desarrollo", "D":U,
"Implementación", "I":U
          SIZE 50 BY 1.08
     Problema.reportado_ref AT ROW 4.5 COL 76 COLON-ALIGNED
          LABEL "Referencia"
          VIEW-AS FILL-IN NATIVE 
          SIZE 9 BY .77
          BGCOLOR 15 FGCOLOR 9 
     Problema.estado AT ROW 5.31 COL 4 NO-LABEL
          VIEW-AS RADIO-SET HORIZONTAL
          RADIO-BUTTONS 
                    "Abierto", "",
"Resuelto", "R":U,
"Descartado", "D":U,
"Presupuestar", "P":U
          SIZE 50 BY 1.08
     Problema.fecha_prevista AT ROW 5.58 COL 76 COLON-ALIGNED
          VIEW-AS FILL-IN NATIVE 
          SIZE 9 BY .77
          BGCOLOR 15 FGCOLOR 9 
     Problema.descripcion AT ROW 7.73 COL 4 NO-LABEL
          VIEW-AS EDITOR
          SIZE 41 BY 2.15
          BGCOLOR 15 FGCOLOR 7 
     Problema.accion AT ROW 7.73 COL 46 NO-LABEL
          VIEW-AS EDITOR
          SIZE 41 BY 2.15
          BGCOLOR 15 FGCOLOR 7 
     "                                Acción Tomada" VIEW-AS TEXT
          SIZE 41 BY .81 AT ROW 6.65 COL 46
          BGCOLOR 7 FGCOLOR 15 FONT 4
     "                            Descripción" VIEW-AS TEXT
          SIZE 41 BY .81 AT ROW 6.65 COL 4
          BGCOLOR 7 FGCOLOR 15 FONT 4
     RECT-6 AT ROW 1 COL 1
    WITH 1 DOWN NO-BOX KEEP-TAB-ORDER OVERLAY 
         SIDE-LABELS NO-UNDERLINE THREE-D 
         AT COL 1 ROW 1 SCROLLABLE 
         FONT 4.


/* *********************** Procedure Settings ************************ */

