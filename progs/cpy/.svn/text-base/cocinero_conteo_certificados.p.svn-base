DEFINE VAR fd AS DATE.
DEFINE VAR fh AS DATE.
DEFINE VAR cant AS INT LABEL "Analisis Realizados".
fd= 04/01/2011.
fh = 04/30/2011.
FIND restriccion no-lock WHERE restriccion.cdg_restriccion = "CERTIF".

DEFINE BUFFER hevento FOR evento.
FOR EACH evento_protocolo , evento OF evento_protocolo WHERE evento.frealizado >= fd AND evento.frealizado <= fh:
cant = cant + 1.
FIND contrato_restriccion WHERE contrato_restriccion.nro_contrato = evento.nro_identificacion AND
contrato_restriccion.nro_restriccion = restriccion.nro_restriccion NO-ERROR.
DISPLAY contrato_restriccion.valor WHEN AVAILABLE contrato_restriccion.
END.

DISPLAY cant with SIDE-LABELS.
