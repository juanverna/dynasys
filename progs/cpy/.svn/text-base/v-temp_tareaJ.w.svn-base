     SIZE 14 BY 1 NO-UNDO.

DEFINE VARIABLE v-proto AS CHARACTER FORMAT "X(256)":U 
     LABEL "Proto" 
     VIEW-AS FILL-IN 
     SIZE 14 BY 1 NO-UNDO.

DEFINE VARIABLE retira AS CHARACTER INITIAL "C" 
     VIEW-AS RADIO-SET VERTICAL
     RADIO-BUTTONS 
          "Consorcio", "C",
"Administacion", "A",
"Otro", "O"
     SIZE 18 BY 2.14 TOOLTIP "Direccion de retiro del Libro, si es otro aclare en el Adicional" NO-UNDO.

DEFINE VARIABLE tienelibro AS LOGICAL INITIAL no 
     LABEL "Confirme que tiene el libro" 
     VIEW-AS TOGGLE-BOX
     SIZE 30 BY .81 TOOLTIP "Confirmacion que el cliente tiene el libro en su poder" NO-UNDO.


/* Browse definitions                                                   */
DEFINE BROWSE BROWSE-7
