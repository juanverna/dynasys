  Notes:       
------------------------------------------------------------------------------*/

IF chProgressBar:ProgressBar-2:VALUE < 10 THEN 
        chProgressBar:ProgressBar-2:VALUE = chProgressBar:ProgressBar-2:VALUE + 1.
ELSE
        chProgressBar:ProgressBar-2:VALUE = 0.

END PROCEDURE.

