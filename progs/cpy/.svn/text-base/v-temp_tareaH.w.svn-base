&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL Tarea.fecha_prevista V-table-Win
ON MOUSE-MENU-DOWN OF Tarea.fecha_prevista IN FRAME F-Main /* Fecha */
DO:
    {selfecha.i}
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME m_CertificadoAnalisis
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL m_CertificadoAnalisis V-table-Win
ON CHOOSE OF MENU-ITEM m_CertificadoAnalisis /* Certificado+Analisis */
DO:
  MENU-ITEM m_CertificadoAnalisisRecibo:CHECKED IN MENU  POPUP-MENU-Banal = 
          NOT MENU-ITEM m_CertificadoAnalisis:CHECKED IN MENU  POPUP-MENU-Banal.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&Scoped-define SELF-NAME m_CertificadoAnalisisRecibo
&ANALYZE-SUSPEND _UIB-CODE-BLOCK _CONTROL m_CertificadoAnalisisRecibo V-table-Win
ON CHOOSE OF MENU-ITEM m_CertificadoAnalisisRecibo /* Certificado+Analisis+Recibo */
DO:
  MENU-ITEM m_CertificadoAnalisis:CHECKED IN MENU  POPUP-MENU-Banal = 
          NOT MENU-ITEM m_CertificadoAnalisisRecibo:CHECKED IN MENU  POPUP-MENU-Banal.
END.

/* _UIB-CODE-BLOCK-END */
&ANALYZE-RESUME


&UNDEFINE SELF-NAME

