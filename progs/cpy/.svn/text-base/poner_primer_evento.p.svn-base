DEFINE INPUT PARAMETER rcontrato AS ROWID.

FUNCTION duref RETURNS INT
  ( d AS CHAR, h AS CHAR ) :
/*------------------------------------------------------------------------------
  Purpose:  
    Notes:  
------------------------------------------------------------------------------*/
DEFINE VAR hh1 AS DECIMAL NO-UNDO.
DEFINE VAR mm1 AS DECIMAL NO-UNDO.
DEFINE VAR hh2 AS DECIMAL NO-UNDO.
DEFINE VAR mm2 AS DECIMAL NO-UNDO.


h = REPLACE(h,":","").
d = REPLACE(d,":","").
hh1 = INT(h).
h = STRING(hh1,"9999").
hh1 = INT(d).
d = STRING(hh1,"9999").

hh1 = INT( SUBSTRING(d,1,2) ).
mm1 = INT( SUBSTRING(d,3,2) ).
hh2 = INT( SUBSTRING(h,1,2) ).
mm2 = INT( SUBSTRING(h,3,2) ).

mm1 = mm1 / 60.
mm2 = mm2 / 60.
hh1 = hh1 + mm1.
hh2 = hh2 + mm2.

RETURN INT((hh2 - hh1) * 60 ).   /* Function return value. */

END FUNCTION.




FUNCTION erdur RETURNS INTEGER (rr AS INT,cc AS INT  ): 
    DEFINE VAR kk AS INT NO-UNDO.
DEFINE VAR pp1 AS INT NO-UNDO.
DEFINE VAR media AS INT NO-UNDO.
DEFINE VAR suma AS INT NO-UNDO.
DEFINE VAR pp AS INT INITIAL 5 NO-UNDO. /*cantidad de periodos maximos de analisis*/
DEFINE BUFFER bevento FOR evento.
DEFINE BUFFER weve FOR evento.
pp1 = 0.
suma = 0.
    FOR EACH bevento WHERE bevento.nro_tipo_evento = rr AND bevento.nro_cliente = cc AND
        NOT bevento.anulado AND bevento.frealizado<>? BY bevento.frealizado DESCENDING:
        kk = abs(duref(bevento.hora_desde, bevento.hora_hasta)).
        IF kk = 0 THEN NEXT.
        pp1 = pp1 + 1.
        suma = suma + kk.
        IF pp1 > pp THEN LEAVE.
    END.
    media = suma / pp1.
    pp1 = 0.
    suma = 0.
    FOR EACH bevento WHERE bevento.nro_tipo_evento = rr AND bevento.nro_cliente = cc AND
        NOT bevento.anulado AND bevento.frealizado<>? BY bevento.fasignado DESCENDING:
            kk = duref(bevento.hora_desde, bevento.hora_hasta).
            IF kk <= media * .8 OR kk >= media * 1.2 THEN NEXT.
        pp1 = pp1 + 1.
        suma = suma + duref(bevento.hora_desde, bevento.hora_hasta).
        IF pp1 > pp THEN LEAVE.
    END.
    media = suma / pp1.
    RETURN media.
END FUNCTION. 


DEFINE VAR k AS INT NO-UNDO.
DEFINE VAR ddd AS DATE NO-UNDO.
DEFINE VAR hhh AS DATE NO-UNDO.
DEFINE VAR hhh1 AS DATE NO-UNDO.
DEFINE VAR tempdurac AS INT NO-UNDO INITIAL 480.

FIND contrato_hd WHERE ROWID(contrato_hd) = rcontrato.
IF contrato_hd.cant_periodos = 0 THEN DO:
       ddd = IF contrato_hd.ultimo_mes = 0 THEN date(month(contrato_hd.rige_desde) , 1 ,YEAR(contrato_hd.rige_desde)) ELSE date(contrato_hd.ultimo_mes , 1 ,contrato_hd.ultimo_ano).
       hhh1 = date( month( ddd + 32 ) , 1, year( ddd + 32 )) - 1.
END.
ELSE DO:
    ddd = date(month(contrato_hd.rige_desde) , 1 ,YEAR(contrato_hd.rige_desde)).
    hhh1 = 1/1/2999.
END.
hhh = date( month( ddd + 32 ) , 1, year( ddd + 32 )) - 1.


/*IF contrato_hd.nro_tipo_evento <> 1 THEN 
   tempdurac = erdur(contrato_hd.nro_tipo_evento,contrato_hd.nro_cliente).*/
/*IF tempdurac = ? OR tempdurac = 0 THEN DO:*/

    IF contrato_hd.nro_tipo_evento <> 1 THEN tempdurac = 480. ELSE tempdurac = 90.
/*END.*/

DO k = 1 TO contrato_hd.numero_eventos:
   FIND FIRST evento WHERE evento.origen = "contrato" AND evento.nro_identificacion = contrato_hd.nro_contrato 
       AND evento.sub_evento = k AND NOT evento.anulado AND
       evento.fmin >= ddd AND evento.fmax <= hhh1 NO-ERROR.
   IF NOT AVAILABLE evento THEN  DO:
      CREATE evento.
      ASSIGN 
          evento.origen = "CONTRATO"
          Evento.Duracion = tempdurac
          Evento.FAsignado = ?
          Evento.FRealizado = ?
          Evento.FCreado = TODAY
          evento.fmin = ddd
          evento.fmax = hhh
          Evento.nro_evento = NEXT-VALUE(proximo_evento)
          Evento.nro_evento_padre = 0
          Evento.nro_identificacion = contrato_hd.nro_contrato
          Evento.Recursos = ""
          evento.sub_evento = k
          evento.evaluar = true
          evento.nro_cliente = contrato_hd.nro_cliente
          Evento.nro_tipo_evento = contrato_hd.nro_tipo_evento
          evento.observacion = contrato_hd.observacion
          evento.leyenda = ""
          evento.reminder = contrato_hd.reminder
          Evento.dreminder = contrato_hd.dreminder
          evento.periodo = YEAR(evento.fmin) * 100 + MONTH(evento.fmin).
          FIND cliente OF contrato_hd.
          FIND FIRST cliente_otros_datos of cliente NO-LOCK NO-ERROR.
          /********************************
          PERDON PERO NO SE ME OCURRE NADA MEJOR
          ********************************/
          FIND restriccion  NO-LOCK WHERE restriccion.nro_tipo_evento = contrato_hd.nro_tipo_evento AND
                restriccion.cdg_restriccion BEGINS "AVISO" NO-ERROR.
          IF AVAILABLE restriccion THEN DO:
                FIND FIRST contrato_restriccion WHERE contrato_restriccion.nro_contrato = contrato_hd.nro_contrato and
                            contrato_restriccion.sub_evento = 1 AND 
                            contrato_restriccion.nro_restriccion = restriccion.nro_restriccion NO-LOCK NO-ERROR.
                IF NOT AVAILABLE contrato_restriccion THEN DO:
                    CREATE contrato_restriccion.
                    ASSIGN contrato_restriccion.nro_contrato = contrato_hd.nro_contrato
                        contrato_restriccion.sub_evento = 1
                        contrato_restriccion.nro_restriccion = restriccion.nro_restriccion
                        contrato_restriccion.valor = "2|5|E|" + IF AVAILABLE cliente_otros_datos THEN cliente_otros_datos.acceso ELSE "".
                END.
          END.
          /*sigo con esto ver si es un contrato del tipo fumigacion y poner certificado*/
          FIND restriccion no-lock WHERE restriccion.nro_tipo_evento = contrato_hd.nro_tipo_evento AND
                restriccion.cdg_restriccion = "CERTIF" NO-ERROR.
          IF AVAILABLE restriccion THEN DO:
                FIND FIRST contrato_restriccion WHERE contrato_restriccion.nro_contrato = contrato_hd.nro_contrato and
                            contrato_restriccion.sub_evento = 1 AND 
                            contrato_restriccion.nro_restriccion = restriccion.nro_restriccion NO-LOCK NO-ERROR.
                IF NOT AVAILABLE contrato_restriccion THEN DO:
                    CREATE contrato_restriccion.
                    ASSIGN contrato_restriccion.nro_contrato = contrato_hd.nro_contrato
                        contrato_restriccion.sub_evento = 1
                        contrato_restriccion.nro_restriccion = restriccion.nro_restriccion
                        contrato_restriccion.valor = "O".
                END.
          END.

          IF contrato_hd.nro_tipo_evento = 3 THEN DO:
            IF AVAILABLE cliente_otros_datos THEN DO:
                evento.leyenda = evento.leyenda + ( IF evento.leyenda <> "" THEN "-" ELSE "" ) +  cliente_otros_datos.observacion.
                evento.leyenda = evento.leyenda + ( IF evento.leyenda <> "" THEN "-" ELSE "" ) +  IF cliente_otros_datos.tanques <> 0 THEN "Tanques:" + string(cliente_otros_datos.tanques) ELSE "".
            END.
            
        
            FIND restriccion no-lock WHERE restriccion.nro_tipo_evento = 3 AND
               restriccion.cdg_restriccion BEGINS "ANAGUA".
            FIND FIRST contrato_restriccion WHERE contrato_restriccion.nro_contrato = contrato_hd.nro_contrato and
                           contrato_restriccion.sub_evento = 1 AND 
                           contrato_restriccion.nro_restriccion = restriccion.nro_restriccion NO-LOCK NO-ERROR.
            IF NOT AVAILABLE contrato_restriccion THEN do:
                CREATE contrato_restriccion.
                ASSIGN contrato_restriccion.nro_contrato = contrato_hd.nro_contrato
                       contrato_restriccion.sub_evento = 1
                       contrato_restriccion.nro_restriccion = restriccion.nro_restriccion
                       contrato_restriccion.valor = "0".
            END.
          END. /*si ya se es un asco esta cableado el 3, quizas default en las restricciones!!!!*/
   END.
END.



